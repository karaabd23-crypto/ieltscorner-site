# example environment variables for local development
# copy this file to ".env" and fill in the values.  Do NOT commit the real key.

OPENAI_API_KEY=sk-<your-key-here>
# Optionally override the model used by the lesson generator (default gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# Google AdSense (replace in src/layouts/Layout.astro <head> when ready)
ADSENSE_CLIENT_ID=ca-pub-<your-adsense-id>
