# example environment variables for local development
# copy this file to ".env" and fill in the values.  Do NOT commit the real key.

OPENAI_API_KEY=sk-<your-key-here>
# Optionally override the model used by the lesson generator (default gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# CELPIP Writing AI Lab
# Create a monthly Stripe product/price and paste the recurring price ID here (e.g., price_123)
CELPIP_WRITING_PRICE_ID=
# Optional fallback display amount in cents
CELPIP_WRITING_AMOUNT_CENTS=500
STRIPE_API_KEY=
# Optional admin-only bypass token for AI lab access (keep secret)
CELPIP_WRITING_ADMIN_BYPASS_TOKEN=

# Kit newsletter forms (all newsletter + lead-magnet signups route through these)
KIT_API_KEY=
# Main digest form (newsletter + lesson-access signups)
KIT_DIGEST_FORM_ID=
# Instagram reading guide lead-magnet form
KIT_READING_GUIDE_FORM_ID=
# Optional additional Kit form IDs to sync into the digest audience (comma-separated)
KIT_EXTRA_AUDIENCE_FORM_IDS=
# Optional fallback form ID used by older scripts
KIT_FORM_ID=
# Canonical digest audience tag (recommended single source for dedupe + sends)
# If set, digest sends pull from this tag first.
KIT_DIGEST_TAG_ID=
# Optional digest audience segment (used for broadcast sending if tag is not set)
KIT_DIGEST_SEGMENT_ID=
# Optional Kit email template id for digest broadcasts (defaults to account default template)
KIT_DIGEST_TEMPLATE_ID=
# Optional sender override for digest broadcasts (must be a verified Kit sender)
KIT_BROADCAST_EMAIL_ADDRESS=
# Optional broadcast flags
KIT_BROADCAST_SEND_DELAY_MINUTES=5
KIT_BROADCAST_PUBLIC=false
# Optional tags to apply on subscribe
KIT_DEFAULT_TAG_ID=
KIT_READING_GUIDE_TAG_ID=

# Optional Claude/Anthropic fallback for content generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google AdSense (replace in src/layouts/Layout.astro <head> when ready)
ADSENSE_CLIENT_ID=ca-pub-<your-adsense-id>

# Telegram auto-post bot settings
# 1) Create bot with @BotFather and copy token
# 2) Add bot as admin in your channel
# 3) TELEGRAM_CHAT_ID can be channel username (@yourchannel) or numeric id (-100...)
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=@your_channel

# Optional: add your channel URL for CTA line in each post
TELEGRAM_CHANNEL_URL=https://t.me/your_channel

# Optional: style guidance used by the generator
TELEGRAM_POST_TEMPLATE=

# Telegram DM/chat webhook settings
# Public endpoint where Telegram should send updates (Netlify function URL)
# Example: https://your-site.netlify.app/.netlify/functions/telegram-webhook
TELEGRAM_WEBHOOK_URL=
# Optional secret used to validate Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=
# Your Telegram numeric chat ID (get it by DMing @userinfobot)
TELEGRAM_OWNER_CHAT_ID=
# Optional contact routing values shown by bot in DM
TELEGRAM_OWNER_USERNAME=
CONTACT_EMAIL=
# Optional Telegram group invite link used by admin-only invite messaging
TELEGRAM_GROUP_INVITE_URL=
# Website URL used in DM quick links
WEBSITE_URL=https://ieltscorner.ca
