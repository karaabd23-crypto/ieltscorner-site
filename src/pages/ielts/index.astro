---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { buildBreadcrumbSchema } from "../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "IELTS", path: "/ielts/" },
  ]),
];
---

<Layout
  title="IELTS Preparation Online | Free Lessons & Band 7+ Help"
  description="Free IELTS lessons for listening, reading, writing, and speaking, plus AI writing feedback and 1:1 coaching. Reach Band 7+ with a clear plan. Start free."
  keywords="IELTS preparation, IELTS listening, IELTS reading, IELTS writing, IELTS speaking"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "IELTS" },
  ]} />

  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/ielts.webp');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill ic-eyebrow">IELTS exam hub</span>
        <h1 class="ic-display">IELTS preparation</h1>
        <p class="muted">Start free with the lesson library, then add writing feedback or coaching when you are ready.</p>
        {/* Task 1: lead with the free hooking tool (lessons); paid options sit as a secondary band below. */}
        <div class="cluster" style="margin-top: var(--s-2);">
          <a class="btn btn-primary ic-btn" href="/lessons">Start free lessons</a>
          <a class="btn btn-ghost" href="/ai-feedback">AI writing feedback</a>
          <a class="btn btn-ghost" href="/tutoring#book-private-class">Private class</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 class="ic-display" style="margin-top: 0;">IELTS skill paths</h2>
      <div class="offer-grid" style="margin-top: var(--s-3);">
        <a class="offer-card ic-card" href="/ielts/listening" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label ic-eyebrow">Skill 1</p>
          <h3 class="offer-card__name">Listening</h3>
          <p class="offer-card__line">Fix prediction and answer-checking mistakes.</p>
          <span class="btn btn-ghost">Open Listening Path</span>
        </a>

        <a class="offer-card ic-card" href="/ielts/reading" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label ic-eyebrow">Skill 2</p>
          <h3 class="offer-card__name">Reading</h3>
          <p class="offer-card__line">Improve timing, question strategy, and accuracy.</p>
          <span class="btn btn-ghost">Open Reading Path</span>
        </a>

        <a class="offer-card ic-card" href="/ielts/writing" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label ic-eyebrow">Skill 3</p>
          <h3 class="offer-card__name">Writing</h3>
          <p class="offer-card__line">Get score-focused corrections and a clear revision plan.</p>
          <span class="btn btn-ghost">Open Writing Path</span>
        </a>

        <a class="offer-card ic-card" href="/ielts/speaking" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label ic-eyebrow">Skill 4</p>
          <h3 class="offer-card__name">Speaking</h3>
          <p class="offer-card__line">Build clear answers and stronger fluency for all parts.</p>
          <span class="btn btn-ghost">Open Speaking Path</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 class="ic-display" style="margin-top: 0;">IELTS tools and support</h2>
      <div class="offer-grid" style="margin-top: var(--s-3);">
        <a class="offer-card ic-card" href="/lessons" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label ic-eyebrow">Free</p>
          <h3 class="offer-card__name">Free Lessons</h3>
          <p class="offer-card__line">Grammar, vocabulary, writing, and speaking lessons.</p>
          <span class="btn btn-ghost">Browse Free Lessons</span>
        </a>

        <a class="offer-card ic-card" href="/ai-feedback" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label ic-eyebrow">Writing</p>
          <h3 class="offer-card__name">AI Writing Feedback</h3>
          <p class="offer-card__line">Submit a writing task and get instant AI feedback.</p>
          <span class="btn btn-ghost">Start AI Feedback</span>
        </a>

        <a class="offer-card ic-card" href="/ielts-writing-help" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label ic-eyebrow">Writing</p>
          <h3 class="offer-card__name">IELTS Writing Help</h3>
          <p class="offer-card__line">Focused writing improvement path with feedback.</p>
          <span class="btn btn-ghost">Open Writing Help</span>
        </a>

        <a class="offer-card ic-card" href="/tutoring#book-private-class" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label ic-eyebrow">Live support</p>
          <h3 class="offer-card__name">Private Class</h3>
          <p class="offer-card__line">One-to-one coaching for any skill. CA$30 per session.</p>
          <span class="btn btn-ghost">Book Private Class</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
