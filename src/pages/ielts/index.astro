---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { buildBreadcrumbSchema } from "../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "IELTS", path: "/ielts/" },
  ]),
];
---

<Layout
  title="IELTS Hub | Choose Your Skill"
  description="IELTS hub with four skill paths: listening, reading, writing, and speaking."
  keywords="IELTS preparation, IELTS listening, IELTS reading, IELTS writing, IELTS speaking"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "IELTS" },
  ]} />

  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/IELTS.png');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill">IELTS exam hub</span>
        <h1>Choose the IELTS skill you want to improve</h1>
        <p class="muted">
          Select one skill below and follow one clear path for faster score improvement.
        </p>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">IELTS skill paths</h2>
      <div class="offer-grid" style="margin-top: var(--s-3);">
        <a class="offer-card" href="/ielts/listening" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label">Skill 1</p>
          <h3 class="offer-card__name">Listening</h3>
          <p class="offer-card__line">Fix prediction and answer-checking mistakes.</p>
          <span class="btn btn-ghost">Open Listening Path</span>
        </a>

        <a class="offer-card" href="/ielts/reading" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label">Skill 2</p>
          <h3 class="offer-card__name">Reading</h3>
          <p class="offer-card__line">Improve timing, question strategy, and accuracy.</p>
          <span class="btn btn-ghost">Open Reading Path</span>
        </a>

        <a class="offer-card" href="/ielts/writing" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label">Skill 3</p>
          <h3 class="offer-card__name">Writing</h3>
          <p class="offer-card__line">Get score-focused corrections and a clear revision plan.</p>
          <span class="btn btn-ghost">Open Writing Path</span>
        </a>

        <a class="offer-card" href="/ielts/speaking" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label">Skill 4</p>
          <h3 class="offer-card__name">Speaking</h3>
          <p class="offer-card__line">Build clear answers and stronger fluency for all parts.</p>
          <span class="btn btn-ghost">Open Speaking Path</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">IELTS support services</h2>
      <p class="muted" style="margin-top: 0;">
        Choose the service that matches your current need.
      </p>
      <div class="offer-grid" style="margin-top: var(--s-3);">
        <a class="offer-card" href="/ai-feedback" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label">Writing</p>
          <h3 class="offer-card__name">AI Writing Feedback</h3>
          <p class="offer-card__line">Practice under timed conditions and get instant AI-scored feedback.</p>
          <span class="btn btn-ghost">Start AI Feedback</span>
        </a>

        <a class="offer-card" href="/tutoring#book-private-class" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label">Live support</p>
          <h3 class="offer-card__name">Private Class</h3>
          <p class="offer-card__line">One-to-one support for any skill: listening, reading, writing, or speaking.</p>
          <span class="btn btn-ghost">Book Private Class</span>
        </a>

        <a class="offer-card" href="/ielts-writing-help" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label">Quick start</p>
          <h3 class="offer-card__name">IELTS Writing Help</h3>
          <p class="offer-card__line">A focused path for writing improvement with correction and feedback.</p>
          <span class="btn btn-ghost">Open Writing Help</span>
        </a>

        <a class="offer-card" href="/lessons" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label">Free</p>
          <h3 class="offer-card__name">Free Lessons</h3>
          <p class="offer-card__line">Grammar, vocabulary, writing, and speaking lessons with search and filters.</p>
          <span class="btn btn-ghost">Browse Free Lessons</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
