---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="IELTS — IELTS Corner"
  description="Band 7+ IELTS support with clear structure for Writing, Speaking, Reading, and Listening."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/IELTS.png');`}>
      <div class="hero-content">
        <span class="pill">🎯 IELTS • Band 7+</span>

        <h1>IELTS help that teaches you what really works.</h1>

        <div class="cluster">
          <a class="btn btn-primary" href="/lessons/ielts">Browse IELTS lessons →</a>
          <a class="btn btn-ghost" href="/lessons">All lessons →</a>
        </div>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <div class="grid grid-2">
      <article class="card">
        <h3>Writing</h3>
        <p class="muted">Learn how to organize your ideas, connect them clearly, and write in the right style for higher scores.</p>
        <a class="btn" href="/lessons/ielts/writing">See lessons →</a>
      </article>

      <article class="card">
        <h3>Speaking</h3>
        <p class="muted">Practice giving clear answers with good vocabulary and natural delivery.</p>
        <a class="btn" href="/lessons/ielts/speaking">See lessons →</a>
      </article>

      <article class="card">
        <h3>Reading</h3>
        <p class="muted">Learn smart reading strategies, how to manage your time, and how to avoid common mistakes.</p>
        <a class="btn" href="/lessons/ielts/reading">See lessons →</a>
      </article>

      <article class="card">
        <h3>Listening</h3>
        <p class="muted">Learn how to predict answers, listen for key words, and check your work carefully.</p>
        <a class="btn" href="/lessons/ielts/listening">See lessons →</a>
      </article>
    </div>

    <div style="height: var(--s-8);"></div>

    <div class="surface feature">
      <div class="feature-grid">
        <div class="stack">
          <h2>Want faster improvement?</h2>
          <p class="muted" style="max-width: 58ch;">
            Most students don’t need more advice. They need feedback, corrections, and a plan.
          </p>
          <div class="cluster">
            <a class="btn btn-primary" href="/tutoring">See tutoring →</a>
            <a class="btn" href="/essay-correction">Essay correction →</a>
          </div>
        </div>

        <div class="checklist">
          <div class="check">
            <div class="icon">✓</div>
            <div>
              <strong>Clear structure</strong>
              <span>Know what to write / say first, next, and last.</span>
            </div>
          </div>

          <div class="check">
            <div class="icon">✓</div>
            <div>
              <strong>Direct feedback</strong>
              <span>Fix the real problems, not random ones.</span>
            </div>
          </div>

          <div class="check">
            <div class="icon">✓</div>
            <div>
              <strong>Band 7+ focus</strong>
              <span>Flow, tone, grammar control.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
