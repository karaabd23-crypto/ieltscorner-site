<Layout
  title="100 IELTS Speaking Part 2 & 3 Questions | Free Practice Bank"
  description="Practice with 100 authentic IELTS Speaking Part 2 cue cards and Part 3 follow-up questions. Grouped by topic with instant filtering. Free, no sign-up required."
  keywords="IELTS speaking questions, IELTS speaking part 2, IELTS speaking part 3, IELTS cue card, IELTS speaking practice, IELTS Band 7 speaking"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "IELTS", href: "/ielts" },
    { label: "Speaking", href: "/ielts/speaking" },
    { label: "Part 2 & 3 Questions" },
  ]} />
  <SkillSubNav exam="IELTS" currentSkill="speaking" />

  <!-- Hero -->
  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/speaking.webp');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill">Free IELTS speaking bank</span>
        <h1>100 IELTS Speaking Part 2 &amp; 3 questions</h1>
        <p class="muted qb-hero-copy">
          Authentic cue cards and examiner follow-up questions across 10 real exam topics.
          Filter by topic, read the cue card, then practise answering the Part 3 discussion
          questions out loud.
        </p>
        <div class="cluster qb-stats">
          <span class="qb-stat">{totalPart2} Part 2 cue cards</span>
          <span class="qb-stat">{totalPart3} Part 3 questions</span>
          <span class="qb-stat">10 topics</span>
        </div>
        <div class="funnel-hero__actions">
          <a class="btn btn-primary" href="#speaking-bank">Browse questions</a>
          <a class="btn btn-ghost" href="/ielts/speaking/band-descriptors">Understand band scores</a>
        </div>
      </div>
    </div>
  </section>

  <!-- How to use this page -->
  <section class="section-sm" style="padding-top: 0;">
    <div class="surface how-to-use">
      <h2 style="margin-top: 0;">How to use this IELTS Speaking question bank</h2>
      <ol class="how-to-list">
        <li><strong>Pick a topic</strong> that interests you or that you find challenging.</li>
        <li><strong>Read the cue card</strong> and give yourself exactly 1 minute to prepare notes.</li>
        <li><strong>Speak for 2 minutes</strong> on the Part 2 topic, covering all the bullet points.</li>
        <li><strong>Answer the Part 3 questions</strong> as if speaking to a real examiner â€” aim for 3â€“5 sentences per answer.</li>
        <li><strong>Repeat with a new topic</strong> to build fluency across question types.</li>
      </ol>
      <div class="how-to-links">
        <a href="/ielts/speaking/band-descriptors" class="btn btn-ghost btn-sm">What do band scores mean?</a>
        <a href="/tutoring#book-private-class" class="btn btn-ghost btn-sm">Get live speaking feedback</a>
      </div>
    </div>
  </section>

  <!-- Topic filter tabs + IELTS Speaking question bank -->
  <section class="section-sm" id="speaking-bank" style="padding-top: 0;">
    <div class="container">

      <!-- Topic filter -->
      <div class="topic-filter" role="tablist" aria-label="Filter by topic">
        <button
          class="topic-btn is-active"
          data-topic="all"
          role="tab"
          aria-selected="true"
        >All topics</button>
        {topics.map((t) => (
          <button
            class="topic-btn"
            data-topic={t.id}
            role="tab"
            aria-selected="false"
          >
            <span aria-hidden="true">{t.icon}</span> {t.label}
          </button>
        ))}
      </div>

      <!-- Cards grid -->
      <div class="cards-grid" id="cards-grid">
        {topics.map((topic) =>
          topic.cards.map((card, cardIdx) => (
            <article
              class="qb-card surface"
              data-topic={topic.id}
              id={card.id}
            >
              <!-- Card header -->
              <div class="qb-card__header">
                <div class="qb-card__meta">
                  <span class="pill pill-sm">{topic.icon} {topic.label}</span>
                  <span class="qb-card__num">Card {cardIdx + 1}</span>
                </div>
                <span class="qb-card__part-badge">Part 2</span>
              </div>

              <!-- Cue card -->
              <div class="cue-card">
                <p class="cue-card__prompt">{card.part2.prompt}</p>
                <p class="cue-card__instruction">You should say:</p>
                <ul class="cue-card__bullets">
                  {card.part2.bullets.map((b) => <li>{b}</li>)}
                </ul>
                <p class="cue-card__time-note">You have 1 minute to prepare. Speak for 1â€“2 minutes.</p>
              </div>

              <!-- Part 3 toggle -->
              <button class="part3-toggle" aria-expanded="false" aria-controls={`part3-${card.id}`}>
                <span class="part3-toggle__label">Part 3 discussion questions</span>
                <span class="part3-toggle__count">{card.part3.length} questions</span>
                <span class="part3-toggle__icon" aria-hidden="true">â–¼</span>
              </button>
              <div class="part3-panel" id={`part3-${card.id}`} hidden>
                <ol class="part3-list">
                  {card.part3.map((q) => <li>{q}</li>)}
                </ol>
                <p class="part3-hint">Aim for extended answers. Use examples, compare viewpoints, and justify your opinions.</p>
              </div>
            </article>
          ))
        )}
      </div>

      <div class="no-results" hidden aria-live="polite">
        <p>No cards for this topic yet. Try "All topics" to see everything.</p>
      </div>
    </div>
  </section>

  <!-- Next step CTA -->
  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 style="margin-top: 0;">Ready to go beyond self-study?</h2>
      <p>Book one private speaking class and get direct examiner-style feedback on your fluency, vocabulary, and structure.</p>
      <div class="funnel-final-cta__actions">
        <a class="btn btn-primary" href="/tutoring#book-private-class">Book a Private Class</a>
        <a class="btn btn-ghost" href="/ielts/speaking/band-descriptors">Read the Band Descriptor Guide</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Topic filter
  const btns = document.querySelectorAll<HTMLButtonElement>(".topic-btn");
  const cards = document.querySelectorAll<HTMLElement>(".qb-card");
  const noResults = document.querySelector<HTMLElement>(".no-results");

  btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      btns.forEach((b) => { b.classList.remove("is-active"); b.setAttribute("aria-selected", "false"); });
      btn.classList.add("is-active");
      btn.setAttribute("aria-selected", "true");

      const topic = btn.dataset.topic!;
      let visible = 0;
      cards.forEach((card) => {
        const show = topic === "all" || card.dataset.topic === topic;
        card.hidden = !show;
        if (show) visible++;
      });
      if (noResults) noResults.hidden = visible > 0;
    });
  });

  // Part 3 accordion toggle
  const toggles = document.querySelectorAll<HTMLButtonElement>(".part3-toggle");
  toggles.forEach((btn) => {
    btn.addEventListener("click", () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!expanded));
      const panelId = btn.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : null;
      if (panel) panel.hidden = expanded;
      btn.querySelector(".part3-toggle__icon")!.textContent = expanded ? "â–¼" : "â–²";
    });
  });
</script>

