---
import Layout from "../../../layouts/Layout.astro";
import SkillFreeLessons from "../../../components/SkillFreeLessons.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "IELTS", path: "/ielts/" },
    { name: "Speaking", path: "/ielts/speaking/" },
  ]),
];
---

<Layout
  title="IELTS Speaking Help | Book Private Class"
  description="Stuck in IELTS speaking? Book one private class and fix fluency, structure, and score-lowering habits."
  keywords="IELTS speaking help, IELTS speaking coaching, IELTS private class"
  structuredData={pageStructuredData}
>
  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/speaking.png');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill">IELTS speaking support</span>
        <h1>Stuck below Band 7 in IELTS Speaking?</h1>
        <p class="muted">
          Get one-to-one speaking support to improve fluency, idea development,
          and response structure for Parts 1, 2, and 3.
        </p>
        <div class="funnel-hero__actions">
          <a class="btn btn-primary" href="/tutoring#book-private-class">Book Private Class</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">What this class helps you fix</h2>
      <ul style="margin: 0; padding-left: 1.2rem;">
        <li>Short answers that do not develop ideas well.</li>
        <li>Frequent hesitation and repetition under pressure.</li>
        <li>Grammar and pronunciation patterns that lower band score.</li>
      </ul>
    </div>
  </section>

  <SkillFreeLessons exam="IELTS" skill="speaking" />

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 style="margin-top: 0;">Your next step</h2>
      <p>Book one focused private class and get direct speaking feedback in real time.</p>
      <div class="funnel-final-cta__actions">
        <a class="btn btn-primary" href="/tutoring#book-private-class">Book Private Class</a>
      </div>
    </div>
  </section>
</Layout>
