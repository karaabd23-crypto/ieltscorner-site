---
import Layout from "../../../layouts/Layout.astro";
import SkillFreeLessons from "../../../components/SkillFreeLessons.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SkillSubNav from "../../../components/SkillSubNav.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "IELTS", path: "/ielts/" },
    { name: "Writing", path: "/ielts/writing/" },
  ]),
];
---

<Layout
  title="IELTS Writing | Get Score-Focused Feedback"
  description="Improve IELTS writing with one focused path: submit your essay and get score-focused corrections."
  keywords="IELTS writing, IELTS essay feedback, IELTS writing correction, Band 7 writing"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "IELTS", href: "/ielts" },
    { label: "Writing" },
  ]} />
  <SkillSubNav exam="IELTS" currentSkill="writing" />

  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/writing.png');`}>
      <div class="hero-content">
        <span class="pill ic-eyebrow">IELTS writing</span>
        <h1 class="ic-display">Improve your IELTS writing with one clear next step</h1>
        <p class="muted" style="max-width: 62ch;">
          Stop guessing. Practice under timed conditions and get AI scoring and feedback you
          can apply in your next draft.
        </p>
        <div class="cluster">
          <a class="btn btn-primary ic-btn" href="/ai-feedback">Try AI Writing Feedback</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 class="ic-display" style="margin-top: 0;">What this fixes</h2>
      <ul style="margin: 0; padding-left: 1.2rem;">
        <li>Weak task response and missing prompt coverage.</li>
        <li>Unclear paragraph structure and weak support.</li>
        <li>Grammar patterns that repeatedly lower your score.</li>
      </ul>
    </div>
  </section>

  <SkillFreeLessons exam="IELTS" skill="writing" />

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 class="ic-display" style="margin-top: 0;">Ready to improve your IELTS writing score?</h2>
      <div class="funnel-final-cta__actions">
        <a class="btn btn-primary" href="/ai-feedback">Try AI Writing Feedback</a>
      </div>
    </div>
  </section>
</Layout>
