---
import Layout from "../../../layouts/Layout.astro";
import SkillFreeLessons from "../../../components/SkillFreeLessons.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SkillSubNav from "../../../components/SkillSubNav.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "IELTS", path: "/ielts/" },
    { name: "Listening", path: "/ielts/listening/" },
  ]),
];
---

<Layout
  title="IELTS Listening Help | Book Private Class"
  description="Stuck in IELTS listening? Book one private class and get a clear plan to fix your score gaps."
  keywords="IELTS listening help, IELTS listening coaching, IELTS private class"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "IELTS", href: "/ielts" },
    { label: "Listening" },
  ]} />
  <SkillSubNav exam="IELTS" currentSkill="listening" />

  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/listening.png');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill">IELTS listening support</span>
        <h1>Stuck below Band 7 in IELTS Listening?</h1>
        <p class="muted">
          Get one-to-one guidance to fix the exact listening habits that keep your score low,
          including prediction mistakes, trap answers, and answer-checking errors.
        </p>
        <div class="funnel-hero__actions">
          <a class="btn btn-primary" href="/tutoring#book-private-class">Book Private Class</a>
        </div>
      </div>
    </div>
  </section>

  <SkillFreeLessons exam="IELTS" skill="listening" />

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 style="margin-top: 0;">Your next step</h2>
      <p>Book one focused private class and get a personal listening improvement plan.</p>
      <div class="funnel-final-cta__actions">
        <a class="btn btn-primary" href="/tutoring#book-private-class">Book Private Class</a>
      </div>
    </div>
  </section>
</Layout>

