---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getLessonTier, getPublicLessonTitle } from "../../../lib/lessonLevel";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const relatedLessons = (
  await getCollection(
    "lessons",
    ({ data }) =>
      !data.draft &&
      data.exam.includes("IELTS") &&
      ["reading", "vocabulary", "grammar"].includes(data.category)
  )
)
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 8);

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "IELTS", path: "/ielts/" },
    { name: "Reading", path: "/ielts/reading/" },
  ]),
];

const pageKeywords = "IELTS reading, IELTS reading practice, IELTS reading question types, IELTS reading tips, Band 7 IELTS reading, IELTS scanning and skimming";
---

<Layout
  title="IELTS Reading Preparation | Question Types, Timing and Strategy"
  description="IELTS reading preparation with question-type strategy, timing control, scanning, skimming, and proof-based answer selection."
  keywords={pageKeywords}
  structuredData={pageStructuredData}
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/reading.png');`}>
      <div class="hero-content">
        <span class="pill">📖 IELTS Reading</span>
        <h1>Stop guessing. Read for proof.</h1>
        <p class="muted" style="max-width: 62ch;">
          IELTS reading gets easier when students stop reading every passage the same way. This hub helps you match strategy to question type, manage time better, and choose answers based on evidence instead of instinct.
        </p>
        <div class="cluster">
          <a class="btn btn-primary" href="/ielts/reading">Browse reading lessons →</a>
          <a class="btn btn-ghost" href="/ielts">Back to IELTS →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-5);">
      <div class="cluster quick-nav">
        <a class="btn" href="/ielts">IELTS Home</a>
        <a class="btn" href="/ielts/listening">Listening</a>
        <a class="btn btn-primary" href="/ielts/reading">Reading</a>
        <a class="btn" href="/ielts/speaking">Speaking</a>
        <a class="btn" href="/ielts/writing">Writing</a>
        <a class="btn" href="/ielts">All IELTS lessons</a>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-6);">
      <h2>Popular IELTS reading guides</h2>
      <p class="muted" style="margin-top: 0; max-width: 70ch;">
        Use these task-level strategy pages before drilling the lesson archive.
      </p>
      <div class="grid grid-2" style="gap: var(--s-4); margin-bottom: var(--s-5);">
        <a class="card" href="/blog/ielts-reading-question-types" style="display:block; text-decoration:none;">
          <h3>IELTS Reading Question Types Guide</h3>
          <p class="muted">How to adapt strategy for matching, completion, and T/F/NG tasks.</p>
        </a>
        <a class="card" href="/ielts/listening" style="display:block; text-decoration:none;">
          <h3>IELTS Listening Companion</h3>
          <p class="muted">Build the same evidence-first habit in listening and reduce answer traps.</p>
        </a>
      </div>

      <h2>What improves IELTS reading scores</h2>
      <div class="grid grid-2" style="gap: var(--s-4); margin-top: var(--s-4);">
        <div class="card">
          <h3>Question-type awareness</h3>
          <p class="muted">True/False/Not Given, matching headings, summary completion, and multiple choice do not reward the same reading behavior.</p>
        </div>
        <div class="card">
          <h3>Keyword discipline</h3>
          <p class="muted">Strong readers track paraphrases and synonyms, not just exact word matches.</p>
        </div>
        <div class="card">
          <h3>Timing control</h3>
          <p class="muted">Students lose marks by overinvesting in one hard question and collapsing late in the section.</p>
        </div>
        <div class="card">
          <h3>Evidence-based choices</h3>
          <p class="muted">If you cannot point to the evidence in the passage, the answer is still not secure.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-6);">
      <h2>Related IELTS reading lessons</h2>
      <div class="grid grid-2" style="margin-top: var(--s-4);">
        {relatedLessons.map((lesson) => (
          <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block; text-decoration:none;">
            <div class="cluster" style="justify-content: space-between;">
              <span class="pill">{lesson.data.category} • {getLessonTier(lesson.data.level)}</span>
              <span class="pill">Open →</span>
            </div>
            <h3 style="margin-top: var(--s-3);">{getPublicLessonTitle(lesson.data.title, lesson.data.level)}</h3>
            <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="grid grid-2">
      <div class="card">
        <h3>Next skill: Listening</h3>
        <p class="muted">If timing and trap answers are your issue in reading, listening often shows similar habits.</p>
        <a class="btn btn-primary" href="/ielts/listening">Open IELTS listening →</a>
      </div>
      <div class="card">
        <h3>Need a full archive?</h3>
        <p class="muted">Use the IELTS lesson archive if you want to move straight into every published reading lesson.</p>
        <a class="btn" href="/ielts/reading">Reading archive →</a>
      </div>
    </div>
  </section>
</Layout>