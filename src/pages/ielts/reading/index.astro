---
import Layout from "../../../layouts/Layout.astro";
import SkillFreeLessons from "../../../components/SkillFreeLessons.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "IELTS", path: "/ielts/" },
    { name: "Reading", path: "/ielts/reading/" },
  ]),
];
---

<Layout
  title="IELTS Reading Help | Book Private Class"
  description="Stuck in IELTS reading? Book one private class and fix timing, question-type strategy, and proof-based answers."
  keywords="IELTS reading help, IELTS reading coaching, IELTS private class"
  structuredData={pageStructuredData}
>
  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/reading.png');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill">IELTS reading support</span>
        <h1>Stuck below Band 7 in IELTS Reading?</h1>
        <p class="muted">
          Get one-to-one coaching to improve timing, handle difficult question types,
          and choose answers based on proof instead of guesswork.
        </p>
        <div class="funnel-hero__actions">
          <a class="btn btn-primary" href="/tutoring#book-private-class">Book Private Class</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">What this class helps you fix</h2>
      <ul style="margin: 0; padding-left: 1.2rem;">
        <li>Running out of time in Passage 3.</li>
        <li>Confusion with True/False/Not Given and matching tasks.</li>
        <li>Wrong answers caused by paraphrase traps.</li>
      </ul>
    </div>
  </section>

  <SkillFreeLessons exam="IELTS" skill="reading" />

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 style="margin-top: 0;">Your next step</h2>
      <p>Book one focused private class and get a clear reading score plan.</p>
      <div class="funnel-final-cta__actions">
        <a class="btn btn-primary" href="/tutoring#book-private-class">Book Private Class</a>
      </div>
    </div>
  </section>
</Layout>
