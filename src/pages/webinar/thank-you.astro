---
import Layout from "../../layouts/Layout.astro";

const webinarMeetLink = "https://meet.google.com/hcf-iwcn-syx";
---

<Layout
  title="Registration Confirmed | CELPIP Weekly Webinar"
  description="Your webinar registration is confirmed. Save the Google Meet link and check your email for the session details."
  type="page"
  noindex={true}
>
  <section class="section" style="padding-top: var(--s-6);">
    <div class="shell" style="max-width: 760px; margin: 0 auto;">
      <div class="surface webinar-thanks-panel">
        <p class="pill" style="margin: 0 auto var(--s-3); width: fit-content;">Registration confirmed</p>
        <h1 style="margin-top: 0; text-align: center;">You're registered</h1>
        <p class="muted" style="text-align: center; max-width: 58ch; margin: 0 auto;">
          Payment is confirmed and your spot is saved. Keep the join link below and check your email
          for the reminder and session details.
        </p>

        <div style="height: var(--s-5);"></div>

        <div class="surface webinar-link-box">
          <h2 style="margin-top: 0; text-align: center;">Join link</h2>
          <p style="text-align: center; margin-top: 0;">
            Save this now so you do not have to search for it later.
          </p>
          <div style="text-align: center;">
            <a href={webinarMeetLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Open Google Meet link
            </a>
          </div>
          <p class="muted" style="margin: var(--s-3) 0 0; word-break: break-all; text-align: center;">
            {webinarMeetLink}
          </p>
        </div>

        <div style="height: var(--s-5);"></div>

        <div class="grid grid-2 webinar-thanks-grid">
          <article class="card">
            <h3 style="margin-top: 0;">What happens next</h3>
            <ul style="margin: 0; padding-left: var(--s-3); color: var(--text-muted);">
              <li>Check your email for the reminder and session details</li>
              <li>Add the session to your calendar if you use one</li>
              <li>Join a few minutes early to test your audio</li>
            </ul>
          </article>

          <article class="card">
            <h3 style="margin-top: 0;">What to bring</h3>
            <ul style="margin: 0; padding-left: var(--s-3); color: var(--text-muted);">
              <li>One specific question or weak task</li>
              <li>Something to take notes with</li>
              <li>An example from your own writing if you want to ask about it</li>
            </ul>
          </article>
        </div>

        <div style="height: var(--s-5);"></div>

        <div class="surface webinar-help-box">
          <h3 style="margin-top: 0;">Need help?</h3>
          <p style="margin-bottom: var(--s-2);">
            If the email does not arrive or the link gives you trouble, contact us directly.
          </p>
          <div class="cluster">
            <a href="mailto:kara.abdolmaleki@gmail.com" class="btn">Email support</a>
            <a href="https://wa.me/16479317537" class="btn" target="_blank" rel="noreferrer">WhatsApp support</a>
          </div>
        </div>

        <div style="height: var(--s-5);"></div>

        <div style="text-align: center;">
          <a href="/lessons/writing" class="btn btn-ghost">Writing lessons</a>
          <a href="/blog" class="btn btn-ghost">Strategy blog</a>
          <a href="/" class="btn btn-ghost">Back to homepage</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .webinar-thanks-panel {
    padding: var(--s-5);
    border-radius: 18px;
  }

  .webinar-link-box,
  .webinar-help-box {
    padding: var(--s-4);
    border-left: 4px solid var(--accent);
  }

  .webinar-thanks-grid {
    gap: var(--s-3);
  }

  @media (max-width: 768px) {
    .webinar-thanks-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
