---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Subscription Confirmed | CELPIP Writing"
  description="Your CELPIP writing subscription has been received."
  noindex={true}
>
  <section class="section">
    <div class="landing-shell">
      <section class="landing-hero">
        <p class="landing-eyebrow">Subscription Confirmed</p>
        <h1>You are subscribed to CELPIP writing emails</h1>
        <p class="landing-subheadline">
          Watch your inbox for weekly writing tips, lesson updates, and announcements.
        </p>
      </section>

      <section class="landing-section">
        <h2>Next step to push your writing score up</h2>
        <a
          class="btn btn-primary"
          href="/essay-correction?src=thank-you-celpip-writing-next-step"
          data-track-click="thank-you-celpip-checklist-next-step-essay"
          data-track-page-type="landing"
          data-track-offer="essay_correction"
          data-track-test="celpip"
          data-track-skill="writing"
          data-track-position="hero"
        >
          Submit One Essay for Score-Focused Feedback
        </a>
      </section>

      <section class="landing-section">
        <h2>Prefer guided live support this week?</h2>
        <a
          class="btn btn-primary"
          href="/webinar?src=thank-you-celpip-writing-secondary"
          data-track-click="thank-you-celpip-checklist-secondary-webinar"
          data-track-page-type="landing"
          data-track-offer="weekly_training"
          data-track-test="celpip"
          data-track-skill="writing"
          data-track-position="mid"
          data-track-intent="purchase"
        >
          Join Weekly Live Training ($12)
        </a>
      </section>
    </div>
  </section>
</Layout>
