---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Subscription Confirmed | IELTS Writing"
  description="Your IELTS writing subscription has been received."
  noindex={true}
>
  <section class="section">
    <div class="landing-shell">
      <section class="landing-hero">
        <p class="landing-eyebrow">Subscription Confirmed</p>
        <h1>You are subscribed to IELTS writing emails</h1>
        <p class="landing-subheadline">
          Watch your inbox for weekly IELTS writing tips and new lesson updates.
        </p>
      </section>

      <section class="landing-section">
        <h2>Next step for Band 7+ writing progress</h2>
        <a
          class="btn btn-primary"
          href="/ai-feedback"
          data-track-click="thank-you-ielts-guide-next-step-ai"
          data-track-page-type="landing"
          data-track-offer="ai_feedback"
          data-track-test="ielts"
          data-track-skill="writing"
          data-track-position="hero"
        >
          Try AI Writing Feedback
        </a>
      </section>

      <section class="landing-section">
        <h2>Want one-to-one writing coaching?</h2>
        <a
          class="btn btn-primary"
          href="/tutoring"
          data-track-click="thank-you-ielts-guide-secondary-tutoring"
          data-track-page-type="landing"
          data-track-offer="tutoring"
          data-track-test="ielts"
          data-track-skill="writing"
          data-track-position="mid"
          data-track-intent="purchase"
        >
          Book a Private Class
        </a>
      </section>
    </div>
  </section>
</Layout>
