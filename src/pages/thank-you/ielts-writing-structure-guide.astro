---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Subscription Confirmed | IELTS Writing"
  description="Your IELTS writing subscription has been received."
  noindex={true}
>
  <section class="section">
    <div class="landing-shell">
      <section class="landing-hero">
        <p class="landing-eyebrow">Subscription Confirmed</p>
        <h1>You are subscribed to IELTS writing emails</h1>
        <p class="landing-subheadline">
          Watch your inbox for weekly IELTS writing tips and new lesson updates.
        </p>
      </section>

      <section class="landing-section">
        <h2>Next step for Band 7+ writing progress</h2>
        <a
          class="btn btn-primary"
          href="/essay-correction?src=thank-you-ielts-guide-next-step"
          data-track-click="thank-you-ielts-guide-next-step-essay"
          data-track-page-type="landing"
          data-track-offer="essay_correction"
          data-track-test="ielts"
          data-track-skill="writing"
          data-track-position="hero"
        >
          Submit One Essay for Score-Focused Feedback
        </a>
      </section>

      <section class="landing-section">
        <h2>Want live coaching this week?</h2>
        <a
          class="btn btn-primary"
          href="/webinar?src=thank-you-ielts-guide-secondary"
          data-track-click="thank-you-ielts-guide-secondary-webinar"
          data-track-page-type="landing"
          data-track-offer="weekly_training"
          data-track-test="ielts"
          data-track-skill="writing"
          data-track-position="mid"
          data-track-intent="purchase"
        >
          Join Weekly Live Training ($12)
        </a>
      </section>
    </div>
  </section>
</Layout>
