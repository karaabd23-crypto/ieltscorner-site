---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Subscription Confirmed | CELPIP Reading"
  description="Your CELPIP reading subscription has been received."
  noindex={true}
>
  <section class="section">
    <div class="landing-shell">
      <section class="landing-hero">
        <p class="landing-eyebrow">Subscription Confirmed</p>
        <h1>You are subscribed to CELPIP reading emails</h1>
        <p class="landing-subheadline">
          Watch your inbox for weekly reading strategies and new lesson updates.
        </p>
      </section>

      <section class="landing-section">
        <h2>Next step to move from CLB 6 to CLB 8</h2>
        <a
          class="btn btn-primary"
          href="/tutoring"
          data-track-click="thank-you-reading-next-step-tutoring"
          data-track-page-type="landing"
          data-track-offer="tutoring"
          data-track-test="celpip"
          data-track-skill="reading"
          data-track-position="hero"
          data-track-intent="purchase"
        >
          Book a Reading Session
        </a>
      </section>

      <section class="landing-section">
        <h2>Need private help for your reading problem?</h2>
        <a
          class="btn btn-primary"
          href="/tutoring?src=thank-you-reading-checklist-secondary"
          data-track-click="thank-you-reading-secondary-tutoring"
          data-track-page-type="landing"
          data-track-offer="tutoring"
          data-track-test="celpip"
          data-track-skill="reading"
          data-track-position="mid"
          data-track-intent="booking"
        >
          Book Reading-Focused 1:1 Support ($30)
        </a>
      </section>
    </div>
  </section>
</Layout>
