---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Checklist Sent | CELPIP Reading"
  description="Your CELPIP Reading CLB 6 to 8 checklist request has been received."
  noindex={true}
>
  <section class="section">
    <div class="landing-shell">
      <section class="landing-hero">
        <p class="landing-eyebrow">Checklist Sent</p>
        <h1>CELPIP Reading CLB 6 to 8 Checklist Requested</h1>
        <p class="landing-subheadline">
          Check your email for the checklist. Use the next step below while it arrives.
        </p>
      </section>

      <section class="landing-section">
        <h2>Next step to move from CLB 6 to CLB 8</h2>
        <a
          class="btn btn-primary"
          href="/webinar?src=thank-you-reading-checklist-next-step"
          data-track-click="thank-you-reading-next-step-webinar"
          data-track-page-type="landing"
          data-track-offer="weekly_training"
          data-track-test="celpip"
          data-track-skill="reading"
          data-track-position="hero"
          data-track-intent="purchase"
        >
          Join Reading Rescue Live Training ($12)
        </a>
      </section>

      <section class="landing-section">
        <h2>Need private help for your reading problem?</h2>
        <a
          class="btn btn-primary"
          href="/tutoring?src=thank-you-reading-checklist-secondary"
          data-track-click="thank-you-reading-secondary-tutoring"
          data-track-page-type="landing"
          data-track-offer="tutoring"
          data-track-test="celpip"
          data-track-skill="reading"
          data-track-position="mid"
          data-track-intent="booking"
        >
          Book Reading-Focused 1:1 Support ($30)
        </a>
      </section>
    </div>
  </section>
</Layout>
