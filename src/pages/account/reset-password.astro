---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Set New Password"
  description="Set a new password for your IELTS Corner account after a password recovery email."
>
  <section class="section-sm account-auth-page">
    <div class="account-auth-card surface">
      <p class="account-auth-card__eyebrow">Account</p>
      <h1>Choose a new password</h1>
      <p class="muted">
        Open this page after you click the recovery link in your email. If you arrived here directly, request a fresh reset email first.
      </p>

      <p id="account-reset-status" hidden></p>

      <form id="account-reset-form" class="account-auth-form">
        <label>
          <span>New password</span>
          <input type="password" name="password" autocomplete="new-password" required />
        </label>
        <button class="btn btn-primary" type="submit">Save new password</button>
      </form>

      <div class="account-auth-actions">
        <a class="btn" href="/account/forgot-password">Need a new reset email?</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { AuthError, getUser, updateUser } from '@netlify/identity';

  (() => {
    const form = document.getElementById('account-reset-form');
    const statusEl = document.getElementById('account-reset-status');

    const showStatus = (message = '', tone = 'info') => {
      if (!(statusEl instanceof HTMLElement)) return;
      statusEl.hidden = !message;
      statusEl.textContent = message;
      statusEl.dataset.tone = tone;
    };

    getUser().then((user) => {
      if (!user) {
        showStatus('Open the password recovery link from your email first, then come back here.', 'error');
      }
    }).catch(() => {
      showStatus('Open the password recovery link from your email first, then come back here.', 'error');
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const password = String(new FormData(form).get('password') || '');

      try {
        await updateUser({ password });
        showStatus('Password updated. Redirecting you to your account...', 'success');
        window.setTimeout(() => {
          window.location.href = '/account';
        }, 700);
      } catch (error) {
        if (error instanceof AuthError) {
          showStatus(error.message, 'error');
          return;
        }
        showStatus(error instanceof Error ? error.message : 'Unable to update your password.', 'error');
      }
    });
  })();
</script>

<style>
  .account-auth-page {
    display: grid;
    place-items: center;
  }

  .account-auth-card {
    width: min(560px, 100%);
    padding: var(--s-5);
    border-radius: 24px;
  }

  .account-auth-card__eyebrow {
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8f3434;
  }

  .account-auth-card h1 {
    margin: 0 0 8px;
  }

  .account-auth-form {
    display: grid;
    gap: 16px;
  }

  .account-auth-form label {
    display: grid;
    gap: 8px;
    font-weight: 600;
  }

  .account-auth-form input {
    min-height: 48px;
    border-radius: 12px;
    border: 1px solid rgba(20, 22, 23, 0.14);
    padding: 0 14px;
    font: inherit;
  }

  .account-auth-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--s-4);
  }

  #account-reset-status {
    margin: 0 0 var(--s-3);
    padding: 12px 14px;
    border-radius: 12px;
    font-weight: 600;
  }

  #account-reset-status[data-tone="success"] {
    background: rgba(33, 138, 77, 0.08);
    color: #246c41;
  }

  #account-reset-status[data-tone="error"] {
    background: rgba(217, 72, 72, 0.08);
    color: #8f3434;
  }
</style>
