---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Forgot Password"
  description="Request an IELTS Corner password reset email for your account."
>
  <section class="section-sm account-auth-page">
    <div class="account-auth-card surface">
      <p class="account-auth-card__eyebrow">Account</p>
      <h1>Reset your password</h1>
      <p class="muted">
        Enter your main login email. We will send you a password reset link through Netlify Identity.
      </p>

      <p id="account-recovery-status" hidden></p>

      <form id="account-recovery-form" class="account-auth-form">
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <button class="btn btn-primary" type="submit">Send reset link</button>
      </form>

      <div class="account-auth-actions">
        <a class="btn" href="/account/sign-in">Back to sign in</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { AuthError, requestPasswordRecovery } from '@netlify/identity';

  (() => {
    const form = document.getElementById('account-recovery-form');
    const statusEl = document.getElementById('account-recovery-status');

    const showStatus = (message = '', tone = 'info') => {
      if (!(statusEl instanceof HTMLElement)) return;
      statusEl.hidden = !message;
      statusEl.textContent = message;
      statusEl.dataset.tone = tone;
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const email = String(new FormData(form).get('email') || '').trim();

      try {
        await requestPasswordRecovery(email);
        showStatus('Password reset email sent. Open the link in that email to choose a new password.', 'success');
      } catch (error) {
        if (error instanceof AuthError) {
          showStatus(error.message, 'error');
          return;
        }
        showStatus(error instanceof Error ? error.message : 'Unable to send the reset email.', 'error');
      }
    });
  })();
</script>

<style>
  .account-auth-page {
    display: grid;
    place-items: center;
  }

  .account-auth-card {
    width: min(560px, 100%);
    padding: var(--s-5);
    border-radius: 24px;
  }

  .account-auth-card__eyebrow {
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8f3434;
  }

  .account-auth-card h1 {
    margin: 0 0 8px;
  }

  .account-auth-form {
    display: grid;
    gap: 16px;
  }

  .account-auth-form label {
    display: grid;
    gap: 8px;
    font-weight: 600;
  }

  .account-auth-form input {
    min-height: 48px;
    border-radius: 12px;
    border: 1px solid rgba(20, 22, 23, 0.14);
    padding: 0 14px;
    font: inherit;
  }

  .account-auth-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--s-4);
  }

  #account-recovery-status {
    margin: 0 0 var(--s-3);
    padding: 12px 14px;
    border-radius: 12px;
    font-weight: 600;
  }

  #account-recovery-status[data-tone="success"] {
    background: rgba(33, 138, 77, 0.08);
    color: #246c41;
  }

  #account-recovery-status[data-tone="error"] {
    background: rgba(217, 72, 72, 0.08);
    color: #8f3434;
  }
</style>
