---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Sign In"
  description="Sign in to your IELTS Corner account to restore CELPIP Reading access and progress."
>
  <section class="section-sm account-auth-page">
    <div class="account-auth-card surface">
      <p class="account-auth-card__eyebrow">Account</p>
      <h1>Sign in</h1>
      <p class="muted">
        Use your main account email and password, or continue with Google.
      </p>

      <p id="account-auth-status" hidden></p>

      <form id="account-login-form" class="account-auth-form">
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          <span>Password</span>
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <button class="btn btn-primary" type="submit">Sign in</button>
      </form>

      <div class="account-auth-actions">
        <button class="btn" id="account-google-login" type="button">Continue with Google</button>
        <a class="btn" href="/account/forgot-password">Forgot password</a>
        <a class="btn" href="/account/sign-up">Create account</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { AuthError, getUser, login, oauthLogin } from '@netlify/identity';

  (() => {
    const form = document.getElementById('account-login-form');
    const googleButton = document.getElementById('account-google-login');
    const statusEl = document.getElementById('account-auth-status');

    const showStatus = (message = '', tone = 'info') => {
      if (!(statusEl instanceof HTMLElement)) return;
      statusEl.hidden = !message;
      statusEl.textContent = message;
      statusEl.dataset.tone = tone;
    };

    try {
      const raw = sessionStorage.getItem('ieltscorner.accountFlash');
      if (raw) {
        sessionStorage.removeItem('ieltscorner.accountFlash');
        const parsed = JSON.parse(raw);
        showStatus(String(parsed?.message || ''), String(parsed?.tone || 'info'));
      }
    } catch {
    }

    getUser().then((user) => {
      if (user) {
        window.location.href = '/account';
      }
    }).catch(() => {
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const formData = new FormData(form);
      const email = String(formData.get('email') || '').trim();
      const password = String(formData.get('password') || '');

      try {
        showStatus('Signing you in...', 'info');
        await login(email, password);
        window.location.href = '/account';
      } catch (error) {
        if (error instanceof AuthError) {
          showStatus(error.status === 401 ? 'Invalid email or password.' : error.message, 'error');
          return;
        }
        showStatus(error instanceof Error ? error.message : 'Unable to sign in.', 'error');
      }
    });

    googleButton?.addEventListener('click', () => {
      try {
        oauthLogin('google');
      } catch (error) {
        showStatus(error instanceof Error ? error.message : 'Google sign-in is unavailable right now.', 'error');
      }
    });
  })();
</script>

<style>
  .account-auth-page {
    display: grid;
    place-items: center;
  }

  .account-auth-card {
    width: min(560px, 100%);
    padding: var(--s-5);
    border-radius: 24px;
  }

  .account-auth-card__eyebrow {
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8f3434;
  }

  .account-auth-card h1 {
    margin: 0 0 8px;
  }

  #account-auth-status {
    margin: 0 0 var(--s-3);
    padding: 12px 14px;
    border-radius: 12px;
    font-weight: 600;
  }

  #account-auth-status[data-tone="info"] {
    background: rgba(56, 116, 203, 0.08);
    color: #27548a;
  }

  #account-auth-status[data-tone="error"] {
    background: rgba(217, 72, 72, 0.08);
    color: #8f3434;
  }

  #account-auth-status[data-tone="success"] {
    background: rgba(33, 138, 77, 0.08);
    color: #246c41;
  }

  .account-auth-form {
    display: grid;
    gap: 16px;
  }

  .account-auth-form label {
    display: grid;
    gap: 8px;
    font-weight: 600;
  }

  .account-auth-form input {
    min-height: 48px;
    border-radius: 12px;
    border: 1px solid rgba(20, 22, 23, 0.14);
    padding: 0 14px;
    font: inherit;
  }

  .account-auth-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--s-4);
  }
</style>
