---
import Layout from "../../layouts/Layout.astro";
import { buildBreadcrumbSchema } from "../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog/" },
  ]),
];

const pageKeywords =
  "IELTS blog, CELPIP blog, IELTS writing tips, IELTS speaking tips, CELPIP writing tips, CELPIP speaking tips, IELTS strategy articles, CELPIP strategy articles";

const featuredArticle = {
  title: "CELPIP Scores for Canadian Immigration (2026)",
  description: "Exact CLB requirements for Express Entry, CRS points by CLB level, and the fastest strategies to move from CLB 7 to CLB 9.",
  href: "/blog/celpip-scores-canadian-immigration",
  meta: "Immigration | 16 min read",
  note: "Start here if your goal is Canadian PR or citizenship — this is the most important page on the site for immigration candidates.",
};

const recentArticles = [
