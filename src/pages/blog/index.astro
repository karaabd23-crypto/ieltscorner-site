      { label: "Advantages and disadvantages essay", href: "/blog/ielts-writing-task-2-advantages-disadvantages" },
      { label: "Speaking Part 1 topics guide", href: "/blog/ielts-speaking-part-1-topics" },
      { label: "Speaking Part 2 cue card guide", href: "/blog/ielts-speaking-part-2-cue-card" },
      { label: "Speaking Part 3 guide", href: "/blog/ielts-speaking-part-3-questions-guide" },
      { label: "Reading question types", href: "/blog/ielts-reading-question-types" },
      { label: "Listening question types", href: "/blog/ielts-listening-question-types" },
      { label: "Listening common traps", href: "/blog/ielts-listening-common-traps" },
    ],
  },
  {
    title: "PTE Core articles",
    links: [
      { label: "PTE Core for Canadian immigration (2026)", href: "/blog/pte-core-canadian-immigration" },
      { label: "PTE Core complete question types guide", href: "/blog/pte-core-question-types" },
      { label: "PTE Core speaking guide", href: "/blog/pte-core-speaking-guide" },
      { label: "PTE Core writing guide", href: "/blog/pte-core-writing-guide" },
      { label: "PTE Core reading guide", href: "/blog/pte-core-reading-guide" },
      { label: "PTE Core listening guide", href: "/blog/pte-core-listening-guide" },
