      { label: "Reading strategies guide (CLB 9)", href: "/blog/celpip-reading-strategies" },
      { label: "Listening complete guide (all 6 parts)", href: "/blog/celpip-listening-strategies" },
      { label: "Reading question types", href: "/blog/celpip-reading-question-types" },
      { label: "Listening question types", href: "/blog/celpip-listening-question-types" },
      { label: "Sample answers guide", href: "/blog/celpip-sample-answers" },
    ],
  },
  {
    title: "IELTS articles",
    links: [
      { label: "Writing Task 2 complete guide", href: "/blog/ielts-writing-task-2-complete-guide" },
      { label: "Listening complete guide (all 4 sections)", href: "/blog/ielts-listening-strategies" },
