      { label: "CELPIP in Calgary", href: "/celpip/calgary/" },
      { label: "CELPIP in Ottawa", href: "/celpip/ottawa/" },
      { label: "CELPIP in Edmonton", href: "/celpip/edmonton/" },
      { label: "CELPIP in Winnipeg", href: "/celpip/winnipeg/" },
    ],
  },
  {
    title: "By city: IELTS preparation",
    links: [
      { label: "IELTS in Toronto", href: "/ielts/toronto/" },
      { label: "IELTS in Vancouver", href: "/ielts/vancouver/" },
      { label: "IELTS in Calgary", href: "/ielts/calgary/" },
      { label: "IELTS in Ottawa", href: "/ielts/ottawa/" },
      { label: "IELTS in Edmonton", href: "/ielts/edmonton/" },
