      </article>

      <article class="card">
        <div style="display: inline-block; background: var(--accent-light); color: var(--accent); padding: var(--s-1) var(--s-2); border-radius: 4px; font-size: 0.85rem; font-weight: 700; margin-bottom: var(--s-2);">
