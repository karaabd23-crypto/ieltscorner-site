  },
  {
    title: "I need help with speaking",
    text: "Start with the task that feels weak, then compare your answers to the speaking guides.",
    href: "/celpip/speaking",
    label: "Open speaking hub",
  },
  {
    title: "I feel lost and need a clearer route",
    text: "Use the free lessons first if you want the building blocks before test strategy.",
    href: "/lessons",
    label: "Open lessons",
  },
];

