      { label: "PTE Core vs CELPIP comparison", href: "/blog/pte-core-vs-celpip" },
      { label: "PTE Core study plan", href: "/blog/pte-core-study-plan" },
      { label: "PTE Core exam day tips", href: "/blog/pte-core-exam-day-tips" },
    ],
  },
  {
    title: "By city: CELPIP preparation",
    links: [
      { label: "CELPIP in Toronto", href: "/celpip/toronto/" },
