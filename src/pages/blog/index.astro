  {
    title: "CELPIP articles",
    links: [
      { label: "CELPIP scores for Canadian immigration", href: "/blog/celpip-scores-canadian-immigration" },
      { label: "Express Entry CRS language strategy", href: "/blog/express-entry-clb-crs-strategy" },
      { label: "CLB levels explained: what every level means", href: "/blog/clb-levels-explained" },
