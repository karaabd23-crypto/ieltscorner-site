---
import Layout from "../../layouts/Layout.astro";
import { buildBreadcrumbSchema } from "../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog/" },
  ]),
];

const pageKeywords = "IELTS blog, CELPIP blog, IELTS writing tips, IELTS speaking tips, CELPIP writing tips, CELPIP speaking tips, IELTS strategy articles, CELPIP strategy articles";
---

<Layout
  title="IELTS and CELPIP Blog | Strategy Guides and Exam Tips"
  description="IELTS and CELPIP strategy guides, exam tips, and high-intent articles for writing, speaking, reading, and listening improvement."
  type="page"
  keywords={pageKeywords}
  structuredData={pageStructuredData}
>
  <section class="section" style="padding-top: var(--s-6);">
    <div class="hero" style={`--hero-bg: url('/heroes/blog.png');`}>
      <div class="hero-content">
        <h1>IELTS & CELPIP strategy blog</h1>
        <p>Task-level guides, score-improvement articles, and practical exam strategy for the queries students actually search.</p>
      </div>
    </div>

    <div style="height: var(--s-6);"></div>

    <!-- FEATURED POST -->
    <div class="surface feature" style="padding: var(--s-5); margin-bottom: var(--s-6);">
      <div class="grid grid-2" style="align-items: center; gap: var(--s-4);">
        <div>
          <div style="display: inline-block; background: var(--accent); color: white; padding: var(--s-1) var(--s-2); border-radius: 4px; font-size: 0.85rem; font-weight: 700; margin-bottom: var(--s-2);">
            FEATURED
          </div>
          <h2 style="margin-top: 0;">IELTS Writing Task 2 Structure: The Format That Keeps Scores Stable</h2>
          <p style="color: var(--text-muted);">A direct guide to IELTS Writing Task 2 structure, paragraph flow, and the mistakes that drag essays down.</p>
          <div style="display: flex; gap: var(--s-3); color: var(--text-muted); font-size: 0.9rem; margin-bottom: var(--s-2);">
            <span>📅 March 14, 2026</span>
            <span>⏱️ 7 min read</span>
          </div>
          <a href="/blog/ielts-writing-task-2-structure" class="btn btn-primary">Read article →</a>
        </div>
        <div style="background: var(--accent-light); padding: var(--s-3); border-radius: 8px; text-align: center;">
          <div style="font-size: 3rem;">📝</div>
        </div>
      </div>
    </div>

    <!-- BLOG POSTS GRID -->
    <h2>Recent articles</h2>
    <div class="grid grid-3" style="gap: var(--s-3); margin-bottom: var(--s-6);">
      <!-- POST 1 -->
      <article class="card">
        <div style="display: inline-block; background: var(--accent-light); color: var(--accent); padding: var(--s-1) var(--s-2); border-radius: 4px; font-size: 0.85rem; font-weight: 700; margin-bottom: var(--s-2);">
          Strategy
        </div>
        <h3 style="margin-top: 0;">How to Get Band 7 in IELTS Writing</h3>
        <p style="color: var(--text-muted); flex: 1;">The exact structure and timing strategy that helps most students jump from Band 6 to Band 7.</p>
        <div style="display: flex; gap: var(--s-2); color: var(--text-muted); font-size: 0.9rem; margin-bottom: var(--s-2);">
          <span>📅 Feb 28, 2026</span>
          <span>⏱️ 6 min</span>
        </div>
        <a href="/blog/band-7-writing-strategy" class="btn btn-ghost">Read →</a>
      </article>

      <article class="card">
        <div style="display: inline-block; background: var(--accent-light); color: var(--accent); padding: var(--s-1) var(--s-2); border-radius: 4px; font-size: 0.85rem; font-weight: 700; margin-bottom: var(--s-2);">
          Writing
        </div>
        <h3 style="margin-top: 0;">IELTS Writing Task 2 Structure</h3>
        <p style="color: var(--text-muted); flex: 1;">A high-intent page for students who specifically need essay structure, paragraph logic, and timing discipline.</p>
        <div style="display: flex; gap: var(--s-2); color: var(--text-muted); font-size: 0.9rem; margin-bottom: var(--s-2);">
          <span>📅 Mar 14, 2026</span>
          <span>⏱️ 7 min</span>
        </div>
        <a href="/blog/ielts-writing-task-2-structure" class="btn btn-ghost">Read →</a>
      </article>

      <!-- POST 2 -->
      <article class="card">
        <div style="display: inline-block; background: var(--accent-light); color: var(--accent); padding: var(--s-1) var(--s-2); border-radius: 4px; font-size: 0.85rem; font-weight: 700; margin-bottom: var(--s-2);">
          Vocabulary
        </div>
        <h3 style="margin-top: 0;">150 Collocations for IELTS Writing</h3>
        <p style="color: var(--text-muted); flex: 1;">The exact collocations that IELTS examiners want to see. Practice these every day.</p>
        <div style="display: flex; gap: var(--s-2); color: var(--text-muted); font-size: 0.9rem; margin-bottom: var(--s-2);">
