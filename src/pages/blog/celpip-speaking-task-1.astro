---
import Layout from "../../layouts/Layout.astro";
import { buildBreadcrumbSchema, buildFAQSchema } from "../../lib/seo";

const pageFaqs = [
  {
    question: "What is CELPIP Speaking Task 1 testing?",
    answer:
      "Task 1 is testing whether you can give clear, helpful advice in a practical everyday situation.",
  },
  {
    question: "How should I structure CELPIP Speaking Task 1?",
    answer:
      "A safe structure is: show you understand the problem, give your advice, explain why it will help, and close supportively.",
  },
  {
    question: "What usually lowers Task 1 scores?",
    answer:
      "Scores often drop when the answer is too vague, too short, or full of advice that does not really fit the situation.",
  },
];

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog/" },
    { name: "CELPIP Speaking Task 1", path: "/blog/celpip-speaking-task-1/" },
  ]),
  buildFAQSchema(pageFaqs),
];
---

<Layout
  title="CELPIP Speaking Task 1 | Give Advice Clearly and Sound Helpful"
  description="A CELPIP Speaking Task 1 guide with simple advice structure, useful language, and clear ways to sound practical and supportive."
  type="article"
  keywords="CELPIP Speaking Task 1, CELPIP giving advice, CELPIP speaking tips"
  structuredData={pageStructuredData}
>
  <article class="section guide-article">
    <a class="guide-back-link" href="/blog">Back to blog</a>

    <header class="guide-header">
      <span class="guide-tag">CELPIP speaking guide</span>
      <h1 style="margin: 0;">CELPIP Speaking Task 1</h1>
      <div class="guide-meta">
        <span>March 17, 2026</span>
        <span>6 min read</span>
      </div>
    </header>

    <div class="guide-lead">
      <p>
        CELPIP Speaking Task 1 is about giving advice, not giving a perfect speech. You need
        to understand the situation, respond like a helpful real person, and explain why
        your advice makes sense.
      </p>
      <p>
        The strongest answers sound practical and human. They do not sound like memorized
        lectures.
      </p>
    </div>

    <div class="guide-grid guide-grid-2">
      <section class="guide-card">
        <h2>What strong answers do</h2>
        <ul class="guide-list">
          <li>Show that you understand the person's problem.</li>
          <li>Give one or two clear pieces of advice.</li>
          <li>Explain why the advice will help.</li>
          <li>Keep the tone supportive and natural.</li>
        </ul>
      </section>

      <section class="guide-card">
        <h2>What weak answers do</h2>
        <ul class="guide-list">
          <li>Stay too general: "Just try your best."</li>
          <li>List advice without reasons.</li>
          <li>Use a tone that sounds cold or bossy.</li>
          <li>Repeat the same point in different words.</li>
        </ul>
      </section>
    </div>

    <section class="guide-card" style="margin-top: var(--s-4);">
      <h2>A simple Task 1 structure</h2>
      <div class="guide-steps">
        <div class="guide-step">
          <span class="guide-step__number">1</span>
          <div>
            <h3>Acknowledge the situation</h3>
            <p>Start by showing that you understand the problem or concern.</p>
          </div>
        </div>
        <div class="guide-step">
          <span class="guide-step__number">2</span>
          <div>
            <h3>Give your advice</h3>
            <p>State one clear recommendation before you add more detail.</p>
          </div>
        </div>
        <div class="guide-step">
          <span class="guide-step__number">3</span>
          <div>
            <h3>Explain why</h3>
            <p>Give one practical reason or short example to support the advice.</p>
          </div>
        </div>
        <div class="guide-step">
          <span class="guide-step__number">4</span>
          <div>
            <h3>Close supportively</h3>
            <p>Finish with a calm sentence that sounds encouraging.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="guide-card" style="margin-top: var(--s-4);">
      <h2>Useful language for Task 1</h2>
      <div class="guide-example">
        <p><strong>Showing understanding:</strong> I can understand why this is frustrating.</p>
        <p><strong>Giving advice:</strong> If I were you, I would start by...</p>
        <p><strong>Explaining:</strong> This would help because...</p>
        <p><strong>Closing:</strong> I think this would make the situation much easier.</p>
      </div>
    </section>

    <section class="guide-card" style="margin-top: var(--s-4);">
      <h2>What often sounds weak</h2>
      <table class="guide-mistake-table">
        <tr>
          <th>Weak move</th>
          <th>Better move</th>
        </tr>
        <tr>
          <td>The answer jumps straight into random advice.</td>
          <td>Show first that you understand the problem.</td>
        </tr>
        <tr>
          <td>The advice is too general.</td>
          <td>Give one specific action the person can take.</td>
        </tr>
        <tr>
          <td>No reason is given.</td>
          <td>Explain briefly why the advice should work.</td>
        </tr>
        <tr>
          <td>The tone sounds harsh.</td>
          <td>Use a polite, supportive voice.</td>
        </tr>
      </table>
    </section>

    <section class="guide-card" style="margin-top: var(--s-4);">
      <h2>Next step</h2>
      <div class="guide-links">
        <a href="/blog/celpip-speaking-part2">
          <strong>Read the Task 2 guide</strong>
          <span>Move from giving advice to telling a clear personal story.</span>
        </a>
        <a href="/blog/celpip-speaking-task-5-comparing-options">
          <strong>Read the Task 5 guide</strong>
          <span>See how speaking changes when you must compare and recommend.</span>
        </a>
        <a href="/celpip/speaking">
          <strong>Go to the CELPIP speaking hub</strong>
          <span>Open more speaking guides and related lesson links.</span>
        </a>
      </div>
    </section>

    <section class="guide-card" style="margin-top: var(--s-4);">
      <h2>FAQ</h2>
      <div class="guide-faq">
        {pageFaqs.map((item) => (
          <details class="card">
            <summary>{item.question}</summary>
            <p class="muted" style="margin-top: var(--s-2); margin-bottom: 0;">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </article>
</Layout>
