---
import Layout from "../../layouts/Layout.astro";
import ServiceTrustCard from "../../components/ServiceTrustCard.astro";
import {
  ESSAY_CORRECTION_CHECKOUT_IS_CONFIGURED,
  getEssayCorrectionCheckoutLinkProps,
} from "../../lib/offers";

const checkoutLink = getEssayCorrectionCheckoutLinkProps();

const pageFaqs = [
  {
    question: "How many essays does this include?",
    answer:
      "This purchase includes one complete essay correction.",
  },
  {
    question: "What type of feedback do I receive?",
    answer:
      "You receive score-focused comments on grammar, structure, clarity, and task response.",
  },
  {
    question: "How do I submit my essay after payment?",
    answer:
      "After checkout, Stripe sends you to the submission page where you paste your essay.",
  },
];
---

<Layout
  title="Essay Correction | IELTS and CELPIP Writing Feedback"
  description="Submit one IELTS or CELPIP essay and get detailed score-focused feedback."
  keywords="IELTS essay correction, CELPIP essay correction, writing feedback"
>
  <section class="section" id="start-checkout">
    <div class="landing-shell">
      <section class="landing-hero">
        <p class="landing-eyebrow">Essay Feedback Service</p>
        <h1>Submit One Essay and Get Score-Focused Feedback</h1>
        <p class="landing-subheadline">
          One correction with clear comments on grammar, structure, and the exact changes needed to improve your IELTS or CELPIP writing score.
        </p>
        <div class="landing-hero__actions">
          <a
            class="btn btn-primary landing-cta"
            href={checkoutLink.href}
            data-track-click="essay-correction-primary-cta"
            data-track-page-type="service"
            data-track-offer="essay_correction"
            data-track-test="ielts_celpip"
            data-track-skill="writing"
            data-track-position="hero"
            data-track-intent="checkout"
            data-track-intent-event="checkout_click"
          >
            Submit an Essay for Correction
          </a>
        </div>
      </section>

      {!ESSAY_CORRECTION_CHECKOUT_IS_CONFIGURED && (
        <section id="payment-link-pending" class="landing-section">
          <h2>Checkout is temporarily unavailable</h2>
          <p class="muted" style="margin-bottom: 0;">
            The payment link is being updated. Please check back shortly or contact us and we will send you the active checkout link.
          </p>
          <div class="landing-hero__actions" style="margin-top: var(--s-3);">
            <a class="btn" href="/contact">Contact Support</a>
          </div>
        </section>
      )}

      <section class="landing-section">
        <h2>What You Get</h2>
        <div class="landing-offer-grid">
          <article class="landing-offer">
            <h3>1 Essay Correction</h3>
            <p>One complete review of one IELTS or CELPIP essay.</p>
          </article>
          <article class="landing-offer">
            <h3>Detailed Notes</h3>
            <p>Clear corrections on grammar, structure, and task coverage.</p>
          </article>
          <article class="landing-offer">
            <h3>Score-Focused Actions</h3>
            <p>Concrete next steps to improve your next writing attempt.</p>
          </article>
        </div>
      </section>

      <section class="landing-section">
        <h2>How It Works</h2>
        <ol style="margin: var(--s-2) 0 0; padding-left: 1.2rem;">
          <li>Pay through checkout.</li>
          <li>Submit your essay on the next page.</li>
          <li>Receive your corrected essay and feedback by email.</li>
        </ol>
      </section>

      <section class="landing-section">
        <ServiceTrustCard
          heading="Know who is checking your writing"
          intro="Before you pay for essay correction, review the teaching and exam background behind this feedback service."
        />
      </section>

      <section class="landing-section landing-section--cta">
        <h2>Ready to submit your essay?</h2>
        <div class="landing-hero__actions">
          <a
            class="btn btn-primary landing-cta"
            href={checkoutLink.href}
            data-track-click="essay-correction-final-cta"
            data-track-page-type="service"
            data-track-offer="essay_correction"
            data-track-test="ielts_celpip"
            data-track-skill="writing"
            data-track-position="end"
            data-track-intent="checkout"
            data-track-intent-event="checkout_click"
          >
            Submit an Essay for Correction
          </a>
        </div>
      </section>

      <section class="landing-section">
        <h2>FAQ</h2>
        <div class="stack" style="gap: var(--s-2);">
          {pageFaqs.map((faq) => (
            <details class="card">
              <summary style="cursor: pointer; font-weight: 700;">{faq.question}</summary>
              <p class="muted" style="margin: var(--s-2) 0 0;">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </section>
</Layout>
