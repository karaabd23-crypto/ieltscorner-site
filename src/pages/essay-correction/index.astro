---
import Layout from "../../layouts/Layout.astro";

const title = "IELTS & CELPIP Essay Correction – Detailed Feedback & Band Estimates";
const description =
  "Get your IELTS or CELPIP writing checked with detailed feedback, band/level estimates, and concrete suggestions to improve.";
---

<Layout title={title} description={description}>
  <section class="section">
    <div class="section-heading">
      <h1>IELTS &amp; CELPIP Essay Correction</h1>
      <p>
        Send your writing, get precise feedback. Instead of guessing what the examiner
        wants, you receive clear comments, band/level estimates, and specific changes
        you can make in your next attempt.
      </p>
    </div>

    <div class="grid-2">
      <div>
        <h2>What you receive</h2>
        <ul>
          <li>• Band/level estimate (IELTS Band 0–9, CELPIP Level 0–12).</li>
          <li>• Comments on Task Response / Content.</li>
          <li>• Comments on flow &amp; linking.</li>
          <li>• Comments on Lexical Resource / Vocabulary.</li>
          <li>• Comments on Grammar &amp; sentence structure.</li>
          <li>• At least a few model sentences or rewrites.</li>
        </ul>

        <h3 class="mt-4">Suitable for</h3>
        <ul>
          <li>• IELTS Writing Task 1 and Task 2.</li>
          <li>• CELPIP Task 1 (email) and Task 2 (survey response).</li>
          <li>• Learners who want honest, detailed feedback instead of “Nice essay!”</li>
        </ul>
      </div>

      <div class="card card--compact">
        <h3 class="mb-4">Packages &amp; pricing</h3>
        <p class="text-muted">
          You can choose from a single-essay review or a bundle package for students who want
          weekly correction and progress tracking. If you are not sure which package is best,
          send one recent sample and I will recommend the right option based on your current level.
        </p>
        <ul>
          <li>• Single-essay review with detailed comments and rewrites.</li>
          <li>• Three-essay package for focused improvement over one to two weeks.</li>
          <li>• Five-essay package for full exam preparation with consistent feedback.</li>
        </ul>

        <div class="mt-4">
          <a href="/tutoring" class="btn btn-primary">
            Contact to choose a package
          </a>
        </div>
      </div>
    </div>

    <section class="section section--tight">
      <div class="card card--compact" style="border: 2px solid var(--accent);">
        <h2 style="margin-top: 0;">Need instant CELPIP writing feedback instead?</h2>
        <p>
          If you want a faster, lower-cost option before ordering human correction, try the paid
          <strong> CELPIP Writing Score &amp; Analysis</strong>. It includes timed Task 1 and Task 2 practice,
          prompt generation, AI scoring, and targeted revision advice.
        </p>
        <a href="/celpip/writing/ai-feedback" class="btn btn-primary">Get AI score & analysis →</a>
      </div>
    </section>

    <section id="submit" class="section section--tight">
      <div class="card card--compact">
        <h2>How to submit your essays</h2>
        <p>
          After you choose your package, send your essay in a Word file or paste it directly in
          your message. Include the exact task question and your target score so the feedback is
          matched to your exam goal.
        </p>
        <ul>
          <li>• Step 1 – Choose a package and confirm your preferred feedback timeline.</li>
          <li>• Step 2 – Send your essay with the task prompt and target band/CLB level.</li>
          <li>• Step 3 – Receive annotated feedback, score estimate, and rewrite suggestions.</li>
        </ul>
      </div>
    </section>
  </section>
</Layout>
