---
import Layout from "../../layouts/Layout.astro";

const title = "IELTS and CELPIP Essay Correction | Detailed Feedback and Band Estimates";
const description =
  "Get your IELTS or CELPIP writing checked with detailed feedback, band or level estimates, and concrete suggestions to improve.";
---

<Layout title={title} description={description}>
  <section class="section">
    <div class="section-heading">
      <h1>IELTS and CELPIP Essay Correction</h1>
      <p>
        Send your writing and get precise feedback. Instead of guessing what the examiner wants,
        you receive clear comments, band or level estimates, and specific changes you can make in your next attempt.
      </p>
      <p class="muted">
        You can also read more about Kara Abdolmaleki and the teaching background on the
        <a href="/about">About page</a>.
      </p>
    </div>

    <div class="grid-2">
      <div>
        <h2>What you receive</h2>
        <ul>
          <li>Band or level estimate for IELTS or CELPIP.</li>
          <li>Comments on task response and content.</li>
          <li>Comments on flow, linking, and organization.</li>
          <li>Comments on vocabulary choice and range.</li>
          <li>Comments on grammar and sentence structure.</li>
          <li>A few model rewrites or better sentence options.</li>
        </ul>

        <h3 class="mt-4">Suitable for</h3>
        <ul>
          <li>IELTS Writing Task 1 and Task 2.</li>
          <li>CELPIP Task 1 email and Task 2 survey response.</li>
          <li>Students who want honest, detailed feedback instead of vague praise.</li>
        </ul>
      </div>

      <div class="card card--compact">
        <h3 class="mb-4">Packages and pricing</h3>
        <p class="text-muted">
          You can choose a single-essay review or a bundle for students who want steady correction and progress tracking.
          If you are not sure which package is best, send one recent sample and I will recommend the right option based on your current level.
        </p>
        <ul>
          <li>Single-essay review with detailed comments and rewrites.</li>
          <li>Three-essay package for focused improvement over one to two weeks.</li>
          <li>Five-essay package for longer exam preparation with consistent feedback.</li>
        </ul>

        <div class="mt-4">
          <a href="/tutoring" class="btn btn-primary">
            Contact to choose a package
          </a>
        </div>
      </div>
    </div>

    <section class="section section--tight">
      <div class="card card--compact" style="border: 1px solid rgba(23, 54, 86, 0.12); background: linear-gradient(145deg, #fffaf2 0%, #f8fbff 100%); margin-bottom: var(--s-4);">
        <h2 style="margin-top: 0;">About the feedback</h2>
        <p>
          If you want to see the teaching background behind this service, the About page includes
          Kara Abdolmaleki's exam results, qualifications, and classroom background.
        </p>
        <div class="cluster">
          <a href="/about" class="btn btn-primary">About Kara</a>
          <a href="/about#evidence-and-qualifications" class="btn">See background</a>
        </div>
      </div>

      <div class="card card--compact" style="border: 2px solid var(--accent);">
        <h2 style="margin-top: 0;">Need instant CELPIP writing feedback instead?</h2>
        <p>
          If you want a faster, lower-cost option before ordering human correction, try the paid
          <strong> CELPIP Writing Score and Analysis</strong>. It includes timed Task 1 and Task 2 practice,
          prompt generation, score analysis, and targeted revision advice.
        </p>
        <a href="/celpip/writing/ai-feedback" class="btn btn-primary">Open writing lab</a>
      </div>
    </section>

    <section id="submit" class="section section--tight">
      <div class="card card--compact">
        <h2>How to submit your essays</h2>
        <p>
          After you choose your package, send your essay in a Word file or paste it directly in
          your message. Include the exact task question and your target score so the feedback is
          matched to your exam goal.
        </p>
        <ul>
          <li>Step 1: Choose a package and confirm your preferred feedback timeline.</li>
          <li>Step 2: Send your essay with the task prompt and target band or CLB level.</li>
          <li>Step 3: Receive annotated feedback, score estimate, and rewrite suggestions.</li>
        </ul>
      </div>
    </section>
  </section>
</Layout>
