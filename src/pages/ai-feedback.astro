---
import Layout from "../layouts/Layout.astro";
import {
  CELPIP_PROMPT_TOTAL,
  CELPIP_WRITING_PRICE_CAD,
} from "../lib/celpipWritingData.mjs";

const promptTotal = CELPIP_PROMPT_TOTAL;
const YOUTUBE_EMBED_URL = "https://www.youtube.com/embed/k-2lGP720OU?si=rg7FiJfdNMHsj9Q3";

const faqs = [
  {
    question: "How much does this cost?",
    answer: `CA$${CELPIP_WRITING_PRICE_CAD} per month.`,
  },
  {
    question: "Is this a live tutoring class?",
    answer: "No. This is not a live class.",
  },
  {
    question: "What do I get after payment?",
    answer: `${promptTotal} timed prompts, CLB feedback, and CLB 9+ sample essays.`,
  },
  {
    question: "Can I cancel anytime?",
    answer: "Yes. You can cancel anytime.",
  },
];
---

<Layout
  title="CELPIP Writing AI Feedback | Pay and Start"
  description="Upload your CELPIP essay and get clear corrections in minutes."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/writing.png');`}>
      <div class="hero-content">
        <span class="pill">CELPIP writing feedback</span>
        <h1>Stuck at CLB 6? See your writing mistakes in minutes</h1>
        <p class="muted" style="max-width: 62ch;">
          Find exactly what is lowering your score and fix it.
        </p>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section funnel-video">
      <h2 style="margin-top: 0;">Watch what you get with the AI CELPIP essay correction</h2>
      <p class="muted funnel-video__intro">
        This video explains the price, how the service works, and what you receive after you submit your writing.
      </p>
      <ul class="offer-card__list" style="margin: var(--s-2) auto 0; max-width: 42rem; text-align: left;">
        <li>Get an estimated CLB score and clear feedback.</li>
        <li>See why your writing got that score.</li>
        <li>Get a CLB 9+ sample essay for the same prompt.</li>
      </ul>
      <div class="funnel-video__embed">
        <iframe
          width="560"
          height="315"
          src={YOUTUBE_EMBED_URL}
          title="YouTube video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <p class="muted" style="margin: var(--s-3) 0 0;">
        Many students do not see these mistakes on their own.
      </p>
      <div class="funnel-video__actions">
        <button class="btn btn-primary buy-writing-lab-btn" type="button">
          Try the AI essay correction
        </button>
      </div>
      <p class="muted" style="margin: var(--s-2) 0 0;">
        Built for CELPIP writing practice, not general AI writing help.
      </p>
      <p class="muted" style="margin: var(--s-2) 0 0;">
        <a href="/celpip/writing/samples">See a corrected CELPIP essay</a>
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">What you get</h2>
      <ul style="margin: 0; padding-left: 1.2rem;">
        <li>CA${CELPIP_WRITING_PRICE_CAD} per month for full access.</li>
        <li>Timed writing practice for CELPIP tasks.</li>
        <li>Estimated CLB score for each response.</li>
        <li>Clear reason for your estimated CLB score.</li>
        <li>Advice to improve toward CLB 9+.</li>
        <li>A CLB 9+ sample essay for the same prompt.</li>
        <li>Access to {promptTotal} prompts and sample essays.</li>
      </ul>
      <h3 style="margin: var(--s-4) 0 var(--s-2);">Who this is for</h3>
      <ul style="margin: 0; padding-left: 1.2rem;">
        <li>Stuck at CLB 6 or 7.</li>
        <li>Writing score lower than other skills.</li>
        <li>Need clear correction.</li>
      </ul>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 style="margin-top: 0;">Primary action</h2>
      <button id="buy-writing-lab" class="btn btn-primary buy-writing-lab-btn" type="button">
        Fix your writing mistakes now
      </button>
      <p class="muted checkout-status" style="margin: var(--s-2) 0 0; min-height: 1.2rem;"></p>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">FAQ</h2>
      <div class="stack" style="gap: var(--s-2);">
        {faqs.map((faq) => (
          <details class="card">
            <summary style="cursor: pointer; font-weight: 700;">{faq.question}</summary>
            <p class="muted" style="margin: var(--s-2) 0 0;">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 style="margin-top: 0;">Final action</h2>
      <button class="btn btn-primary buy-writing-lab-btn" type="button">
        See your mistakes before your next test
      </button>
      <p class="muted checkout-status" style="margin: var(--s-2) 0 0; min-height: 1.2rem;"></p>
    </div>
  </section>

  <script>
    const buyButtons = Array.from(document.querySelectorAll(".buy-writing-lab-btn"));
    const statusEls = Array.from(document.querySelectorAll(".checkout-status"));

    const setCheckoutStatus = (message: string) => {
      statusEls.forEach((el) => {
        if (el instanceof HTMLElement) {
          el.textContent = message;
        }
      });
    };

    const readApiResponse = async (response: Response) => {
      const contentType = response.headers.get("content-type") || "";
      if (contentType.includes("application/json")) {
        return response.json();
      }

      const text = await response.text();
      const isHtml = /<!doctype html>|<html/i.test(text);
      if (isHtml) {
        throw new Error("Checkout is unavailable. Please try again.");
      }

      try {
        return JSON.parse(text);
      } catch {
      }

      throw new Error(text?.trim() || "Unexpected checkout response.");
    };

    const startCheckout = async () => {
      setCheckoutStatus("Redirecting to secure checkout...");
      buyButtons.forEach((button) => {
        if (button instanceof HTMLButtonElement) button.disabled = true;
      });

      try {
        const response = await fetch("/.netlify/functions/create-celpip-writing-checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ product: "celpip-writing-ai" }),
        });
        const data = await readApiResponse(response);
        if (!response.ok || !data.checkoutUrl) {
          throw new Error(data.error || "Unable to start checkout.");
        }
        window.location.href = data.checkoutUrl;
      } catch (error) {
        const message = error instanceof Error ? error.message : "Unable to start checkout.";
        setCheckoutStatus(message);
        buyButtons.forEach((button) => {
          if (button instanceof HTMLButtonElement) button.disabled = false;
        });
      }
    };

    buyButtons.forEach((button) => button.addEventListener("click", startCheckout));

    if (new URLSearchParams(window.location.search).get("canceled") === "1") {
      setCheckoutStatus("Checkout was canceled. You can start again.");
    }
  </script>
</Layout>
