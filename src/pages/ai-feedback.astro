---
import Layout from "../layouts/Layout.astro";
import CelpipPracticeHub from "../components/CelpipPracticeHub.astro";
import ContextualNextStepPromo from "../components/ContextualNextStepPromo.astro";
import { aiFeedbackSecondaryPromo } from "../lib/promotionTools";
import {
  CELPIP_WRITING_PRICE_CAD,
} from "../lib/celpipWritingData.mjs";

const YOUTUBE_EMBED_URL = "https://www.youtube.com/embed/k-2lGP720OU?si=rg7FiJfdNMHsj9Q3";
const celpipQuickLinks = [
  { href: "/celpip", label: "CELPIP Hub" },
  { href: "/celpip/listening", label: "Listening" },
  { href: "/celpip/reading", label: "Reading" },
  { href: "/celpip/writing", label: "Writing" },
  { href: "/celpip/writing/questions", label: "Question Bank" },
  { href: "/celpip/speaking", label: "Speaking" },
  { href: "/celpip/writing/samples", label: "Sample Essays" },
  { href: "/celpip/reading-guide", label: "Reading Guide" },
];

const faqs = [
  {
    question: "How much does this cost?",
    answer: `CA$${CELPIP_WRITING_PRICE_CAD} per month. The first task is always free with no payment required.`,
  },
  {
    question: "Is this a live tutoring class?",
    answer: "No. This is not a live class. You write your response, submit it, and receive automated CLB scoring and feedback instantly.",
  },
  {
    question: "What do I get after subscribing?",
    answer: `Full access to all Task 1 and Task 2 practice prompts, AI evaluations with CLB scoring, and saved sample response bands inside each task.`,
  },
  {
    question: "Can I cancel anytime?",
    answer: "Yes. You can cancel instantly at any time from inside the practice hub. No commitment required.",
  },
];
---

<Layout
  title="CELPIP Writing AI Feedback — Try Free"
  description="Practice CELPIP Task 1 email writing with AI feedback. Your first evaluation is free — get your CLB score, see your mistakes, and know what to fix."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/writing.webp');`}>
      <div class="hero-content">
        <span class="pill ic-eyebrow">CELPIP writing feedback</span>
        <h1 class="ic-display">See your CELPIP writing score in minutes</h1>
        <p class="muted" style="max-width: 60ch;">
          Write a timed email, get an estimated CLB score, and see exactly what is lowering it. The first task is always free.
        </p>
        <div class="cluster" style="margin-top: var(--s-3);">
          <a class="btn btn-primary ic-btn" href="#celpip-writing-lab">Score my writing free</a>
          <a class="btn btn-ghost" href="/questions">Browse free question bank</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm" style="padding-top: 0; padding-bottom: var(--s-3);">
    <div class="surface" style="padding: var(--s-3) var(--s-4);">
      <p class="muted" style="margin: 0; font-size: 0.88rem;">CELPIP quick menu</p>
      <div class="cluster" style="margin-top: var(--s-2); gap: var(--s-2);">
        {celpipQuickLinks.map((link) => (
          <a class="btn" href={link.href}>{link.label}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm" style="padding-top: 0; padding-bottom: var(--s-4);">
    <div class="surface funnel-section funnel-video" style="max-width: 480px; margin: 0 auto; padding: var(--s-4);">
      <p class="muted funnel-video__intro" style="margin: 0 0 var(--s-3); font-size: 0.85rem;">
        Watch how the AI essay correction works and what you receive after submitting.
      </p>
      <div class="funnel-video__embed" style="max-width: 420px; margin: 0 auto;">
        <iframe
          width="420"
          height="236"
          src={YOUTUBE_EMBED_URL}
          title="YouTube video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section-sm" style="padding-top: 0;">
    <div class="container" style="margin-bottom: var(--s-3);">
      <p class="muted" style="margin: 0; max-width: 72ch;">
        This tool supports writing development through structured feedback and guided revision, not just a score.
      </p>
    </div>
  </section>

  <section class="section-sm" style="padding-top: 0;" id="celpip-writing-lab">
    <div class="container">
      <CelpipPracticeHub />
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">FAQ</h2>
      <div class="stack" style="gap: var(--s-2);">
        {faqs.map((faq) => (
          <details class="card">
            <summary style="cursor: pointer; font-weight: 700;">{faq.question}</summary>
            <p class="muted" style="margin: var(--s-2) 0 0;">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <ContextualNextStepPromo
        {...aiFeedbackSecondaryPromo}
        trackPageType="landing"
        trackTest="celpip"
        trackSkill="writing"
        trackPosition="ai-feedback-secondary"
      />
    </div>
  </section>

  <script>
    // Handle canceled checkout param
    if (new URLSearchParams(window.location.search).get("canceled") === "1") {
      const hub = document.getElementById('practice-hub');
      if (hub) {
        const msg = document.createElement('p');
        msg.style.cssText = 'color: var(--muted); font-size: 0.88rem; text-align: center; margin-top: var(--s-3);';
        msg.textContent = 'Checkout was canceled. You can subscribe again from within the practice hub.';
        hub.insertAdjacentElement('afterend', msg);
      }
    }
  </script>
</Layout>
