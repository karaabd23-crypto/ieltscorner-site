---
import Layout from "../layouts/Layout.astro";
import ServiceTrustCard from "../components/ServiceTrustCard.astro";
import {
  CELPIP_PROMPT_TOTAL,
  CELPIP_TASK_CONFIG,
  CELPIP_WRITING_PRICE_CAD,
} from "../lib/celpipWritingData.mjs";

const task1 = CELPIP_TASK_CONFIG.task1;
const task2 = CELPIP_TASK_CONFIG.task2;
const promptTotal = CELPIP_PROMPT_TOTAL;
const writingFeedbackVideoEmbedUrl = "https://www.youtube.com/embed/k-2lGP720OU?si=U7xe8VvybPi0IPOZ";
---

<Layout
  title="CELPIP Writing AI Feedback | Start Subscription"
  description="Get CELPIP writing AI feedback with score analysis and model responses."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/writing.png');`}>
      <div class="hero-content">
        <span class="pill">CELPIP Writing AI Feedback</span>
        <h1>Get detailed CELPIP writing feedback in minutes</h1>
        <p style="max-width: 68ch;">
          Practice with timed prompts, get score-based analysis, and see exactly what to fix.
        </p>
        <div class="cluster">
          <button id="buy-writing-lab" class="btn btn-primary buy-writing-lab-btn" type="button">
            Get Access for CA${CELPIP_WRITING_PRICE_CAD}/month
          </button>
        </div>
        <p class="muted checkout-status" style="margin: var(--s-2) 0 0; min-height: 1.2rem;"></p>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section funnel-video">
      <h2 style="margin-top: 0;">Watch How the CELPIP Writing Feedback Service Works</h2>
      <p class="muted funnel-video__intro">
        See exactly what kind of corrections you get and how this helps improve your writing score before your next test.
      </p>
      <div class="funnel-video__embed">
        <iframe
          width="560"
          height="315"
          src={writingFeedbackVideoEmbedUrl}
          title="CELPIP writing feedback service video"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">What you get</h2>
      <ul style="margin: 0; padding-left: 1.2rem;">
        <li>{promptTotal} CELPIP writing prompts for Task 1 and Task 2 practice.</li>
        <li>Score analysis by criteria with clear corrections and rewrite suggestions.</li>
        <li>Model responses so you can compare your answer to a strong version.</li>
        <li>Monthly access for CA${CELPIP_WRITING_PRICE_CAD}, cancel any time.</li>
      </ul>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">How it works</h2>
      <ol style="margin: 0; padding-left: 1.2rem;">
        <li>Subscribe and open the writing lab.</li>
        <li>Write a timed response for <strong>{task1.label}</strong> or <strong>{task2.label}</strong>.</li>
        <li>Review your score report and apply the fixes in your next attempt.</li>
      </ol>
    </div>
  </section>

  <section class="section-sm">
    <ServiceTrustCard
      heading="Know the teaching background behind this feedback"
      intro="Before you subscribe, check the qualifications and score evidence used to design IELTS Corner feedback systems."
    />
  </section>

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 style="margin-top: 0;">Ready to start?</h2>
      <div class="funnel-final-cta__actions">
        <button class="btn btn-primary buy-writing-lab-btn" type="button">
          Start AI Feedback Subscription
        </button>
      </div>
      <p class="muted checkout-status" style="margin: var(--s-2) 0 0; min-height: 1.2rem;"></p>
    </div>
  </section>

  <script>
    const buyButtons = Array.from(document.querySelectorAll(".buy-writing-lab-btn"));
    const statusEls = Array.from(document.querySelectorAll(".checkout-status"));

    const setCheckoutStatus = (message: string) => {
      statusEls.forEach((el) => {
        if (el instanceof HTMLElement) {
          el.textContent = message;
        }
      });
    };

    const readApiResponse = async (response: Response) => {
      const contentType = response.headers.get("content-type") || "";
      if (contentType.includes("application/json")) {
        return response.json();
      }

      const text = await response.text();
      const isHtml = /<!doctype html>|<html/i.test(text);
      if (isHtml) {
        throw new Error(
          "Checkout endpoint returned HTML instead of JSON. Start the site with Netlify Functions enabled (`netlify dev`) and verify Stripe env vars."
        );
      }

      try {
        return JSON.parse(text);
      } catch {
      }

      throw new Error(text?.trim() || "Unexpected response from checkout endpoint.");
    };

    const startCheckout = async () => {
      setCheckoutStatus("Redirecting to secure checkout...");
      buyButtons.forEach((button) => {
        if (button instanceof HTMLButtonElement) button.disabled = true;
      });

      try {
        const response = await fetch("/.netlify/functions/create-celpip-writing-checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ product: "celpip-writing-ai" }),
        });
        const data = await readApiResponse(response);
        if (!response.ok || !data.checkoutUrl) {
          throw new Error(data.error || "Unable to start checkout.");
        }
        window.location.href = data.checkoutUrl;
      } catch (error) {
        const message = error instanceof Error ? error.message : "Unable to start checkout.";
        setCheckoutStatus(message);
        buyButtons.forEach((button) => {
          if (button instanceof HTMLButtonElement) button.disabled = false;
        });
      }
    };

    buyButtons.forEach((button) => button.addEventListener("click", startCheckout));

    if (new URLSearchParams(window.location.search).get("canceled") === "1") {
      setCheckoutStatus("Checkout was canceled. You can start again anytime.");
    }
  </script>
</Layout>
