---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Us — IELTS Corner"
  description="Get in touch with us for tutoring, essay correction, or general questions about IELTS and CELPIP exam preparation."
  type="page"
>
  <section class="section" style="padding-top: var(--s-6);">
    <div class="hero" style={`--hero-bg: url('/heroes/contact.png');`}>
      <div class="hero-content">
        <h1>Get in touch with us.</h1>
        <p>Have questions about our lessons, tutoring, or services? We're here to help.</p>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <!-- CONTACT FORM & INFO -->
    <div class="grid grid-2">
      <!-- FORM -->
      <div>
        <h2>Send us a message</h2>
        <form name="contact" method="POST" netlify class="stack" style="gap: var(--s-3);">
          <input type="hidden" name="form-name" value="contact" />

          <div>
            <label for="name" style="display: block; margin-bottom: var(--s-1);">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              style="width: 100%; padding: var(--s-1); border: 1px solid var(--text-muted); border-radius: 4px; font-size: 1rem;"
            />
          </div>

          <div>
            <label for="email" style="display: block; margin-bottom: var(--s-1);">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              style="width: 100%; padding: var(--s-1); border: 1px solid var(--text-muted); border-radius: 4px; font-size: 1rem;"
            />
          </div>

          <div>
            <label for="subject" style="display: block; margin-bottom: var(--s-1);">Subject</label>
            <select
              id="subject"
              name="subject"
              required
              style="width: 100%; padding: var(--s-1); border: 1px solid var(--text-muted); border-radius: 4px; font-size: 1rem;"
            >
              <option value="">Choose a subject</option>
              <option value="tutoring">Tutoring inquiry</option>
              <option value="essay-correction">Essay correction</option>
              <option value="ebook">eBook question</option>
              <option value="lessons">Lessons question</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label for="message" style="display: block; margin-bottom: var(--s-1);">Message</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              style="width: 100%; padding: var(--s-1); border: 1px solid var(--text-muted); border-radius: 4px; font-size: 1rem; font-family: inherit;"
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary">Send message</button>
        </form>
      </div>

      <!-- CONTACT INFO -->
      <div>
        <h2>Other ways to reach us</h2>

        <div class="stack" style="gap: var(--s-4);">
          <div class="surface" style="padding: var(--s-3); border-radius: 8px;">
            <h3 style="margin-top: 0;">WhatsApp</h3>
            <p>Quick questions? Message us on WhatsApp for fast replies.</p>
            <a href="https://wa.me/1234567890" class="btn" target="_blank" rel="noopener noreferrer">
              Open WhatsApp →
            </a>
          </div>

          <div class="surface" style="padding: var(--s-3); border-radius: 8px;">
            <h3 style="margin-top: 0;">Email</h3>
            <p>For longer messages or detailed inquiries, send us an email.</p>
            <a href="mailto:hello@ieltscorner.ca" class="btn">
              hello@ieltscorner.ca
            </a>
          </div>

          <div class="surface" style="padding: var(--s-3); border-radius: 8px;">
            <h3 style="margin-top: 0;">Services</h3>
            <ul style="margin: 0; padding-left: var(--s-3);">
              <li><strong>Tutoring:</strong> CA$30/hour - Live 1-on-1 lessons</li>
              <li><strong>Essay Correction:</strong> CA$15 per essay</li>
              <li><strong>eBook:</strong> $19.99 - Complete grammar + writing guide</li>
            </ul>
          </div>

          <div class="surface" style="padding: var(--s-3); border-radius: 8px; background: var(--accent-light); border-left: 4px solid var(--accent);">
            <h3 style="margin-top: 0;">Response time</h3>
            <p>We reply to all messages within 24 hours during business days. For urgent questions about tutoring, try WhatsApp.</p>
          </div>
        </div>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <!-- FAQ INLINE -->
    <div>
      <h2>Common questions</h2>
      <div class="grid grid-2">
        <div class="surface" style="padding: var(--s-3);">
          <h3 style="margin-top: 0;">How do I book a tutoring session?</h3>
          <p>Fill out the form above and select "Tutoring inquiry." We'll reply with available times and a payment link.</p>
        </div>

        <div class="surface" style="padding: var(--s-3);">
          <h3 style="margin-top: 0;">What payment methods do you accept?</h3>
          <p>We accept Stripe (credit/debit cards), PayPal, and e-transfer. Payment details are sent after you contact us.</p>
        </div>

        <div class="surface" style="padding: var(--s-3);">
          <h3 style="margin-top: 0;">Can I get a refund on lessons?</h3>
          <p>Yes. If you're not satisfied with tutoring, we offer a full refund for your first 2 hours within 7 days.</p>
        </div>

        <div class="surface" style="padding: var(--s-3);">
          <h3 style="margin-top: 0;">Do you offer group lessons?</h3>
          <p>Currently, we offer 1-on-1 tutoring. Contact us if you're interested in group rates for 3+ students.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
