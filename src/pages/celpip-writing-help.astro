---
import ConversionLayout from "../layouts/ConversionLayout.astro";
---

<ConversionLayout
  title="CELPIP Writing Help | Start AI Feedback"
  description="Get detailed CELPIP writing feedback and a clear improvement plan."
  canonical="/celpip-writing-help/"
  keywords="CELPIP writing help, CELPIP writing feedback, CLB 9 writing"
>
  <section class="section landing-shell">
    <section class="landing-hero">
      <p class="landing-eyebrow">CELPIP Writing Support</p>
      <h1>Stuck at CLB 6 or 7 in CELPIP Writing?</h1>
      <p class="landing-subheadline">
        Use one focused path: watch the feedback demo, then start AI feedback and fix your score-lowering mistakes.
      </p>
      <div class="landing-hero__actions">
        <a class="btn btn-primary landing-cta" href="/ai-feedback">Start AI Feedback</a>
      </div>
    </section>

    <section class="landing-section">
      <h2>What you get</h2>
      <ul class="landing-list">
        <li>Clear feedback by scoring criteria</li>
        <li>Practical correction points you can apply immediately</li>
        <li>A direct path from practice to improvement</li>
      </ul>
    </section>

    <section class="landing-section landing-section--cta">
      <h2>Ready to improve your CELPIP writing score?</h2>
      <div class="landing-hero__actions">
        <a class="btn btn-primary landing-cta" href="/ai-feedback">Start AI Feedback</a>
      </div>
      <p class="muted" style="margin-top: var(--s-2);">
        Need one-on-one help instead? <a href="/tutoring#book-private-class">Book Private Class</a>.
      </p>
    </section>
  </section>
</ConversionLayout>