---
import Layout from "../../layouts/Layout.astro";
import ServiceTrustCard from "../../components/ServiceTrustCard.astro";

const PRIVATE_CALENDLY_URL = "https://calendly.com/ieltscorner/60min";
---

<Layout
  title="Private Classes | IELTS and CELPIP"
  description="Book one-on-one IELTS and CELPIP classes directly from the booking calendar."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/tutoring.png');`}>
      <div class="hero-content">
        <span class="pill">Private classes | Google Meet</span>
        <h1>Book your private class</h1>
        <p class="muted" style="max-width: 62ch;">
          One-to-one support focused on your exact score target, with direct correction and
          a clear plan for what to practice next.
        </p>

        <div class="cluster">
          <a class="btn btn-primary" href="#book-private-class">Book Private Class</a>
        </div>
      </div>
    </div>

    <div style="height: var(--s-6);"></div>

    <section class="surface funnel-section">
      <h2 style="margin-top: 0;">What you get in a private class</h2>
      <div class="checklist">
        <div class="check">
          <div class="icon">1</div>
          <div>
            <strong>Focused diagnosis</strong>
            <span>Find the exact errors that are blocking your next score jump.</span>
          </div>
        </div>
        <div class="check">
          <div class="icon">2</div>
          <div>
            <strong>Live correction</strong>
            <span>Fix speaking and writing mistakes in real time during class.</span>
          </div>
        </div>
        <div class="check">
          <div class="icon">3</div>
          <div>
            <strong>Clear follow-up plan</strong>
            <span>Leave class knowing exactly what to practice before your test.</span>
          </div>
        </div>
      </div>
    </section>

    <div style="height: var(--s-6);"></div>

    <ServiceTrustCard
      heading="Know your instructor before booking"
      intro="If you are paying for one-to-one support, you should see the teaching background first. The About page shows score evidence, TESL certification, and CELPIP instructor training."
    />

    <div style="height: var(--s-6);"></div>

    <section id="book-private-class" class="surface calendly-wrap">
      <h2 style="margin-top: 0;">Complete your booking</h2>
      <p class="muted" style="margin-top: 0;">
        Select your date and time below.
      </p>

      <div
        class="calendly-inline-widget"
        data-url={PRIVATE_CALENDLY_URL}
        style="min-width:320px;height:700px;"
      ></div>
    </section>
  </section>

  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async is:inline></script>
</Layout>

<style>
  .calendly-wrap {
    padding: var(--s-5);
    border: 2px solid color-mix(in srgb, var(--accent) 38%, var(--border) 62%);
    border-radius: var(--radius);
  }

  @media (max-width: 768px) {
    .calendly-wrap {
      padding: var(--s-3);
    }

    .calendly-inline-widget {
      height: 700px !important;
    }
  }
</style>
