---
import Layout from "../../layouts/Layout.astro";

const PRIVATE_CALENDLY_URL = 'https://calendly.com/ieltscorner/30min';
---

<Layout
  title="Private Classes — IELTS & CELPIP"
  description="Book one-on-one IELTS/CELPIP classes directly from the embedded Calendly calendar."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/tutoring.png');`}>
      <div class="hero-content">
        <span class="pill">🎓 Private Classes • Google Meet</span>
        <h1>Book Your Private Class</h1>
        <p class="muted" style="max-width: 64ch;">
          Choose your preferred time directly from the embedded calendar below.
          You’ll receive confirmation and session details by email.
        </p>

        <div class="cluster">
          <a class="btn btn-primary" href="#book-private-class">Open booking calendar ↓</a>
          <a class="btn btn-ghost" href={PRIVATE_CALENDLY_URL} target="_blank" rel="noreferrer">
            Open in new tab
          </a>
        </div>
      </div>
    </div>

    <div style="height: var(--s-7);"></div>

    <div class="grid grid-2" style="align-items: start; gap: var(--s-5);">
      <article class="card">
        <h2 style="margin-top: 0;">Why private classes work</h2>
        <div class="checklist">
          <div class="check">
            <div class="icon">✓</div>
            <div>
              <strong>Personalized strategy</strong>
              <span>Focused on your exact score target and weak points.</span>
            </div>
          </div>
          <div class="check">
            <div class="icon">✓</div>
            <div>
              <strong>Direct corrections</strong>
              <span>Clear feedback on speaking, writing, grammar, and vocabulary.</span>
            </div>
          </div>
          <div class="check">
            <div class="icon">✓</div>
            <div>
              <strong>Simple action plan</strong>
              <span>Know exactly what to practice before your next session.</span>
            </div>
          </div>
        </div>
      </article>

      <article class="surface tutoring-note">
        <h3 style="margin-top: 0;">Group classes</h3>
        <p class="muted" style="margin-top: 0; margin-bottom: 0;">
          Group classes are also managed through Calendly. Use the booking calendar below to select the appropriate class type and time slot.
        </p>
      </article>
    </div>

    <div style="height: var(--s-7);"></div>

    <div id="book-private-class" class="surface calendly-wrap">
      <h2 style="margin-top: 0;">Private Class Booking Calendar</h2>
      <p class="muted" style="margin-top: 0;">
        Select a date and time below to reserve your private IELTS/CELPIP session.
      </p>

      <div
        class="calendly-inline-widget"
        data-url={PRIVATE_CALENDLY_URL}
        style="min-width:320px;height:700px;"
      ></div>
    </div>
  </section>

  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async is:inline></script>
</Layout>

<style>
  .calendly-wrap {
    padding: var(--s-5);
    border: 2px solid color-mix(in srgb, var(--accent) 38%, var(--border) 62%);
    border-radius: var(--radius);
  }

  .tutoring-note {
    padding: var(--s-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--surface) 86%, var(--band) 14%);
  }

  @media (max-width: 768px) {
    .calendly-wrap {
      padding: var(--s-3);
    }

    .calendly-inline-widget {
      height: 700px !important;
    }
  }
</style>
