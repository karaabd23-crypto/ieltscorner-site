---
import Layout from "../layouts/Layout.astro";

const WEBINAR_CALENDLY_URL = "https://calendly.com/ieltscorner/weekly_webinar";
const WEBINAR_VIDEO_EMBED_URL = "https://www.youtube.com/embed/okqSzoEJwXc?si=Ptd4DV6yQAffKw98";

const faqs = [
  {
    question: "What will I learn in the webinar?",
    answer: "Each class focuses on one CELPIP score problem and how to fix it.",
  },
  {
    question: "Can I ask questions live?",
    answer: "Yes. You can ask your questions during the session.",
  },
  {
    question: "How do I register?",
    answer: "Click the button and choose your time in Calendly.",
  },
];
---

<Layout
  title="CELPIP Weekly Webinar | Register"
  description="Register for the weekly CELPIP webinar and get live strategy support."
  type="page"
  noindex={true}
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/webinar.webp'); --hero-bg-opacity: 0.18;`}>
      <div class="hero-content">
        <span class="pill">Weekly webinar | Live online</span>
        <h1>Join this Saturday's CELPIP webinar</h1>
        <p>
          Get live guidance and clear strategy for your next test.
        </p>
        <p class="muted" style="margin: 0;">
          This Saturday at 6:00 PM (PST). Weekly seats are limited.
        </p>
        <div class="funnel-hero__actions">
          <button class="btn btn-primary open-webinar-calendly-btn" type="button">
            Join this Saturday's CELPIP webinar
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section funnel-video">
      <h2 style="margin-top: 0;">Watch how the Saturday CELPIP webinars work</h2>
      <p class="muted funnel-video__intro">
        This video explains what happens in each session and what you will learn.
      </p>
      <p class="muted" style="margin: var(--s-2) 0 0;">
        Know exactly what to expect before you join.
      </p>
      <p class="muted" style="margin: var(--s-2) 0 var(--s-3);">
        This Saturday at 6:00 PM (PST). Weekly seats are limited.
      </p>
      <div class="funnel-video__embed">
        <iframe
          width="560"
          height="315"
          src={WEBINAR_VIDEO_EMBED_URL}
          title="YouTube video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <div class="funnel-video__actions">
        <button class="btn btn-primary open-webinar-calendly-btn" type="button">
          Join this Saturday's CELPIP webinar
        </button>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">What you get</h2>
      <ul style="margin: 0; padding-left: 1.2rem;">
        <li>Live CELPIP teaching in a weekly class.</li>
        <li>One score problem with clear fixes.</li>
        <li>Chance to ask your questions live.</li>
        <li>Action steps to use before your next test.</li>
      </ul>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 style="margin-top: 0;">Reserve your webinar seat</h2>
      <p class="muted">This Saturday at 6:00 PM (PST). Weekly seats are limited.</p>
      <div class="funnel-final-cta__actions">
        <button class="btn btn-primary open-webinar-calendly-btn" type="button">
          Join this Saturday's CELPIP webinar
        </button>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">FAQ</h2>
      <div class="stack" style="gap: var(--s-2);">
        {faqs.map((faq) => (
          <details class="card">
            <summary style="cursor: pointer; font-weight: 700;">{faq.question}</summary>
            <p class="muted" style="margin: var(--s-2) 0 0;">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 style="margin-top: 0;">Ready to join live?</h2>
      <p class="muted">This Saturday at 6:00 PM (PST). Weekly seats are limited.</p>
      <div class="funnel-final-cta__actions">
        <button class="btn btn-primary open-webinar-calendly-btn" type="button">
          Join this Saturday's CELPIP webinar
        </button>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section funnel-section--quiet">
      <h2 style="margin-top: 0;">Not ready for a live session?</h2>
      <p class="muted" style="margin-top: 0; max-width: 62ch;">
        Start with free lessons or try another support option instead.
      </p>
      <div class="cluster" style="margin-top: var(--s-3);">
        <a class="btn" href="/lessons">Browse free lessons</a>
        <a class="btn" href="/celpip">CELPIP Hub</a>
        <a class="btn" href="/ai-feedback">AI Writing Feedback</a>
        <a class="btn" href="/tutoring">Private tutoring</a>
      </div>
    </div>
  </section>

  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async is:inline></script>

  <script is:inline>
    window.addEventListener("load", () => {
      const calendlyUrl = "https://calendly.com/ieltscorner/weekly_webinar";

      const openPopup = () => {
        if (!window.Calendly) {
          window.open(calendlyUrl, "_blank", "noopener,noreferrer");
          return;
        }
        window.Calendly.initPopupWidget({ url: calendlyUrl });
      };

      const buttons = Array.from(document.querySelectorAll(".open-webinar-calendly-btn"));
      buttons.forEach((button) => button.addEventListener("click", openPopup));
    });
  </script>
</Layout>
