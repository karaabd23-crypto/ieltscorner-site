---
import Layout from "../layouts/Layout.astro";
import ServiceTrustCard from "../components/ServiceTrustCard.astro";

const WEBINAR_CALENDLY_URL = "https://calendly.com/ieltscorner/weekly_webinar";
const WEBINAR_VIDEO_EMBED_URL = "";
const showWebinarVideo = WEBINAR_VIDEO_EMBED_URL.trim().length > 0;
---

<Layout
  title="CELPIP Weekly Webinar | Register"
  description="Register for the weekly CELPIP webinar and get live strategy support."
  type="page"
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/webinar.png'); --hero-bg-opacity: 0.18;`}>
      <div class="hero-content">
        <span class="pill">Weekly webinar | Live online</span>
        <h1>Register for this week's CELPIP webinar</h1>
        <p>
          Join one focused live session, get clear strategy on one score problem, and ask
          your questions before your next test.
        </p>

        <div class="cluster">
          <button id="open-webinar-calendly" class="btn btn-primary" type="button">
            Register Now
          </button>
        </div>
      </div>
    </div>

    <div style="height: var(--s-6);"></div>

    <section class="surface funnel-section funnel-video" id="webinar-video-preview">
      <h2 style="margin-top: 0;">Webinar video preview</h2>
      {showWebinarVideo ? (
        <>
          <p class="muted funnel-video__intro">
            Watch the webinar preview, then register below to join the next live session.
          </p>
          <div class="funnel-video__embed">
            <iframe
              width="560"
              height="315"
              src={WEBINAR_VIDEO_EMBED_URL}
              title="Webinar preview video"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </>
      ) : (
        <p class="muted funnel-video__intro" style="margin-bottom: 0;">
          The webinar preview video is being added soon. This section is ready for the embed
          link, and registration is open below now.
        </p>
      )}
    </section>

    <div style="height: var(--s-6);"></div>

    <ServiceTrustCard
      heading="Know your instructor before registration"
      intro="Before you reserve your seat, you can review teaching qualifications and score evidence on the About page."
    />

    <div style="height: var(--s-6);"></div>

    <section id="register-webinar" class="surface calendly-wrap">
      <h2 style="margin-top: 0;">Complete your webinar registration</h2>
      <p class="muted" style="margin-top: 0;">
        Choose your time below and reserve your seat.
      </p>

      <div
        class="calendly-inline-widget"
        data-url={WEBINAR_CALENDLY_URL}
        style="min-width:320px;height:700px;"
      ></div>
    </section>
  </section>

  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async is:inline></script>

  <script is:inline>
    window.addEventListener("load", () => {
      const calendlyUrl = "https://calendly.com/ieltscorner/weekly_webinar";

      const openPopup = () => {
        if (!window.Calendly) {
          window.open(calendlyUrl, "_blank", "noopener,noreferrer");
          return;
        }
        window.Calendly.initPopupWidget({ url: calendlyUrl });
      };

      const primary = document.getElementById("open-webinar-calendly");
      primary?.addEventListener("click", openPopup);
    });
  </script>
</Layout>

<style>
  .calendly-wrap {
    padding: var(--s-5);
    border: 2px solid color-mix(in srgb, var(--accent) 38%, var(--border) 62%);
    border-radius: var(--radius);
  }

  @media (max-width: 768px) {
    .calendly-wrap {
      padding: var(--s-3);
    }

    .calendly-inline-widget {
      height: 700px !important;
    }
  }
</style>
