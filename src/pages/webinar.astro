---
import Layout from "../layouts/Layout.astro";

const WEBINAR_CALENDLY_URL = 'https://calendly.com/ieltscorner/webinar';
---

<Layout
  title="CELPIP Weekly Webinar — Register with Calendly"
  description="Join weekly CELPIP webinars with live strategy and Q&A. Register instantly via Calendly popup."
  type="page"
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/webinar.png');`}>
      <div class="hero-content">
        <span class="pill">🎓 Weekly Webinar • Live Online</span>
        <h1>Register for This Week’s Webinar</h1>
        <p class="muted" style="max-width: 64ch;">
          Live CELPIP strategy session with practical examples and real-time Q&A.
          Click below to open the registration popup and pick your slot.
        </p>

        <div class="cluster">
          <button id="open-webinar-calendly" class="btn btn-primary" type="button">
            Open Registration Popup →
          </button>
          <a class="btn btn-ghost" href={WEBINAR_CALENDLY_URL} target="_blank" rel="noreferrer">
            Open full booking page
          </a>
        </div>

        <p class="muted" style="font-size: 14px; margin: 0;">
          If the popup is blocked, use “Open full booking page”.
        </p>
      </div>
    </div>

    <div style="height: var(--s-7);"></div>

    <article class="card">
      <h2 style="margin-top: 0;">What you get</h2>
      <div class="checklist">
        <div class="check">
          <div class="icon">✓</div>
          <div>
            <strong>Focused live teaching</strong>
            <span>High-impact CELPIP strategy in a practical format.</span>
          </div>
        </div>
        <div class="check">
          <div class="icon">✓</div>
          <div>
            <strong>Q&A with instructor</strong>
            <span>Ask your own questions and get direct guidance.</span>
          </div>
        </div>
        <div class="check">
          <div class="icon">✓</div>
          <div>
            <strong>Actionable next steps</strong>
            <span>Leave with a simple study plan for the week.</span>
          </div>
        </div>
      </div>
    </article>
  </section>

  <script is:inline>
    window.addEventListener('load', () => {
      const calendlyUrl = 'https://calendly.com/ieltscorner/webinar';

      const openPopup = () => {
        if (!window.Calendly) {
          window.open(calendlyUrl, '_blank', 'noopener,noreferrer');
          return;
        }
        window.Calendly.initPopupWidget({ url: calendlyUrl });
      };

      const primary = document.getElementById('open-webinar-calendly');

      primary?.addEventListener('click', openPopup);
    });
  </script>
</Layout>
