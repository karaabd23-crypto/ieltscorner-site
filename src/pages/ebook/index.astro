---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="eBook Coming Soon — IELTS Corner"
  description="The IELTS Corner eBook is in development and will be available soon."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/ebook.png');`}>
      <div class="hero-content">
        <span class="pill">📘 eBook</span>
        <h1>eBook Coming Soon</h1>
        <p class="muted" style="max-width: 62ch;">
          The eBook is currently in progress and not available yet. We are building a practical, score-focused guide for IELTS and CELPIP learners.
        </p>
        <p class="muted" style="max-width: 62ch; margin-top: var(--s-2);">
          While it is being prepared, you can use free lessons and get support through tutoring.
        </p>
        <div class="cluster" style="margin-top: var(--s-2);">
          <a class="btn btn-primary" href="/lessons">Explore free lessons →</a>
          <a class="btn" href="/tutoring">Book a class →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
