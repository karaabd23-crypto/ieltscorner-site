---
import Layout from "../../../layouts/Layout.astro";
import SkillFreeLessons from "../../../components/SkillFreeLessons.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SkillSubNav from "../../../components/SkillSubNav.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP", path: "/celpip/" },
    { name: "Listening", path: "/celpip/listening/" },
  ]),
];
---

<Layout
  title="CELPIP Listening Help | Book Private Class"
  description="Stuck in CELPIP listening? Book one private class and fix the exact habits that lower your score."
  keywords="CELPIP listening help, CELPIP listening coaching, CELPIP private class"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "CELPIP", href: "/celpip" },
    { label: "Listening" },
  ]} />
  <SkillSubNav exam="CELPIP" currentSkill="listening" />

  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/listening.webp');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill ic-eyebrow">CELPIP listening support</span>
        <h1 class="ic-display">Stuck at CLB 6 or 7 in CELPIP Listening?</h1>
        <p class="muted">
          Get one-to-one support to fix answer-trap mistakes, improve note-taking,
          and build a clear method for each listening part.
        </p>
        <div class="funnel-hero__actions">
          <a class="btn btn-primary ic-btn" href="/tutoring#book-private-class">Book Private Class</a>
        </div>
      </div>
    </div>
  </section>

  <SkillFreeLessons exam="CELPIP" skill="listening" />

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 class="ic-display" style="margin-top: 0;">Your next step</h2>
      <p>Book one focused class and get a personal listening score plan.</p>
      <div class="funnel-final-cta__actions">
        <a class="btn btn-primary" href="/tutoring#book-private-class">Book Private Class</a>
      </div>
    </div>
  </section>
</Layout>

