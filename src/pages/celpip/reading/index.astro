---
import Layout from "../../../layouts/Layout.astro";
import SkillFreeLessons from "../../../components/SkillFreeLessons.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SkillSubNav from "../../../components/SkillSubNav.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP", path: "/celpip/" },
    { name: "Reading", path: "/celpip/reading/" },
  ]),
];
---

<Layout
  title="CELPIP Reading Help | Book Private Class"
  description="Stuck in CELPIP reading? Book one private class and fix timing, question strategy, and score-lowering mistakes."
  keywords="CELPIP reading help, CELPIP reading coaching, CELPIP private class"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "CELPIP", href: "/celpip" },
    { label: "Reading" },
  ]} />
  <SkillSubNav exam="CELPIP" currentSkill="reading" />

  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/reading.png');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill">CELPIP reading support</span>
        <h1>Stuck at CLB 6 or 7 in CELPIP Reading?</h1>
        <p class="muted">
          Get one-to-one coaching to improve timing, handle each reading task with a clear method,
          and stop losing marks to distractors.
        </p>
        <div class="funnel-hero__actions">
          <a class="btn btn-primary" href="/tutoring#book-private-class">Book Private Class</a>
        </div>
      </div>
    </div>
  </section>

  <SkillFreeLessons exam="CELPIP" skill="reading" />

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 style="margin-top: 0;">Your next step</h2>
      <p>Book one focused class and get a personal reading improvement plan.</p>
      <div class="funnel-final-cta__actions">
        <a class="btn btn-primary" href="/tutoring#book-private-class">Book Private Class</a>
      </div>
    </div>
  </section>
</Layout>

