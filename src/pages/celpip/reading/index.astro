---
import Layout from "../../../layouts/Layout.astro";
import CelpipWritingBanner from "../../../components/CelpipWritingBanner.astro";
import { getCollection } from "astro:content";
import { getLessonTier, getPublicLessonTitle } from "../../../lib/lessonLevel";

const skillLessons = (
  await getCollection(
    "lessons",
    ({ data }) =>
      !data.draft &&
      data.exam.includes("CELPIP") &&
      ["reading", "vocabulary", "grammar"].includes(data.category)
  )
)
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 10);
---

<Layout
  title="CELPIP Reading | Comprehension Strategies & Vocabulary | IELTS Corner"
  description="CELPIP reading strategies for multiple choice, matching, and fill-in questions. Learn scanning, inference, and vocabulary in context."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/reading.png');`}>
      <div class="hero-content">
        <span class="pill">📖 CELPIP Reading</span>
        <h1>Break the CLB 6 reading ceiling and push toward CLB 8</h1>
        <p class="muted" style="max-width: 62ch;">
          Use focused reading strategy for distractors, inference, timing, and viewpoint questions so your score stops stalling.
        </p>
        <div class="cluster">
          <a
            class="btn btn-primary"
            href="/celpip/reading/clb-6-to-8"
            data-track-click="celpip-reading-hero-rescue"
            data-track-page-type="hub"
            data-track-offer="reading_rescue"
            data-track-test="celpip"
            data-track-skill="reading"
            data-track-position="hero"
          >
            Open CLB 6 to 8 Rescue Hub
          </a>
          <a
            class="btn"
            href="/tutoring"
            data-track-click="celpip-reading-hero-tutoring"
            data-track-page-type="hub"
            data-track-offer="tutoring"
            data-track-test="celpip"
            data-track-skill="reading"
            data-track-position="hero"
          >
            Get Reading-Focused Tutoring
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <CelpipWritingBanner />
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-5);">
      <div class="cluster quick-nav">
        <a class="btn" href="/celpip">CELPIP Home</a>
        <a class="btn" href="/celpip/listening">Listening</a>
        <a class="btn btn-primary" href="/celpip/reading">Reading</a>
        <a class="btn btn-primary" href="/celpip/reading/clb-6-to-8">CLB 6 to 8 Rescue</a>
        <a class="btn" href="/celpip/speaking">Speaking</a>
        <a class="btn" href="/celpip/writing">Writing</a>
        <a class="btn" href="/lessons">All Lessons</a>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-6);">
      <h2>Popular CELPIP reading guides</h2>
      <p class="muted" style="margin-top: 0; max-width: 68ch;">
        Start here for query-focused strategy before opening the full lesson list.
      </p>
      <div class="grid grid-2" style="margin-top: var(--s-4);">
        <a class="card" href="/blog/celpip-reading-question-types" style="display:block; text-decoration:none;">
          <h3>CELPIP Reading Question Types Guide</h3>
          <p class="muted">Format-by-format tactics for correspondence, diagrams, and viewpoints.</p>
        </a>
        <a class="card" href="/blog/celpip-sample-answers" style="display:block; text-decoration:none;">
          <h3>CELPIP sample answers guide</h3>
          <p class="muted">How to review sample answers without memorization traps.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-6);">
      <h2>Related lessons for reading improvement</h2>
      <p class="muted" style="margin-top: 0; max-width: 68ch;">
        Work through these CELPIP-related vocabulary and grammar lessons to read faster and choose better answers under time pressure.
      </p>
      <div class="grid grid-2">
        {skillLessons.map((lesson) => (
          <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block;">
            <div class="cluster" style="justify-content: space-between;">
              <span class="pill">{lesson.data.category} • {getLessonTier(lesson.data.level)}</span>
              <span class="pill">Open →</span>
            </div>
            <h3 style="margin-top: var(--s-3);">{getPublicLessonTitle(lesson.data.title, lesson.data.level)}</h3>
            <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="stack" style="gap: var(--s-8);">
      <!-- Format breakdown -->
      <div class="surface" style="padding: var(--s-6);">
        <h2>CELPIP Reading format (55-60 minutes)</h2>
        <div class="grid grid-2">
          <div>
            <h3>Practice Task (1 question)</h3>
            <p>Quick warm-up before scored parts begin.</p>
          </div>
          <div>
            <h3>Part 1: Reading Correspondence (11 questions)</h3>
            <p><strong>Tests:</strong> Main idea, details, and purpose in emails/messages.</p>
          </div>
          <div>
            <h3>Part 2: Reading to Apply a Diagram (8 questions)</h3>
            <p><strong>Tests:</strong> Reading and applying visual information correctly.</p>
          </div>
          <div>
            <h3>Part 3: Reading for Information (9 questions)</h3>
            <p><strong>Tests:</strong> Details, comparisons, and key factual information.</p>
          </div>
          <div>
            <h3>Part 4: Reading for Viewpoints (10 questions)</h3>
            <p><strong>Tests:</strong> Opinions, stance, and supporting arguments.</p>
          </div>
          <div>
            <h3>Possible unscored items</h3>
            <p>Reading may include unscored test-development items in any part.</p>
          </div>
        </div>
      </div>

      <!-- Pro strategies -->
      <div class="surface" style="padding: var(--s-6);">
        <h2>CELPIP reading pro strategies</h2>
        <div class="stack" style="gap: var(--s-4);">
          <div>
            <h4>✓ Skim for main idea first (30 seconds)</h4>
            <p>Read the first sentence of each paragraph. Understand the topic and organization before diving into details.</p>
          </div>
          <div>
            <h4>✓ Read the question before re-reading the passage</h4>
            <p>Know what to look for. This saves time and focuses your attention on relevant parts.</p>
          </div>
          <div>
            <h4>✓ Look for keyword matches (but not always)</h4>
            <p>Right answers sometimes paraphrase the passage, not repeat it exactly. Look for synonyms and rephrased ideas.</p>
          </div>
          <div>
            <h4>✓ Use context for unknown vocabulary</h4>
            <p>If you don't know a word, read the surrounding sentence. Often the meaning becomes clear.</p>
          </div>
          <div>
            <h4>✓ Watch for opinion vs. fact</h4>
            <p>Passages often mix facts and opinions. Words like "think," "believe," "seems" signal opinion; this matters for inference questions.</p>
          </div>
          <div>
            <h4>✓ Don't over-read for inference</h4>
            <p>Inference questions have answers that logically follow from the text. Don't add your own world knowledge.</p>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="surface" style="padding: var(--s-6);">
        <div class="stack" style="gap: var(--s-4); text-align: center;">
          <h2>Need to move from CLB 6 reading to CLB 8?</h2>
          <p class="muted">Use the rescue hub, then get targeted support for your weakest reading question types.</p>
          <div class="cluster" style="justify-content: center;">
            <a
              class="btn btn-primary"
              href="/celpip/reading/clb-6-to-8"
              data-track-click="celpip-reading-end-rescue"
              data-track-page-type="hub"
              data-track-offer="reading_rescue"
              data-track-test="celpip"
              data-track-skill="reading"
              data-track-position="end"
            >
              Start the Reading Rescue Pathway
            </a>
            <a
              class="btn"
              href="/tutoring"
              data-track-click="celpip-reading-end-tutoring"
              data-track-page-type="hub"
              data-track-offer="tutoring"
              data-track-test="celpip"
              data-track-skill="reading"
              data-track-position="end"
            >
              Book 1:1 Reading Support
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
