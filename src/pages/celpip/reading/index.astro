---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SkillSubNav from "../../../components/SkillSubNav.astro";
import ContextualNextStepPromo from "../../../components/ContextualNextStepPromo.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";
import {
  CELPIP_READING_FREE_TEST,
  CELPIP_READING_PREMIUM_TESTS,
  CELPIP_READING_PRICE_CAD,
} from "../../../lib/celpipReadingData.mjs";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP", path: "/celpip/" },
    { name: "Reading", path: "/celpip/reading/" },
  ]),
];
---

<Layout
  title="CELPIP Reading Tests"
  description="Choose a CELPIP reading test, start the free full test in a separate exam-style environment, or unlock premium reading access immediately from the hub."
  keywords="CELPIP reading test, CELPIP reading simulator, CELPIP reading practice"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "CELPIP", href: "/celpip" },
    { label: "Reading" },
  ]} />

  <SkillSubNav exam="CELPIP" currentSkill="reading" />

  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/reading.png');`}>
      <div class="hero-content funnel-hero__content reading-catalog-hero">
        <span class="pill">CELPIP reading tests</span>
        <h1>Choose your reading test first. The exam screen opens separately.</h1>
        <p class="muted">
          Start with one full free reading test, or unlock premium now if you already know you want the full reading pack.
          The premium subscription gives you the detailed review layer and the remaining premium tests without making you buy only after the free diagnostic.
        </p>
        <div class="funnel-hero__actions">
          <a class="btn btn-primary" href="/celpip/reading/free-test">Start Free Test</a>
          <button class="btn btn-ghost" id="reading-hub-start-checkout" type="button">Unlock premium now</button>
          <a class="btn btn-ghost" href="/tutoring#book-private-class">Book private reading coaching</a>
        </div>
        <p class="muted reading-catalog__status" id="reading-hub-checkout-status" style="margin: 0; min-height: 1.4rem;"></p>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface reading-catalog">
      <div class="reading-catalog__head">
        <div>
          <p class="reading-catalog__label">Available tests</p>
          <h2>Test list</h2>
        </div>
        <p class="muted reading-catalog__copy">
          The free test opens in a dedicated test environment. You can also unlock Reading Premium directly from this page before taking the test.
        </p>
      </div>

      <div class="reading-catalog__grid">
        <article class="reading-test-card reading-test-card--free">
          <p class="reading-test-card__badge">Free</p>
          <h3>{CELPIP_READING_FREE_TEST.title}</h3>
          <p class="muted">{CELPIP_READING_FREE_TEST.estimatedDifficulty}</p>
          <ul class="reading-test-card__list">
            <li>{CELPIP_READING_FREE_TEST.totalQuestions} auto-marked questions</li>
            <li>{CELPIP_READING_FREE_TEST.durationMinutes}-minute timed test</li>
            <li>Instant score plus lesson recommendations</li>
          </ul>
          <a class="btn btn-primary" href="/celpip/reading/free-test">Start Free Test</a>
          <p class="muted" style="margin: 0;">Use this first if you want a diagnostic before deciding on premium.</p>
        </article>

        {CELPIP_READING_PREMIUM_TESTS.map((test) => (
          <article class="reading-test-card reading-test-card--locked">
            <p class="reading-test-card__badge">Premium</p>
            <h3>{test.title}</h3>
            <p class="muted">{test.summary}</p>
            <p class="reading-test-card__focus"><strong>Focus:</strong> {test.focus}</p>
            <div class="reading-test-card__lockline">
              Unlock with Reading Premium right now for CA${CELPIP_READING_PRICE_CAD}/month. Cancel anytime.
            </div>
            <button class="btn btn-ghost reading-test-card__cta" type="button" data-reading-checkout="true">Unlock premium now</button>
          </article>
        ))}
      </div>

      <div class="reading-catalog__promo">
        <ContextualNextStepPromo
          eyebrow="Reading premium"
          title="Start with the free test or unlock Reading Premium immediately."
          intro="One full test is free. Premium adds detailed answer review, explanations, and the remaining full tests whenever you are ready to use them."
          primary={{
            offer: "reading_premium",
            title: "Reading Premium",
            description:
              "Go straight to secure checkout if you already know you want the full reading pack.",
            href: "#reading-hub-start-checkout",
            cta: "Unlock premium now",
          }}
          secondary={{
            offer: "reading_test",
            title: "Free Reading Test",
            description:
              "Take the free diagnostic first if you want to see your score before subscribing.",
            href: "/celpip/reading/free-test",
            cta: "Start free test",
          }}
          variant="compact"
          promoType="reading_premium_strip"
          trackPageType="hub"
          trackTest="celpip"
          trackSkill="reading"
          trackPosition="reading-premium-strip"
        />
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface reading-process">
      <h2 style="margin-top: 0;">How it works</h2>
      <div class="reading-process__grid">
        <article class="reading-process__item">
          <span>1</span>
          <h3>Choose a test</h3>
          <p>Start with the free full reading test, or unlock premium immediately from this page.</p>
        </article>
        <article class="reading-process__item">
          <span>2</span>
          <h3>Take the test when you are ready</h3>
          <p>The exam opens in a separate focused screen, whether you start free first or subscribe before taking it.</p>
        </article>
        <article class="reading-process__item">
          <span>3</span>
          <h3>Use review and premium tests</h3>
          <p>You get the score immediately, and premium adds deeper review plus the remaining tests when you want them.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <p class="offer-card__label">Need faster help?</p>
      <h2 style="margin-top: 0;">Choose the path that fits you: free diagnostic first, or premium immediately.</h2>
      <p>
        The free test is still the clean diagnostic. But if you already know you want the full reading pack, you can subscribe now without waiting for the first attempt.
      </p>
      <div class="funnel-final-cta__actions">
        <a class="btn btn-primary" href="/celpip/reading/free-test">Take the free reading test</a>
        <button class="btn" type="button" data-reading-checkout="true">Unlock premium now</button>
        <a class="btn" href="/tutoring#book-private-class">Book private class</a>
      </div>
    </div>
  </section>

  <section class="section-sm" style="padding-bottom: var(--s-6);">
    <div class="surface reading-ebook-callout">
      <div class="reading-ebook-callout__inner">
        <div>
          <p class="reading-ebook-callout__label">Also preparing speaking?</p>
          <h2 style="margin-top: var(--s-1); margin-bottom: var(--s-2);">The speaking guide covers what the reading test cannot.</h2>
          <p class="muted" style="margin: 0; max-width: 58ch;">
            All 8 CELPIP speaking tasks in one 109-page book. Scored samples at every CLB level, response frames, grammar drills, and a 4-week plan. One-time purchase, instant PDF download.
          </p>
        </div>
        <a class="btn btn-primary reading-ebook-callout__btn" href="/ebook">Get the Speaking eBook - CA$49.50</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    const statusEl = document.getElementById('reading-hub-checkout-status');
    const checkoutButtons = Array.from(document.querySelectorAll('[data-reading-checkout="true"], #reading-hub-start-checkout'));
    const params = new URLSearchParams(window.location.search);

    const setStatus = (message = '', tone = 'info') => {
      if (!(statusEl instanceof HTMLElement)) return;
      statusEl.textContent = message;
      statusEl.dataset.tone = message ? tone : '';
    };

    if (params.get('checkout') === 'success') {
      setStatus('Payment confirmed. Premium is active for this purchase. You can start the free test whenever you are ready and use the premium review there.', 'success');
    } else if (params.get('checkout') === 'canceled') {
      setStatus('Checkout canceled. You can still start the free test now or come back to premium later.', 'info');
    }

    const beginCheckout = async () => {
      setStatus('Opening secure checkout...', 'info');

      try {
        const response = await fetch('/.netlify/functions/create-celpip-reading-checkout', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ source: 'reading-hub' }),
        });

        const data = await response.json().catch(() => null);
        if (!response.ok || !data?.checkoutUrl) {
          throw new Error(data?.error || 'Unable to start checkout.');
        }

        window.location.href = data.checkoutUrl;
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Unable to start checkout.', 'error');
      }
    };

    checkoutButtons.forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        void beginCheckout();
      });
    });
  })();
</script>

<style>
  .reading-catalog-hero {
    max-width: 62ch;
  }

  .reading-catalog {
    padding: clamp(20px, 2vw + 12px, 32px);
  }

  .reading-catalog__head {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    align-items: end;
    margin-bottom: var(--s-4);
  }

  .reading-catalog__head h2,
  .reading-test-card h3,
  .reading-process__item h3 {
    margin: 0;
  }

  .reading-catalog__label {
    margin: 0 0 6px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7d3940;
  }

  .reading-catalog__copy {
    margin: 0;
    max-width: 42ch;
  }

  .reading-catalog__status {
    color: #5f6c79;
  }

  .reading-catalog__status[data-tone="success"] {
    color: #21603c;
  }

  .reading-catalog__status[data-tone="error"] {
    color: #9f2e2e;
  }

  .reading-catalog__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .reading-catalog__promo {
    margin-top: var(--s-4);
  }

  .reading-test-card {
    display: grid;
    gap: 10px;
    padding: 18px;
    border-radius: 18px;
    border: 1px solid rgba(20, 22, 23, 0.14);
    background: #fff;
  }

  .reading-test-card--free {
    border-color: color-mix(in srgb, var(--accent) 34%, rgba(20, 22, 23, 0.14) 66%);
    background:
      radial-gradient(circle at top right, rgba(217, 72, 72, 0.08), transparent 34%),
      #fff;
  }

  .reading-test-card__badge {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5f6c79;
  }

  .reading-test-card__list {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 8px;
    color: #334556;
  }

  .reading-test-card__focus,
  .reading-test-card__lockline {
    margin: 0;
    color: #334556;
  }

  .reading-test-card__lockline {
    margin-top: auto;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(20, 22, 23, 0.05);
    font-weight: 700;
  }

  .reading-test-card__cta {
    width: fit-content;
  }

  .reading-process {
    padding: clamp(20px, 2vw + 12px, 32px);
  }

  .reading-process__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .reading-process__item {
    padding: 18px;
    border-radius: 18px;
    border: 1px solid rgba(20, 22, 23, 0.14);
    background: #fff;
  }

  .reading-process__item span {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(217, 72, 72, 0.1);
    color: #8f3434;
    font-weight: 800;
    margin-bottom: 10px;
  }

  .reading-process__item p {
    margin: 8px 0 0;
    color: #334556;
  }

  @media (max-width: 1080px) {
    .reading-catalog__grid,
    .reading-process__grid {
      grid-template-columns: 1fr 1fr;
    }

    .reading-test-card--free {
      grid-column: span 2;
    }
  }

  @media (max-width: 760px) {
    .reading-catalog__head,
    .reading-catalog__grid,
    .reading-process__grid {
      grid-template-columns: 1fr;
    }

    .reading-test-card--free {
      grid-column: auto;
    }
  }

  .reading-ebook-callout {
    padding: clamp(20px, 2vw + 12px, 32px);
    border: 1.5px solid color-mix(in srgb, var(--accent) 22%, var(--border) 78%);
  }

  .reading-ebook-callout__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    flex-wrap: wrap;
  }

  .reading-ebook-callout__label {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7d3940;
  }

  .reading-ebook-callout__btn {
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
