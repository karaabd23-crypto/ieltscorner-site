---
import Layout from "../../../../layouts/Layout.astro";
import {
  CELPIP_PROMPT_TOTAL,
  CELPIP_TASK_CONFIG,
  CELPIP_WRITING_PRICE_CAD,
} from "../../../../lib/celpipWritingData.mjs";

const task1 = CELPIP_TASK_CONFIG.task1;
const task2 = CELPIP_TASK_CONFIG.task2;
const promptTotal = CELPIP_PROMPT_TOTAL;
---

<Layout
  title="Get CELPIP Writing Marks | Timed Practice and Score Analysis"
  description="Monthly CELPIP writing lab with timed Task 1 and Task 2 practice, teacher-built scoring, and instant cancellation."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/writing.png');`}>
      <div class="hero-content">
        <span class="pill">CELPIP Writing Lab</span>
        <h1>Practice CELPIP writing and get your score</h1>
        <p style="max-width: 68ch; font-size: 1.15rem; line-height: 1.7;">
          Pick a prompt. Write your answer. Get a score, feedback, and a sample response
          that shows you what a strong answer looks like.
        </p>
        <p style="margin-top: var(--s-2); max-width: 68ch; font-size: 1rem; line-height: 1.7;">
          This tool was built by <a href="/about">Kara Abdolmaleki</a>, who personally
          trained the AI on the official CELPIP writing level descriptors.
        </p>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-5);">
      <h2 style="margin-top: 0;">How it works</h2>
      <p style="margin-top: 0; max-width: 72ch; font-size: 1.15rem; line-height: 1.7;">
        You choose a writing prompt and write your answer with a timer, just like the
        real test. When you finish, you submit your response. The AI reads it and gives
        you a CLB level for four areas: how well you answered the question, how clear
        your writing is, how good your words are, and how correct your grammar is. For
        each area, it tells you what you did well and what you need to fix, it also finds
        your mistakes, shows you better sentences, and tells you which free lessons to
        study next.
      </p>
      <p style="margin-top: 0; max-width: 72ch; font-size: 1.15rem; line-height: 1.7;">
        After you get your score, the system also shows you a sample response for the
        same prompt. This is a CLB 9+ model answer so you can see exactly what a top
        score looks like. You can compare your writing to the sample and understand the
        difference. Kara personally trained the AI using the official CELPIP writing
        descriptors, so it scores your work the same way a real CELPIP rater would — not
        just grammar, but the full picture.
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-5);">
      <h2 style="margin-top: 0;">What you get for CA${CELPIP_WRITING_PRICE_CAD}/month</h2>
      <p style="margin-top: 0; max-width: 72ch; font-size: 1.15rem; line-height: 1.7;">
        Your subscription gives you everything you need to practise CELPIP writing and
        improve your score. You get {promptTotal} writing prompts: both Task 1 emails and
        Task 2 survey responses. Every prompt comes with a CLB 9+ sample answer so you
        always know what a strong response looks like. You can submit as many responses
        as you want each month and get scored every time.
      </p>
      <p style="margin-top: 0; max-width: 72ch; font-size: 1.15rem; line-height: 1.7;">
        You also get full access to the <a href="/celpip/writing/samples">sample essay
        library</a>. 100 model answers you can search by task type, topic, and CLB
        level. Use them to study patterns, compare your writing, and learn what examiners
        want to see. There are no contracts and no hidden fees. You can cancel instantly
        from your dashboard at any time.
      </p>
      <div class="surface feature" style="margin-top: var(--s-5); padding: var(--s-5); border: 2px solid var(--accent); text-align: center;">
        <p style="margin: 0; font-size: 1.35rem; line-height: 1.6; font-weight: 700;">
          Get access to the AI rater and sample essays for only $5 per month.<br />
          Cancel anytime with one click.
        </p>
        <button id="buy-writing-lab" class="btn btn-primary" type="button" style="margin-top: var(--s-4); font-size: 1.15rem; padding: var(--s-3) var(--s-6);">
          Get Access
        </button>
        <p id="checkout-status" class="muted" style="margin: var(--s-2) 0 0; min-height: 1.2rem;"></p>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="grid grid-3">
      <article class="card">
        <h2 style="margin-top: 0;">Task 1</h2>
        <p style="font-size: 1.1rem;"><strong>{task1.label}</strong></p>
        <p style="margin-bottom: 0; font-size: 1.05rem;">{task1.minutes} minutes | {task1.targetWords}</p>
      </article>
      <article class="card">
        <h2 style="margin-top: 0;">Task 2</h2>
        <p style="font-size: 1.1rem;"><strong>{task2.label}</strong></p>
        <p style="margin-bottom: 0; font-size: 1.05rem;">{task2.minutes} minutes | {task2.targetWords}</p>
      </article>
      <article class="card">
        <h2 style="margin-top: 0;">After you submit</h2>
        <p style="font-size: 1.1rem;"><strong>Score + sample response</strong></p>
        <p style="margin-bottom: 0; font-size: 1.05rem;">Your CLB level, feedback on each area, mistakes, better sentences, and a model answer for the same prompt</p>
      </article>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-6);">
      <div class="grid grid-2" style="align-items:start; gap: var(--s-5);">
        <div>
          <h2>How you use the writing lab</h2>
          <div class="checklist">
            <div class="check"><div class="icon">1</div><div><strong>Pick a prompt</strong><span>Choose a Task 1 email or a Task 2 survey question.</span></div></div>
            <div class="check"><div class="icon">2</div><div><strong>Write your answer</strong><span>Use the timer to practise under real test conditions.</span></div></div>
            <div class="check"><div class="icon">3</div><div><strong>Submit and get your score</strong><span>See your CLB level for each area, your mistakes, and better sentences.</span></div></div>
            <div class="check"><div class="icon">4</div><div><strong>Read the sample response</strong><span>See a CLB 9+ model answer for the same prompt and compare it to yours.</span></div></div>
            <div class="check"><div class="icon">5</div><div><strong>Study the lessons it recommends</strong><span>The system tells you which free lessons to read based on your weak areas.</span></div></div>
            <div class="check"><div class="icon">6</div><div><strong>Browse the sample library</strong><span>Search 100 model essays by task, topic, and level whenever you want.</span></div></div>
          </div>
        </div>

        <div class="card" style="border: 2px solid var(--accent);">
          <h3 style="margin-top: 0;">Everything in your plan</h3>
          <p style="margin: 0; font-size: 1.05rem; line-height: 1.7;">
            Task 1 and Task 2 prompts with a timed writing screen. {promptTotal} prompts
            you can practise again and again. A CLB 9+ sample response for every prompt.
            Full score reports with feedback, mistakes, rewrites, and lesson links. Access
            to 100 searchable sample essays organized by task, topic, and level. Word count
            tracking. Cancel any time — no contracts, no hidden fees.
          </p>
          <div style="height: var(--s-4);"></div>
          <button id="buy-writing-lab-secondary" class="btn btn-primary" type="button" style="width: 100%;">
            Subscribe for CA${CELPIP_WRITING_PRICE_CAD}/month
          </button>
          <p id="checkout-status-secondary" class="muted" style="margin: var(--s-2) 0 0; min-height: 1.2rem;"></p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const buyButtons = [
      document.getElementById("buy-writing-lab"),
      document.getElementById("buy-writing-lab-secondary"),
    ].filter(Boolean);
    const statusEls = [
      document.getElementById("checkout-status"),
      document.getElementById("checkout-status-secondary"),
    ].filter(Boolean);

    const setCheckoutStatus = (message: string) => {
      statusEls.forEach((el) => {
        if (el instanceof HTMLElement) {
          el.textContent = message;
        }
      });
    };

    const readApiResponse = async (response: Response) => {
      const contentType = response.headers.get("content-type") || "";
      if (contentType.includes("application/json")) {
        return response.json();
      }

      const text = await response.text();
      const isHtml = /<!doctype html>|<html/i.test(text);
      if (isHtml) {
        throw new Error(
          "Checkout endpoint returned HTML instead of JSON. Start the site with Netlify Functions enabled (use `netlify dev`) and confirm Stripe env vars are set."
        );
      }

      try {
        return JSON.parse(text);
      } catch {
      }

      throw new Error(text?.trim() || "Unexpected response from checkout endpoint.");
    };

    const startCheckout = async () => {
      setCheckoutStatus("Redirecting to secure checkout...");
      buyButtons.forEach((button) => {
        if (button instanceof HTMLButtonElement) button.disabled = true;
      });

      try {
        const response = await fetch("/.netlify/functions/create-celpip-writing-checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ product: "celpip-writing-ai" }),
        });
        const data = await readApiResponse(response);
        if (!response.ok || !data.checkoutUrl) {
          throw new Error(data.error || "Unable to start checkout");
        }
        window.location.href = data.checkoutUrl;
      } catch (error) {
        const message = error instanceof Error ? error.message : "Unable to start checkout.";
        setCheckoutStatus(message);
        buyButtons.forEach((button) => {
          if (button instanceof HTMLButtonElement) button.disabled = false;
        });
      }
    };

    buyButtons.forEach((button) => button?.addEventListener("click", startCheckout));

    if (new URLSearchParams(window.location.search).get("canceled") === "1") {
      setCheckoutStatus("Checkout was canceled. You can try again anytime.");
    }
  </script>
</Layout>
