---
import Layout from "../../../layouts/Layout.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP", path: "/celpip/" },
    { name: "Writing", path: "/celpip/writing/" },
  ]),
];
---

<Layout
  title="CELPIP Writing Hub | Fix Writing Mistakes"
  description="CELPIP writing hub with one clear path to AI writing feedback."
  keywords="CELPIP writing, CELPIP writing feedback, CLB 9 CELPIP writing"
  structuredData={pageStructuredData}
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/writing.png');`}>
      <div class="hero-content">
        <span class="pill">CELPIP writing</span>
        <h1>Your CELPIP writing score is stuck. Here is why.</h1>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">Why your writing score is not improving</h2>
      <ul style="margin: 0; padding-left: 1.2rem;">
        <li>You do not see your grammar mistakes.</li>
        <li>You repeat the same structure.</li>
        <li>You do not know what a high score looks like.</li>
      </ul>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <p class="offer-card__label">Main action</p>
      <h2 style="margin-top: 0;">Get feedback on your writing</h2>
      <p>Upload your essay and see your mistakes in minutes.</p>
      <a class="btn btn-primary" href="/ai-feedback">See your mistakes before your next test</a>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section" style="opacity: 0.88;">
      <h2 style="margin-top: 0;">Free lessons (optional)</h2>
      <p class="muted" style="margin: 0;">
        Study free writing lessons first if you are not ready to pay.
      </p>
      <a class="btn btn-ghost" href="/lessons/writing" style="margin-top: var(--s-3);">Open free writing lessons</a>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">Need another skill page?</h2>
      <p class="muted" style="margin-top: 0;">You can return to the CELPIP main page.</p>
      <a class="btn btn-ghost" href="/celpip">Go back to CELPIP main page</a>
    </div>
  </section>
</Layout>
