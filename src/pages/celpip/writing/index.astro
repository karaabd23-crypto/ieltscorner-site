---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getLessonTier, getPublicLessonTitle } from "../../../lib/lessonLevel";

const skillLessons = (
  await getCollection(
    "lessons",
    ({ data }) =>
      !data.draft &&
      data.exam.includes("CELPIP") &&
      ["writing", "grammar", "vocabulary"].includes(data.category)
  )
)
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 10);
---

<Layout
  title="CELPIP Writing | Email & Survey Response Strategies | IELTS Corner"
  description="CELPIP writing strategies for task response, organization, and grammar. Master task 1 email and task 2 survey response with clear templates and examples."
>
  <section class="section">
    <div class="hero" style={`--hero: #f2f1ef; --hero-bg: url('/heroes/writing.png');`}>
      <div class="hero-content">
        <span class="pill">✍️ CELPIP Writing</span>
        <h1>Organize your ideas, express clearly, score higher</h1>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-5);">
      <div class="cluster quick-nav">
        <a class="btn" href="/celpip">CELPIP Home</a>
        <a class="btn" href="/celpip/listening">Listening</a>
        <a class="btn" href="/celpip/reading">Reading</a>
        <a class="btn" href="/celpip/speaking">Speaking</a>
        <a class="btn btn-primary" href="/celpip/writing">Writing</a>
        <a class="btn" href="/lessons">All Lessons</a>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-6); border: 2px solid var(--accent);">
      <h2 style="margin-top: 0;">All CELPIP Writing services in one place</h2>
      <p class="muted" style="margin-top: 0; max-width: 72ch;">
        Start with free writing lessons, get your writing scored by AI under timed conditions, then book a class for human feedback when you need deeper support.
      </p>

      <div class="grid grid-2" style="margin-top: var(--s-4);">
        <article class="card" style="display:flex; flex-direction:column; gap: var(--s-2);">
          <h3 style="margin: 0;">✍️ AI Writing Score & Analysis</h3>
          <p class="muted" style="margin:0;">Timed Task 1 + Task 2 practice with AI level estimate, trait scores, and revision advice.</p>
          <a class="btn btn-primary" href="/celpip/writing/ai-feedback">Get your writing scored by AI →</a>
        </article>

        <article class="card" style="display:flex; flex-direction:column; gap: var(--s-2);">
          <h3 style="margin: 0;">🧑‍🏫 Book a Writing Class</h3>
          <p class="muted" style="margin:0;">Get direct human feedback during private classes focused on your CELPIP writing performance.</p>
          <a class="btn" href="/tutoring">Book a class for human feedback →</a>
        </article>

        <article class="card" style="display:flex; flex-direction:column; gap: var(--s-2);">
          <h3 style="margin: 0;">📚 Free Writing Lessons</h3>
          <p class="muted" style="margin:0;">Templates, structure models, and grammar support for CELPIP writing tasks.</p>
          <a class="btn" href="/lessons/celpip/writing">Browse writing lessons →</a>
        </article>

        <article class="card" style="display:flex; flex-direction:column; gap: var(--s-2);">
          <h3 style="margin: 0;">🎓 Tutoring + Webinar</h3>
          <p class="muted" style="margin:0;">Private coaching and weekly CELPIP webinar sessions for guided improvement.</p>
          <div class="cluster">
            <a class="btn" href="/tutoring">Private tutoring →</a>
            <a class="btn" href="/webinar">Weekly webinar →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-6);">
      <h2>Related lessons for writing improvement</h2>
      <p class="muted" style="margin-top: 0; max-width: 68ch;">
        Use these CELPIP writing, grammar, and vocabulary lessons to improve task completion, tone control, and sentence accuracy.
      </p>
      <div class="grid grid-2">
        {skillLessons.map((lesson) => (
          <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block;">
            <div class="cluster" style="justify-content: space-between;">
              <span class="pill">{lesson.data.category} • {getLessonTier(lesson.data.level)}</span>
              <span class="pill">Open →</span>
            </div>
            <h3 style="margin-top: var(--s-3);">{getPublicLessonTitle(lesson.data.title, lesson.data.level)}</h3>
            <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="stack" style="gap: var(--s-8);">
      <!-- Format breakdown -->
      <div class="surface" style="padding: var(--s-6);">
        <h2>CELPIP Writing format (53–60 minutes, 2 tasks)</h2>
        <div class="grid grid-2">
          <div>
            <h3>Task 1: Writing an Email (27 minutes)</h3>
            <p>Write one email about an everyday matter and complete all required points.</p>
            <p><strong>Target length:</strong> 150–200 words.</p>
          </div>
          <div>
            <h3>Task 2: Responding to Survey Questions (26 minutes)</h3>
            <p>Choose one option, explain your choice, and support it with clear reasons.</p>
            <p><strong>Target length:</strong> 150–200 words.</p>
          </div>
        </div>
      </div>

      <!-- Pro strategies -->
      <div class="surface" style="padding: var(--s-6);">
        <h2>CELPIP writing pro strategies</h2>
        <div class="stack" style="gap: var(--s-4);">
          <div>
            <h4>✓ Plan each task before writing</h4>
            <p>Take 1–2 minutes to note purpose, tone, and key points before you type.</p>
          </div>
          <div>
            <h4>✓ Use clear transitions between ideas</h4>
            <p>Words like "Firstly," "In addition," "However," "Therefore" guide the reader and show your organization.</p>
          </div>
          <div>
            <h4>✓ Match your tone to the task</h4>
            <p>Task 1 email tone is usually semi-formal. Task 2 should be clear and persuasive, not too casual.</p>
          </div>
          <div>
            <h4>✓ Cover all required points</h4>
            <p>Missing one instruction can lower your score, even with strong grammar.</p>
          </div>
          <div>
            <h4>✓ Avoid repetition with synonyms and pronouns</h4>
            <p>Instead of repeating "writing," use "it," "this skill," or "the task." Vary your sentence structure too.</p>
          </div>
          <div>
            <h4>✓ Leave 5 minutes to proofread</h4>
            <p>Check spelling, verb forms (past tense consistency), and sentence structure. Small corrections improve your score.</p>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="surface" style="padding: var(--s-6);">
        <div class="stack" style="gap: var(--s-4); text-align: center;">
          <h2>Ready to improve your writing?</h2>
          <p class="muted">Practice with real CELPIP writing tasks, get timed AI feedback, then book a class for human guidance.</p>
          <div class="cluster" style="justify-content: center;">
            <a class="btn btn-primary" href="/lessons/celpip/writing">Free writing lessons →</a>
            <a class="btn" href="/celpip/writing/ai-feedback">AI score & analysis →</a>
            <a class="btn" href="/tutoring">Book a writing class →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
