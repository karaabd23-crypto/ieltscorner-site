---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SkillSubNav from "../../../components/SkillSubNav.astro";
import FeaturedToolsSection from "../../../components/FeaturedToolsSection.astro";
import { celpipWritingFeaturedToolCards } from "../../../lib/promotionTools";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const writingServices = [
  {
    title: "AI Writing Feedback Hub",
    description: "Practice Task 1 and Task 2 in the CELPIP writing lab with timer, score report, and revision guidance.",
    href: "/ai-feedback",
    cta: "Start AI feedback",
    tag: "Core",
  },
  {
    title: "Free Question Bank",
    description: "Browse 100 free CELPIP writing questions before you move into scored practice.",
    href: "/celpip/writing/questions",
    cta: "Open question bank",
    tag: "Free",
  },
  {
    title: "100 Writing Sample Essays",
    description: "Access the CELPIP Task 1 and Task 2 sample library to study strong model responses.",
    href: "/celpip/writing/samples",
    cta: "Open sample library",
    tag: "Core",
  },
  {
    title: "Private Writing Class",
    description: "Book one-to-one writing coaching to fix your exact Task 1 and Task 2 weak points.",
    href: "/tutoring#book-private-class",
    cta: "Book private class",
    tag: "Live",
  },
  {
    title: "CELPIP Writing Help",
    description: "Use the focused writing landing path if you want a faster start point before practice.",
    href: "/celpip-writing-help",
    cta: "Open writing help",
    tag: "Path",
  },
  {
    title: "Free Writing Lessons",
    description: "Open writing lessons immediately for extra grammar, structure, and task-response practice.",
    href: "/lessons/writing",
    cta: "Open writing lessons",
    tag: "Free",
  },
];

const writingResources = [
  {
    title: "Task 1 Email Guide",
    href: "/blog/celpip-writing-task-1-email",
  },
  {
    title: "Task 1 Templates",
    href: "/blog/celpip-writing-task-1-templates",
  },
  {
    title: "Task 2 Survey Response Guide",
    href: "/blog/celpip-writing-task-2-survey-response",
  },
  {
    title: "Task 2 Templates",
    href: "/blog/celpip-writing-task-2-templates",
  },
  {
    title: "CELPIP Sample Answers Overview",
    href: "/blog/celpip-sample-answers",
  },
  {
    title: "Free CELPIP Question Bank",
    href: "/celpip/writing/questions",
  },
  {
    title: "CLB 9 Strategy Guide",
    href: "/celpip/clb-9-strategy",
  },
];

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP", path: "/celpip/" },
    { name: "Writing", path: "/celpip/writing/" },
  ]),
];
---

<Layout
  title="CELPIP Writing Hub | All Writing Services"
  description="One-page CELPIP writing hub with direct links to all writing services, including AI feedback, sample essays, correction, and live support."
  keywords="CELPIP writing, CELPIP writing services, CELPIP task 1, CELPIP task 2, CELPIP writing feedback"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "CELPIP", href: "/celpip" },
    { label: "Writing" },
  ]} />
  <SkillSubNav exam="CELPIP" currentSkill="writing" />

  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/writing.webp');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill ic-eyebrow">CELPIP writing hub</span>
        <h1 class="ic-display">All CELPIP writing services on one page</h1>
        <p class="muted">
          You do not need to navigate deeper to find services. Use the cards below to open any writing service directly.
        </p>
        <div class="funnel-hero__actions">
          <a class="btn btn-primary ic-btn" href="/ai-feedback">Start AI writing feedback</a>
          <a class="btn btn-ghost" href="/celpip/writing/questions">Browse free question bank</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface writing-map">
      <FeaturedToolsSection
        eyebrow="Start with the right writing tool"
        title="Choose the writing path that matches your stage"
        intro="Use the writing lab for feedback, sample essays for proof, and the question bank when you just want free repetition."
        cards={celpipWritingFeaturedToolCards}
        trackPageType="hub"
        trackTest="celpip"
        trackSkill="writing"
        trackPosition="celpip-writing-featured-tools"
      />
    </div>
  </section>

  <section class="section-sm">
    <div class="surface writing-map">
      <h2 class="ic-display" style="margin-top: 0;">CELPIP writing service map</h2>
      <p class="muted" style="margin-top: 0;">
        Everything else on the writing page stays here for direct access.
      </p>
      <div class="grid grid-2 writing-services-grid">
        {writingServices.map((service) => (
          <a class="card writing-link-card" href={service.href}>
            <div class="writing-link-card__head">
              <span class="pill writing-link-card__tag">{service.tag}</span>
              <h3>{service.title}</h3>
            </div>
            <p class="muted">{service.description}</p>
            <span class="writing-link-card__cta">{service.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface writing-map writing-map--quiet">
      <h2 class="ic-display" style="margin-top: 0;">Task 1 and Task 2 support resources</h2>
      <p class="muted" style="margin-top: 0;">
        If you want extra guidance before paid services, these links take you directly to writing strategy pages.
      </p>
      <div class="grid grid-3 writing-resources-grid">
        {writingResources.map((resource) => (
          <a class="card writing-resource-card" href={resource.href}>
            <h3>{resource.title}</h3>
            <span class="writing-link-card__cta">Open resource</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 class="ic-display" style="margin-top: 0;">Need another CELPIP skill?</h2>
      <p class="muted" style="margin-top: 0;">Go back to the CELPIP hub to open Listening, Reading, or Speaking support.</p>
      <a class="btn btn-ghost" href="/celpip">Back to CELPIP hub</a>
    </div>
  </section>
</Layout>

<style>
  .writing-map {
    padding: var(--s-5);
  }

  .writing-map--quiet {
    opacity: 0.97;
  }

  .writing-services-grid,
  .writing-resources-grid {
    gap: var(--s-3);
    margin-top: var(--s-3);
    align-items: stretch;
  }

  .writing-link-card,
  .writing-resource-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    text-decoration: none;
    border: 1px solid var(--border);
    transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease;
  }

  .writing-link-card:hover,
  .writing-link-card:focus-visible,
  .writing-resource-card:hover,
  .writing-resource-card:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border) 45%);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .writing-link-card__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    align-items: center;
  }

  .writing-link-card__head h3,
  .writing-resource-card h3 {
    margin: 0;
    color: var(--text);
  }

  .writing-link-card p {
    margin: 0;
  }

  .writing-link-card__tag {
    width: fit-content;
  }

  .writing-link-card__cta {
    margin-top: auto;
    font-weight: 700;
    color: var(--accent);
  }

  @media (max-width: 960px) {
    .writing-resources-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .writing-map {
      padding: var(--s-4);
    }

    .writing-services-grid,
    .writing-resources-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
