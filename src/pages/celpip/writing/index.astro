---
import Layout from "../../../layouts/Layout.astro";
import SkillFreeLessons from "../../../components/SkillFreeLessons.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP", path: "/celpip/" },
    { name: "Writing", path: "/celpip/writing/" },
  ]),
];
---

<Layout
  title="CELPIP Writing | Start AI Feedback"
  description="Improve CELPIP writing faster with focused AI feedback and clear correction points."
  keywords="CELPIP writing, CELPIP writing feedback, CLB 9 CELPIP writing"
  structuredData={pageStructuredData}
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/writing.png');`}>
      <div class="hero-content">
        <span class="pill">CELPIP writing</span>
        <h1>Improve CELPIP writing with one clear next step</h1>
        <p class="muted" style="max-width: 62ch;">
          Start with AI feedback to see your score gaps quickly and fix the mistakes that
          hold your writing score down.
        </p>
        <div class="cluster">
          <a class="btn btn-primary" href="/ai-feedback">Go to AI Feedback</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">Why this path works</h2>
      <ul style="margin: 0; padding-left: 1.2rem;">
        <li>Practice timed Task 1 and Task 2 responses.</li>
        <li>Get clear score-based feedback on your own writing.</li>
        <li>Apply fixes immediately in your next attempt.</li>
      </ul>
    </div>
  </section>

  <SkillFreeLessons exam="CELPIP" skill="writing" />

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 style="margin-top: 0;">Start your CELPIP writing feedback now</h2>
      <div class="funnel-final-cta__actions">
        <a class="btn btn-primary" href="/ai-feedback">Go to AI Feedback</a>
      </div>
      <p class="muted" style="margin: var(--s-2) 0 0;">
        Need human correction instead? <a href="/essay-correction">Use essay correction</a>.
      </p>
    </div>
  </section>
</Layout>
