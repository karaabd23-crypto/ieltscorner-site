---
import Layout from "../../layouts/Layout.astro";
import { buildBreadcrumbSchema } from "../../lib/seo";

const pageKeywords = "CELPIP preparation, CELPIP listening, CELPIP reading, CELPIP writing, CELPIP speaking";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP", path: "/celpip/" },
  ]),
];
---

<Layout
  title="CELPIP Hub | Choose Your Skill"
  description="CELPIP hub with four skill paths: listening, reading, writing, and speaking."
  keywords={pageKeywords}
  structuredData={pageStructuredData}
>
  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/celpip.png');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill">CELPIP exam hub</span>
        <h1>Choose the CELPIP skill you want to improve</h1>
        <p class="muted">
          Select one skill below and follow a focused study path with a clear next step.
        </p>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">CELPIP skill paths</h2>
      <div class="offer-grid" style="margin-top: var(--s-3);">
        <a class="offer-card" href="/celpip/listening" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label">Skill 1</p>
          <h3 class="offer-card__name">Listening</h3>
          <p class="offer-card__line">Fix answer-trap mistakes and improve listening accuracy.</p>
          <span class="btn btn-ghost">Open Listening Path</span>
        </a>

        <a class="offer-card" href="/celpip/reading" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label">Skill 2</p>
          <h3 class="offer-card__name">Reading</h3>
          <p class="offer-card__line">Improve timing, question strategy, and proof-based answers.</p>
          <span class="btn btn-ghost">Open Reading Path</span>
        </a>

        <a class="offer-card" href="/celpip/writing" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label">Skill 3</p>
          <h3 class="offer-card__name">Writing</h3>
          <p class="offer-card__line">Get score-focused feedback and see the AI feedback video in the writing path.</p>
          <span class="btn btn-ghost">Open Writing Path</span>
        </a>

        <a class="offer-card" href="/celpip/speaking" style="text-decoration: none; color: inherit;">
          <p class="offer-card__label">Skill 4</p>
          <h3 class="offer-card__name">Speaking</h3>
          <p class="offer-card__line">Build clearer answers and reduce hesitation under pressure.</p>
          <span class="btn btn-ghost">Open Speaking Path</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
