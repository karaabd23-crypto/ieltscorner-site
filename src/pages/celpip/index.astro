---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FeaturedToolsSection from "../../components/FeaturedToolsSection.astro";
import { celpipFeaturedToolCards } from "../../lib/promotionTools";
import { buildBreadcrumbSchema } from "../../lib/seo";

const pageKeywords = "CELPIP preparation, CELPIP listening, CELPIP reading, CELPIP writing, CELPIP speaking, CELPIP services";

const skillCards = [
  {
    badge: "L",
    title: "Listening",
    description: "Practice listening. Learn timing and common trap answers.",
    href: "/celpip/listening",
    cta: "Open listening hub",
  },
  {
    badge: "R",
    title: "Reading",
    description: "Practice reading. Learn how to avoid wrong answer traps.",
    href: "/celpip/reading",
    cta: "Open reading hub",
  },
  {
    badge: "W",
    title: "Writing",
    description: "Practice Task 1 and Task 2 writing with examples and feedback.",
    href: "/celpip/writing",
    cta: "Open writing hub",
  },
  {
    badge: "S",
    title: "Speaking",
    description: "Practice speaking for all tasks. Build clear answers and confidence.",
    href: "/celpip/speaking",
    cta: "Open speaking hub",
  },
];

const celpipServices = [
  {
    title: "CELPIP Writing Practice",
    description: "Write Task 1 and Task 2 with a timer and get a score.",
    href: "/ai-feedback",
    cta: "Open writing practice",
  },
  {
    title: "CELPIP Question Bank",
    description: "Use 100 free Task 1 and Task 2 prompts.",
    href: "/celpip/writing/questions",
    cta: "Open CELPIP Question Bank",
  },
  {
    title: "Free Lessons",
    description: "Read free lessons for grammar, vocabulary, reading, writing, and speaking.",
    href: "/lessons",
    cta: "Browse free lessons",
  },
  {
    title: "CELPIP Reading Practice",
    description: "Take one free reading test. Choose paid review if you need more.",
    href: "/celpip/reading/free-test",
    cta: "Start reading practice",
  },
  {
    title: "100 Writing Sample Essays",
    description: "Read sample answers for Task 1 and Task 2.",
    href: "/celpip/writing/samples",
    cta: "Open sample library",
  },
  {
    title: "Private CELPIP Class",
    description: "Book a private class for any CELPIP skill.",
    href: "/tutoring#book-private-class",
    cta: "Book private class",
  },
  {
    title: "CELPIP Speaking Preparation Guide",
    description: "A 109-page guide for all 8 speaking tasks.",
    href: "/ebook",
    cta: "Get the CELPIP Speaking Preparation Guide",
  },
  {
    title: "CELPIP Writing Help",
    description: "Start here if you need writing help.",
    href: "/celpip-writing-help",
    cta: "Open writing help",
  },
  {
    title: "CLB 9 Strategy Guide",
    description: "Read a simple plan to move toward CLB 9.",
    href: "/celpip/clb-9-strategy",
    cta: "Read CLB 9 strategy",
  },
  {
    title: "Reading Rescue Hub",
    description: "Extra reading help for CLB 6 to CLB 8.",
    href: "/celpip/reading/clb-6-to-8",
    cta: "Open reading rescue",
  },
  {
    title: "Full Reading Guide",
    description: "Read the full reading guide with practice steps.",
    href: "/celpip/reading-guide",
    cta: "Open reading guide",
  },
  {
    title: "CELPIP for Canadian Immigration",
    description: "See CLB score needs for PR and citizenship.",
    href: "/celpip-for-canadian-immigration",
    cta: "See score requirements",
  },
];

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP", path: "/celpip/" },
  ]),
];
---

<Layout
  title="CELPIP Preparation: Free Practice Tests & CLB 9 Strategy"
  description="Prepare for CELPIP with free practice for listening, reading, writing, and speaking, a free full reading test, and instant AI writing feedback. Hit CLB 9 for Canadian PR. No card needed."
  keywords={pageKeywords}
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "CELPIP" },
  ]} />

  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/celpip.webp');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill ic-eyebrow">CELPIP hub</span>
        <h1 class="ic-display">Choose your skill, then choose your service</h1>
        <p class="muted">
          Choose one skill first. Then choose one tool below.
        </p>
        <div class="funnel-hero__actions">
          <a class="btn btn-primary" href="/celpip/writing/questions">Question bank</a>
          <a class="btn btn-ghost" href="/lessons">Lessons</a>
          <a class="btn btn-ghost" href="/celpip/reading/free-test">CELPIP reading</a>
          <a class="btn btn-ghost" href="/ai-feedback">Writing lab</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface celpip-section">
      <FeaturedToolsSection
        eyebrow="Start here"
        title="Best CELPIP tools to start"
        intro="Use one tool first. Keep it simple."
        cards={celpipFeaturedToolCards}
        trackPageType="hub"
        trackTest="celpip"
        trackSkill="general"
        trackPosition="celpip-featured-tools"
      />
    </div>
  </section>

  <section class="section-sm">
    <div class="surface celpip-section">
      <h2 class="ic-display" style="margin-top: 0;">1) Explore by skill</h2>
      <p class="muted" style="margin-top: 0;">
        Pick one skill. Open that page first.
      </p>
      <div class="grid grid-2 celpip-grid">
        {skillCards.map((skill) => (
          <a class="card celpip-link-card ic-card" href={skill.href}>
            <span class="pill celpip-pill ic-eyebrow">{skill.badge}</span>
            <h3 class="ic-display">{skill.title}</h3>
            <p class="muted">{skill.description}</p>
            <span class="celpip-link-card__cta">{skill.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface celpip-section">
      <h2 class="ic-display" style="margin-top: 0;">2) More CELPIP support</h2>
      <p class="muted" style="margin-top: 0;">
        All CELPIP tools are listed here.
      </p>
      <div class="grid grid-3 celpip-grid celpip-grid-services">
        {celpipServices.map((service) => (
          <a class="card celpip-link-card ic-card" href={service.href}>
            <h3 class="ic-display">{service.title}</h3>
            <p class="muted">{service.description}</p>
            <span class="celpip-link-card__cta">{service.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <p class="offer-card__label ic-eyebrow">Fast path</p>
      <h2 class="ic-display" style="margin-top: 0;">Need writing support first?</h2>
      <p>Open one page to see all writing tools.</p>
      <a class="btn btn-primary ic-btn" href="/celpip/writing">Open CELPIP writing services</a>
    </div>
  </section>
</Layout>

<style>
  .celpip-section {
    padding: var(--s-5);
  }

  .celpip-grid {
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  .celpip-grid-services {
    align-items: stretch;
  }

  .celpip-link-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    text-decoration: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: var(--shadow-soft);
    padding: 20px;
    transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease;
  }

  .celpip-link-card h3 {
    margin: 0;
    color: var(--text);
  }

  .celpip-link-card p {
    margin: 0;
  }

  .celpip-link-card:hover,
  .celpip-link-card:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border) 45%);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .celpip-pill {
    width: fit-content;
  }

  .celpip-link-card__cta {
    margin-top: auto;
    font-weight: 700;
    color: var(--accent);
  }

  @media (max-width: 960px) {
    .celpip-grid-services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .celpip-section {
      padding: var(--s-4);
    }

    .celpip-grid,
    .celpip-grid-services {
      grid-template-columns: 1fr;
    }
  }
</style>


