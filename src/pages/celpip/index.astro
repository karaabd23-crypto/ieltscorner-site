---
import Layout from "../../layouts/Layout.astro";
import { buildBreadcrumbSchema } from "../../lib/seo";

const pageKeywords = "CELPIP preparation, CELPIP listening, CELPIP reading, CELPIP writing, CELPIP speaking";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP", path: "/celpip/" },
  ]),
];
---

<Layout
  title="CELPIP Entry | Start With Writing"
  description="CELPIP entry page for writing users stuck at CLB 6 or 7."
  keywords={pageKeywords}
  structuredData={pageStructuredData}
>
  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/celpip.png');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill">CELPIP entry page</span>
        <h1>Stuck at CLB 6 in CELPIP Writing?</h1>
        <p class="muted">Find your mistakes and fix them step by step.</p>
        <a class="btn btn-primary" href="/celpip/writing">Fix your writing mistakes now</a>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">Why your writing score is not improving</h2>
      <ul style="margin: 0; padding-left: 1.2rem;">
        <li>You do not see your grammar mistakes.</li>
        <li>You repeat the same structure.</li>
        <li>You do not know what a high score looks like.</li>
      </ul>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">Who this is for</h2>
      <ul style="margin: 0; padding-left: 1.2rem;">
        <li>You are stuck at CLB 6 or 7.</li>
        <li>Your writing score is lower than other skills.</li>
        <li>You do not know what mistakes you make.</li>
      </ul>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <p class="offer-card__label">Start here</p>
      <h2 style="margin-top: 0;">Start here (recommended)</h2>
      <ul style="margin: var(--s-2) auto 0; max-width: 36rem; text-align: left; padding-left: 1.2rem;">
        <li>Step 1: Upload your writing.</li>
        <li>Step 2: See your mistakes.</li>
        <li>Step 3: Fix them and improve.</li>
      </ul>
      <a class="btn btn-primary" href="/celpip/writing" style="margin-top: var(--s-4);">See your mistakes before your next test</a>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section">
      <h2 style="margin-top: 0;">Need help with speaking, reading, or listening?</h2>
      <p class="muted" style="margin-bottom: 0;">Book one class and get direct correction.</p>
      <a class="btn btn-ghost" href="/tutoring#book-private-class" style="margin-top: var(--s-3);">Book a CELPIP class</a>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-section funnel-section--quiet">
      <h2 style="margin-top: 0;">Need help right now? Join this week's live class</h2>
      <p class="muted" style="margin-bottom: 0;">
        Ask questions, get feedback, and see real answers explained.
      </p>
      <p class="muted" style="margin-top: var(--s-2); margin-bottom: 0;">
        This Saturday at 6:00 PM (PST)
      </p>
      <p class="muted" style="margin-top: var(--s-2); margin-bottom: 0;">
        Weekly seats are limited.
      </p>
      <a class="btn btn-ghost" href="/webinar" style="margin-top: var(--s-3);">Join this Saturday's CELPIP webinar</a>
    </div>
  </section>
</Layout>
