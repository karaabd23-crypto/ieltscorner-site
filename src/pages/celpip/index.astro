---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FeaturedToolsSection from "../../components/FeaturedToolsSection.astro";
import { celpipFeaturedToolCards } from "../../lib/promotionTools";
import { buildBreadcrumbSchema } from "../../lib/seo";

const pageKeywords = "CELPIP preparation, CELPIP listening, CELPIP reading, CELPIP writing, CELPIP speaking, CELPIP services";

const skillCards = [
  {
    badge: "L",
    title: "Listening",
    description: "Improve timing, note-taking, and trap-answer accuracy with focused CELPIP listening support.",
    href: "/celpip/listening",
    cta: "Open listening hub",
  },
  {
    badge: "R",
    title: "Reading",
    description: "Fix distractor mistakes and pacing issues with reading-specific strategy and drills.",
    href: "/celpip/reading",
    cta: "Open reading hub",
  },
  {
    badge: "W",
    title: "Writing",
    description: "Access Task 1 and Task 2 writing practice, sample essays, and correction services.",
    href: "/celpip/writing",
    cta: "Open writing hub",
  },
  {
    badge: "S",
    title: "Speaking",
    description: "Build stronger speaking structure, fluency, and confidence across all speaking tasks.",
    href: "/celpip/speaking",
    cta: "Open speaking hub",
  },
];

const celpipServices = [
  {
    title: "CELPIP Writing Practice",
    description: "Practice Task 1 and Task 2 with timer, scoring, revision guidance, and saved premium progress.",
    href: "/ai-feedback",
    cta: "Open writing practice",
  },
  {
    title: "CELPIP Question Bank",
    description: "Browse 100 public Task 1 and Task 2 prompts before moving into scored writing practice.",
    href: "/celpip/writing/questions",
    cta: "Open question bank",
  },
  {
    title: "Free Lessons",
    description: "Open the lesson library when you want grammar, vocabulary, reading, writing, or speaking support outside the test tools.",
    href: "/lessons",
    cta: "Browse free lessons",
  },
  {
    title: "CELPIP Reading Practice",
    description: "Take the free reading test first, then unlock premium review if you want deeper explanations and progress tracking.",
    href: "/celpip/reading/free-test",
    cta: "Start reading practice",
  },
  {
    title: "100 Writing Sample Essays",
    description: "Open the CELPIP sample essay library for Task 1 and Task 2 model responses.",
    href: "/celpip/writing/samples",
    cta: "Open sample library",
  },
  {
    title: "Private CELPIP Class",
    description: "Book a one-on-one class for listening, reading, writing, or speaking improvement.",
    href: "/tutoring#book-private-class",
    cta: "Book private class",
  },
  {
    title: "CELPIP Speaking Preparation Guide",
    description: "All 8 speaking tasks in one 109-page guide. Scored samples, response frames, grammar drills, and a 4-week study plan. CA$49.50.",
    href: "/ebook",
    cta: "Get the CELPIP Speaking Preparation Guide",
  },
  {
    title: "CELPIP Writing Help",
    description: "Quick-start writing support path that leads directly to correction and improvement.",
    href: "/celpip-writing-help",
    cta: "Open writing help",
  },
  {
    title: "CLB 9 Strategy Guide",
    description: "Review a full strategy page for reaching CLB 9 across CELPIP skills.",
    href: "/celpip/clb-9-strategy",
    cta: "Read CLB 9 strategy",
  },
  {
    title: "Reading Rescue Hub",
    description: "Use the CLB 6 to 8 reading rescue flow for timing, inference, and trap fixes.",
    href: "/celpip/reading/clb-6-to-8",
    cta: "Open reading rescue",
  },
  {
    title: "Full Reading Guide",
    description: "Read the full long-form reading guide with drills and strategy examples.",
    href: "/celpip/reading-guide",
    cta: "Open reading guide",
  },
  {
    title: "CELPIP for Canadian Immigration",
    description: "CLB requirements for Express Entry, citizenship, and PNPs. Includes CRS point values by CLB level and a comparison with IELTS.",
    href: "/celpip-for-canadian-immigration",
    cta: "See score requirements",
  },
];

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP", path: "/celpip/" },
  ]),
];
---

<Layout
  title="CELPIP Preparation Online | Free Practice & CLB 9 Help"
  description="Free CELPIP practice for listening, reading, writing, and speaking, plus a free reading test and AI writing feedback. Reach CLB 9 for Canadian PR. Start free."
  keywords={pageKeywords}
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "CELPIP" },
  ]} />

  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/celpip.webp');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill ic-eyebrow">CELPIP hub</span>
        <h1 class="ic-display">Choose your skill, then choose your service</h1>
        <p class="muted">
          Start with Listening, Reading, Writing, or Speaking. Then use the quick links and service cards below to go directly to the exact CELPIP support you need.
        </p>
        <div class="funnel-hero__actions">
          <a class="btn btn-primary ic-btn" href="/celpip/writing/questions">Question bank</a>
          <a class="btn btn-ghost" href="/lessons">Free lessons</a>
          <a class="btn btn-ghost" href="/celpip/reading/free-test">Reading practice</a>
          <a class="btn btn-ghost" href="/ai-feedback">Writing practice</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface celpip-section">
      <FeaturedToolsSection
        eyebrow="Start with a tool, not the menu"
        title="The three CELPIP tools that deserve top billing"
        intro="These are the quickest ways to start practicing, diagnose your level, or move into premium improvement."
        cards={celpipFeaturedToolCards}
        trackPageType="hub"
        trackTest="celpip"
        trackSkill="general"
        trackPosition="celpip-featured-tools"
      />
    </div>
  </section>

  <section class="section-sm">
    <div class="surface celpip-section">
      <h2 class="ic-display" style="margin-top: 0;">1) Explore by skill</h2>
      <p class="muted" style="margin-top: 0;">
        Pick the skill page first. Each page is focused and links to the right support options for that skill.
      </p>
      <div class="grid grid-2 celpip-grid">
        {skillCards.map((skill) => (
          <a class="card celpip-link-card ic-card" href={skill.href}>
            <span class="pill celpip-pill ic-eyebrow">{skill.badge}</span>
            <h3 class="ic-display">{skill.title}</h3>
            <p class="muted">{skill.description}</p>
            <span class="celpip-link-card__cta">{skill.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface celpip-section">
      <h2 class="ic-display" style="margin-top: 0;">2) More CELPIP support</h2>
      <p class="muted" style="margin-top: 0;">
        Every active CELPIP-related service is listed here for one-click access.
      </p>
      <div class="grid grid-3 celpip-grid celpip-grid-services">
        {celpipServices.map((service) => (
          <a class="card celpip-link-card ic-card" href={service.href}>
            <h3 class="ic-display">{service.title}</h3>
            <p class="muted">{service.description}</p>
            <span class="celpip-link-card__cta">{service.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <p class="offer-card__label ic-eyebrow">Fast path</p>
      <h2 class="ic-display" style="margin-top: 0;">Need writing support first?</h2>
      <p>Use the writing hub to see all writing services on one page.</p>
      <a class="btn btn-primary ic-btn" href="/celpip/writing">Open CELPIP writing services</a>
    </div>
  </section>
</Layout>

<style>
  .celpip-section {
    padding: var(--s-5);
  }

  .celpip-grid {
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  .celpip-grid-services {
    align-items: stretch;
  }

  .celpip-link-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    text-decoration: none;
    border: 1px solid var(--border);
    transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease;
  }

  .celpip-link-card h3 {
    margin: 0;
    color: var(--text);
  }

  .celpip-link-card p {
    margin: 0;
  }

  .celpip-link-card:hover,
  .celpip-link-card:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border) 45%);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .celpip-pill {
    width: fit-content;
  }

  .celpip-link-card__cta {
    margin-top: auto;
    font-weight: 700;
    color: var(--accent);
  }

  @media (max-width: 960px) {
    .celpip-grid-services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .celpip-section {
      padding: var(--s-4);
    }

    .celpip-grid,
    .celpip-grid-services {
      grid-template-columns: 1fr;
    }
  }
</style>
