---
import Layout from "../../layouts/Layout.astro";
import { buildBreadcrumbSchema, buildFAQSchema } from "../../lib/seo";

const pageKeywords =
  "CELPIP preparation, CELPIP writing, CELPIP speaking, CELPIP reading, CELPIP listening, CELPIP writing samples, CELPIP tutor, CELPIP webinar, CLB 9 CELPIP";

const pageFaqs = [
  {
    question: "What is the best way to prepare for CELPIP?",
    answer:
      "The best way to prepare for CELPIP is to learn the task format for each skill, practice under time pressure, and review the weak areas that keep lowering your score.",
  },
  {
    question: "Does IELTS Corner cover all four CELPIP skills?",
    answer:
      "Yes. IELTS Corner has separate CELPIP pages for writing, speaking, reading, and listening, plus lessons, samples, AI feedback, webinars, and tutoring.",
  },
  {
    question: "Do you offer CELPIP writing feedback?",
    answer:
      "Yes. You can use the AI writing tool, sample responses, essay correction, and private classes for deeper feedback.",
  },
  {
    question: "Do I need paid support to start studying here?",
    answer:
      "No. You can start with the free skill hubs, lessons, and blog guides. Paid support is there only if you want feedback or a faster study path.",
  },
];

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP", path: "/celpip/" },
  ]),
  buildFAQSchema(pageFaqs),
];
---

<Layout
  title="CELPIP Preparation | Writing, Speaking, Reading and Listening"
  description="CELPIP preparation for writing, speaking, reading, and listening. Study with free lessons, writing tools, skill guides, and optional feedback."
  keywords={pageKeywords}
  structuredData={pageStructuredData}
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/celpip.png');`}>
      <div class="hero-content" style="text-align: center; max-width: 64ch; margin: 0 auto;">
        <span class="pill">CELPIP preparation</span>
        <h1>Start with the task you need to fix.</h1>
        <p class="muted">
          Keep your study path simple. Choose one skill, learn the format, practice with
          clear models, and add feedback only when you need it.
        </p>
        <div class="cluster" style="margin-top: var(--s-3); justify-content: center;">
          <a class="btn btn-primary" href="/celpip/writing">Start with CELPIP writing</a>
          <a class="btn btn-ghost" href="/lessons/celpip">Browse CELPIP lessons</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-6);">
      <h2 style="margin-top: 0; text-align: center;">Choose your CELPIP skill</h2>
      <p class="muted" style="max-width: 70ch; margin: 0 auto; text-align: center;">
        These pages are organized around real student problems, not broad course labels.
        That makes it easier to find the next useful step.
      </p>
      <div class="grid grid-2" style="gap: var(--s-4); margin-top: var(--s-5);">
        <a class="card" href="/celpip/writing" style="text-decoration:none;">
          <h3>CELPIP Writing</h3>
          <p class="muted">
            Email and survey response strategy, stronger structure, and better task
            coverage.
          </p>
        </a>
        <a class="card" href="/celpip/speaking" style="text-decoration:none;">
          <h3>CELPIP Speaking</h3>
          <p class="muted">
            Task-by-task speaking support for fluency, organization, and clearer answers.
          </p>
        </a>
        <a class="card" href="/celpip/reading" style="text-decoration:none;">
          <h3>CELPIP Reading</h3>
          <p class="muted">
            Reading tactics for detail questions, skimming, timing, and careful answer
            choice.
          </p>
        </a>
        <a class="card" href="/celpip/listening" style="text-decoration:none;">
          <h3>CELPIP Listening</h3>
          <p class="muted">
            Prediction, note-taking, and common traps that cause avoidable listening
            mistakes.
          </p>
        </a>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface feature">
      <div class="feature-grid">
        <div class="stack">
          <h2>Simple CELPIP study order</h2>
          <p class="muted" style="max-width: 58ch;">
            Students improve faster when the study order is clear. Learn the task first,
            practice it, then review what is still weak.
          </p>
        </div>

        <div class="grid grid-2" style="gap: var(--s-3);">
          <div class="card">
            <h3>1. Learn the format</h3>
            <p class="muted">Know what each task wants before you spend hours practicing it.</p>
          </div>
          <div class="card">
            <h3>2. Use free models</h3>
            <p class="muted">Study lessons, samples, and strategy guides until the structure feels natural.</p>
          </div>
          <div class="card">
            <h3>3. Notice your weak point</h3>
            <p class="muted">Track whether the problem is timing, grammar, clarity, or task completion.</p>
          </div>
          <div class="card">
            <h3>4. Add feedback if needed</h3>
            <p class="muted">Use AI scoring, a webinar, or a private class when you need targeted correction.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="grid grid-2" style="gap: var(--s-4);">
      <a class="card" href="/celpip/writing/samples" style="text-decoration:none;">
        <h3>CELPIP sample answers</h3>
        <p class="muted">
          Study complete responses and see how structure, tone, and support work together.
        </p>
      </a>
      <a class="card" href="/celpip/writing/ai-feedback" style="text-decoration:none;">
        <h3>AI writing feedback</h3>
        <p class="muted">
          Get a score estimate, trait feedback, and lesson suggestions for CELPIP writing.
        </p>
      </a>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-6);">
      <h2 style="margin-top: 0;">CELPIP preparation FAQ</h2>
      <div class="stack" style="gap: var(--s-3); margin-top: var(--s-4);">
        {pageFaqs.map((item) => (
          <details class="card">
            <summary style="cursor: pointer; font-weight: 700;">{item.question}</summary>
            <p class="muted" style="margin-top: var(--s-2); margin-bottom: 0;">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
