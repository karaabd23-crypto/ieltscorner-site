---
import Layout from "../../../layouts/Layout.astro";
import CelpipWritingBanner from "../../../components/CelpipWritingBanner.astro";
import { getCollection } from "astro:content";
import { getLessonTier, getPublicLessonTitle } from "../../../lib/lessonLevel";

const skillLessons = (
  await getCollection(
    "lessons",
    ({ data }) =>
      !data.draft &&
      data.exam.includes("CELPIP") &&
      ["speaking", "vocabulary", "grammar"].includes(data.category)
  )
)
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 10);
---

<Layout
  title="CELPIP Speaking | Fluency & Task Response Strategies | IELTS Corner"
  description="CELPIP speaking strategies for all tasks. Learn delivery techniques, templates, and how to manage time under pressure."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/speaking.png');`}>
      <div class="hero-content">
        <span class="pill">🗣️ CELPIP Speaking</span>
        <h1>Know what to say, speak clearly, score higher</h1>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <CelpipWritingBanner />
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-5);">
      <div class="cluster quick-nav">
        <a class="btn" href="/celpip">CELPIP Home</a>
        <a class="btn" href="/celpip/listening">Listening</a>
        <a class="btn" href="/celpip/reading">Reading</a>
        <a class="btn btn-primary" href="/celpip/speaking">Speaking</a>
        <a class="btn" href="/celpip/writing">Writing</a>
        <a class="btn" href="/lessons">All Lessons</a>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-6); border: 2px solid var(--accent);">
      <h2 style="margin-top: 0;">All CELPIP Speaking services in one place</h2>
      <p class="muted" style="margin-top: 0; max-width: 72ch;">
        Use this page as your speaking hub: free lessons, guided coaching, webinar training, and skill-building resources from one location.
      </p>

      <div class="grid grid-2" style="margin-top: var(--s-4);">
        <article class="card" style="display:flex; flex-direction:column; gap: var(--s-2);">
          <h3 style="margin: 0;">🎙️ Free Speaking Lessons</h3>
          <p class="muted" style="margin:0;">Task-by-task strategies, structure templates, and fluency support for CELPIP speaking.</p>
          <a class="btn btn-primary" href="/lessons/celpip/speaking">Browse speaking lessons →</a>
        </article>

        <article class="card" style="display:flex; flex-direction:column; gap: var(--s-2);">
          <h3 style="margin: 0;">🧑‍🏫 Private Speaking Coaching</h3>
          <p class="muted" style="margin:0;">One-on-one feedback on pronunciation, fluency, structure, and confidence under pressure.</p>
          <a class="btn" href="/tutoring">Book speaking coaching →</a>
        </article>

        <article class="card" style="display:flex; flex-direction:column; gap: var(--s-2);">
          <h3 style="margin: 0;">🎓 Weekly CELPIP Webinar</h3>
          <p class="muted" style="margin:0;">Live strategy sessions with practical examples and Q&A.</p>
          <a class="btn" href="/webinar">Join webinar sessions →</a>
        </article>

        <article class="card" style="display:flex; flex-direction:column; gap: var(--s-2);">
          <h3 style="margin: 0;">✍️ Add Writing Support</h3>
          <p class="muted" style="margin:0;">Build your full CELPIP score by combining speaking prep with writing practice and feedback.</p>
          <div class="cluster">
            <a class="btn" href="/celpip/writing">Writing hub →</a>
            <a class="btn" href="/celpip/writing/ai-feedback">AI score & analysis →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-6);">
      <h2>Popular CELPIP speaking guides</h2>
      <p class="muted" style="margin-top: 0; max-width: 68ch;">
        These task-level pages target the exact speaking queries learners search before choosing lessons or tutoring.
      </p>
      <div class="grid grid-2" style="gap: var(--s-3);">
        <a class="card" href="/blog/celpip-speaking-task-1" style="display:block; text-decoration:none;">
          <h3>CELPIP Speaking Task 1 Guide</h3>
          <p class="muted">How to structure personal-experience responses with stronger fluency and clarity.</p>
        </a>
        <a class="card" href="/blog/celpip-speaking-part2" style="display:block; text-decoration:none;">
          <h3>CELPIP Speaking Task 2 Guide</h3>
          <p class="muted">A focused strategy page for one of the most searched CELPIP speaking tasks.</p>
        </a>
      </div>
      <div class="grid grid-2" style="gap: var(--s-3); margin-top: var(--s-3);">
        <a class="card" href="/blog/celpip-speaking-task-2-opinion-strategy" style="display:block; text-decoration:none;">
          <h3>CELPIP Speaking Task 2 opinion strategy</h3>
          <p class="muted">A practical framework for position-first answers under short prep time.</p>
        </a>
        <a class="card" href="/blog/celpip-speaking-task-5-comparing-options" style="display:block; text-decoration:none;">
          <h3>CELPIP Speaking Task 5 comparing options</h3>
          <p class="muted">How to compare choices and justify one recommendation clearly.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="surface" style="padding: var(--s-6);">
      <h2>Related lessons for speaking improvement</h2>
      <p class="muted" style="margin-top: 0; max-width: 68ch;">
        These related CELPIP speaking, grammar, and vocabulary lessons make it easier to practice fluency with clear structure.
      </p>
      <div class="grid grid-2">
        {skillLessons.map((lesson) => (
          <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block;">
            <div class="cluster" style="justify-content: space-between;">
              <span class="pill">{lesson.data.category} • {getLessonTier(lesson.data.level)}</span>
              <span class="pill">Open →</span>
            </div>
            <h3 style="margin-top: var(--s-3);">{getPublicLessonTitle(lesson.data.title, lesson.data.level)}</h3>
            <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="stack" style="gap: var(--s-8);">
      <!-- Format breakdown -->
      <div class="surface" style="padding: var(--s-6);">
        <h2>CELPIP Speaking format (15–20 minutes, 8 tasks)</h2>
        <div class="grid grid-2">
          <div><h3>Task 1: Giving Advice</h3><p>Give practical advice for a situation.</p></div>
          <div><h3>Task 2: Talking about a Personal Experience</h3><p>Tell a clear, structured short story.</p></div>
          <div><h3>Task 3: Describing a Scene</h3><p>Describe an image so the listener can picture it.</p></div>
          <div><h3>Task 4: Making Predictions</h3><p>Predict what will happen next and explain why.</p></div>
          <div><h3>Task 5: Comparing and Persuading</h3><p>Choose one option and persuade the listener.</p></div>
          <div><h3>Task 6: Dealing with a Difficult Situation</h3><p>Respond politely and solve a real-life problem.</p></div>
          <div><h3>Task 7: Expressing Opinions</h3><p>Give your opinion with reasons and examples.</p></div>
          <div><h3>Task 8: Describing an Unusual Situation</h3><p>Explain clearly when the situation is surprising or unexpected.</p></div>
        </div>
      </div>

      <!-- Pro strategies -->
      <div class="surface" style="padding: var(--s-6);">
        <h2>CELPIP speaking pro strategies</h2>
        <div class="stack" style="gap: var(--s-4);">
          <div>
            <h4>✓ Use prep time for quick keywords</h4>
            <p>Write 3–4 key points only. Do not memorize full sentences.</p>
          </div>
          <div>
            <h4>✓ Extend your ideas with examples</h4>
            <p>In opinion and persuasion tasks, avoid one-sentence answers. Add "because" and one example.</p>
          </div>
          <div>
            <h4>✓ Don't panic about pauses</h4>
            <p>A 2–3 second pause is normal. Use it to think. Saying "ummm" or "like" too much hurts fluency more than silence does.</p>
          </div>
          <div>
            <h4>✓ Speak at natural pace, not too fast</h4>
            <p>Clear pronunciation matters more than speed. Slow down if you're nervous. The examiner can understand you better.</p>
          </div>
          <div>
            <h4>✓ Read Task 5 instructions very carefully</h4>
            <p>Task 5 has two screens. First you choose an option, then you prepare and speak on the next screen.</p>
          </div>
          <div>
            <h4>✓ Use transition phrases for fluency</h4>
            <p>Words like "First of all," "In addition," "However," "That's why" connect your ideas and make you sound more fluent.</p>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="surface" style="padding: var(--s-6);">
        <div class="stack" style="gap: var(--s-4); text-align: center;">
          <h2>Ready to boost your speaking confidence?</h2>
          <p class="muted">Practice with real CELPIP speaking tasks and get feedback on fluency and clarity.</p>
          <div class="cluster" style="justify-content: center;">
            <a class="btn btn-primary" href="/lessons/celpip/speaking">Free speaking lessons →</a>
            <a class="btn" href="/tutoring">Book speaking coaching →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
