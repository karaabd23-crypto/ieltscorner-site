---
import Layout from "../../../layouts/Layout.astro";
import SkillFreeLessons from "../../../components/SkillFreeLessons.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SkillSubNav from "../../../components/SkillSubNav.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP", path: "/celpip/" },
    { name: "Speaking", path: "/celpip/speaking/" },
  ]),
];
---

<Layout
  title="CELPIP Speaking Help | Book Private Class"
  description="Stuck in CELPIP speaking? Book one private class and improve fluency, structure, and response quality."
  keywords="CELPIP speaking help, CELPIP speaking coaching, CELPIP private class"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "CELPIP", href: "/celpip" },
    { label: "Speaking" },
  ]} />
  <SkillSubNav exam="CELPIP" currentSkill="speaking" />

  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/speaking.png');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill ic-eyebrow">CELPIP speaking support</span>
        <h1 class="ic-display">Stuck at CLB 6 or 7 in CELPIP Speaking?</h1>
        <p class="muted">
          Get one-to-one coaching to improve answer structure, fluency, and confidence
          across all CELPIP speaking tasks.
        </p>
        <div class="funnel-hero__actions">
          <a class="btn btn-primary ic-btn" href="/tutoring#book-private-class">Book Private Class</a>
        </div>
      </div>
    </div>
  </section>

  <SkillFreeLessons exam="CELPIP" skill="speaking" />

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 class="ic-display" style="margin-top: 0;">Your next step</h2>
      <p>Book one focused class and get live speaking correction in real time.</p>
      <div class="funnel-final-cta__actions">
        <a class="btn btn-primary" href="/tutoring#book-private-class">Book Private Class</a>
      </div>
    </div>
  </section>
</Layout>

