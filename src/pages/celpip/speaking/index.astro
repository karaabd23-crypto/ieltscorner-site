---
import Layout from "../../../layouts/Layout.astro";
import SkillFreeLessons from "../../../components/SkillFreeLessons.astro";
import SkillQuickFacts from "../../../components/SkillQuickFacts.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SkillSubNav from "../../../components/SkillSubNav.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP", path: "/celpip/" },
    { name: "Speaking", path: "/celpip/speaking/" },
  ]),
];
---

<Layout
  title="CELPIP Speaking | Free Guides, Strategies, and Coaching"
  description="Free CELPIP Speaking guides for all 8 tasks. CLB 7 to CLB 9 strategies, Task 7 and 8 transcripts, and private coaching when you want live feedback."
  keywords="CELPIP speaking help, CELPIP speaking coaching, CELPIP private class"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "CELPIP", href: "/celpip" },
    { label: "Speaking" },
  ]} />
  <SkillSubNav exam="CELPIP" currentSkill="speaking" />

  <section class="section">
    <div class="hero funnel-hero" style={`--hero-bg: url('/heroes/speaking.webp');`}>
      <div class="hero-content funnel-hero__content">
        <span class="pill ic-eyebrow">CELPIP speaking support</span>
        <h1 class="ic-display">CELPIP Speaking</h1>
        <p class="muted">Free lessons and strategy guides below. Private coaching also available.</p>
        <div class="funnel-hero__actions">
          <a class="btn btn-primary ic-btn" href="/blog/celpip-speaking-tasks-complete-guide/">Free speaking guide</a>
          <a class="btn btn-ghost" href="/blog/celpip-speaking-clb9-strategies/">CLB 7 to CLB 9 moves</a>
          <a class="btn btn-ghost" href="/tutoring#book-private-class">Book private class</a>
        </div>
      </div>
    </div>
  </section>

  <SkillQuickFacts
    heading="CELPIP Speaking at a glance"
    facts={[
      { value: "8", label: "speaking tasks" },
      { value: "~20 min", label: "total test time" },
      { value: "30–90s", label: "to answer each task" },
      { value: "CLB 9", label: "common target" },
    ]}
    focusPoints={[
      "Tasks 7 and 8 (opinion and difficult situation) carry the most weight, so practice them first.",
      "You score higher for clear organization and natural pace than for rare vocabulary.",
      "Use the short prep time to plan a position and one reason before you start speaking.",
    ]}
  />

  <SkillFreeLessons exam="CELPIP" skill="speaking" />

  <section class="section-sm">
    <div class="surface funnel-final-cta">
      <h2 class="ic-display" style="margin-top: 0;">Your next step</h2>
      <p>Book one focused class and get live speaking correction in real time.</p>
      <div class="funnel-final-cta__actions">
        <a class="btn btn-primary" href="/tutoring#book-private-class">Book Private Class</a>
      </div>
    </div>
  </section>
</Layout>

