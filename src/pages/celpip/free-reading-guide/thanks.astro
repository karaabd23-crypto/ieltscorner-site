---
import ConversionLayout from "../../../layouts/ConversionLayout.astro";
---

<ConversionLayout
  title="Guide Access Confirmed | CELPIP Reading"
  description="Your CELPIP reading guide access is confirmed."
  noindex={true}
>
  <section class="landing-shell instagram-lead-shell">
    <section class="landing-hero instagram-lead-hero">
      <p class="landing-eyebrow">Guide Access Confirmed</p>
      <h1>Your free CELPIP reading guide is ready.</h1>
      <p class="landing-subheadline">
        Open the guide now for the full strategy breakdown, mini drills, and 5-day action plan. Then check your inbox for future reading lessons and tips.
      </p>
      <div class="landing-hero__actions">
        <a
          class="btn btn-primary landing-cta"
          href="/celpip/reading-guide/"
          data-track-click="instagram-reading-guide-thanks-open-guide"
          data-track-page-type="landing"
          data-track-offer="lead_capture"
          data-track-test="celpip"
          data-track-skill="reading"
          data-track-position="hero"
        >
          Open The Guide
        </a>
      </div>
      <p class="instagram-lead-disclaimer">
        If you do not see the email, check your promotions or spam folder and move it to primary.
      </p>
    </section>

    <section class="landing-section">
      <p class="landing-eyebrow">Keep Momentum</p>
      <h2>Keep building your CELPIP Reading score</h2>
      <p class="muted">
        Use the weekly digest and CELPIP reading lessons to keep improving after this guide.
      </p>
      <div class="landing-offer-grid instagram-lead-next-grid">
        <article class="landing-offer">
          <h3>CELPIP Reading Lessons</h3>
          <p>Continue with focused reading lessons to improve strategy, timing, and accuracy.</p>
          <a
            class="btn btn-ghost"
            href="/celpip/reading/"
            data-track-click="instagram-reading-guide-thanks-reading-lessons"
            data-track-page-type="landing"
            data-track-offer="reading_lessons"
            data-track-test="celpip"
            data-track-skill="reading"
            data-track-position="mid"
          >
            See more reading lessons
          </a>
        </article>

        <article class="landing-offer">
          <h3>CELPIP Webinar</h3>
          <p>Join a guided session focused on real CELPIP question traps.</p>
          <a
            class="btn btn-ghost"
            href="/webinar/"
            data-track-click="instagram-reading-guide-thanks-webinar"
            data-track-page-type="landing"
            data-track-offer="weekly_training"
            data-track-test="celpip"
            data-track-skill="reading"
            data-track-position="mid"
          >
            View Webinar
          </a>
        </article>

        <article class="landing-offer">
          <h3>Private Tutoring</h3>
          <p>Book one focused class to fix your exact reading weak points.</p>
          <a
            class="btn btn-ghost"
            href="/tutoring/"
            data-track-click="instagram-reading-guide-thanks-tutoring"
            data-track-page-type="landing"
            data-track-offer="tutoring"
            data-track-test="celpip"
            data-track-skill="reading"
            data-track-position="mid"
          >
            View Tutoring
          </a>
        </article>
      </div>
    </section>
  </section>
</ConversionLayout>
