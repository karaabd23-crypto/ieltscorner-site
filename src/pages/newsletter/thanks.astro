---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Newsletter Subscription Confirmed — IELTS Corner"
  description="Your newsletter subscription has been received."
  type="page"
>
  <section class="section" style="padding-top: var(--s-6);">
    <div class="shell" style="max-width: 760px; margin: 0 auto;">
      <div class="surface" style="padding: var(--s-4); border-radius: 10px; text-align: center;">
        <h1 style="margin-top: 0;">You’re subscribed ✅</h1>
        <p style="color: var(--text-muted); margin-bottom: var(--s-3);">
          Thanks for joining our newsletter. We’ll send IELTS/CELPIP tips and updates to your inbox.
        </p>
        <a href="/" class="btn btn-primary" style="text-decoration: none;">Back to home</a>
      </div>
    </div>
  </section>
</Layout>
