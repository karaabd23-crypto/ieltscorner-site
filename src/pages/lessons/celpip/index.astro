---
import Layout from "../../../layouts/Layout.astro";
import CelpipWritingBanner from "../../../components/CelpipWritingBanner.astro";
import { getCollection } from "astro:content";
import { getLessonTier, getPublicLessonTitle } from "../../../lib/lessonLevel";

const PREVIEW = 6; // lessons shown per skill before "See all"

const celpipLessons = await getCollection(
  "lessons",
  ({ data }) => !data.draft && data.exam.includes("CELPIP")
);

const bySkill = (cat: string) =>
  celpipLessons
    .filter(({ data }) => data.category === cat)
    .sort((a, b) => (a.data.date < b.data.date ? 1 : -1));

const writing  = bySkill("writing");
const speaking = bySkill("speaking");
const listening= bySkill("listening");
const reading  = bySkill("reading");
---

<Layout
  title="CELPIP Lessons — IELTS Corner"
  description="CELPIP lessons for Writing, Speaking, Listening, and Reading. CLB 7+ focused and strategy-based."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/lesson.png');`}>
      <div class="hero-content">
        <span class="pill">🍁 CELPIP Lessons</span>
        <h1>All CELPIP lessons in one place.</h1>
        <div class="cluster">
          <a class="btn btn-primary" href="/lessons">← All lessons</a>
          <a class="btn btn-ghost" href="/webinar">Live webinars →</a>
        </div>
      </div>
    </div>

    <div style="height: var(--s-5);"></div>

    <CelpipWritingBanner />

    <div style="height: var(--s-7);"></div>

    <!-- QUICK NAV -->
    <div class="surface" style="padding: var(--s-4);">
      <div class="cluster">
        <a class="btn btn-primary" href="#writing">✍️ Writing</a>
        <a class="btn" href="#speaking">🎤 Speaking</a>
        <a class="btn" href="#listening">🎧 Listening</a>
        <a class="btn" href="#reading">📖 Reading</a>
      </div>
    </div>

    <div style="height: var(--s-7);"></div>

    <!-- WRITING -->
    <h2 id="writing" style="scroll-margin-top: var(--s-6);">✍️ Writing</h2>
    {writing.length > 0 ? (
      <>
        <div class="grid grid-2">
          {writing.slice(0, PREVIEW).map((lesson) => (
            <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block; text-decoration:none;">
              <div class="cluster" style="justify-content: space-between;">
                <span class="pill">{getLessonTier(lesson.data.level)}</span>
                <span class="pill">Open →</span>
              </div>
              <h3 style="margin-top: var(--s-3);">{getPublicLessonTitle(lesson.data.title, lesson.data.level)}</h3>
              <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
            </a>
          ))}
        </div>
        {writing.length > PREVIEW && (
          <div style="margin-top: var(--s-4);">
            <a class="btn" href="/lessons/celpip/writing">See all {writing.length} writing lessons →</a>
          </div>
        )}
      </>
    ) : (
      <p class="muted">No writing lessons yet — check back soon.</p>
    )}

    <div style="height: var(--s-7);"></div>

    <!-- SPEAKING -->
    <h2 id="speaking" style="scroll-margin-top: var(--s-6);">🎤 Speaking</h2>
    {speaking.length > 0 ? (
      <>
        <div class="grid grid-2">
          {speaking.slice(0, PREVIEW).map((lesson) => (
            <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block; text-decoration:none;">
              <div class="cluster" style="justify-content: space-between;">
                <span class="pill">{getLessonTier(lesson.data.level)}</span>
                <span class="pill">Open →</span>
              </div>
              <h3 style="margin-top: var(--s-3);">{getPublicLessonTitle(lesson.data.title, lesson.data.level)}</h3>
              <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
            </a>
          ))}
        </div>
        {speaking.length > PREVIEW && (
          <div style="margin-top: var(--s-4);">
            <a class="btn" href="/lessons/celpip/speaking">See all {speaking.length} speaking lessons →</a>
          </div>
        )}
      </>
    ) : (
      <p class="muted">No speaking lessons yet — check back soon.</p>
    )}

    <div style="height: var(--s-7);"></div>

    <!-- LISTENING -->
    <h2 id="listening" style="scroll-margin-top: var(--s-6);">🎧 Listening</h2>
    {listening.length > 0 ? (
      <>
        <div class="grid grid-2">
          {listening.slice(0, PREVIEW).map((lesson) => (
            <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block; text-decoration:none;">
              <div class="cluster" style="justify-content: space-between;">
                <span class="pill">{getLessonTier(lesson.data.level)}</span>
                <span class="pill">Open →</span>
              </div>
              <h3 style="margin-top: var(--s-3);">{getPublicLessonTitle(lesson.data.title, lesson.data.level)}</h3>
              <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
            </a>
          ))}
        </div>
        {listening.length > PREVIEW && (
          <div style="margin-top: var(--s-4);">
            <a class="btn" href="/lessons/celpip/listening">See all {listening.length} listening lessons →</a>
          </div>
        )}
      </>
    ) : (
      <p class="muted">No listening lessons yet — check back soon.</p>
    )}

    <div style="height: var(--s-7);"></div>

    <!-- READING -->
    <h2 id="reading" style="scroll-margin-top: var(--s-6);">📖 Reading</h2>
    {reading.length > 0 ? (
      <>
        <div class="grid grid-2">
          {reading.slice(0, PREVIEW).map((lesson) => (
            <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block; text-decoration:none;">
              <div class="cluster" style="justify-content: space-between;">
                <span class="pill">{getLessonTier(lesson.data.level)}</span>
                <span class="pill">Open →</span>
              </div>
              <h3 style="margin-top: var(--s-3);">{getPublicLessonTitle(lesson.data.title, lesson.data.level)}</h3>
              <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
            </a>
          ))}
        </div>
        {reading.length > PREVIEW && (
          <div style="margin-top: var(--s-4);">
            <a class="btn" href="/lessons/celpip/reading">See all {reading.length} reading lessons →</a>
          </div>
        )}
      </>
    ) : (
      <p class="muted">No reading lessons yet — check back soon.</p>
    )}

    <div style="height: var(--s-8);"></div>

    <div class="surface feature">
      <div class="feature-grid">
        <div class="stack">
          <h2>Want live training?</h2>
          <p class="muted" style="max-width: 58ch;">
            Lessons build understanding — but live webinars give you real-time feedback and strategy guidance.
          </p>
          <div class="cluster">
            <a class="btn btn-primary" href="/webinar">See webinars →</a>
            <a class="btn" href="/tutoring">One-on-one tutoring →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
