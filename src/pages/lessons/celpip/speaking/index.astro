---
import Layout from "../../../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allLessons = (
  await getCollection(
    "lessons",
    ({ data }) => !data.draft && data.exam.includes("CELPIP") && data.category === "speaking"
  )
).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));

const relatedLessons = (
  await getCollection(
    "lessons",
    ({ data }) =>
      !data.draft &&
      data.exam.includes("CELPIP") &&
      ["grammar", "vocabulary"].includes(data.category)
  )
)
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 6);
---

<Layout
  title="CELPIP Speaking Lessons — IELTS Corner"
  description="CELPIP Speaking lessons: task strategies, natural delivery, and coherent responses for CLB 7+."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/lesson.png');`}>
      <div class="hero-content">
        <span class="pill">🎤 CELPIP Speaking</span>
        <h1>Speak clearly. Think quickly. Score high.</h1>

        <p class="muted" style="max-width: 60ch;">
          CELPIP Speaking has 8 tasks. Each has a different format. Learn the structure first, then practice delivery,
          and watch your score jump.
        </p>

        <div class="cluster">
          <a class="btn btn-primary" href="/lessons/celpip">Back to CELPIP lessons →</a>
          <a class="btn btn-ghost" href="/webinar">Webinars →</a>
        </div>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <section class="section-sm">
      <div class="surface" style="padding: var(--s-5);">
        <div class="cluster quick-nav">
          <a class="btn" href="/lessons/celpip">CELPIP Home</a>
          <a class="btn btn-primary" href="/lessons/celpip/speaking">Speaking</a>
          <a class="btn" href="/lessons/celpip/listening">Listening</a>
          <a class="btn" href="/lessons/celpip/reading">Reading</a>
          <a class="btn" href="/lessons/celpip/writing">Writing</a>
          <a class="btn" href="/lessons">All Lessons</a>
        </div>
      </div>
    </section>

    <div class="grid grid-2">
      <div class="card">
        <h3>The 8 tasks</h3>
        <p class="muted">
          Tasks 1–6 are straightforward. Tasks 7–8 are hybrid (you read, hear, then speak). Each gets easier when
          you know the format first.
        </p>
      </div>

      <div class="card">
        <h3>What scores you</h3>
        <p class="muted">
          Fluency, accuracy, vocabulary breadth, and pronunciation. You don't need a perfect accent — you need clear
          delivery and confident pacing.
        </p>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <h2>CELPIP Speaking Lessons</h2>
    {allLessons.length > 0 ? (
      <div class="grid grid-2">
        {allLessons.map((lesson) => (
          <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block;">
            <div class="cluster" style="justify-content: space-between;">
              <span class="pill">{lesson.data.level}</span>
              <span class="pill">Open →</span>
            </div>
            <h3 style="margin-top: var(--s-3);">{lesson.data.title}</h3>
            <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
          </a>
        ))}
      </div>
    ) : (
      <div class="surface" style="padding: var(--s-5); text-align: center;">
        <p class="muted">No CELPIP Speaking lessons yet. Check back soon!</p>
      </div>
    )}

    {relatedLessons.length > 0 && (
      <>
        <div style="height: var(--s-8);"></div>

        <h2>Related CELPIP lessons</h2>
        <p class="muted" style="max-width: 70ch;">
          Use these grammar and vocabulary lessons to strengthen the patterns that appear in CELPIP speaking tasks.
        </p>

        <div class="grid grid-2">
          {relatedLessons.map((lesson) => (
            <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block;">
              <div class="cluster" style="justify-content: space-between;">
                <span class="pill">{lesson.data.category} • {lesson.data.level}</span>
                <span class="pill">Open →</span>
              </div>
              <h3 style="margin-top: var(--s-3);">{lesson.data.title}</h3>
              <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
            </a>
          ))}
        </div>
      </>
    )}
  </section>
</Layout>
