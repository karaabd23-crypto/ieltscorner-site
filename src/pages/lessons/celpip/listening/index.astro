---
import Layout from "../../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getLessonTier, getPublicLessonTitle } from "../../../../lib/lessonLevel";

const allLessons = (
  await getCollection(
    "lessons",
    ({ data }) => !data.draft && data.exam.includes("CELPIP") && data.category === "listening"
  )
).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));

const relatedLessons = (
  await getCollection(
    "lessons",
    ({ data }) =>
      !data.draft &&
      data.exam.includes("CELPIP") &&
      ["grammar", "vocabulary"].includes(data.category)
  )
)
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 6);
---

<Layout
  title="CELPIP Listening Lessons — IELTS Corner"
  description="CELPIP Listening lessons: comprehension, note-taking, and accuracy strategies for CLB 7+."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/lesson.png');`}>
      <div class="hero-content">
        <span class="pill">🎧 CELPIP Listening</span>
        <h1>Listen faster. Catch the details. Score high.</h1>

        <div class="cluster">
          <a class="btn btn-primary" href="/lessons/celpip">Back to CELPIP lessons →</a>
          <a class="btn btn-ghost" href="/webinar">Webinars →</a>
        </div>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <section class="section-sm">
      <div class="surface" style="padding: var(--s-5);">
        <div class="cluster quick-nav">
          <a class="btn" href="/lessons/celpip">CELPIP Home</a>
          <a class="btn btn-primary" href="/lessons/celpip/listening">Listening</a>
          <a class="btn" href="/lessons/celpip/reading">Reading</a>
          <a class="btn" href="/lessons/celpip/speaking">Speaking</a>
          <a class="btn" href="/lessons/celpip/writing">Writing</a>
          <a class="btn" href="/lessons">All Lessons</a>
        </div>
      </div>
    </section>

    <div class="grid grid-2">
      <div class="card">
        <h3>Format & timing</h3>
        <p class="muted">
          47–55 minutes total with 6 parts. Most are conversations: lecture, casual chat, interview,
          announcement, or short Q&A. You hear each once.
        </p>
      </div>

      <div class="card">
        <h3>What scores you</h3>
        <p class="muted">
          Accurate note-taking, fast scanning of questions, and picking answers that match the exact words
          or clear meaning. Context matters.
        </p>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <h2>CELPIP Listening Lessons</h2>
    {allLessons.length > 0 ? (
      <div class="grid grid-2">
        {allLessons.map((lesson) => (
          <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block;">
            <div class="cluster" style="justify-content: space-between;">
              <span class="pill">{getLessonTier(lesson.data.level)}</span>
              <span class="pill">Open →</span>
            </div>
            <h3 style="margin-top: var(--s-3);">{getPublicLessonTitle(lesson.data.title, lesson.data.level)}</h3>
            <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
          </a>
        ))}
      </div>
    ) : (
      <div class="surface" style="padding: var(--s-5); text-align: center;">
        <p class="muted">No CELPIP Listening lessons yet. Check back soon!</p>
      </div>
    )}

    {relatedLessons.length > 0 && (
      <>
        <div style="height: var(--s-8);"></div>

        <h2>Related CELPIP lessons</h2>
        <p class="muted" style="max-width: 70ch;">
          Use these grammar and vocabulary lessons to strengthen the patterns that appear in CELPIP listening tasks.
        </p>

        <div class="grid grid-2">
          {relatedLessons.map((lesson) => (
            <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block;">
              <div class="cluster" style="justify-content: space-between;">
                <span class="pill">{lesson.data.category} • {getLessonTier(lesson.data.level)}</span>
                <span class="pill">Open →</span>
              </div>
              <h3 style="margin-top: var(--s-3);">{getPublicLessonTitle(lesson.data.title, lesson.data.level)}</h3>
              <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
            </a>
          ))}
        </div>
      </>
    )}
  </section>
</Layout>
