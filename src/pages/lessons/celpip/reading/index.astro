---
import Layout from "../../../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allLessons = (
  await getCollection(
    "lessons",
    ({ data }) => !data.draft && data.exam.includes("CELPIP")
  )
)
  .filter(({ data }) => data.category === "reading")
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1));

const relatedLessons = (
  await getCollection(
    "lessons",
    ({ data }) =>
      !data.draft &&
      data.exam.includes("CELPIP") &&
      ["grammar", "vocabulary"].includes(data.category)
  )
)
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 6);
---

<Layout
  title="CELPIP Reading Lessons — IELTS Corner"
  description="CELPIP Reading lessons: scanning, inference, and accuracy strategies for CLB 7+."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/lesson.png');`}>
      <div class="hero-content">
        <span class="pill">📖 CELPIP Reading</span>
        <h1>Read faster. Answer accurately. Score high.</h1>

        <p class="muted" style="max-width: 60ch;">
          CELPIP Reading contains workplace, academic, and personal texts. You win by scanning for keywords, understanding
          context, and matching answers to proof in the text.
        </p>

        <div class="cluster">
          <a class="btn btn-primary" href="/lessons/celpip">Back to CELPIP lessons →</a>
          <a class="btn btn-ghost" href="/webinar">Webinars →</a>
        </div>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <section class="section-sm">
      <div class="surface" style="padding: var(--s-5);">
        <div class="cluster quick-nav">
          <a class="btn" href="/lessons/celpip">CELPIP Home</a>
          <a class="btn" href="/lessons/celpip/listening">Listening</a>
          <a class="btn btn-primary" href="/lessons/celpip/reading">Reading</a>
          <a class="btn" href="/lessons/celpip/speaking">Speaking</a>
          <a class="btn" href="/lessons/celpip/writing">Writing</a>
          <a class="btn" href="/lessons">All Lessons</a>
        </div>
      </div>
    </section>

    <div class="grid grid-2">
      <div class="card">
        <h3>Format & timing</h3>
        <p class="muted">
          55–60 minutes total with 4 parts. You read workplace emails, schedules, articles, and advertisements.
          Questions test comprehension and inference.
        </p>
      </div>

      <div class="card">
        <h3>What scores you</h3>
        <p class="muted">
          Finding exact details, inferring meaning from context, and recognizing synonyms and paraphrases.
          Time management is critical.
        </p>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <h2>CELPIP Reading Lessons</h2>
    {allLessons.length > 0 ? (
      <div class="grid grid-2">
        {allLessons.map((lesson) => (
          <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block;">
            <div class="cluster" style="justify-content: space-between;">
              <span class="pill">{lesson.data.level}</span>
              <span class="pill">Open →</span>
            </div>
            <h3 style="margin-top: var(--s-3);">{lesson.data.title}</h3>
            <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
          </a>
        ))}
      </div>
    ) : (
      <div class="surface" style="padding: var(--s-5); text-align: center;">
        <p class="muted">No CELPIP Reading lessons yet. Check back soon!</p>
      </div>
    )}

    {relatedLessons.length > 0 && (
      <>
        <div style="height: var(--s-8);"></div>

        <h2>Related CELPIP lessons</h2>
        <p class="muted" style="max-width: 70ch;">
          Use these grammar and vocabulary lessons to strengthen the patterns that appear in CELPIP reading texts.
        </p>

        <div class="grid grid-2">
          {relatedLessons.map((lesson) => (
            <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block;">
              <div class="cluster" style="justify-content: space-between;">
                <span class="pill">{lesson.data.category} • {lesson.data.level}</span>
                <span class="pill">Open →</span>
              </div>
              <h3 style="margin-top: var(--s-3);">{lesson.data.title}</h3>
              <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
            </a>
          ))}
        </div>
      </>
    )}
  </section>
</Layout>
