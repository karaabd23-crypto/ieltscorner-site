---
import ContentAd from "../../../components/ContentAd.astro";
import LeadCaptureForm from "../../../components/LeadCaptureForm.astro";
import InArticleAd from "../../../components/InArticleAd.astro";
import LeadMagnetCard from "../../../components/LeadMagnetCard.astro";
import OfferLadderBlock from "../../../components/OfferLadderBlock.astro";
import OfferSequenceBlock from "../../../components/OfferSequenceBlock.astro";
import Layout from "../../../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { getLessonTier, getPublicLessonTitle } from "../../../lib/lessonLevel";

type LessonEntry = CollectionEntry<"lessons">;
type GuideLink = {
  title: string;
  href: string;
  description: string;
};

type ServiceLink = {
  title: string;
  href: string;
  description: string;
};

type CtaBlock = {
  kicker: string;
  text: string;
  href: string;
  offer: string;
};

type LeadMagnetBlock = {
  headline: string;
  bullets: string[];
  formName: string;
  formType: string;
  successPath: string;
  magnetId: string;
  buttonLabel: string;
};

const categories: LessonEntry["data"]["category"][] = [
  "grammar",
  "vocabulary",
  "writing",
  "speaking",
  "listening",
  "reading",
];

const categoryLabel = (value: LessonEntry["data"]["category"]) =>
  value[0].toUpperCase() + value.slice(1);

const cleanHeadingText = (text: string) =>
  text
    .replace(/\p{Extended_Pictographic}/gu, "")
    .replace(/\u00E2\u20AC\u00A2|\u00C2|[•·]/g, "")
    .replace(/\s{2,}/g, " ")
    .trim();

const getLessonTests = (lesson: LessonEntry): ("IELTS" | "CELPIP")[] => {
  if (lesson.data.test) return [lesson.data.test];
  return lesson.data.exam;
};

const getLessonSkill = (lesson: LessonEntry) => lesson.data.skill ?? lesson.data.category;

const toTimeValue = (dateValue: string) => {
  const parsed = Date.parse(dateValue);
  return Number.isNaN(parsed) ? 0 : parsed;
};

export async function getStaticPaths() {
  const items = await getCollection(
    "lessons",
    ({ data }: { data: LessonEntry["data"] }) => !data.draft
  );

  return items.map((item: LessonEntry) => ({
    params: { category: item.data.category, slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props as { item: LessonEntry };
const { Content, headings } = await item.render();
const publicTitle = getPublicLessonTitle(item.data.title, item.data.level);
const currentCategory = item.data.category;
const slugText = item.slug.toLowerCase();

const allLessons = await getCollection("lessons", ({ data }) => !data.draft);
const sameCategoryLessons = allLessons
  .filter((lesson) => lesson.data.category === currentCategory)
  .sort((a, b) => (toTimeValue(b.data.date) - toTimeValue(a.data.date)));

const currentIndex = sameCategoryLessons.findIndex((lesson) => lesson.slug === item.slug);
const newerLesson = currentIndex > 0 ? sameCategoryLessons[currentIndex - 1] : null;
const olderLesson =
  currentIndex >= 0 && currentIndex < sameCategoryLessons.length - 1
    ? sameCategoryLessons[currentIndex + 1]
    : null;

const currentTests = getLessonTests(item);
const currentSkill = getLessonSkill(item);
const currentTestSet = new Set(currentTests);

const relatedCandidates = allLessons
  .filter((lesson) => lesson.slug !== item.slug)
  .map((lesson) => {
    const candidateTests = getLessonTests(lesson);
    const candidateSkill = getLessonSkill(lesson);
    const sharedTests = candidateTests.filter((test) => currentTestSet.has(test));
    const skillMatch = candidateSkill === currentSkill;
    const categoryMatch = lesson.data.category === currentCategory;

    let score = 0;
    if (sharedTests.length > 0) score += 4;
    if (skillMatch) score += 4;
    if (categoryMatch) score += 2;

    return { lesson, score };
  })
  .filter((itemScore) => itemScore.score > 0)
  .sort((a, b) => b.score - a.score || toTimeValue(b.lesson.data.date) - toTimeValue(a.lesson.data.date));

const relatedLessons: LessonEntry[] = [];
for (const candidate of relatedCandidates) {
  if (relatedLessons.length >= 2) break;
  if (relatedLessons.some((lesson) => lesson.slug === candidate.lesson.slug)) continue;
  relatedLessons.push(candidate.lesson);
}

if (relatedLessons.length < 2) {
  for (const fallbackLesson of sameCategoryLessons) {
    if (fallbackLesson.slug === item.slug) continue;
    if (relatedLessons.some((lesson) => lesson.slug === fallbackLesson.slug)) continue;
    relatedLessons.push(fallbackLesson);
    if (relatedLessons.length >= 2) break;
  }
}

const currentPathHint = `${currentCategory}-${slugText}`;
const likelyCelpip =
  currentTests.includes("CELPIP") &&
  (!currentTests.includes("IELTS") || currentPathHint.includes("celpip"));

const serviceLink: ServiceLink = likelyCelpip
  ? {
      title: "CELPIP Writing Help",
      href: "/celpip-writing-help",
      description: "Reach CLB 9 faster with live training, tutoring, and essay correction.",
    }
  : {
      title: "IELTS Writing Help",
      href: "/ielts-writing-help",
      description: "Get Band 7+ faster with structured feedback and targeted writing support.",
    };

const isWritingLesson = currentSkill === "writing" || currentCategory === "writing";
const trackTest = likelyCelpip ? "celpip" : currentTests.includes("IELTS") ? "ielts" : "general";
const readingRescueLesson = likelyCelpip && currentSkill === "reading";
const showIntentStack = isWritingLesson || readingRescueLesson;
const ladderSkill = readingRescueLesson ? "reading" : "writing";
const showBottomLessonAd = !showIntentStack;

const leadMagnetBlock: LeadMagnetBlock | null = readingRescueLesson
  ? {
      headline: "CELPIP Reading CLB 6->8 Mistake Checklist",
      bullets: [
        "Catch distractor and inference traps before they steal points.",
        "Use a timing map that protects accuracy in the final section.",
        "Apply an error-review loop that turns misses into score gains.",
      ],
      formName: "lead-magnet-celpip-reading-checklist",
      formType: "lead_magnet_celpip_reading_checklist",
      successPath: "/thank-you/celpip-reading-checklist/",
      magnetId: "celpip_reading_clb6_to_8_checklist",
      buttonLabel: "Send Me The Reading Checklist",
    }
  : isWritingLesson
    ? likelyCelpip
      ? {
          headline: "CELPIP Writing Score-Boost Checklist",
          bullets: [
            "Run a pre-write task-coverage check before your timer starts.",
            "Use tone and structure checks that prevent CLB-limiting errors.",
            "Apply a final revision sequence for cleaner grammar and clarity.",
          ],
          formName: "lead-magnet-celpip-writing-score-boost-checklist",
          formType: "lead_magnet_celpip_writing_score_boost_checklist",
          successPath: "/thank-you/celpip-writing-score-boost/",
          magnetId: "celpip_writing_score_boost_checklist",
          buttonLabel: "Send Me The Score-Boost Checklist",
        }
      : {
          headline: "IELTS Writing Band 7+ Structure Guide",
          bullets: [
            "Use a paragraph plan that keeps your response coherent under pressure.",
            "Avoid the structure mistakes that cap Task 2 scores around Band 6.",
            "Apply a fast final check for grammar, support, and task response.",
          ],
          formName: "lead-magnet-ielts-writing-structure-guide",
          formType: "lead_magnet_ielts_writing_structure_guide",
          successPath: "/thank-you/ielts-writing-structure-guide/",
          magnetId: "ielts_writing_band7_structure_guide",
          buttonLabel: "Send Me The Band 7+ Guide",
        }
    : null;

const midLessonCta: CtaBlock = isWritingLesson
  ? likelyCelpip
    ? {
        kicker: "CELPIP Writing Rescue",
        text: "Want direct feedback on your CELPIP writing? Get one essay corrected with score-focused comments.",
        href: "/essay-correction?src=lesson-mid-celpip-writing",
        offer: "essay_correction",
      }
    : {
        kicker: "IELTS Writing Rescue",
        text: "Get Band 7+ writing feedback on one essay and stop repeating hidden scoring mistakes.",
        href: "/essay-correction?src=lesson-mid-ielts-writing",
        offer: "essay_correction",
      }
  : likelyCelpip
    ? {
        kicker: "Live CELPIP Support",
        text: "Fix your next CELPIP weak point in this week's live training session.",
        href: "/webinar?src=lesson-mid-celpip",
        offer: "weekly_training",
      }
    : {
        kicker: "Live IELTS Support",
        text: "Join live training to fix the patterns that keep your IELTS score from moving.",
        href: "/webinar?src=lesson-mid-ielts",
        offer: "weekly_training",
      };

const endLessonCta: CtaBlock = isWritingLesson
  ? likelyCelpip
    ? {
        kicker: "Personal Essay Feedback",
        text: "Submit one CELPIP essay for detailed grammar, structure, and score-focused correction.",
        href: "/essay-correction?src=lesson-end-celpip-writing",
        offer: "essay_correction",
      }
    : {
        kicker: "Personal Essay Feedback",
        text: "Submit one IELTS essay for detailed grammar, structure, and Band-focused correction.",
        href: "/essay-correction?src=lesson-end-ielts-writing",
        offer: "essay_correction",
      }
  : likelyCelpip
    ? {
        kicker: "Personalized Coaching",
        text: "Need faster CELPIP improvement? Book a focused 1:1 strategy session.",
        href: "/tutoring?src=lesson-end-celpip",
        offer: "tutoring",
      }
    : {
        kicker: "Personalized Coaching",
        text: "Need faster IELTS improvement? Book a focused 1:1 strategy session.",
        href: "/tutoring?src=lesson-end-ielts",
        offer: "tutoring",
      };

const guideLinks: GuideLink[] = [];
const seenGuideHrefs = new Set<string>();

const addGuide = (guide: GuideLink) => {
  if (seenGuideHrefs.has(guide.href)) return;
  seenGuideHrefs.add(guide.href);
  guideLinks.push(guide);
};

if (item.data.exam.includes("IELTS")) {
  if (currentCategory === "writing") {
    addGuide({
      title: "IELTS Writing Task 2 Structure",
      href: "/blog/ielts-writing-task-2-structure",
      description: "Essay format, paragraph control, and timing structure for stable scores.",
    });
    addGuide({
      title: "How to Get Band 7 in IELTS Writing",
      href: "/blog/band-7-writing-strategy",
      description: "A focused strategy guide for moving from Band 6 to Band 7+.",
    });
  }

  if (currentCategory === "speaking") {
    addGuide({
      title: "IELTS Speaking Part 2 Cue Card Guide",
      href: "/blog/ielts-speaking-part-2-cue-card",
      description: "How to use 1-minute prep time and maintain coherent 2-minute answers.",
    });
    addGuide({
      title: "IELTS Speaking Part 1 Topics Guide",
      href: "/blog/ielts-speaking-part-1-topics",
      description: "Natural, score-safe approaches for short personal topic questions.",
    });
  }

  if (currentCategory === "reading") {
    addGuide({
      title: "IELTS Reading Question Types Guide",
      href: "/blog/ielts-reading-question-types",
      description: "Question-type strategy for matching, completion, and T/F/NG tasks.",
    });
  }
}

if (item.data.exam.includes("CELPIP")) {
  if (currentCategory === "writing") {
    addGuide({
      title: "CELPIP Writing Task 1 Email Guide",
      href: "/blog/celpip-writing-task-1-email",
      description: "Tone, structure, and prompt coverage for stronger Task 1 responses.",
    });
    addGuide({
      title: "CELPIP Writing Task 2 Survey Response Guide",
      href: "/blog/celpip-writing-task-2-survey-response",
      description: "Position, support, and paragraph flow for Task 2 clarity.",
    });
    addGuide({
      title: "CELPIP Sample Answers Guide",
      href: "/blog/celpip-sample-answers",
      description: "How to use model answers strategically without memorization traps.",
    });
  }

  if (currentCategory === "speaking") {
    addGuide({
      title: "CELPIP Speaking Hub",
      href: "/celpip/speaking",
      description: "Open all task guides, lessons, and speaking support in one place.",
    });

    if (slugText.includes("task1-experience")) {
      addGuide({
        title: "CELPIP Speaking Task 2 Guide",
        href: "/celpip/speaking/task-2-personal-experience",
        description: "Tell a personal experience clearly with a simple story frame.",
      });
    } else if (slugText.includes("task2-opinion")) {
      addGuide({
        title: "CELPIP Speaking Task 7 Guide",
        href: "/celpip/speaking/task-7-opinion",
        description: "Express opinions clearly with reasons that are easy to follow.",
      });
    } else if (slugText.includes("task3-interview")) {
      addGuide({
        title: "CELPIP Speaking Format Guide",
        href: "/celpip/speaking",
        description: "See the official task order, including Task 3 scene description.",
      });
    } else {
      addGuide({
        title: "CELPIP Speaking Task 1 Guide",
        href: "/celpip/speaking/task-1-advice",
        description: "Give practical advice clearly and sound helpful, not generic.",
      });
      addGuide({
        title: "CELPIP Speaking Task 5 Guide",
        href: "/celpip/speaking/task-5-comparison",
        description: "Compare options clearly and recommend the better choice.",
      });
    }
  }
}

if (slugText.includes("task1") && currentCategory === "writing") {
  addGuide({
    title: "CELPIP Writing Task 1 Email Guide",
    href: "/blog/celpip-writing-task-1-email",
    description: "Specific guidance for email tasks and semi-formal tone control.",
  });
}

if (slugText.includes("task2") && currentCategory === "writing") {
  addGuide({
    title: "IELTS Writing Task 2 Structure",
    href: "/blog/ielts-writing-task-2-structure",
    description: "A reliable blueprint for essay structure, paragraph control, and timing.",
  });
}

if (slugText.includes("part1") && currentCategory === "speaking") {
  addGuide({
    title: "IELTS Speaking Part 1 Topics Guide",
    href: "/blog/ielts-speaking-part-1-topics",
    description: "Practical development techniques for short speaking prompts.",
  });
}

if (slugText.includes("part2") && currentCategory === "speaking") {
  addGuide({
    title: "IELTS Speaking Part 2 Cue Card Guide",
    href: "/blog/ielts-speaking-part-2-cue-card",
    description: "How to plan, extend, and close long-turn answers naturally.",
  });
}

// SEO: Structured Data for Lesson
const lessonSchema = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  "name": publicTitle,
  "description": item.data.excerpt,
  "educationalLevel": item.data.level,
  "teaches": item.data.category,
  "audience": {
    "@type": "EducationalAudience",
    "educationalRole": "student",
  },
  "provider": {
    "@type": "EducationalOrganization",
    "name": "IELTS Corner",
    "url": Astro.site,
  },
  "datePublished": item.data.date,
  "inLanguage": "en-CA",
  "learningResourceType": "lesson",
  "isAccessibleForFree": true,
};

// SEO: Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": Astro.site,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Lessons",
      "item": new URL("/lessons", Astro.site),
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": categoryLabel(currentCategory),
      "item": new URL(`/lessons/${currentCategory}`, Astro.site),
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": publicTitle,
      "item": new URL(`/lessons/${currentCategory}/${item.slug}`, Astro.site),
    },
  ],
};

// Enhanced meta keywords for SEO
const seoKeywords = `${publicTitle}, ${item.data.category}, ${item.data.level}, ${item.data.exam.join(", ")}, IELTS lessons, CELPIP lessons, English test preparation`;
---

<Layout
  title={publicTitle}
  description={item.data.excerpt}
  keywords={seoKeywords}
  type="article"
  canonical={`/lessons/${currentCategory}/${item.slug}/`}
>
  <!-- Structured Data Scripts -->
  <script type="application/ld+json" set:html={JSON.stringify(lessonSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <section class="section">
    <div class="stack">
      <!-- SEO Breadcrumbs -->
      <nav aria-label="Breadcrumb" style="font-size: 14px;">
        <ol style="display: flex; gap: 8px; list-style: none; padding: 0; margin: 0; color: var(--muted);">
          <li><a href="/">Home</a></li>
          <li>&gt;</li>
          <li><a href="/lessons">Lessons</a></li>
          <li>&gt;</li>
          <li><a href={`/lessons/${currentCategory}`}>{categoryLabel(currentCategory)}</a></li>
          <li>&gt;</li>
          <li>{publicTitle}</li>
        </ol>
      </nav>

      <span class="pill">{getLessonTier(item.data.level)} | {item.data.exam.join(" & ")}</span>
      <h1>{publicTitle}</h1>
      <p class="muted" style="max-width: 75ch;">{item.data.excerpt}</p>

      <div class="cluster">
        <a class="btn btn-primary" href={`/lessons/${currentCategory}`}>
          &lt;- Back to {categoryLabel(currentCategory)} lessons
        </a>
        <a class="btn" href="/lessons">All lessons</a>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <article class="surface lesson-content" style="padding: var(--s-6);">
      <div class="lesson-divider" aria-hidden="true"></div>
      <div class="lesson-body-content" data-lesson-body>
        <Content />
      </div>

      <div id="lesson-mid-cta-template" hidden aria-hidden="true">
        <section class="lesson-inline-cta lesson-inline-cta--mid">
          <p class="lesson-inline-cta__kicker">{midLessonCta.kicker}</p>
          <a
            class="btn btn-primary lesson-inline-cta__button"
            href={midLessonCta.href}
            data-track-click="lesson-mid-primary-cta"
            data-track-page-type="lesson"
            data-track-offer={midLessonCta.offer}
            data-track-test={trackTest}
            data-track-skill={currentSkill}
            data-track-position="mid"
          >
            {midLessonCta.text}
          </a>
        </section>
      </div>

      {showBottomLessonAd && (
        <InArticleAd
          adId="lesson-in-article-ad"
          targetSelector=".lesson-content"
          anchorSelector=".lesson-example-grid, #lesson-map, .lesson-teach-grid"
        />
      )}

      {showBottomLessonAd && (
        <ContentAd className="lesson-bottom-ad" />
      )}

      <section class="lesson-inline-cta lesson-inline-cta--end">
        <p class="lesson-inline-cta__kicker">{endLessonCta.kicker}</p>
        <a
          class="btn btn-primary lesson-inline-cta__button"
          href={endLessonCta.href}
          data-track-click="lesson-end-primary-cta"
          data-track-page-type="lesson"
          data-track-offer={endLessonCta.offer}
          data-track-test={trackTest}
          data-track-skill={currentSkill}
          data-track-position="end"
        >
          {endLessonCta.text}
        </a>
      </section>

      <div class="lesson-divider lesson-divider-soft" aria-hidden="true"></div>

      <section class="surface lesson-related-system">
        <h3>Related lessons and your next support option</h3>
        <p class="muted" style="margin-top: 0;">
          These recommendations are matched by test focus and skill level for this lesson.
        </p>
        <div class="lesson-related-grid">
          {relatedLessons.map((relatedLesson) => (
            <a
              class="lesson-related-card"
              href={`/lessons/${relatedLesson.data.category}/${relatedLesson.slug}/`}
            >
              <h4>{getPublicLessonTitle(relatedLesson.data.title, relatedLesson.data.level)}</h4>
              <p>{relatedLesson.data.description ?? relatedLesson.data.excerpt}</p>
            </a>
          ))}
          <a
            class="lesson-related-card"
            href={serviceLink.href}
            data-track-click="lesson-service-link"
            data-track-page-type="lesson"
            data-track-offer="writing_help"
            data-track-test={trackTest}
            data-track-skill={currentSkill}
            data-track-position="end"
          >
            <h4>{serviceLink.title}</h4>
            <p>{serviceLink.description}</p>
          </a>
        </div>
      </section>

      {guideLinks.length > 0 && (
        <div class="surface" style="padding: var(--s-4); margin-top: var(--s-6);">
          <h3 style="margin-top: 0;">Related Strategy Guides</h3>
          <p class="muted" style="margin-top: 0;">Use these focused pages to go deeper on the exact test task behind this lesson.</p>
          <div class="grid grid-2" style="gap: var(--s-3);">
            {guideLinks.slice(0, 4).map((guide) => (
              <a class="card" href={guide.href} style="display:block; text-decoration:none;">
                <h4 style="margin-top: 0; margin-bottom: var(--s-1);">{guide.title}</h4>
                <p class="muted" style="margin: 0;">{guide.description}</p>
              </a>
            ))}
          </div>
        </div>
      )}

      <LeadCaptureForm
        heading="Get free Band 7+ strategies every week"
        message="Get free Band 7+ strategies every week"
        buttonLabel="Send Me Weekly Strategies"
        source={`lesson-${currentCategory}-${item.slug}`}
        formName="lesson-lead-capture"
        formType="lead_capture_general"
        pageType="lesson"
        offer="lead_capture"
        test={trackTest}
        skill={currentSkill}
        position="form_section"
        className="lesson-lead-capture"
      />

      {leadMagnetBlock && (
        <div style="margin-top: var(--s-6);">
          <LeadMagnetCard
            headline={leadMagnetBlock.headline}
            bullets={leadMagnetBlock.bullets}
            formName={leadMagnetBlock.formName}
            formType={leadMagnetBlock.formType}
            successPath={leadMagnetBlock.successPath}
            source={`lesson-${currentCategory}-${item.slug}`}
            magnetId={leadMagnetBlock.magnetId}
            buttonLabel={leadMagnetBlock.buttonLabel}
            pageType="lesson"
            offer="lead_magnet"
            test={trackTest}
            skill={ladderSkill}
            position="end"
          />
        </div>
      )}

      {showIntentStack && (
        <OfferLadderBlock
          test={trackTest}
          skill={ladderSkill}
          pageType="lesson"
          position="end"
          className="lesson-offer-ladder"
          heading="Choose the fastest way to improve"
        />
      )}

      {showIntentStack && (
        <OfferSequenceBlock
          test={trackTest}
          skill={ladderSkill}
          pageType="lesson"
          position="end"
          className="lesson-offer-sequence"
          heading="What to do next"
        />
      )}

      <div class="surface" style="padding: var(--s-3); margin-top: var(--s-6);">
        <p class="muted" style="margin: 0 0 var(--s-2) 0;">Explore another category:</p>
        <div class="cluster" aria-label="Explore lesson categories">
          {categories.map((category) => (
            <a
              class={`btn ${category === currentCategory ? "btn-primary" : ""}`}
              href={`/lessons/${category}`}
            >
              {categoryLabel(category)}
            </a>
          ))}
        </div>
      </div>

      <div class="cluster" style="margin-top: var(--s-6); justify-content: space-between;">
        <div class="cluster">
          {newerLesson ? (
            <a class="btn" href={`/lessons/${newerLesson.data.category}/${newerLesson.slug}/`}>
              &lt;- Newer lesson
            </a>
          ) : (
            <a class="btn" href={`/lessons/${currentCategory}`}>
              &lt;- Back to {categoryLabel(currentCategory)} list
            </a>
          )}

          {olderLesson ? (
            <a class="btn" href={`/lessons/${olderLesson.data.category}/${olderLesson.slug}/`}>
              Older lesson -&gt;
            </a>
          ) : null}
        </div>

        <a class="btn btn-primary" href="/lessons">Explore all categories -&gt;</a>
      </div>
    </article>
  </section>

  {headings.length > 0 && (
    <div class="lesson-jump-drawer" tabindex="0" aria-label="Lesson sections quick navigation">
      <div class="lesson-jump-tab">Jump to</div>
      <ul>
        {headings
          .filter((heading) => heading.depth <= 3)
          .map((heading) => (
            <li>
              <a href={`#${heading.slug}`} style={`padding-left: ${(heading.depth - 1) * 8}px;`}>
                {cleanHeadingText(heading.text)}
              </a>
            </li>
          ))}
      </ul>
    </div>
  )}

  <script is:inline>
    (() => {
      const normalizeAnswer = (value) =>
        String(value || "")
          .toLowerCase()
          .replace(/[^\w\s]/g, " ")
          .replace(/\s+/g, " ")
          .trim();

      const injectMidLessonCta = () => {
        const template = document.getElementById("lesson-mid-cta-template");
        if (!(template instanceof HTMLElement)) return;

        const roots = Array.from(document.querySelectorAll("[data-lesson-body]"));
        roots.forEach((root) => {
          if (!(root instanceof HTMLElement)) return;
          if (root.dataset.midCtaInjected === "true") return;

          const blocks = Array.from(root.children).filter((child) => child instanceof HTMLElement);
          if (blocks.length === 0) return;

          const insertionIndex = Math.max(0, Math.floor(blocks.length / 2) - 1);
          const ctaNode = template.firstElementChild?.cloneNode(true);
          if (!(ctaNode instanceof HTMLElement)) return;

          blocks[insertionIndex].insertAdjacentElement("afterend", ctaNode);
          root.dataset.midCtaInjected = "true";
        });
      };

      const initializePracticeLab = () => {
        const roots = Array.from(document.querySelectorAll(".lesson-content"));
        if (roots.length === 0) return;

        roots.forEach((root) => {
          const lab = root.querySelector("[data-practice-lab]");
          if (!lab || lab.dataset.initialized === "true") return;
          lab.dataset.initialized = "true";

          const tasks = Array.from(lab.querySelectorAll(".practice-task"));
          const scoreNode = lab.querySelector("[data-practice-score]");
          const resetButton = lab.querySelector("[data-practice-reset]");

          const updateScore = () => {
            const completed = tasks.filter((task) => task.dataset.complete === "true").length;
            if (scoreNode) scoreNode.textContent = `Score: ${completed}/${tasks.length}`;
          };

          const setTaskFeedback = (task, message, ok = false) => {
            const feedback = task.querySelector("[data-task-feedback]");
            if (feedback) feedback.textContent = message;
            task.classList.toggle("is-complete", ok);
            task.classList.toggle("is-wrong", !ok && Boolean(message));
          };

          const getFeedbackMessage = (task, ok, fallback) =>
            ok
              ? task.getAttribute("data-correct-feedback") || fallback
              : task.getAttribute("data-wrong-feedback") || fallback;

          const markTask = (task, ok) => {
            task.dataset.complete = ok ? "true" : "false";
            updateScore();
          };

          const resetTask = (task) => {
            task.dataset.complete = "false";
            task.classList.remove("is-complete", "is-wrong");
            const feedback = task.querySelector("[data-task-feedback]");
            if (feedback) feedback.textContent = "";

            if (task.dataset.taskType === "choice") {
              task.querySelectorAll(".practice-choice").forEach((buttonNode) => {
                buttonNode.classList.remove("is-correct", "is-wrong");
              });
            }

            if (task.dataset.taskType === "order") {
              const bank = task.querySelector("[data-order-bank]");
              const answer = task.querySelector("[data-order-answer]");
              if (bank && answer) {
                Array.from(answer.querySelectorAll(".practice-chip")).forEach((chip) => bank.appendChild(chip));
              }
            }

            if (task.dataset.taskType === "typing") {
              const input = task.querySelector("[data-typing-input]");
              if (input) input.value = "";
            }

            if (task.dataset.taskType === "sort") {
              task.querySelectorAll(".practice-sort-row").forEach((row) => {
                row.dataset.choice = "";
                row.classList.remove("is-correct", "is-wrong");
              });
              task.querySelectorAll(".practice-sort-btn").forEach((buttonNode) => {
                buttonNode.classList.remove("is-active");
              });
            }
          };

          tasks.forEach((task) => {
            task.dataset.complete = "false";

            if (task.dataset.taskType === "choice") {
              const buttons = Array.from(task.querySelectorAll(".practice-choice"));
              buttons.forEach((buttonNode) => {
                buttonNode.addEventListener("click", () => {
                  if (task.dataset.complete === "true") return;
                  const correctIndex = Number(task.dataset.taskAnswer || -1);
                  const selectedIndex = Number(buttonNode.getAttribute("data-choice-index"));
                  buttons.forEach((node) => node.classList.remove("is-correct", "is-wrong"));

                  if (selectedIndex === correctIndex) {
                    buttonNode.classList.add("is-correct");
                    setTaskFeedback(
                      task,
                      getFeedbackMessage(task, true, "Correct. That is the stronger option."),
                      true
                    );
                    markTask(task, true);
                  } else {
                    buttonNode.classList.add("is-wrong");
                    setTaskFeedback(
                      task,
                      getFeedbackMessage(task, false, "Not yet. Compare the meaning and try again."),
                      false
                    );
                    markTask(task, false);
                  }
                });
              });
            }

            if (task.dataset.taskType === "order") {
              task.addEventListener("click", (event) => {
                const target = event.target;
                if (!(target instanceof HTMLElement)) return;
                const chip = target.closest(".practice-chip");
                if (!chip) return;
                const bank = task.querySelector("[data-order-bank]");
                const answer = task.querySelector("[data-order-answer]");
                if (!bank || !answer) return;

                if (answer.contains(chip)) bank.appendChild(chip);
                else answer.appendChild(chip);
              });

              const checkButton = task.querySelector("[data-task-check]");
              const clearButton = task.querySelector("[data-task-clear]");

              checkButton?.addEventListener("click", () => {
                const answer = task.querySelector("[data-order-answer]");
                const expected = String(task.dataset.taskAnswer || "").split("||").filter(Boolean);
                const current = Array.from(answer?.querySelectorAll(".practice-chip") || []).map((chip) =>
                  chip.getAttribute("data-chip-value") || ""
                );

                if (current.length !== expected.length) {
                  setTaskFeedback(task, "Use all the chunks before you check.", false);
                  markTask(task, false);
                  return;
                }

                const ok = current.every((value, index) => value === expected[index]);
                setTaskFeedback(
                  task,
                  getFeedbackMessage(
                    task,
                    ok,
                    ok ? "Correct. The sentence order is natural." : "Not yet. Read it again and rebuild the order."
                  ),
                  ok
                );
                markTask(task, ok);
              });

              clearButton?.addEventListener("click", () => resetTask(task));
            }

            if (task.dataset.taskType === "typing") {
              const checkButton = task.querySelector("[data-task-check]");
              const input = task.querySelector("[data-typing-input]");

              checkButton?.addEventListener("click", () => {
                const answers = String(task.dataset.taskAnswers || "")
                  .split("||")
                  .map((item) => normalizeAnswer(item))
                  .filter(Boolean);
                const userAnswer = normalizeAnswer(input?.value || "");
                const ok = answers.includes(userAnswer);

                setTaskFeedback(
                  task,
                  getFeedbackMessage(
                    task,
                    ok,
                    ok ? "Correct. Nice repair." : "Not yet. Check the target form and try again."
                  ),
                  ok
                );
                markTask(task, ok);
              });
            }

            if (task.dataset.taskType === "sort") {
              task.querySelectorAll(".practice-sort-row").forEach((row) => {
                row.querySelectorAll(".practice-sort-btn").forEach((buttonNode) => {
                  buttonNode.addEventListener("click", () => {
                    row.dataset.choice = buttonNode.getAttribute("data-sort-choice") || "";
                    row.querySelectorAll(".practice-sort-btn").forEach((btn) => btn.classList.remove("is-active"));
                    buttonNode.classList.add("is-active");
                  });
                });
              });

              const checkButton = task.querySelector("[data-task-check]");
              checkButton?.addEventListener("click", () => {
                const rows = Array.from(task.querySelectorAll(".practice-sort-row"));
                let allChosen = true;
                let allCorrect = true;

                rows.forEach((row) => {
                  const choice = row.dataset.choice || "";
                  const target = row.dataset.sortTarget || "";
                  row.classList.remove("is-correct", "is-wrong");

                  if (!choice) {
                    allChosen = false;
                    allCorrect = false;
                    return;
                  }

                  if (choice === target) row.classList.add("is-correct");
                  else {
                    row.classList.add("is-wrong");
                    allCorrect = false;
                  }
                });

                if (!allChosen) {
                  setTaskFeedback(task, "Choose a column for every sentence first.", false);
                  markTask(task, false);
                  return;
                }

                setTaskFeedback(
                  task,
                  getFeedbackMessage(
                    task,
                    allCorrect,
                    allCorrect
                      ? "Correct. You sorted the sentences accurately."
                      : "Some rows are in the wrong column. Try again."
                  ),
                  allCorrect
                );
                markTask(task, allCorrect);
              });
            }
          });

          resetButton?.addEventListener("click", () => {
            tasks.forEach((task) => resetTask(task));
            updateScore();
          });

          updateScore();
        });
      };

      const initializeLessonEnhancements = () => {
        injectMidLessonCta();
        initializePracticeLab();
      };

      initializeLessonEnhancements();
      document.addEventListener("astro:page-load", initializeLessonEnhancements);
    })();
  </script>
</Layout>
