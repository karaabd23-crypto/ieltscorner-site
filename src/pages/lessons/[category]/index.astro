---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { getLessonTier, getPublicLessonTitle } from "../../../lib/lessonLevel";

type LessonEntry = CollectionEntry<"lessons">;
type Category = LessonEntry["data"]["category"];

export const getStaticPaths = () => {
  return [
    { params: { category: "grammar" } },
    { params: { category: "vocabulary" } },
    { params: { category: "writing" } },
    { params: { category: "speaking" } },
    { params: { category: "listening" } },
    { params: { category: "reading" } },
  ];
};

const category = Astro.params.category as Category;

const lessons = (
  await getCollection("lessons", ({ data }) => !data.draft && data.category === category)
).sort((a: LessonEntry, b: LessonEntry) => {
  if (category === "grammar" || category === "vocabulary") {
    return getPublicLessonTitle(a.data.title, a.data.level).localeCompare(
      getPublicLessonTitle(b.data.title, b.data.level),
      "en",
      { sensitivity: "base" }
    );
  }

  return a.data.date < b.data.date ? 1 : -1;
});

const metaMap: Record<Category, { pill: string; h1: string; blurb: string; keywords: string }> = {
  grammar: {
    pill: "Grammar | Band 7+ focus",
    h1: "Learn grammar that helps you get a higher score.",
    blurb:
      "Learn the grammar you need for IELTS, CELPIP, and PTE Core. These lessons explain conditionals, articles, passive voice, sentence patterns, and other high-impact structures with clear examples.",
    keywords:
      "IELTS grammar, CELPIP grammar, PTE Core grammar, Band 7 grammar, advanced English grammar, grammar for IELTS writing, grammar for IELTS speaking, C1 grammar lessons",
  },
  vocabulary: {
    pill: "Vocabulary | Band 7+ focus",
    h1: "Learn the words you need for Band 7+ and CLB 9+.",
    blurb:
      "Build vocabulary for IELTS, CELPIP, and PTE Core targets. These lessons teach useful word groups, collocations, and expressions that help you sound more natural and precise.",
    keywords:
      "IELTS vocabulary, CELPIP vocabulary, PTE Core vocabulary, Band 7 vocabulary, academic vocabulary, IELTS word list, advanced English words, vocabulary for IELTS",
  },
  writing: {
    pill: "Writing | Band 7+ / CLB 9+",
    h1: "Learn how to write better and get higher scores.",
    blurb:
      "Improve IELTS, CELPIP, and PTE Core writing with clearer structure, stronger task response, better paragraph flow, and more accurate grammar.",
    keywords:
      "IELTS writing, CELPIP writing, PTE Core writing, Band 7 writing, IELTS essay, CELPIP email, PTE email writing, writing samples, IELTS writing tips",
  },
  speaking: {
    pill: "Speaking | Band 7+ / CLB 9+",
    h1: "Learn how to speak clearly and naturally in your test.",
    blurb:
      "Improve IELTS, CELPIP, and PTE Core speaking with lessons on fluency, idea development, pronunciation, structure, and natural delivery.",
    keywords:
      "IELTS speaking, CELPIP speaking, PTE Core speaking, Band 7 speaking, speaking test tips, IELTS speaking part 2, CELPIP speaking practice, improve speaking scores",
  },
  listening: {
    pill: "Listening | Band 7+ / CLB 9+",
    h1: "Train your ear for faster, more accurate answers.",
    blurb:
      "Improve IELTS, CELPIP, and PTE Core listening with targeted practice in prediction, note-taking, signposts, and detail recognition.",
    keywords:
      "IELTS listening, CELPIP listening, PTE Core listening, listening strategies, note-taking for listening, listening practice, Band 7 listening, CLB 9 listening",
  },
  reading: {
    pill: "Reading | Band 7+ / CLB 9+",
    h1: "Read with precision and choose evidence-based answers.",
    blurb:
      "Build stronger IELTS, CELPIP, and PTE Core reading skills with scanning, inference, timing control, and text-based answer selection.",
    keywords:
      "IELTS reading, CELPIP reading, PTE Core reading, reading strategies, scanning and skimming, inference questions, Band 7 reading, CLB 9 reading",
  },
};

const meta = metaMap[category];
---

<Layout
  title={`${category[0].toUpperCase() + category.slice(1)} Lessons for IELTS, CELPIP & PTE Core`}
  description={meta.blurb}
  keywords={meta.keywords}
>
  <section class="section">
    <div class="stack">
      <span class="pill">{meta.pill}</span>
      <h1>{meta.h1}</h1>
      <p class="muted" style="max-width: 75ch;">{meta.blurb}</p>

      <div class="cluster">
        <a class="btn btn-primary" href="/celpip">CELPIP hub</a>
        <a class="btn" href="/ielts">IELTS hub</a>
        <a class="btn" href="/pte-core">PTE Core hub</a>
        <a class="btn" href="/lessons">All lessons</a>
      </div>
      <p id="exam-filter-notice" class="muted" style="display:none; margin-top: var(--s-2); font-size: var(--step--1);"></p>
    </div>
  </section>

  <section class="section-sm">
    <div class="stack">
      <h2>Available lessons</h2>

      {lessons.length === 0 ? (
        <div class="surface" style="padding: var(--s-6);">
          <p class="muted" style="margin: 0;">
            There are no published lessons in this category yet, but new lesson posts are added regularly.
            You can continue with another category now and return here for fresh content.
          </p>
        </div>
      ) : (
        <>
          <div class="surface" style="padding: var(--s-4); margin-top: var(--s-4);">
            <label for="lesson-search" style="font-weight: 700; display: block; margin-bottom: var(--s-2);">
              Search {category} topics
            </label>
            <div class="cluster" style="gap: var(--s-2); align-items: center;">
              <input
                id="lesson-search"
                type="search"
                placeholder="Type keywords (for example: tense, article, conditionals)"
                autocomplete="off"
                style="flex: 1 1 320px; min-width: 220px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; font: inherit;"
              />
              <button id="lesson-search-clear" class="btn" type="button">Clear</button>
            </div>
            <p id="lesson-search-summary" class="muted" style="margin: var(--s-2) 0 0;">
              Showing {lessons.length} of {lessons.length} lessons.
            </p>
          </div>

          <div id="lesson-search-grid" class="grid grid-2" style="margin-top: var(--s-5);">
            {lessons.map((lesson: LessonEntry, index: number) => {
              const searchText = [
                getPublicLessonTitle(lesson.data.title, lesson.data.level),
                lesson.data.excerpt,
                lesson.data.level,
                lesson.data.category,
                lesson.slug,
                lesson.data.exam.join(" "),
                ...(lesson.data.tags || []),
              ].join(" ").toLowerCase();

              return (
                <>
                  <a
                    class="card lesson-search-item"
                    data-search={searchText}
                    data-exams={(lesson.data.exam ?? []).map((v: string) => String(v).toUpperCase()).join(",")}
                    href={`/lessons/${lesson.data.category}/${lesson.slug}/`}
                    style="display:block;"
                  >
                    <div class="cluster" style="justify-content: space-between;">
                      <div class="cluster">
                        <span class="pill">{getLessonTier(lesson.data.level)} | {lesson.data.exam.join(" & ")}</span>
                        {lesson.data.tags?.length ? <span class="pill">{lesson.data.tags[0]}</span> : null}
                      </div>
                      <span class="pill">Open</span>
                    </div>

                    <h3 style="margin-top: var(--s-3);">{getPublicLessonTitle(lesson.data.title, lesson.data.level)}</h3>
                    <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
                  </a>

                </>
              );
            })}
          </div>

          <div id="lesson-search-empty" class="surface" style="display:none; padding: var(--s-5); margin-top: var(--s-4);">
            <p class="muted" style="margin: 0;">No lessons match your search yet. Try a simpler keyword.</p>
          </div>
        </>
      )}
    </div>
  </section>

  <script is:inline>
    (() => {
      const input = document.getElementById("lesson-search");
      const clearBtn = document.getElementById("lesson-search-clear");
      const summary = document.getElementById("lesson-search-summary");
      const empty = document.getElementById("lesson-search-empty");
      const notice = document.getElementById("exam-filter-notice");
      const cards = Array.from(document.querySelectorAll(".lesson-search-item"));

      if (!(input instanceof HTMLInputElement) || !summary || !empty || cards.length === 0) {
        return;
      }

      // Read ?exam= from the URL (set by SkillFreeLessons links)
      const urlExam = new URLSearchParams(window.location.search).get("exam")?.toUpperCase() || "";
      const validExams = ["IELTS", "CELPIP", "PTE_CORE"];
      const activeExam = validExams.includes(urlExam) ? urlExam : "";

      // Show a notice when pre-filtered
      if (activeExam && notice instanceof HTMLElement) {
        const displayLabel = activeExam === "PTE_CORE" ? "PTE Core" : activeExam;
        notice.style.display = "block";
        notice.innerHTML = `Showing <strong>${displayLabel}</strong> lessons only. <a href="?">Show all exams</a>`;
      }

      const total = cards.length;

      const applyFilter = () => {
        const query = input.value.trim().toLowerCase();
        const terms = query.split(/\s+/).filter(Boolean);
        let visible = 0;

        cards.forEach((card) => {
          const text = (card.getAttribute("data-search") || "").toLowerCase();
          const cardExams = (card.getAttribute("data-exams") || "").toUpperCase();

          const keywordMatch = terms.every((term) => text.includes(term));

          // When pre-filtered by exam: hide lessons that belong exclusively to the other exam.
          // Lessons with no exam tag (generic) remain visible for all.
          let examMatch = true;
          if (activeExam) {
            const examList = cardExams
              .split(",")
              .map((value) => value.trim())
              .filter(Boolean);

            if (examList.length > 0 && !examList.includes(activeExam)) {
              examMatch = false;
            }
          }

          const matches = keywordMatch && examMatch;
          card.style.display = matches ? "block" : "none";
          if (matches) visible += 1;
        });

        summary.textContent = `Showing ${visible} of ${total} lessons.`;
        empty.style.display = visible === 0 ? "block" : "none";
      };

      applyFilter();
      input.addEventListener("input", applyFilter);

      if (clearBtn instanceof HTMLButtonElement) {
        clearBtn.addEventListener("click", () => {
          input.value = "";
          applyFilter();
          input.focus();
        });
      }
    })();
  </script>
</Layout>
