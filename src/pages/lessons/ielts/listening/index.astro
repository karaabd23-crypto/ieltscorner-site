---
import Layout from "../../../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const relatedLessons = (
  await getCollection(
    "lessons",
    ({ data }) =>
      !data.draft &&
      data.exam.includes("IELTS") &&
      ["grammar", "vocabulary", "speaking"].includes(data.category)
  )
)
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 8);
---

<Layout
  title="IELTS Listening Lessons — IELTS Corner"
  description="IELTS Listening lessons: traps, strategies, and drills to improve accuracy and speed."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/lesson.png');`}>
      <div class="hero-content">
        <span class="pill">🎧 IELTS Listening</span>
        <h1>Stop losing marks to predictable traps.</h1>

        <p class="muted" style="max-width: 60ch;">
          Listening is not “hard” — it’s fast. You win by predicting, tracking signposts, and writing answers
          that match the question exactly.
        </p>

        <div class="cluster">
          <a class="btn btn-primary" href="/lessons/ielts">Back to IELTS lessons →</a>
          <a class="btn btn-ghost" href="/tutoring">Tutoring →</a>
        </div>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <section class="section-sm">
      <div class="surface" style="padding: var(--s-5);">
        <div class="cluster quick-nav">
          <a class="btn" href="/lessons/ielts">IELTS Home</a>
          <a class="btn btn-primary" href="/lessons/ielts/listening">Listening</a>
          <a class="btn" href="/lessons/ielts/reading">Reading</a>
          <a class="btn" href="/lessons/ielts/speaking">Speaking</a>
          <a class="btn" href="/lessons/ielts/writing">Writing</a>
          <a class="btn" href="/lessons">All Lessons</a>
        </div>
      </div>
    </section>

    <div class="grid grid-2">
      <div class="card">
        <h3>Core method</h3>
        <p class="muted">
          Use a 3-step loop: <strong>Preview → Predict → Prove</strong>.
          Preview the questions, predict the answer type, then prove it using the audio + question grammar.
        </p>
      </div>

      <div class="card">
        <h3>Common traps</h3>
        <p class="muted">
          The most common traps include plurals, word form changes, spelling errors, number confusion,
          and speaker self-corrections such as “Thursday… sorry, Friday.”
        </p>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <h2>Related IELTS lessons</h2>
    <p class="muted" style="max-width: 70ch;">
      Use these related lessons to strengthen the grammar and vocabulary patterns that appear in IELTS listening tasks.
    </p>

    <div class="grid grid-2">
      {relatedLessons.map((lesson) => (
        <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block;">
          <div class="cluster" style="justify-content: space-between;">
            <span class="pill">{lesson.data.category} • {lesson.data.level}</span>
            <span class="pill">Open →</span>
          </div>
          <h3 style="margin-top: var(--s-3);">{lesson.data.title}</h3>
          <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
