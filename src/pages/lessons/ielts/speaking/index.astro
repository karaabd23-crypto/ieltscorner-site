---
import Layout from "../../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getLessonTier, getPublicLessonTitle } from "../../../../lib/lessonLevel";

const relatedLessons = (
  await getCollection(
    "lessons",
    ({ data }) =>
      !data.draft &&
      data.exam.includes("IELTS") &&
      ["speaking", "vocabulary", "grammar"].includes(data.category)
  )
)
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 8);
---

<Layout
  title="IELTS Speaking Lessons — IELTS Corner"
  description="IELTS Speaking lessons: structure for Parts 1–3, natural extension, and Band 7+ strategies."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/lesson.png');`}>
      <div class="hero-content">
        <span class="pill">🗣️ IELTS Speaking</span>
        <h1>Sound natural. Stay structured. Score higher.</h1>

        <p class="muted" style="max-width: 60ch;">
          Speaking isn’t “big words.” It’s clear answers, smart extension, and controlled grammar —
          delivered like a human, not a memorized script.
        </p>

        <div class="cluster">
          <a class="btn btn-primary" href="/lessons/ielts">Back to IELTS lessons →</a>
          <a class="btn btn-ghost" href="/tutoring">Tutoring →</a>
        </div>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <div class="grid grid-2">
      <div class="card">
        <h3>Core template</h3>
        <p class="muted">
          Use <strong>Answer → Reason → Example → Result</strong> for Parts 1 & 3.
          It keeps you coherent without sounding rehearsed.
        </p>
      </div>

      <div class="card">
        <h3>Common traps</h3>
        <p class="muted">
          One-sentence answers, memorized idioms, unnatural “fancy” vocabulary, and panic pauses
          after every question.
        </p>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <section class="section-sm">
      <div class="surface" style="padding: var(--s-5);">
        <div class="cluster quick-nav">
          <a class="btn" href="/lessons/ielts">IELTS Home</a>
          <a class="btn" href="/lessons/ielts/listening">Listening</a>
          <a class="btn" href="/lessons/ielts/reading">Reading</a>
          <a class="btn btn-primary" href="/lessons/ielts/speaking">Speaking</a>
          <a class="btn" href="/lessons/ielts/writing">Writing</a>
          <a class="btn" href="/lessons">All Lessons</a>
        </div>
      </div>
    </section>

    <h2>IELTS Speaking lessons</h2>
    <p class="muted" style="max-width: 70ch;">
      This section focuses on repeatable speaking patterns you can use in Parts 1, 2, and 3.
      Train one structure at a time, record yourself, and track whether your answers stay clear
      when the topic becomes unfamiliar.
    </p>

    <div class="grid grid-2">
      {relatedLessons.map((lesson) => (
        <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block;">
          <div class="cluster" style="justify-content: space-between;">
            <span class="pill">{lesson.data.category} • {getLessonTier(lesson.data.level)}</span>
            <span class="pill">Open →</span>
          </div>
          <h3 style="margin-top: var(--s-3);">{getPublicLessonTitle(lesson.data.title, lesson.data.level)}</h3>
          <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
        </a>
      ))}
    </div>

    <div style="height: var(--s-8);"></div>

    <div class="grid grid-2">
      <div class="card">
        <h3>Next: Writing</h3>
        <p class="muted">Band 7+ flow, paragraph logic, and precision.</p>
        <a class="btn btn-primary" href="/lessons/ielts/writing">Go to Writing →</a>
      </div>

      <div class="card">
        <h3>Want feedback?</h3>
        <p class="muted">Speaking improves fastest with corrections you can actually use.</p>
        <a class="btn" href="/tutoring">See tutoring →</a>
      </div>
    </div>
  </section>
</Layout>
