---
import Layout from "../../../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const relatedLessons = (
  await getCollection(
    "lessons",
    ({ data }) =>
      !data.draft &&
      data.exam.includes("IELTS") &&
      ["vocabulary", "grammar", "writing"].includes(data.category)
  )
)
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 8);
---

<Layout
  title="IELTS Reading Lessons — IELTS Corner"
  description="IELTS Reading lessons: speed, keywords, question types, and proof-based strategies to avoid traps."
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/lesson.png');`}>
      <div class="hero-content">
        <span class="pill">📖 IELTS Reading</span>
        <h1>Reading isn’t about English. It’s about control.</h1>

        <p class="muted" style="max-width: 60ch;">
          You don’t have time to understand everything. You need a system for finding answers fast
          and rejecting tempting wrong options.
        </p>

        <div class="cluster">
          <a class="btn btn-primary" href="/lessons/ielts">Back to IELTS lessons →</a>
          <a class="btn btn-ghost" href="/tutoring">Tutoring →</a>
        </div>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <div class="grid grid-2">
      <div class="card">
        <h3>Core method</h3>
        <p class="muted">
          Use <strong>Map → Hunt → Prove</strong>.
          Map the passage (paragraph purpose), hunt using strong keywords (names, dates, nouns),
          then prove answers with meaning (not just matching words).
        </p>
      </div>

      <div class="card">
        <h3>Common traps</h3>
        <p class="muted">
          “Half-true” options, extreme language (always/never), wrong cause/effect, and answers that
          match words but change meaning.
        </p>
      </div>
    </div>

    <div style="height: var(--s-8);"></div>

    <section class="section-sm">
      <div class="surface" style="padding: var(--s-5);">
        <div class="cluster quick-nav">
          <a class="btn" href="/lessons/ielts">IELTS Home</a>
          <a class="btn" href="/lessons/ielts/listening">Listening</a>
          <a class="btn btn-primary" href="/lessons/ielts/reading">Reading</a>
          <a class="btn" href="/lessons/ielts/speaking">Speaking</a>
          <a class="btn" href="/lessons/ielts/writing">Writing</a>
          <a class="btn" href="/lessons">All Lessons</a>
        </div>
      </div>
    </section>

    <h2>IELTS Reading lessons</h2>
    <p class="muted" style="max-width: 70ch;">
      Use this page as your reading training map. Start with keyword control and paragraph mapping,
      then move to question-type drills so you can find evidence quickly and avoid trap answers.
    </p>

    <div class="grid grid-2">
      {relatedLessons.map((lesson) => (
        <a class="card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`} style="display:block;">
          <div class="cluster" style="justify-content: space-between;">
            <span class="pill">{lesson.data.category} • {lesson.data.level}</span>
            <span class="pill">Open →</span>
          </div>
          <h3 style="margin-top: var(--s-3);">{lesson.data.title}</h3>
          <p class="muted" style="margin-bottom: 0;">{lesson.data.excerpt}</p>
        </a>
      ))}
    </div>

    <div style="height: var(--s-8);"></div>

    <div class="grid grid-2">
      <div class="card">
        <h3>Next: Listening</h3>
        <p class="muted">Prediction, signposts, and accuracy under pressure.</p>
        <a class="btn btn-primary" href="/lessons/ielts/listening">Go to Listening →</a>
      </div>

      <div class="card">
        <h3>Want feedback?</h3>
        <p class="muted">Speed and accuracy improve fastest with targeted corrections.</p>
        <a class="btn" href="/tutoring">See tutoring →</a>
      </div>
    </div>
  </section>
</Layout>
