---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Thank you for your review | IELTS Corner"
  description="Thank you for sharing your experience with IELTS Corner."
  noindex={true}
>
  <section class="section" style="padding-top: var(--s-6);">
    <div style="max-width: 560px; margin: 0 auto; text-align: center;">
      <span class="pill ic-eyebrow">Received</span>
      <h1 class="ic-display" style="margin-top: var(--s-2);">Thank you</h1>
      <p class="muted">
        Your review has been received. It means a lot, and it helps other learners
        decide. If we publish it, it will show your first name and last initial only.
      </p>
      <div class="cluster" style="justify-content: center; margin-top: var(--s-4);">
        <a class="btn btn-primary ic-btn" href="/lessons">Back to free lessons</a>
        <a class="btn btn-ghost" href="/success-stories">See student stories</a>
      </div>
    </div>
  </section>
</Layout>
