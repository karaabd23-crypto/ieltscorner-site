---
import Layout from "../layouts/Layout.astro";
import { buildBreadcrumbSchema, buildFAQSchema } from "../lib/seo";

// FAQ targets the exact questions people search ("what CLB is IELTS 7?").
// FAQPage schema can earn featured snippets / People-Also-Ask placements.
const faqs = [
  {
    question: "What CLB level is IELTS 7?",
    answer:
      "On the IRCC concordance for IELTS General Training, a band of 6.0 in a skill is CLB 7 for reading, while listening 6.0 is CLB 7. For writing and speaking, 6.0 is CLB 7. Use the calculator above to convert each of your four skills exactly, since the mapping differs by skill.",
  },
  {
    question: "What CELPIP score do I need for CLB 9?",
    answer:
      "CELPIP uses the same number as the CLB level, so CLB 9 means a CELPIP score of 9 in that skill. Reaching CLB 9 in all four skills gives the maximum language points for Express Entry.",
  },
  {
    question: "What CLB do I need for Canadian PR (Express Entry)?",
    answer:
      "Most Express Entry programs require a minimum of CLB 7 in all four skills. CLB 9 in all four skills adds roughly 42 CRS points over CLB 7, which can be decisive in the draws.",
  },
  {
    question: "Is this CLB calculator accurate?",
    answer:
      "It uses the official IRCC concordance tables that map IELTS, CELPIP, and PTE Core scores to CLB levels. Always confirm against the current IRCC tables before submitting an application, as thresholds can change.",
  },
];

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CLB Calculator", path: "/clb-calculator/" },
  ]),
  buildFAQSchema(faqs),
];
---

<Layout
  title="CLB Calculator: IELTS, CELPIP & PTE Core to CLB"
  description="Free CLB Calculator: enter your IELTS, CELPIP, or PTE Core scores and instantly see your Canadian Language Benchmark (CLB) level in each skill plus estimated Express Entry CRS points."
  type="page"
  keywords="CLB calculator, IELTS to CLB, CELPIP to CLB, PTE Core to CLB, CLB level calculator, Express Entry language score, CRS points calculator"
  structuredData={pageStructuredData}
>
  <section class="section" style="padding-top: var(--s-6);">
    <div style="max-width: 720px; margin: 0 auto;">
      <header style="text-align: center; margin-bottom: var(--s-6);">
        <span class="ic-eyebrow">Free tool</span>
        <h1 class="ic-display" style="margin: var(--s-2) 0;">CLB Calculator</h1>
        <p class="muted" style="max-width: 56ch; margin: 0 auto;">Enter your IELTS, CELPIP, or PTE Core scores to see your CLB level in each skill and your estimated Express Entry CRS language points.</p>
      </header>

      <div class="surface" style="padding: var(--s-6);" id="clb-calc">
        <div style="margin-bottom: var(--s-4);">
          <label class="clb-label" for="test-select">Which test did you take?</label>
          <div class="clb-radio-group" role="radiogroup" aria-label="Test type">
            <label class="clb-radio-option" id="opt-ielts">
              <input type="radio" name="test" value="ielts" id="radio-ielts" checked />
              IELTS General
            </label>
            <label class="clb-radio-option" id="opt-celpip">
              <input type="radio" name="test" value="celpip" id="radio-celpip" />
              CELPIP General
            </label>
            <label class="clb-radio-option" id="opt-pte">
              <input type="radio" name="test" value="pte" id="radio-pte" />
              PTE Core
            </label>
          </div>
        </div>

        <div class="clb-score-grid">
          <div class="clb-score-field">
            <label class="clb-label" for="score-l">Listening</label>
            <input class="clb-input" type="number" id="score-l" placeholder="e.g. 7.5" step="0.5" min="0" max="9" />
          </div>
          <div class="clb-score-field">
            <label class="clb-label" for="score-r">Reading</label>
            <input class="clb-input" type="number" id="score-r" placeholder="e.g. 7.0" step="0.5" min="0" max="9" />
          </div>
          <div class="clb-score-field">
            <label class="clb-label" for="score-w">Writing</label>
            <input class="clb-input" type="number" id="score-w" placeholder="e.g. 6.5" step="0.5" min="0" max="9" />
          </div>
          <div class="clb-score-field">
            <label class="clb-label" for="score-s">Speaking</label>
            <input class="clb-input" type="number" id="score-s" placeholder="e.g. 7.0" step="0.5" min="0" max="9" />
          </div>
        </div>

        <button class="btn btn-primary ic-btn clb-btn" id="calc-btn" type="button" style="width: 100%; margin-top: var(--s-4);">
          Calculate my CLB level
        </button>

        <div id="clb-result" style="display: none; margin-top: var(--s-5);">
          <h2 class="ic-display" style="margin: 0 0 var(--s-3) 0; font-size: 1.2rem;">Your CLB results</h2>

          <div class="clb-result-grid" id="result-grid"></div>

          <div class="surface" id="result-summary" style="padding: var(--s-4); margin-top: var(--s-4); background: var(--blue-50, #f0f7ff);">
            <p id="result-overall" style="margin: 0; font-weight: 600;"></p>
            <p id="result-crs" style="margin: var(--s-2) 0 0 0;" class="muted"></p>
            <p id="result-note" style="margin: var(--s-2) 0 0 0;" class="muted"></p>
          </div>

          <div style="margin-top: var(--s-4);" id="result-links"></div>
        </div>

        <div id="clb-error" style="display: none; margin-top: var(--s-4); color: var(--red-600, #dc2626);">
          <p id="error-message"></p>
        </div>
      </div>

      <div class="surface" style="padding: var(--s-5); margin-top: var(--s-5);">
        <h2 class="ic-display" style="margin-top: 0; font-size: 1.1rem;">How to use this calculator</h2>
        <ol style="padding-left: var(--s-4); margin: 0;">
          <li style="margin-bottom: var(--s-2);">Select your test (IELTS General, CELPIP General, or PTE Core).</li>
          <li style="margin-bottom: var(--s-2);">Enter your scores for each of the four skills. Use the score exactly as it appears on your score report.</li>
          <li style="margin-bottom: var(--s-2);">Click Calculate. Your CLB level per skill and estimated CRS points will appear instantly.</li>
          <li>Use the results to identify which skills to improve and which test resources match your target CLB.</li>
        </ol>
        <p class="muted" style="margin-top: var(--s-3); margin-bottom: 0;">CLB conversion tables are based on official IRCC concordance data. CRS points shown are estimates for a single applicant, first official language. Always verify current requirements at ircc.canada.ca before submitting an immigration application.</p>
      </div>

      <div class="surface" style="padding: var(--s-5); margin-top: var(--s-5);">
        <h2 class="ic-display" style="margin-top: 0; font-size: 1.1rem;">About CLB levels and Express Entry</h2>
        <p>Canadian Language Benchmarks (CLB) are the language standard used by IRCC for immigration. Every approved language test -- IELTS, CELPIP, and PTE Core -- maps to CLB levels through an official concordance table.</p>
        <p>For Express Entry, the minimum CLB requirement for most programs is CLB 7 in all four skills. However, reaching CLB 9 significantly increases your Comprehensive Ranking System (CRS) score, which determines who receives an Invitation to Apply.</p>
        <p class="muted" style="margin-bottom: 0;">The difference between CLB 7 and CLB 9 in all four skills is approximately 42 CRS points -- equivalent to roughly one year of skilled Canadian work experience.</p>
      </div>

      <section class="surface" style="padding: var(--s-5); margin-top: var(--s-5);">
        <h2 class="ic-display" style="margin-top: 0; font-size: 1.2rem;">CLB conversion: common questions</h2>
        {faqs.map((faq) => (
          <details class="clb-faq-item">
            <summary class="clb-faq-q">{faq.question}</summary>
            <p class="clb-faq-a">{faq.answer}</p>
          </details>
        ))}
      </section>
    </div>
  </section>

  <style>
    .clb-faq-item {
      border-top: 1px solid var(--border);
      padding: var(--s-3) 0;
    }
    .clb-faq-item:first-of-type {
      border-top: none;
    }
    .clb-faq-q {
      font-weight: 600;
      cursor: pointer;
    }
    .clb-faq-a {
      margin: var(--s-2) 0 0;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .clb-label {
      display: block;
      font-weight: 600;
      margin-bottom: var(--s-2);
    }

    .clb-radio-group {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
    }

    .clb-radio-option {
      display: flex;
      align-items: center;
      gap: var(--s-1);
      padding: var(--s-2) var(--s-3);
      border: 2px solid var(--border-color, #e2e8f0);
      border-radius: 6px;
      cursor: pointer;
      font-weight: 500;
      transition: border-color 0.15s, background 0.15s;
    }

    .clb-radio-option:has(input:checked) {
      border-color: var(--ic-primary, #2563eb);
      background: var(--blue-50, #eff6ff);
    }

    .clb-radio-option input {
      margin: 0;
    }

    .clb-score-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-3);
      margin-top: var(--s-4);
    }

    @media (min-width: 500px) {
      .clb-score-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .clb-score-field label {
      display: block;
      font-weight: 600;
      margin-bottom: var(--s-1);
      font-size: 0.9rem;
    }

    .clb-input {
      width: 100%;
      padding: var(--s-2);
      border: 2px solid var(--border-color, #e2e8f0);
      border-radius: 6px;
      font-size: 1rem;
      text-align: center;
      box-sizing: border-box;
    }

    .clb-input:focus {
      border-color: var(--ic-primary, #2563eb);
      outline: none;
    }

    .clb-btn {
      font-size: 1rem;
      padding: var(--s-3) var(--s-4);
    }

    .clb-result-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-3);
    }

    @media (min-width: 500px) {
      .clb-result-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .clb-result-card {
      border: 2px solid var(--border-color, #e2e8f0);
      border-radius: 8px;
      padding: var(--s-3);
      text-align: center;
    }

    .clb-result-card.clb-met {
      border-color: #22c55e;
      background: #f0fdf4;
    }

    .clb-result-card.clb-close {
      border-color: #f59e0b;
      background: #fffbeb;
    }

    .clb-result-card.clb-below {
      border-color: #ef4444;
      background: #fef2f2;
    }

    .clb-result-skill {
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted-color, #64748b);
      margin-bottom: var(--s-1);
    }

    .clb-result-clb {
      font-size: 1.8rem;
      font-weight: 800;
      line-height: 1;
      margin-bottom: var(--s-1);
    }

    .clb-result-score {
      font-size: 0.85rem;
      color: var(--muted-color, #64748b);
    }
  </style>

  <script is:inline>
    (() => {
      const IELTS_CLB = {
        L: [
          { min: 0, clb: 0 }, { min: 4.5, clb: 4 }, { min: 5, clb: 5 },
          { min: 5.5, clb: 6 }, { min: 6, clb: 7 }, { min: 7.5, clb: 8 },
          { min: 8, clb: 9 }, { min: 8.5, clb: 10 }
        ],
        R: [
          { min: 0, clb: 0 }, { min: 3.5, clb: 4 }, { min: 4, clb: 5 },
          { min: 5, clb: 6 }, { min: 6, clb: 7 }, { min: 7, clb: 8 },
          { min: 8, clb: 9 }, { min: 8.5, clb: 10 }
        ],
        W: [
          { min: 0, clb: 0 }, { min: 4, clb: 4 }, { min: 5, clb: 5 },
          { min: 5.5, clb: 6 }, { min: 6, clb: 7 }, { min: 7, clb: 8 },
          { min: 7.5, clb: 9 }, { min: 8, clb: 10 }
        ],
        S: [
          { min: 0, clb: 0 }, { min: 4, clb: 4 }, { min: 5, clb: 5 },
          { min: 5.5, clb: 6 }, { min: 6, clb: 7 }, { min: 7, clb: 8 },
          { min: 7.5, clb: 9 }, { min: 8, clb: 10 }
        ]
      };

      const CELPIP_CLB = {
        L: [
          { min: 0, clb: 0 }, { min: 4, clb: 4 }, { min: 5, clb: 5 },
          { min: 6, clb: 6 }, { min: 7, clb: 7 }, { min: 8, clb: 8 },
          { min: 9, clb: 9 }, { min: 10, clb: 10 }
        ],
        R: [
          { min: 0, clb: 0 }, { min: 4, clb: 4 }, { min: 5, clb: 5 },
          { min: 6, clb: 6 }, { min: 7, clb: 7 }, { min: 8, clb: 8 },
          { min: 9, clb: 9 }, { min: 10, clb: 10 }
        ],
        W: [
          { min: 0, clb: 0 }, { min: 4, clb: 4 }, { min: 5, clb: 5 },
          { min: 6, clb: 6 }, { min: 7, clb: 7 }, { min: 8, clb: 8 },
          { min: 9, clb: 9 }, { min: 10, clb: 10 }
        ],
        S: [
          { min: 0, clb: 0 }, { min: 4, clb: 4 }, { min: 5, clb: 5 },
          { min: 6, clb: 6 }, { min: 7, clb: 7 }, { min: 8, clb: 8 },
          { min: 9, clb: 9 }, { min: 10, clb: 10 }
        ]
      };

      const PTE_CLB = {
        L: [
          { min: 0, clb: 0 }, { min: 18, clb: 4 }, { min: 33, clb: 5 },
          { min: 47, clb: 6 }, { min: 60, clb: 7 }, { min: 71, clb: 8 },
          { min: 79, clb: 9 }, { min: 82, clb: 10 }
        ],
        R: [
          { min: 0, clb: 0 }, { min: 33, clb: 4 }, { min: 46, clb: 5 },
          { min: 54, clb: 6 }, { min: 60, clb: 7 }, { min: 69, clb: 8 },
          { min: 79, clb: 9 }, { min: 82, clb: 10 }
        ],
        W: [
          { min: 0, clb: 0 }, { min: 41, clb: 4 }, { min: 51, clb: 5 },
          { min: 56, clb: 6 }, { min: 60, clb: 7 }, { min: 69, clb: 8 },
          { min: 79, clb: 9 }, { min: 82, clb: 10 }
        ],
        S: [
          { min: 0, clb: 0 }, { min: 42, clb: 4 }, { min: 52, clb: 5 },
          { min: 59, clb: 6 }, { min: 68, clb: 7 }, { min: 73, clb: 8 },
          { min: 79, clb: 9 }, { min: 82, clb: 10 }
        ]
      };

      const CRS_SINGLE_FIRST = {
        0: 0, 1: 0, 2: 0, 3: 0, 4: 6, 5: 6, 6: 9,
        7: 17, 8: 23, 9: 31, 10: 34
      };

      const tables = { ielts: IELTS_CLB, celpip: CELPIP_CLB, pte: PTE_CLB };

      const placeholders = {
        ielts: { L: "e.g. 8.0", R: "e.g. 7.5", W: "e.g. 6.5", S: "e.g. 7.0", step: "0.5", min: "0", max: "9" },
        celpip: { L: "e.g. 9", R: "e.g. 8", W: "e.g. 7", S: "e.g. 8", step: "1", min: "1", max: "12" },
        pte: { L: "e.g. 71", R: "e.g. 69", W: "e.g. 69", S: "e.g. 73", step: "1", min: "10", max: "90" }
      };

      const getClb = (table, score) => {
        const entries = [...table].reverse();
        for (const entry of entries) {
          if (score >= entry.min) return entry.clb;
        }
        return 0;
      };

      const updatePlaceholders = (test) => {
        const ph = placeholders[test];
        const fields = [
          { id: "score-l", key: "L" },
          { id: "score-r", key: "R" },
          { id: "score-w", key: "W" },
          { id: "score-s", key: "S" }
        ];
        fields.forEach(({ id, key }) => {
          const input = document.getElementById(id);
          if (!input) return;
          input.placeholder = ph[key];
          input.step = ph.step;
          input.min = ph.min;
          input.max = ph.max;
          input.value = "";
        });
      };

      const skillNames = { L: "Listening", R: "Reading", W: "Writing", S: "Speaking" };

      const getResultClass = (clb) => {
        if (clb >= 9) return "clb-met";
        if (clb >= 7) return "clb-close";
        return "clb-below";
      };

      const crsPointsForProfile = (clbs) => {
        const total = ["L", "R", "W", "S"].reduce((sum, skill) => {
          return sum + (CRS_SINGLE_FIRST[clbs[skill]] || 0);
        }, 0);
        return total;
      };

      const minClb = (clbs) => Math.min(...Object.values(clbs));

      const calculate = () => {
        const test = document.querySelector('input[name="test"]:checked')?.value;
        const scores = {
          L: parseFloat(document.getElementById("score-l")?.value),
          R: parseFloat(document.getElementById("score-r")?.value),
          W: parseFloat(document.getElementById("score-w")?.value),
          S: parseFloat(document.getElementById("score-s")?.value)
        };

        const errorEl = document.getElementById("clb-error");
        const errorMsg = document.getElementById("error-message");
        const resultEl = document.getElementById("clb-result");

        const invalid = Object.entries(scores).some(([, v]) => isNaN(v));
        if (invalid) {
          errorMsg.textContent = "Please enter a score for all four skills before calculating.";
          errorEl.style.display = "block";
          resultEl.style.display = "none";
          return;
        }

        errorEl.style.display = "none";

        const table = tables[test];
        const clbs = {
          L: getClb(table.L, scores.L),
          R: getClb(table.R, scores.R),
          W: getClb(table.W, scores.W),
          S: getClb(table.S, scores.S)
        };

        const grid = document.getElementById("result-grid");
        grid.innerHTML = "";

        ["L", "R", "W", "S"].forEach((skill) => {
          const card = document.createElement("div");
          card.className = `clb-result-card ${getResultClass(clbs[skill])}`;
          card.innerHTML = `
            <div class="clb-result-skill">${skillNames[skill]}</div>
            <div class="clb-result-clb">CLB ${clbs[skill]}</div>
            <div class="clb-result-score">Score: ${scores[skill]}</div>
          `;
          grid.appendChild(card);
        });

        const overallClb = minClb(clbs);
        const crsPoints = crsPointsForProfile(clbs);
        const overallEl = document.getElementById("result-overall");
        const crsEl = document.getElementById("result-crs");
        const noteEl = document.getElementById("result-note");

        overallEl.textContent = `Your lowest CLB level is CLB ${overallClb}. This is your effective overall level for Express Entry eligibility.`;

        crsEl.textContent = `Estimated CRS language points (single applicant, first official language): approximately ${crsPoints} points.`;

        if (overallClb < 7) {
          noteEl.textContent = "You are currently below the CLB 7 minimum required for most Express Entry programs. Focus on your lowest-scoring skill first.";
        } else if (overallClb === 7) {
          noteEl.textContent = "You meet the CLB 7 Express Entry minimum. Improving to CLB 9 in all skills could add approximately 42 additional CRS points.";
        } else if (overallClb < 9) {
          noteEl.textContent = "You exceed the minimum but have room to improve your CRS score. Reaching CLB 9 in all four skills maximizes your language CRS points.";
        } else {
          noteEl.textContent = "You have achieved CLB 9 or above in all four skills -- your language CRS points are at or near maximum.";
        }

        const linksEl = document.getElementById("result-links");
        const testLinks = {
          ielts: [
            { href: "/ielts", label: "Open the IELTS hub", desc: "Access all IELTS skill guides, lessons, and practice tools." },
            { href: "/ai-feedback", label: "Get AI writing feedback", desc: "Submit a Task 1 or Task 2 response for scored feedback." }
          ],
          celpip: [
            { href: "/celpip", label: "Open the CELPIP hub", desc: "Access all CELPIP skill guides, lessons, and practice tools." },
            { href: "/ai-feedback", label: "Get AI writing feedback", desc: "Submit a Task 1 or Task 2 response for scored feedback." }
          ],
          pte: [
            { href: "/pte-core", label: "Open the PTE Core hub", desc: "Access all PTE Core skill guides, the simulator, and lessons." },
            { href: "/pte-core/simulator", label: "Open the PTE Core simulator", desc: "Practice all four sections under timed exam conditions." }
          ]
        };
        const links = testLinks[test] || testLinks.ielts;
        linksEl.innerHTML = `<div class="guide-links">${links.map(l => `<a href="${l.href}"><strong>${l.label}</strong><span>${l.desc}</span></a>`).join("")}</div>`;

        resultEl.style.display = "block";
        resultEl.scrollIntoView({ behavior: "smooth", block: "start" });
      };

      const init = () => {
        document.querySelectorAll('input[name="test"]').forEach((radio) => {
          radio.addEventListener("change", (e) => {
            updatePlaceholders(e.target.value);
            const result = document.getElementById("clb-result");
            const error = document.getElementById("clb-error");
            if (result) result.style.display = "none";
            if (error) error.style.display = "none";
          });
        });

        const btn = document.getElementById("calc-btn");
        if (btn) btn.addEventListener("click", calculate);

        document.querySelectorAll(".clb-input").forEach((input) => {
          input.addEventListener("keydown", (e) => {
            if (e.key === "Enter") calculate();
          });
        });

        updatePlaceholders("ielts");
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
      document.addEventListener("astro:page-load", init);
    })();
  </script>
</Layout>
