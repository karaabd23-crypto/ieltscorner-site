---
import ConversionLayout from "../layouts/ConversionLayout.astro";
---

<ConversionLayout
  title="IELTS Writing Help | Submit Essay for Feedback"
  description="Get score-focused IELTS writing feedback with one clear next step."
  canonical="/ielts-writing-help/"
  keywords="IELTS writing help, IELTS essay feedback, IELTS Band 7 writing"
>
  <section class="section landing-shell">
    <section class="landing-hero">
      <p class="landing-eyebrow">IELTS Writing Support</p>
      <h1>Stuck below Band 7 in IELTS Writing?</h1>
      <p class="landing-subheadline">
        Use one focused path: submit your essay, get detailed correction, and apply the exact changes in your next draft.
      </p>
      <div class="landing-hero__actions">
        <a class="btn btn-primary landing-cta" href="/essay-correction#start-checkout">Submit Essay for Feedback</a>
      </div>
    </section>

    <section class="landing-section">
      <h2>What you get</h2>
      <ul class="landing-list">
        <li>Score-focused correction on grammar, structure, and task response</li>
        <li>Clear next actions for your next writing attempt</li>
        <li>A direct path from mistakes to improvement</li>
      </ul>
    </section>

    <section class="landing-section landing-section--cta">
      <h2>Ready to improve your IELTS writing score?</h2>
      <div class="landing-hero__actions">
        <a class="btn btn-primary landing-cta" href="/essay-correction#start-checkout">Submit Essay for Feedback</a>
      </div>
      <p class="muted" style="margin-top: var(--s-2);">
        Need live coaching instead? <a href="/tutoring#book-private-class">Book Private Class</a>.
      </p>
    </section>
  </section>
</ConversionLayout>