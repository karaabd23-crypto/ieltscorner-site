---
import Layout from "../../../layouts/Layout.astro";
import SkillFreeLessons from "../../../components/SkillFreeLessons.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SkillSubNav from "../../../components/SkillSubNav.astro";
import PteCoreSkillShowcase from "../../../components/PteCoreSkillShowcase.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "PTE Core", path: "/pte-core/" },
    { name: "Speaking", path: "/pte-core/speaking/" },
  ]),
];
---

<Layout
  title="PTE Core Speaking | Strategy and Practice"
  description="Build PTE Core speaking fluency, pronunciation, and response control with guided task pathways."
  keywords="PTE Core speaking, PTE Core speaking practice, PTE Core pronunciation"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "PTE Core", href: "/pte-core" },
    { label: "Speaking" },
  ]} />
  <SkillSubNav exam="PTE_CORE" currentSkill="speaking" />

  <PteCoreSkillShowcase skillSlug="speaking" />

  <SkillFreeLessons exam="PTE_CORE" skill="speaking" />
</Layout>
