---
import Layout from "../../../layouts/Layout.astro";
import SkillFreeLessons from "../../../components/SkillFreeLessons.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SkillSubNav from "../../../components/SkillSubNav.astro";
import PteCoreSkillShowcase from "../../../components/PteCoreSkillShowcase.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "PTE Core", path: "/pte-core/" },
    { name: "Reading", path: "/pte-core/reading/" },
  ]),
];
---

<Layout
  title="PTE Core Reading | Strategy and Practice"
  description="Build PTE Core reading precision with structured question-type strategy and timed workflow guidance."
  keywords="PTE Core reading, PTE Core reading practice, PTE Core question types"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "PTE Core", href: "/pte-core" },
    { label: "Reading" },
  ]} />
  <SkillSubNav exam="PTE_CORE" currentSkill="reading" />

  <PteCoreSkillShowcase skillSlug="reading" />

  <SkillFreeLessons exam="PTE_CORE" skill="reading" />
</Layout>
