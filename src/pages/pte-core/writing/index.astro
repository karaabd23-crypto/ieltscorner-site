---
import Layout from "../../../layouts/Layout.astro";
import SkillFreeLessons from "../../../components/SkillFreeLessons.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SkillSubNav from "../../../components/SkillSubNav.astro";
import PteCoreSkillShowcase from "../../../components/PteCoreSkillShowcase.astro";
import { buildBreadcrumbSchema } from "../../../lib/seo";

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "PTE Core", path: "/pte-core/" },
    { name: "Writing", path: "/pte-core/writing/" },
  ]),
];
---

<Layout
  title="PTE Core Writing | Strategy and Practice"
  description="Improve PTE Core writing control with focused guidance for summarize-written-text and write-email task workflows."
  keywords="PTE Core writing, PTE Core write email, PTE Core summarize written text"
  structuredData={pageStructuredData}
>
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "PTE Core", href: "/pte-core" },
    { label: "Writing" },
  ]} />
  <SkillSubNav exam="PTE_CORE" currentSkill="writing" />

  <PteCoreSkillShowcase skillSlug="writing" />

  <SkillFreeLessons exam="PTE_CORE" skill="writing" />
</Layout>
