---
import Layout from "../../../layouts/Layout.astro";

const PRIVATE_CALENDLY_URL = "https://calendly.com/ieltscorner/60min";
---

<Layout
  title="Booking | IELTS Corner"
  description="Your payment was received. Use Calendly to book your lesson."
  noindex={true}
>
  <section class="section">
    <div class="hero" style={`--hero-bg: url('/heroes/tutoring.png');`}>
      <div class="hero-content">
        <span class="pill">Payment received</span>
        <h1>Book your lesson on Calendly</h1>

        <p class="muted" style="max-width: 62ch;">
          Booking is handled through Calendly. Choose the time that fits you best.
        </p>

        <div class="cluster">
          <a class="btn btn-primary" href={PRIVATE_CALENDLY_URL} target="_blank" rel="noreferrer">
            Open Calendly booking
          </a>
          <a class="btn btn-ghost" href="/tutoring">
            Back to tutoring
          </a>
        </div>
      </div>
    </div>

    <div style="height: var(--s-6);"></div>

    <div class="card">
      <h3 style="margin-top: 0;">Booking note</h3>
      <p class="muted" style="margin-bottom: 0;">
        Use the same name and email used during payment so the booking can be matched quickly.
      </p>
    </div>
  </section>
</Layout>
