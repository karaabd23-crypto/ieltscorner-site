---
import Layout from "../layouts/Layout.astro";

const homeKeywords =
  "IELTS preparation, CELPIP preparation, IELTS lessons, CELPIP lessons, IELTS tutor, CELPIP tutor, IELTS writing feedback, CELPIP writing feedback";
---

<Layout
  title="IELTS and CELPIP Preparation | Choose Your Path"
  description="Pick IELTS or CELPIP, choose the support you need, and follow one clear next step."
  keywords={homeKeywords}
  type="website"
>
  <section class="section home-funnel" style="padding-top: var(--s-6);">
    <div class="hero" style={`--hero-bg: url('/heroes/home.png');`}>
      <div class="hero-content">
        <span class="pill">IELTS + CELPIP prep</span>
        <h1>Pick your exam. Pick your support. Start now.</h1>
        <p class="muted" style="max-width: 58ch;">
          Use one clear path: choose IELTS or CELPIP first, then choose the support option that fits your goal.
        </p>

        <div class="cluster" style="margin-top: var(--s-2);">
          <a class="btn btn-primary" href="/celpip">Go to CELPIP Hub</a>
          <a class="btn btn-ghost" href="/ielts">Go to IELTS Hub</a>
        </div>
      </div>
    </div>

    <section class="surface home-step">
      <p class="home-step__label">Step 1</p>
      <h2>Choose your exam</h2>
      <p class="muted home-step__intro">Both hubs include all four skills: listening, reading, writing, and speaking.</p>

      <div class="grid grid-2" style="gap: var(--s-4); margin-top: var(--s-3);">
        <a class="card home-option-card" href="/celpip" aria-label="Go to CELPIP Hub">
          <p class="home-option-card__kicker">CELPIP</p>
          <h3>CELPIP Hub</h3>
          <p class="muted">Follow CELPIP skill paths and go directly to writing feedback when ready.</p>
          <span class="home-option-card__cta">Go to CELPIP Hub</span>
        </a>

        <a class="card home-option-card" href="/ielts" aria-label="Go to IELTS Hub">
          <p class="home-option-card__kicker">IELTS</p>
          <h3>IELTS Hub</h3>
          <p class="muted">Follow IELTS skill paths and move to writing correction or private support.</p>
          <span class="home-option-card__cta">Go to IELTS Hub</span>
        </a>
      </div>
    </section>

    <section class="surface home-step">
      <p class="home-step__label">Step 2</p>
      <h2>Paid support options</h2>
      <p class="muted home-step__intro">Choose the service that matches what you need right now.</p>

      <div class="grid grid-4" style="gap: var(--s-4); margin-top: var(--s-3);">
        <a class="card home-option-card" href="/ai-feedback" aria-label="Start AI Feedback">
          <p class="home-option-card__kicker">Paid service</p>
          <h3>AI Feedback</h3>
          <p class="muted">For CELPIP writing practice with fast score-based corrections.</p>
          <span class="home-option-card__cta">Start AI Feedback</span>
        </a>

        <a class="card home-option-card" href="/tutoring#book-private-class" aria-label="Book Private Class">
          <p class="home-option-card__kicker">Paid service</p>
          <h3>Private Class</h3>
          <p class="muted">For one-to-one support in listening, reading, writing, or speaking.</p>
          <span class="home-option-card__cta">Book Private Class</span>
        </a>
      </div>
    </section>

    <section class="surface home-step">
      <p class="home-step__label">Step 3</p>
      <h2>Free lessons</h2>
      <p class="muted home-step__intro">If you want to study first, start with the free lesson library.</p>

      <a class="card home-option-card home-option-card--free" href="/lessons" aria-label="Browse Free Lessons">
        <p class="home-option-card__kicker">Free option</p>
        <h3>Free Lessons Library</h3>
        <p class="muted">Grammar, vocabulary, writing, speaking, listening, and reading lessons with search and filters.</p>
        <span class="home-option-card__cta">Browse or Search Free Lessons</span>
      </a>
    </section>
  </section>
</Layout>
