---
import Layout from "../layouts/Layout.astro";
import FeaturedToolsSection from "../components/FeaturedToolsSection.astro";
import { homeFeaturedToolCards } from "../lib/promotionTools";

const homeKeywords =
  "IELTS preparation, CELPIP preparation, PTE Core preparation, IELTS lessons, CELPIP lessons, PTE Core lessons, IELTS tutor, CELPIP tutor, IELTS writing feedback, CELPIP writing feedback, PTE Core simulator";
---

<Layout
  title="IELTS, CELPIP & PTE Core Prep for Canada | IELTS Corner"
  description="Free lessons, practice tests, and a CLB calculator for IELTS, CELPIP, and PTE Core. Built for Canadian PR and citizenship goals. Start free, no card needed."
  keywords={homeKeywords}
  type="website"
>
  <section class="section home-funnel" style="padding-top: var(--s-6);">
    <div class="hero" style={`--hero-bg: url('/heroes/home.webp');`}>
      <div class="hero-content">
        <span class="pill">IELTS + CELPIP + PTE Core prep</span>
        <h1 class="ic-display">Pick your exam. Pick your support. Start now.</h1>
        <p class="muted home-hero__sub">Start free with 80 CELPIP writing tasks and model answers. No card required.</p>
        {/* Task 3: above-the-fold primary CTA straight to the free question bank, thumb-reachable at 375px */}
        <a class="btn btn-primary ic-btn home-hero__primary-cta" href="/questions">Start free practice &rarr;</a>
        <div class="cluster home-hero__exam-links" style="margin-top: var(--s-2);">
          <a class="btn btn-ghost" href="/celpip">CELPIP</a>
          <a class="btn btn-ghost" href="/pte-core">PTE Core</a>
          <a class="btn btn-ghost" href="/ielts">IELTS</a>
          <a class="btn btn-ghost" href="/lessons">Free lessons</a>
        </div>
      </div>
    </div>

    <section class="surface home-step">
      <p class="home-step__label ic-eyebrow">Step 1</p>
      <h2 class="ic-display">Choose your exam</h2>
      <p class="muted home-step__intro">Pick your exam. Each hub has free lessons, practice tools, and paid support in one place.</p>

      <div class="grid grid-3" style="gap: var(--s-4); margin-top: var(--s-3);">
        <a class="card home-option-card ic-card" href="/celpip" aria-label="Go to CELPIP Hub">
          <p class="home-option-card__kicker ic-eyebrow">CELPIP</p>
          <h3>CELPIP Hub</h3>
          <p class="muted">Follow CELPIP skill paths and go directly to writing feedback when ready.</p>
          <span class="home-option-card__cta">Go to CELPIP Hub</span>
        </a>

        <a class="card home-option-card ic-card" href="/pte-core" aria-label="Go to PTE Core Hub">
          <p class="home-option-card__kicker ic-eyebrow">PTE Core</p>
          <h3>PTE Core Hub</h3>
          <p class="muted">Follow PTE Core skill paths and open question-type guides or simulator practice.</p>
          <span class="home-option-card__cta">Go to PTE Core Hub</span>
        </a>

        <a class="card home-option-card ic-card" href="/ielts" aria-label="Go to IELTS Hub">
          <p class="home-option-card__kicker ic-eyebrow">IELTS</p>
          <h3>IELTS Hub</h3>
          <p class="muted">Follow IELTS skill paths and move to writing correction or private support.</p>
          <span class="home-option-card__cta">Go to IELTS Hub</span>
        </a>
      </div>
    </section>

    <section class="surface home-step">
      <p class="home-step__label ic-eyebrow">Step 2</p>
      <FeaturedToolsSection
        eyebrow="Featured CELPIP tools"
        title="Start with the tool that fits your next move"
        intro="Most visitors do better with one clear tool instead of digging through the menu first."
        cards={homeFeaturedToolCards}
        trackPageType="site"
        trackTest="celpip"
        trackSkill="general"
        trackPosition="home-featured-tools"
      />
    </section>

    <section class="surface home-step">
      <p class="home-step__label ic-eyebrow">Step 3</p>
      <h2 class="ic-display">More options</h2>
      <p class="muted home-step__intro">Free lessons, practice questions, private coaching, and a speaking guide.</p>

      <div class="grid grid-3" style="gap: var(--s-4); margin-top: var(--s-3);">
        <a class="card home-option-card home-option-card--free ic-card" href="/lessons" aria-label="Browse Free Lessons">
          <p class="home-option-card__kicker ic-eyebrow">Free</p>
          <h3>Lessons Library</h3>
          <p class="muted">Grammar, vocabulary, writing, speaking, listening, and reading lessons.</p>
          <span class="home-option-card__cta">Browse Free Lessons</span>
        </a>

        <a class="card home-option-card home-option-card--free ic-card" href="/questions" aria-label="Practice Questions">
          <p class="home-option-card__kicker ic-eyebrow">Free</p>
          <h3>Practice Questions</h3>
          <p class="muted">CELPIP email and survey writing tasks at CLB 6 to 10, with model answers.</p>
          <span class="home-option-card__cta">Open Practice Questions</span>
        </a>

        <a class="card home-option-card ic-card" href="/tutoring#book-private-class" aria-label="Book Private Class">
          <p class="home-option-card__kicker ic-eyebrow">1:1 support</p>
          <h3>Private Class</h3>
          <p class="muted">Direct help for any skill. CA$30 per session.</p>
          <span class="home-option-card__cta">Book Private Class</span>
        </a>
      </div>
    </section>
  </section>
</Layout>

<style>
  /* Task 3: prominent, thumb-reachable hero CTA to the free question bank. */
  .home-hero__sub {
    margin-top: var(--s-2);
    max-width: 48ch;
  }

  .home-hero__primary-cta {
    margin-top: var(--s-3);
    font-size: 1.05rem;
    padding: 0.85rem 1.6rem;
  }

  @media (max-width: 480px) {
    /* Full-width tap target, comfortably within thumb reach at 375px. */
    .home-hero__primary-cta {
      display: block;
      width: 100%;
      text-align: center;
      padding: 1rem 1.25rem;
      font-size: 1.1rem;
    }

    .home-hero__exam-links {
      gap: var(--s-2);
    }
  }
</style>
