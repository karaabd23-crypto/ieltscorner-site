---
import Layout from "../layouts/Layout.astro";

const homeKeywords = "IELTS preparation, CELPIP test, Band 7+ IELTS, CLB 9+ CELPIP, English test prep Canada, IELTS lessons, CELPIP lessons, IELTS grammar, IELTS vocabulary, IELTS writing, IELTS speaking, English tutoring Canada";
---

<Layout
  title="IELTS Corner — Band 7+ IELTS & CELPIP Lessons & Tutoring"
  description="Achieve Band 7+ in IELTS or CLB 9+ in CELPIP with expert lessons, proven strategies, and personalized tutoring. Free grammar, vocabulary, writing, and speaking lessons for Canadian English test takers."
  keywords={homeKeywords}
  type="website"
>
  <section class="section" style="padding-top: var(--s-6);">
    <!-- HERO (background image) -->
    <div
      class="hero"
      style={`--hero-bg: url('/heroes/home.png');`}
    >
      <div class="hero-content">
        <span class="pill">🎯 Band 7+ • IELTS &amp; CELPIP</span>

        <h1>Precision English that actually moves your score.</h1>

        <p>
          This site teaches grammar, vocabulary, flow, and tone through exam-focused lessons that you can apply immediately.
        </p>

        <div class="cluster" style="margin-top: var(--s-2);">
          <a class="btn btn-primary" href="/lessons">Free lessons →</a>
          <a class="btn btn-ghost" href="/tutoring">1:1 coaching</a>
        </div>
      </div>
    </div>

    <!-- breathing room -->
    <div style="height: var(--s-8);"></div>

    <!-- TOP CATEGORY CARDS -->
    <div class="grid grid-4">
      <article class="card">
        <h3>Grammar</h3>
        <p>You will learn advanced structures through simple explanations and practical examples.</p>
        <a class="btn" href="/lessons/grammar">Explore →</a>
      </article>

      <article class="card">
        <h3>Vocabulary</h3>
        <p>You will build high-value vocabulary and word groups that improve clarity in test answers.</p>
        <a class="btn" href="/lessons/vocabulary">Explore →</a>
      </article>

      <article class="card">
        <h3>Writing</h3>
        <p>You will practice task response, paragraph flow, and tone control for stronger writing scores.</p>
        <a class="btn" href="/lessons/writing">Explore →</a>
      </article>

      <article class="card">
        <h3>Speaking</h3>
        <p>You will learn how to deliver natural answers with clear structure under exam pressure.</p>
        <a class="btn" href="/lessons/speaking">Explore →</a>
      </article>
    </div>

    <div style="height: var(--s-8);"></div>

    <!-- FEATURE SECTION -->
    <div class="surface feature">
      <div class="feature-grid">
        <div class="stack">
          <h2>Built for serious learners.</h2>
          <p>Most score plateaus happen because of weak structure, not because of low effort.</p>

          <div class="cluster" style="margin-top: var(--s-2);">
            <a class="btn btn-primary" href="/celpip">CELPIP course →</a>
            <a class="btn" href="/ielts">IELTS guide →</a>
          </div>
        </div>

        <div>
          <h3 style="margin: 0 0 var(--s-4);">What you’ll get</h3>

          <div class="checklist">
            <div class="check">
              <div class="icon">✓</div>
              <div>
                <strong>Clear explanations</strong>
                <span>Short. Direct. Test-relevant.</span>
              </div>
            </div>

            <div class="check">
              <div class="icon">✓</div>
              <div>
                <strong>Scoring-aligned practice</strong>
                <span>Coherence + control first.</span>
              </div>
            </div>

            <div class="check">
              <div class="icon">✓</div>
              <div>
                <strong>Reusable frameworks</strong>
                <span>Templates you can repeat.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
