---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="You're in | IELTS Corner"
  description="Thank you for signing up. Your CLB 9 Writing System is on its way."
>
  <section class="section">
    <div class="surface" style="max-width: 540px; margin: 0 auto; text-align: center;">
      <div class="stack" style="align-items: center;">
        <span class="pill">Confirmed</span>
        <h1>You're in.</h1>
        <p class="muted">You'll receive the CLB 9 Writing System shortly. Check your email.</p>
        <hr style="width: 100%; border: none; border-top: 1px solid #ddd;" />
        <p class="muted">While you're here, start improving your score right away:</p>
        <div class="cluster" style="justify-content: center;">
          <a class="btn btn-primary" href="/celpip/writing/ai-feedback">Try AI Writing Feedback</a>
          <a class="btn" href="/celpip/writing/samples">See Band 9 Samples</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
