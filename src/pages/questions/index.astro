---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { buildBreadcrumbSchema } from "../../lib/seo";

const questions = await getCollection("questions");
const sorted = [...questions].sort(
  (a, b) =>
    new Date(b.data.publishedAt).getTime() -
    new Date(a.data.publishedAt).getTime()
);

const pageStructuredData = [
  buildBreadcrumbSchema(Astro.site, [
    { name: "Home", path: "/" },
    { name: "CELPIP Writing Questions", path: "/questions/" },
  ]),
];
---

<Layout
  title="Free CELPIP Practice Questions | IELTS Corner"
  description="Unlock free CELPIP email and survey writing practice questions. Enter your email to access the full CELPIP Question Bank, no credit card required."
  keywords="CELPIP practice questions, CELPIP writing tasks, CLB practice, email writing CELPIP, survey writing CELPIP"
  structuredData={pageStructuredData}
>
  <section class="section">
    <div class="hero" style="--hero-bg: url('/heroes/lesson.webp');">
      <div class="hero-content">
        <span class="pill ic-eyebrow">Free CELPIP Question Bank</span>
        <h1 class="ic-display">Free CELPIP Writing Practice Questions</h1>
        <p class="muted" style="max-width: 60ch;">
          {sorted.length} email and survey tasks at CLB 6 to 10. Each one has a model answer and scoring notes.
        </p>
        <div class="cluster" style="margin-top: var(--s-3);">
          <a class="btn btn-primary ic-btn" href="#questions-gate-section">Unlock free questions</a>
          <a class="btn btn-ghost" href="/ai-feedback">Get writing scored</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sample preview â€” visible before gate -->
  <section class="section-sm">
    <div style="max-width: 860px; margin: 0 auto;">
      <p class="ic-eyebrow" style="margin-bottom: var(--s-2);">Sample questions</p>
      <div class="grid grid-2" style="gap: var(--s-3);">
        {sorted.slice(0, 3).map((q) => (
          <div class="card" style="opacity: 0.92;">
            <div class="cluster" style="justify-content: space-between; margin-bottom: var(--s-2);">
              <span class="pill">{q.data.taskType === "email" ? "Email" : "Survey"}</span>
              <span class="pill">CLB {q.data.targetCLB}</span>
            </div>
            <h3 style="margin-top: 0;">{q.data.title}</h3>
            <p class="muted" style="font-size: 0.9rem; margin-bottom: 0;">
              {q.data.prompt.length > 100 ? q.data.prompt.slice(0, 100) + "â€¦" : q.data.prompt}
            </p>
          </div>
        ))}
        <div class="card" style="display: flex; align-items: center; justify-content: center; min-height: 120px; border: 2px dashed var(--border); background: none;">
          <p class="muted" style="text-align: center; margin: 0;">+{sorted.length - 3} more questions inside</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Email gate (Phase 2) -->
  <section class="section-sm" id="questions-gate-section">
    <div class="surface funnel-section" id="questions-gate" style="max-width: 540px; margin: 0 auto;">
      <h2 style="margin-top: 0;">Enter your email to open all {sorted.length} questions</h2>
      <p class="muted">Free. We will also send you weekly CELPIP tips.</p>

      <form id="questions-gate-form" novalidate>
        <input type="hidden" name="bot-field" value="" />

        <label class="lead-capture__field" style="display: flex; flex-direction: column; gap: var(--s-2); margin-bottom: var(--s-3);">
          <span>Email address</span>
          <input
            id="questions-gate-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="your@email.com"
            style="padding: var(--s-2) var(--s-3); border: 1px solid var(--border); border-radius: var(--radius); font-size: 1rem; width: 100%;"
          />
        </label>

        {/* Task 6: optional daily-prompt opt-in. Tagged in Kit via dailyPrompt flag. */}
        <label class="qbank-daily-optin" style="display: flex; align-items: flex-start; gap: var(--s-2); margin-bottom: var(--s-3); font-size: 0.92rem;">
          <input type="checkbox" id="questions-gate-daily" name="dailyPrompt" style="margin-top: 3px;" />
          <span>Also send me one short CELPIP practice prompt each day.</span>
        </label>

        <button
          id="questions-gate-submit"
          type="submit"
          class="btn btn-primary ic-btn"
          style="width: 100%;"
        >
          Unlock free questions
        </button>

        <p
          id="questions-gate-status"
          style="margin-top: var(--s-3); min-height: 1.4em; font-size: 0.9rem;"
          aria-live="polite"
        ></p>
      </form>
    </div>

    <!-- Question list (hidden until gate is passed) -->
    <div id="questions-list" style="display: none; margin-top: var(--s-5);">
      <div class="cluster" style="justify-content: space-between; align-items: baseline; margin-bottom: var(--s-3);">
        <h2 style="margin: 0;">
          {sorted.length} practice question{sorted.length !== 1 ? "s" : ""}
        </h2>
        {/* Quick win: progress counter from locally tracked visited questions. */}
        <span class="pill qbank-progress" id="qbank-progress" data-total={sorted.length} hidden>
          0 of {sorted.length} done
        </span>
      </div>
      <div class="grid grid-2">
        {sorted.map((q) => (
          <a class="card" href={`/questions/${q.slug}/`}>
            <div class="cluster" style="justify-content: space-between; margin-bottom: var(--s-2);">
              <span class="pill">{q.data.taskType === "email" ? "Email" : "Survey"}</span>
              <span class="pill">CLB {q.data.targetCLB}</span>
            </div>
            <h3 style="margin-top: 0;">{q.data.title}</h3>
            <p class="muted" style="font-size: 0.9rem; margin-bottom: 0;">
              {q.data.prompt.length > 120
                ? q.data.prompt.slice(0, 120) + "â€¦"
                : q.data.prompt}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const STORAGE_KEY = "qbank_unlocked";

  const form = document.getElementById("questions-gate-form") as HTMLFormElement | null;
  const gate = document.getElementById("questions-gate") as HTMLElement | null;
  const list = document.getElementById("questions-list") as HTMLElement | null;
  const status = document.getElementById("questions-gate-status") as HTMLElement | null;
  const submitBtn = document.getElementById("questions-gate-submit") as HTMLButtonElement | null;
  const emailInput = document.getElementById("questions-gate-email") as HTMLInputElement | null;

  const VISITED_KEY = "qbank_visited";

  function getVisitedCount(): number {
    try {
      const raw = localStorage.getItem(VISITED_KEY);
      if (!raw) return 0;
      const arr = JSON.parse(raw);
      return Array.isArray(arr) ? arr.length : 0;
    } catch {
      return 0;
    }
  }

  function updateProgress() {
    const el = document.getElementById("qbank-progress");
    if (!el) return;
    const total = Number(el.getAttribute("data-total") || "0");
    const done = Math.min(getVisitedCount(), total);
    el.textContent = `${done} of ${total} done`;
    el.hidden = false;
  }

  function unlockQuestions() {
    if (gate) gate.style.display = "none";
    if (list) list.style.display = "block";
    updateProgress();
  }

  // Already unlocked in a previous visit
  if (localStorage.getItem(STORAGE_KEY) === "1") {
    unlockQuestions();
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const email = emailInput?.value.trim() ?? "";
    if (!email) {
      if (status) status.textContent = "Please enter your email address.";
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Saving...";
    }
    if (status) status.textContent = "";

    try {
      const dailyInput = document.getElementById("questions-gate-daily") as HTMLInputElement | null;
      const wantsDaily = Boolean(dailyInput?.checked);

      const response = await fetch("/.netlify/functions/subscribe-newsletter", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email,
          source: wantsDaily ? "question-bank-daily" : "question-bank",
          audience: "digest",
          dailyPrompt: wantsDaily,
          formRenderedAt: Date.now(),
          "bot-field": "",
          "cf-turnstile-response": "",
        }),
      });

      const data = await response.json().catch(() => null);

      if (!response.ok) {
        throw new Error(data?.error || "Could not save your email right now.");
      }

      localStorage.setItem(STORAGE_KEY, "1");
      unlockQuestions();
    } catch (error) {
      if (status) {
        status.textContent =
          error instanceof Error && error.message
            ? error.message
            : "We could not save your email right now. Please try again.";
        status.style.color = "var(--text-muted)";
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Unlock free questions";
      }
    }
  });
</script>


