---
import "../styles/global.css";

// TypeScript declaration for AdSense
declare global {
  interface Window {
    adsbygoogle: any[];
  }
}

const {
  title = "IELTS Corner",
  description = "High-level IELTS & CELPIP prep for serious learners.",
  ogImage = "/heroes/lesson.png",
  canonical = Astro.url.pathname,
  type = "website",
  keywords = "IELTS, CELPIP, English test preparation, Band 7+, CLB 9+, English lessons Canada",
} = Astro.props;

const fullTitle = title.includes("IELTS Corner") ? title : `${title} | IELTS Corner`;
const canonicalURL = new URL(canonical, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const isLessonsPath = Astro.url.pathname.startsWith("/lessons");

// Structured data for Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "IELTS Corner",
  "description": "Professional IELTS and CELPIP test preparation with expert tutoring and free lessons",
  "url": Astro.site,
  "logo": new URL("/logo.gif", Astro.site),
  "sameAs": [
    "https://www.instagram.com/ieltscorner.ca",
    "https://www.youtube.com/@KaraAbdolmaleki",
    "https://t.me/Kaysenglishcorner"
  ],
  "areaServed": "Canada",
  "teaches": "English Language",
  "educationalLevel": ["Intermediate", "Advanced"],
};
---

<script is:inline>
  // TypeScript type declaration for AdSense
  window.adsbygoogle = window.adsbygoogle || [];
</script>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="IELTS Corner" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="IELTS Corner" />
    <meta property="og:locale" content="en_CA" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    
    <!-- Favicon and Assets -->
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/src/styles/global.css" />
    
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    
    <!-- Google AdSense -->
    <meta name="google-adsense-account" content="ca-pub-5615542310815721">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5615542310815721"
     crossorigin="anonymous"></script>

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>

    <!-- Calendly global badge -->
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
    <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async is:inline></script>
    <script is:inline>
      window.addEventListener('load', () => {
        if (!window.Calendly || window.__ieltscornerCalendlyBadgeInit) {
          return;
        }

        window.Calendly.initBadgeWidget({
          url: "https://calendly.com/ieltscorner/webinar",
          text: "Register for this week's Webinar",
          color: '#d94848',
          textColor: '#ffffff',
          branding: true,
        });

        window.__ieltscornerCalendlyBadgeInit = true;
      });
    </script>
  </head>

  <body>
    <!-- WEBINAR BANNER (Sticky) -->
    <div style="position: sticky; top: 0; z-index: 100; background: linear-gradient(90deg, var(--accent) 0%, rgba(217, 72, 72, 0.9) 100%); color: white; padding: 12px 0; text-align: center; border-bottom: 1px solid rgba(255, 255, 255, 0.2);">
      <div class="container" style="display: flex; align-items: center; justify-content: center; gap: var(--s-2); flex-wrap: wrap;">
        <span style="font-size: 14px;">🎓 <strong>Weekly Webinar Every Saturday at 6:00 PM PST</strong></span>
        <a href="/webinar" style="color: white; font-weight: 700; font-size: 13px; text-decoration: none; background: rgba(255, 255, 255, 0.2); padding: 6px 12px; border-radius: 999px; transition: background 140ms ease;">
          Register Now →
        </a>
      </div>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <img src="/logo.gif" alt="IELTS Corner logo" />
          <div class="brand-title">
            <strong>IELTS Corner</strong>
            <span>Your bridge to English in Canada</span>
          </div>
        </a>

        <nav class="nav" aria-label="Primary">
          <a href="/ielts">IELTS</a>
          <a href="/celpip">CELPIP</a>
          <a href="/webinar">Webinar</a>
          <a href="/lessons">Free Lessons</a>
          <a href="/ebook">eBook</a>
        </nav>

        <div class="header-right">
          <div class="social" aria-label="Social links">
            <a href="https://www.instagram.com/ieltscorner.ca" target="_blank" rel="noreferrer">IG</a>
            <a href="https://www.youtube.com/@KaraAbdolmaleki" target="_blank" rel="noreferrer">YT</a>
            <a href="https://t.me/Kaysenglishcorner" target="_blank" rel="noreferrer">TG</a>
          </div>
          <a class="cta" href="/tutoring">Book a Lesson</a>
        </div>
      </div>

            <div class="container ad-container-header" style="padding: var(--s-2) 0; display: none;">
        <!-- AdSense Header Banner (Hidden on mobile) -->
        <ins class="adsbygoogle"
              style="display:block; max-height: 120px;"
             data-ad-client="ca-pub-5615542310815721"
             data-ad-slot="9664200893"
              data-ad-format="horizontal"
             data-full-width-responsive="true"></ins>
        <script is:inline>
             (window.adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>
    </header>

    {isLessonsPath && (
      <div id="lesson-email-gate" class="lesson-email-gate" role="dialog" aria-modal="true" aria-labelledby="lesson-email-gate-title">
        <div class="lesson-email-gate__panel surface">
          <h2 id="lesson-email-gate-title" style="margin-top: 0;">Get instant access to all lessons</h2>
          <p class="muted" style="margin-top: 0;">
            Enter your email once to unlock free lesson access. You will also receive lesson updates twice a week.
          </p>

          {/* @ts-ignore */}
          <form
            id="lesson-email-gate-form"
            name="newsletter"
            method="POST"
            action="/newsletter/thanks/"
            netlify
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            class="lesson-email-gate__form"
          >
            <input type="hidden" name="form-name" value="newsletter" />
            <p style="display:none;">
              <label>Don’t fill this out: <input name="bot-field" /></label>
            </p>

            <input
              type="email"
              name="email"
              placeholder="Your email"
              required
              autocomplete="email"
              style="padding: var(--s-2); border-radius: 6px; border: 1px solid var(--text-muted);"
            />
            <button type="submit" class="btn btn-primary">Unlock lessons</button>
          </form>

          <p id="lesson-email-gate-status" role="status" aria-live="polite" class="muted" style="min-height: 1.2rem; margin: var(--s-2) 0 0;"></p>
          <p class="muted" style="font-size: 0.9rem; margin-bottom: 0;">By continuing, you agree to receive lesson emails. You can unsubscribe any time.</p>
        </div>
      </div>
    )}

    <main class="site-main">
      <div class="container">
        <slot />
      </div>
    </main>

    <!-- AdSense Before Footer (Hidden on mobile) -->
        <div class="container ad-container-footer" style="padding: var(--s-3) 0; display: none;">
      <ins class="adsbygoogle"
          style="display:block; max-height: 120px;"
          data-ad-format="horizontal"
           data-ad-client="ca-pub-5615542310815721"
           data-ad-slot="7254823697"></ins>
      <script is:inline>
           (window.adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-inner">
          <div>
            <h3>IELTS Corner</h3>
            <div class="muted">Band 7+ focused lessons for IELTS &amp; CELPIP.</div>
          </div>

          <div>
            <h3>Explore</h3>
            <div class="footer-links">
              <a href="/lessons">Lessons</a>
              <a href="/tutoring">Tutoring</a>
              <a href="/essay-correction">Essay correction</a>
              <a href="/ebook">eBook</a>
            </div>
          </div>

          <div>
            <h3>Social</h3>
            <div class="footer-links">
              <a href="https://www.instagram.com/ieltscorner.ca" target="_blank" rel="noreferrer">Instagram</a>
              <a href="https://www.youtube.com/@KaraAbdolmaleki" target="_blank" rel="noreferrer">YouTube</a>
              <a href="https://t.me/Kaysenglishcorner" target="_blank" rel="noreferrer">Telegram</a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <div>© {new Date().getFullYear()} IELTS Corner</div>
          <div class="muted-2">ieltscorner.com → redirects to ieltscorner.ca</div>
        </div>
      </div>
    </footer>

    {isLessonsPath && (
      <script is:inline>
        (() => {
          const storageKey = 'ieltscorner.lessonsGateUnlocked';
          const gate = document.getElementById('lesson-email-gate');
          const form = document.getElementById('lesson-email-gate-form');
          const status = document.getElementById('lesson-email-gate-status');

          if (!gate) return;

          try {
            if (localStorage.getItem(storageKey) === 'true') {
              gate.remove();
              return;
            }
          } catch {
          }

          document.body.classList.add('lessons-locked');

          if (!(form instanceof HTMLFormElement)) return;

          form.addEventListener('submit', async (event) => {
            event.preventDefault();

            if (status instanceof HTMLElement) {
              status.textContent = 'Unlocking...';
            }

            const formData = new FormData(form);
            const params = new URLSearchParams();
            formData.forEach((value, key) => {
              params.append(key, String(value));
            });

            try {
              const response = await fetch('/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString(),
              });

              if (!response.ok) {
                throw new Error('Request failed');
              }

              try {
                localStorage.setItem(storageKey, 'true');
              } catch {
              }

              gate.remove();
              document.body.classList.remove('lessons-locked');
            } catch {
              form.submit();
            }
          });
        })();
      </script>
    )}

    {isLessonsPath && (
      <style is:global>
        body.lessons-locked {
          overflow: hidden;
        }

        .lesson-email-gate {
          position: fixed;
          inset: 0;
          z-index: 1000;
          display: grid;
          place-items: center;
          padding: var(--s-4);
          background: color-mix(in srgb, var(--text) 55%, transparent);
        }

        .lesson-email-gate__panel {
          width: min(520px, 100%);
          padding: var(--s-5);
          border-radius: 12px;
        }

        .lesson-email-gate__form {
          display: grid;
          grid-template-columns: 1fr auto;
          gap: var(--s-2);
          margin-top: var(--s-3);
        }

        @media (max-width: 640px) {
          .lesson-email-gate__form {
            grid-template-columns: 1fr;
          }
        }
      </style>
    )}
  </body>
</html>
