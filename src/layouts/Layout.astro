---
import "../styles/theme-tokens.css";
import "../styles/global.css";
import TrustStrip from "../components/TrustStrip.astro";
import ConversionTrackingScript from "../components/ConversionTrackingScript.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import ContentAd from "../components/ContentAd.astro";
import ContextualNextStepPromo from "../components/ContextualNextStepPromo.astro";
import IdentityCallbackBridge from "../components/IdentityCallbackBridge.astro";
import { getBlogPromoConfig } from "../lib/promotionTools";

// TypeScript declaration for AdSense
declare global {
  interface Window {
    adsbygoogle: any[];
  }
}

const {
  title = "IELTS Corner",
  description = "High-level IELTS, CELPIP, and PTE Core prep for serious learners.",
  ogImage = "/heroes/lesson.png",
  canonical = Astro.url.pathname,
  type = "website",
  keywords = "IELTS, CELPIP, PTE Core, English test preparation, Band 7+, CLB 9+, English lessons Canada",
  noindex = false,
  structuredData = [],
} = Astro.props;

const fullTitle = title.includes("IELTS Corner") ? title : `${title} | IELTS Corner`;
const canonicalURL = new URL(canonical, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const isLessonsPath = Astro.url.pathname.startsWith("/lessons");
const isLocalPreview = import.meta.env.DEV || ["localhost", "127.0.0.1"].includes(Astro.url.hostname);
const normalizedPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const showLessonEmailGate = isLessonsPath && !isLocalPreview;
const showAds = !isLocalPreview && normalizedPath !== "/ai-feedback";
const currentPath = Astro.url.pathname;
const isBlogArticle = currentPath.startsWith("/blog/") && currentPath !== "/blog/" && currentPath !== "/blog";
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
// Google Search Console verification. Set GOOGLE_SITE_VERIFICATION in Netlify
// env (the token from Search Console > Settings > Ownership verification >
// HTML tag). When unset (local/dev), no tag is emitted.
const googleSiteVerification = import.meta.env.GOOGLE_SITE_VERIFICATION || "";
const isPrePaymentPath =
  normalizedPath === "/ai-feedback" ||
  normalizedPath.startsWith("/tutoring") ||
  normalizedPath.startsWith("/ai-feedback");
const isExamSkillPath =
  ((normalizedPath.startsWith("/celpip/") && normalizedPath !== "/celpip") ||
    (normalizedPath.startsWith("/ielts/") && normalizedPath !== "/ielts") ||
    (normalizedPath.startsWith("/pte-core/") && normalizedPath !== "/pte-core")) &&
  !isPrePaymentPath;
const isExamHubPath = normalizedPath === "/celpip" || normalizedPath === "/ielts" || normalizedPath === "/pte-core";
const isSupportLandingPath =
  normalizedPath === "/celpip-writing-help" ||
  normalizedPath === "/ielts-writing-help";
const isGuidedPath =
  normalizedPath === "/ai-feedback" ||
  normalizedPath === "/celpip" ||
  normalizedPath.startsWith("/celpip/") ||
  normalizedPath === "/pte-core" ||
  normalizedPath.startsWith("/pte-core/") ||
  normalizedPath === "/ielts" ||
  normalizedPath.startsWith("/ielts/") ||
  normalizedPath === "/tutoring" ||
  normalizedPath.startsWith("/tutoring/") ||
  normalizedPath === "/celpip-writing-help" ||
  normalizedPath === "/ielts-writing-help" ||
  normalizedPath.startsWith("/contact/");
const reduceFunnelDistractions =
  isGuidedPath ||
  normalizedPath === "/contact";

const isPathActive = (path: string) =>
  normalizedPath === path || normalizedPath.startsWith(`${path}/`);

const showFocusHeader = false;
const floatingCtaPaths = new Set<string>();
const showFloatingWebinarCta = floatingCtaPaths.has(normalizedPath);
const showFloatingEbookCta =
  !normalizedPath.startsWith('/ebook') &&
  !normalizedPath.startsWith('/ai-feedback');
const showPageBottomAd = showAds && !isGuidedPath;
const highIntentTrackingPaths = new Set([
  "/celpip/reading/clb-6-to-8",
  "/celpip-writing-help",
  "/ielts-writing-help",
  "/ai-feedback",
  "/pte-core/simulator",
  "/pte-core/simulator/practice",
]);

const inferTrackingPageType = (path: string) => {
  if (path.startsWith("/lessons/")) return "lesson";
  if (path.startsWith("/blog/")) return "blog";
  if (path.includes("-help") || path.startsWith("/tutoring")) return "landing";
  if (path.startsWith("/celpip/") || path.startsWith("/ielts/") || path.startsWith("/pte-core/")) return "hub";
  return "site";
};

const inferTrackingTest = (path: string) => {
  if (path.includes("/celpip")) return "celpip";
  if (path.includes("/ielts")) return "ielts";
  if (path.includes("/pte-core")) return "pte_core";
  return "general";
};

const inferTrackingSkill = (path: string) => {
  if (path.includes("/writing")) return "writing";
  if (path.includes("/reading")) return "reading";
  if (path.includes("/speaking")) return "speaking";
  if (path.includes("/listening")) return "listening";
  if (path.includes("/grammar")) return "grammar";
  if (path.includes("/vocabulary")) return "vocabulary";
  return "general";
};

const trackingPageType = inferTrackingPageType(normalizedPath);
const trackingIntentLevel = highIntentTrackingPaths.has(normalizedPath)
  ? "high"
  : ["landing", "hub", "lesson"].includes(trackingPageType)
    ? "medium"
    : "low";
const trackingTest = inferTrackingTest(normalizedPath);
const trackingSkill = inferTrackingSkill(normalizedPath);
const blogPromoConfig = isBlogArticle ? getBlogPromoConfig(normalizedPath) : null;

// Quick win: context-aware sticky CTA. AI Writing Lab on writing pages,
// CELPIP Speaking Guide (eBook) on speaking pages, eBook default elsewhere.
const floatingCta =
  trackingSkill === "writing"
    ? {
        href: "/ai-feedback",
        icon: "✍️",
        text: "Score your writing",
        strong: "AI Lab",
        aria: "Get instant AI writing feedback",
      }
    : {
        href: "/ebook",
        icon: "📖",
        text: "CELPIP Speaking Guide",
        strong: "CA$49.50",
        aria: "Get the CELPIP Speaking Guide - CA$49.50",
      };
const newsletterTurnstileSiteKey = String(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '').trim();

const generalNavGroups = [
  {
    label: 'IELTS',
    href: '/ielts',
    items: [
      { label: 'Listening', href: '/ielts/listening' },
      { label: 'Reading', href: '/ielts/reading' },
      { label: 'Writing', href: '/ielts/writing' },
      { label: 'Speaking', href: '/ielts/speaking' },
      { label: 'Speaking Questions', href: '/ielts/speaking/questions' },
      { label: 'Band Descriptors', href: '/ielts/speaking/band-descriptors' },
    ],
  },
  {
    label: 'CELPIP',
    href: '/celpip',
    items: [
      { label: 'Listening', href: '/celpip/listening' },
      { label: 'Reading', href: '/celpip/reading' },
      { label: 'Writing', href: '/celpip/writing' },
      { label: 'Speaking', href: '/celpip/speaking' },
    ],
  },
  {
    label: 'PTE Core',
    href: '/pte-core',
    items: [
      { label: 'Listening', href: '/pte-core/listening' },
      { label: 'Reading', href: '/pte-core/reading' },
      { label: 'Writing', href: '/pte-core/writing' },
      { label: 'Speaking', href: '/pte-core/speaking' },
      { label: 'Question Types', href: '/pte-core/question-types' },
      { label: 'Simulator', href: '/pte-core/simulator' },
    ],
  },
  {
    label: 'Services',
    href: '/tutoring',
    items: [
      { label: 'Tutoring', href: '/tutoring' },
      { label: 'AI Writing Lab', href: '/ai-feedback' },
      { label: 'eBook', href: '/ebook' },
    ],
  },
  {
    label: 'Resources',
    href: '/lessons',
    items: [
      { label: 'Free Lessons', href: '/lessons' },
      { label: 'CLB Calculator', href: '/clb-calculator' },
      { label: 'Blog', href: '/blog' },
      { label: 'CELPIP for Immigration', href: '/celpip-for-canadian-immigration' },
      { label: 'IELTS vs CELPIP vs PTE', href: '/ielts-vs-celpip-vs-pte-core' },
      { label: 'Success stories', href: '/success-stories' },
      { label: 'FAQ', href: '/faq' },
      { label: 'Contact', href: '/contact' },
      { label: 'About', href: '/about' },
    ],
  },
];

const practiceNavGroup = {
  label: 'Practice',
  href: '/celpip/reading',
  items: [
    { label: 'CELPIP Reading Practice', href: '/celpip/reading' },
    { label: 'CELPIP Writing Practice', href: '/ai-feedback' },
    { label: 'PTE Core Simulator', href: '/pte-core/simulator' },
    { label: 'Free Lessons', href: '/lessons' },
  ],
};

const activeNavGroups = [generalNavGroups[0], generalNavGroups[1], generalNavGroups[2], practiceNavGroup, generalNavGroups[3], generalNavGroups[4]];

// Structured data for Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "IELTS Corner",
  "description": "Professional IELTS, CELPIP, and PTE Core test preparation with expert tutoring and free lessons",
  "url": Astro.site,
  "logo": new URL("/logo.gif", Astro.site),
  "sameAs": [
    "https://www.instagram.com/ieltscorner.ca",
    "https://www.youtube.com/@KaraAbdolmaleki",
    "https://t.me/Kaysenglishcorner"
  ],
  "areaServed": "Canada",
  "teaches": "English Language",
  "educationalLevel": ["Intermediate", "Advanced"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "IELTS Corner",
  "url": Astro.site,
  "inLanguage": "en",
  "publisher": {
    "@type": "EducationalOrganization",
    "name": "IELTS Corner",
    "url": Astro.site,
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": type === "article" ? "Article" : "WebPage",
  "name": fullTitle,
  "description": description,
  "url": canonicalURL,
  "primaryImageOfPage": ogImageURL,
  "inLanguage": "en",
  "isPartOf": {
    "@type": "WebSite",
    "name": "IELTS Corner",
    "url": Astro.site,
  },
  "about": ["IELTS", "CELPIP", "PTE Core", "English test preparation"],
};

const extraStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const pageSchemas = [organizationSchema, websiteSchema, webPageSchema, ...extraStructuredData].filter(Boolean);
const serializeJsonForScript = (value: unknown) =>
  JSON.stringify(value)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026')
    .replace(/\u2028/g, '\\u2028')
    .replace(/\u2029/g, '\\u2029');
---

<script is:inline>
  // TypeScript type declaration for AdSense
  window.adsbygoogle = window.adsbygoogle || [];
</script>

<!doctype html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <GoogleAnalytics measurementId="G-G0WCV3WJ44" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <IdentityCallbackBridge />
    
    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="IELTS Corner" />
    <meta name="robots" content={robotsContent} />
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="IELTS Corner" />
    <meta property="og:locale" content="en_CA" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    
    <!-- Favicon and Assets -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    
    <!-- Structured Data (JSON-LD) -->
    {pageSchemas.map((schema) => (
      <script type="application/ld+json" set:html={serializeJsonForScript(schema)} />
    ))}
    <slot name="head" />
    
    {showAds && (
      <>
        <!-- Google AdSense -->
        <meta name="google-adsense-account" content="ca-pub-5615542310815721">
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5615542310815721"
         crossorigin="anonymous"></script>
      </>
    )}

    <!-- Calendly popup support (disabled while webinar is inactive)
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
    -->
    <style is:inline>
      /* Hide the Calendly auto-badge entirely. we use our own button */
      .calendly-badge-widget { display: none !important; }

      .floating-cta-btn {
        position: fixed;
        bottom: 24px;
        z-index: 1000;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-sizing: border-box;
        height: 48px;
        padding: 0 28px;
        font-size: 0.95rem;
        font-weight: 800;
        font-family: inherit;
        line-height: 1;
        background: transparent;
        color: #d94848;
        border: 2px solid #d94848;
        border-radius: 999px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        text-decoration: none;
        white-space: nowrap;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        cursor: pointer;
        transition: background 140ms ease, color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
      }
      .floating-cta-btn:hover {
        background: #d94848;
        color: #fff;
        transform: scale(1.05);
        box-shadow: 0 4px 20px rgba(0,0,0,0.25);
      }
      .floating-cta-btn--left { left: 24px; }
      .floating-cta-btn--right { right: 24px; }

      @media (max-width: 600px) {
        .floating-cta-btn {
          bottom: 16px;
          height: 42px;
          padding: 0 20px;
          font-size: 0.85rem;
        }
        .floating-cta-btn--left { left: 16px; }
        .floating-cta-btn--right { right: 16px; }
      }

      /* Header ebook pill */
      .cta-ebook {
        background: rgba(217,72,72,0.08);
        color: #d94848;
        border: 1.5px solid rgba(217,72,72,0.3);
        font-weight: 700;
        padding: 0 14px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        text-decoration: none;
        font-size: 0.85rem;
        white-space: nowrap;
        transition: background 140ms, color 140ms, border-color 140ms;
      }
      .cta-ebook:hover {
        background: #d94848;
        color: #fff;
        border-color: #d94848;
      }

      /* Floating ebook button */
      .floating-ebook-btn {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 1000;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px 10px 14px;
        background: #1d1d1d;
        color: #fff;
        border-radius: 999px;
        text-decoration: none;
        font-size: 0.85rem;
        font-family: inherit;
        font-weight: 600;
        box-shadow: 0 4px 18px rgba(0,0,0,0.22);
        transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
        white-space: nowrap;
        animation: ebook-float-in 0.5s 1.2s cubic-bezier(0.34,1.56,0.64,1) both;
      }
      .floating-ebook-btn strong {
        color: #ff9090;
        font-weight: 800;
      }
      .floating-ebook-btn__icon {
        font-size: 1rem;
        line-height: 1;
      }
      .floating-ebook-btn:hover {
        background: #d94848;
        transform: translateY(-2px) scale(1.03);
        box-shadow: 0 6px 24px rgba(217,72,72,0.35);
      }
      .floating-ebook-btn:hover strong {
        color: #fff;
      }
      @keyframes ebook-float-in {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @media (max-width: 600px) {
        .floating-ebook-btn {
          bottom: 16px;
          right: 16px;
          padding: 9px 14px 9px 12px;
          font-size: 0.8rem;
        }
      }
    </style>
    <!-- Calendly widget disabled while webinar is inactive
    <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async is:inline></script>
    <script is:inline>
      window.addEventListener('load', () => {
        const allowBadge = document.body?.dataset.mainPage === '1';
        if (!allowBadge || window.__ieltscornerCalendlyBadgeInit) return;
        if (window.Calendly) {
          window.Calendly.initBadgeWidget({
            url: "https://calendly.com/ieltscorner/weekly_webinar",
            text: "Join Weekly Webinar",
            color: '#c48787',
            textColor: '#ffffff',
            branding: false,
          });
        }
        window.__ieltscornerCalendlyBadgeInit = true;
      });
    </script>
    -->
  </head>

  <body
    class="ic-page"
    data-main-page={showFloatingWebinarCta ? "1" : "0"}
    data-intent-level={trackingIntentLevel}
    data-page-type={trackingPageType}
    data-test={trackingTest}
    data-skill={trackingSkill}
    data-turnstile-site-key={newsletterTurnstileSiteKey}
  >
    <a class="skip-link" href="#main-content">Skip to content</a>

    <form
      name="subscription-cancel-feedback"
      method="POST"
      action="/"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      hidden
      aria-hidden="true"
    >
      <input type="hidden" name="form-name" value="subscription-cancel-feedback" />
      <input type="hidden" name="source_page" />
      <input type="hidden" name="session_id" />
      <input type="hidden" name="subscription_id" />
      <input type="hidden" name="cancel_flow_version" />
      <input type="hidden" name="reason_code" />
      <input type="hidden" name="reason_detail" />
      <input type="hidden" name="improvement_priority" />
      <input type="hidden" name="usage_frequency" />
      <input type="hidden" name="satisfaction_score" />
      <input type="hidden" name="what_would_keep_you" />
      <input type="hidden" name="bot-field" />
    </form>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="IELTS Corner home">
          <img src="/logo.gif" alt="IELTS Corner" loading="eager" decoding="async" />
          <div class="brand-title">
            <strong>IELTS Corner</strong>
            <span>IELTS &amp; CELPIP prep</span>
          </div>
        </a>

        {showFocusHeader ? (
          <div class="header-right header-right--focus"></div>
        ) : (
          <>
            <button
              id="menu-toggle"
              class="menu-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="site-header-panel"
              aria-label="Toggle primary navigation"
            >
              Menu
            </button>

            <div id="site-header-panel" class="header-panel">
              <div class="header-main-row">
                {/* Task 2: condensed mobile nav (Exam / Practice / Account) with a More disclosure.
                    Shown only <=768px; the full desktop nav below is hidden on mobile via CSS. */}
                <nav class="nav nav-mobile" aria-label="Primary navigation (mobile)">
                  <a id="mobile-nav-exam" class="nav-mobile__link" href="/celpip">Exam</a>
                  <a class="nav-mobile__link" href="/celpip/reading/free-test">Practice</a>
                  <a class="nav-mobile__link" href="/account">Account</a>
                  <details class="nav-mobile__more">
                    <summary>More</summary>
                    <div class="nav-mobile__more-links">
                      <a href="/celpip">CELPIP</a>
                      <a href="/ielts">IELTS</a>
                      <a href="/pte-core">PTE Core</a>
                      <a href="/lessons">Free Lessons</a>
                      <a href="/clb-calculator">CLB Calculator</a>
                      <a href="/questions">Question Bank</a>
                      <a href="/ai-feedback">AI Writing Lab</a>
                      <a href="/tutoring">Tutoring</a>
                      <a href="/ebook">eBook</a>
                      <a href="/blog">Blog</a>
                      <a href="/success-stories">Success Stories</a>
                      <a href="/faq">FAQ</a>
                      <a href="/contact">Contact</a>
                      <a href="/account/sign-in">Sign in</a>
                    </div>
                  </details>
                </nav>

                <nav id="primary-navigation" class="nav nav-main" aria-label="Primary navigation">
                  {activeNavGroups.map((group) => {
                    const groupActive = currentPath === group.href || currentPath.startsWith(`${group.href}/`);
                    return (
                      <div class="nav-item nav-item-dropdown">
                        <div class="nav-item-row">
                          <a class:list={["nav-trigger", groupActive && "is-active"]} href={group.href}>
                            <span>{group.label}</span>
                          </a>
                          <button class="nav-expand" type="button" aria-label={`Expand ${group.label} links`} aria-expanded="false">
                            <span aria-hidden="true">v</span>
                          </button>
                        </div>
                        <div class="nav-dropdown" role="menu" aria-label={`${group.label} links`}>
                          {group.items.map((item) => {
                            const itemActive = currentPath === item.href || currentPath.startsWith(`${item.href}/`);
                            return (
                              <a class:list={[itemActive && 'is-active']} href={item.href} role="menuitem">{item.label}</a>
                            );
                          })}
                        </div>
                      </div>
                    );
                  })}

                  <a class:list={["nav-trigger", isPathActive('/account') && 'is-active']} href="/account">
                    <span>Account</span>
                  </a>
                </nav>

                <div class="header-right">
                  <div class="social" aria-label="Social links">
                    <a href="https://www.instagram.com/ieltscorner.ca" target="_blank" rel="noreferrer" aria-label="Instagram">IG</a>
                    <a href="https://www.youtube.com/@KaraAbdolmaleki" target="_blank" rel="noreferrer" aria-label="YouTube">YT</a>
                    <a href="https://t.me/Kaysenglishcorner" target="_blank" rel="noreferrer" aria-label="Telegram">TG</a>
                  </div>

                  <a class="btn btn-primary cta-book" href="/tutoring">Book a class</a>
                  <a class="btn cta-ebook" href="/ebook" aria-label="Get the CELPIP Speaking Guide">CELPIP Speaking Guide</a>
                  <a class="btn cta-signin" href="/account/sign-in">Sign in</a>
                </div>
              </div>
            </div>
          </>
        )}
      </div>
    </header>

    <TrustStrip />

    <script is:inline>
      // Dropdown persistence: keep open for 2s after mouse leaves, close on click elsewhere
      document.addEventListener('DOMContentLoaded', () => {
        const siteHeader = document.querySelector('.site-header');
        const menuToggle = document.getElementById('menu-toggle');
        const dropdowns = document.querySelectorAll('.nav-item-dropdown');
        const expandButtons = document.querySelectorAll('.nav-expand');
        const desktopQuery = window.matchMedia('(min-width: 769px)');
        const mobileQuery = window.matchMedia('(max-width: 768px)');

        const setExpandState = (item, expanded) => {
          const button = item.querySelector('.nav-expand');
          if (button instanceof HTMLButtonElement) {
            button.setAttribute('aria-expanded', String(expanded));
          }
        };

        const closeAllDropdowns = () => {
          dropdowns.forEach((item) => {
            item.classList.remove('dropdown-open');
            setExpandState(item, false);
          });
        };

        const closeMenu = () => {
          if (!siteHeader || !menuToggle) return;
          siteHeader.classList.remove('menu-open');
          menuToggle.setAttribute('aria-expanded', 'false');
          menuToggle.textContent = 'Menu';
          closeAllDropdowns();
        };

        if (menuToggle) {
          menuToggle.addEventListener('click', () => {
            if (!siteHeader) return;
            const isOpen = siteHeader.classList.toggle('menu-open');
            menuToggle.setAttribute('aria-expanded', String(isOpen));
            menuToggle.textContent = isOpen ? 'Close' : 'Menu';
          });
        }

        // Mobile accordion: expand/collapse from dedicated chevron button.
        expandButtons.forEach((button) => {
          button.addEventListener('click', (event) => {
            if (!mobileQuery.matches) return;
            event.preventDefault();
            event.stopPropagation();

            const item = button.closest('.nav-item-dropdown');
            if (!item) return;

            const isOpen = item.classList.contains('dropdown-open');
            closeAllDropdowns();

            if (!isOpen) {
              item.classList.add('dropdown-open');
              setExpandState(item, true);
            }
          });
        });

        // Close mobile menu after choosing any destination link.
        const navLinks = document.querySelectorAll('#primary-navigation a, #site-header-panel .header-right a');
        navLinks.forEach((link) => {
          link.addEventListener('click', () => {
            if (!mobileQuery.matches) return;
            closeMenu();
          });
        });

        dropdowns.forEach((item) => {
          let timeoutId;
          item.addEventListener('mouseenter', () => {
            if (!desktopQuery.matches) return;
            clearTimeout(timeoutId);
            item.classList.add('dropdown-open');
          });
          item.addEventListener('mouseleave', () => {
            if (!desktopQuery.matches) return;
            timeoutId = setTimeout(() => {
              item.classList.remove('dropdown-open');
            }, 2000);
          });
        });

        // Close dropdown immediately if clicking outside
        document.addEventListener('click', (e) => {
          const clickedInsideHeader = e.target instanceof Node && siteHeader?.contains(e.target);
          if (!clickedInsideHeader) {
            closeMenu();
          }

          dropdowns.forEach((item) => {
            if (!(e.target instanceof Node) || !item.contains(e.target)) {
              item.classList.remove('dropdown-open');
              setExpandState(item, false);
            }
          });
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeMenu();
            dropdowns.forEach((item) => item.classList.remove('dropdown-open'));
          }
        });

        desktopQuery.addEventListener('change', (event) => {
          if (event.matches) {
            closeMenu();
            closeAllDropdowns();
          }
        });

        // Task 2: mobile "Exam" entry points at the last exam hub the user visited
        // (defaults to CELPIP). Remember the exam whenever a hub page is open.
        try {
          const path = window.location.pathname;
          const examMap = { '/celpip': 'celpip', '/ielts': 'ielts', '/pte-core': 'pte-core' };
          for (const base in examMap) {
            if (path === base || path.startsWith(base + '/')) {
              localStorage.setItem('ic_last_exam', base);
              break;
            }
          }
          const examLink = document.getElementById('mobile-nav-exam');
          const lastExam = localStorage.getItem('ic_last_exam');
          if (examLink instanceof HTMLAnchorElement && lastExam) {
            examLink.setAttribute('href', lastExam);
            examLink.textContent =
              lastExam === '/ielts' ? 'IELTS' : lastExam === '/pte-core' ? 'PTE Core' : 'CELPIP';
          }
        } catch (_) { /* localStorage unavailable; keep default CELPIP */ }
      });
    </script>

