---
import "../styles/global.css";

// TypeScript declaration for AdSense
declare global {
  interface Window {
    adsbygoogle: any[];
  }
}

const {
  title = "IELTS Corner",
  description = "High-level IELTS & CELPIP prep for serious learners.",
  ogImage = "/heroes/lesson.png",
  canonical = Astro.url.pathname,
  type = "website",
  keywords = "IELTS, CELPIP, English test preparation, Band 7+, CLB 9+, English lessons Canada",
  noindex = false,
  structuredData = [],
} = Astro.props;

const fullTitle = title.includes("IELTS Corner") ? title : `${title} | IELTS Corner`;
const canonicalURL = new URL(canonical, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const isLessonsPath = Astro.url.pathname.startsWith("/lessons");
const isLocalPreview = import.meta.env.DEV || ["localhost", "127.0.0.1"].includes(Astro.url.hostname);
const showLessonEmailGate = isLessonsPath && !isLocalPreview;
const showAds = !isLocalPreview;
const currentPath = Astro.url.pathname;
const isBlogArticle = currentPath.startsWith("/blog/") && currentPath !== "/blog/" && currentPath !== "/blog";
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
const normalizedPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const floatingCtaPaths = new Set(["/", "/ielts", "/celpip", "/webinar"]);
const showFloatingWebinarCta = floatingCtaPaths.has(normalizedPath);

const navGroups = [
  {
    label: 'IELTS',
    href: '/ielts',
    items: [
      { label: 'Overview', href: '/ielts' },
      { label: 'All IELTS lessons', href: '/lessons/ielts' },
      { label: 'Listening', href: '/ielts/listening' },
      { label: 'Reading', href: '/ielts/reading' },
      { label: 'Writing', href: '/ielts/writing' },
      { label: 'Speaking', href: '/ielts/speaking' },
    ],
  },
  {
    label: 'CELPIP',
    href: '/celpip',
    items: [
      { label: 'Overview', href: '/celpip' },
      { label: 'Listening', href: '/celpip/listening' },
      { label: 'Reading', href: '/celpip/reading' },
      { label: 'Writing', href: '/celpip/writing' },
      { label: 'Speaking', href: '/celpip/speaking' },
      { label: 'AI Writing Lab', href: '/celpip/writing/ai-feedback' },
      { label: 'Sample Essays', href: '/celpip/writing/samples' },
    ],
  },
  {
    label: 'Services',
    href: '/tutoring',
    items: [
      { label: 'Tutoring', href: '/tutoring' },
      { label: 'Essay correction', href: '/essay-correction' },
      { label: 'eBook', href: '/ebook' },
      { label: 'Weekly webinar', href: '/webinar' },
    ],
  },
  {
    label: 'Resources',
    href: '/lessons',
    items: [
      { label: 'All lessons', href: '/lessons' },
      { label: 'Blog', href: '/blog' },
      { label: 'Success stories', href: '/success-stories' },
      { label: 'FAQ', href: '/faq' },
      { label: 'Contact', href: '/contact' },
      { label: 'About', href: '/about' },
    ],
  },
];

// Structured data for Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "IELTS Corner",
  "description": "Professional IELTS and CELPIP test preparation with expert tutoring and free lessons",
  "url": Astro.site,
  "logo": new URL("/logo.gif", Astro.site),
  "sameAs": [
    "https://www.instagram.com/ieltscorner.ca",
    "https://www.youtube.com/@KaraAbdolmaleki",
    "https://t.me/Kaysenglishcorner"
  ],
  "areaServed": "Canada",
  "teaches": "English Language",
  "educationalLevel": ["Intermediate", "Advanced"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "IELTS Corner",
  "url": Astro.site,
  "inLanguage": "en",
  "publisher": {
    "@type": "EducationalOrganization",
    "name": "IELTS Corner",
    "url": Astro.site,
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": type === "article" ? "Article" : "WebPage",
  "name": fullTitle,
  "description": description,
  "url": canonicalURL,
  "primaryImageOfPage": ogImageURL,
  "inLanguage": "en",
  "isPartOf": {
    "@type": "WebSite",
    "name": "IELTS Corner",
    "url": Astro.site,
  },
  "about": ["IELTS", "CELPIP", "English test preparation"],
};

const extraStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const pageSchemas = [organizationSchema, websiteSchema, webPageSchema, ...extraStructuredData].filter(Boolean);
---

<script is:inline>
  // TypeScript type declaration for AdSense
  window.adsbygoogle = window.adsbygoogle || [];
</script>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="IELTS Corner" />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="IELTS Corner" />
    <meta property="og:locale" content="en_CA" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    
    <!-- Favicon and Assets -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/src/styles/global.css" />
    
    <!-- Structured Data (JSON-LD) -->
    {pageSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <slot name="head" />
    
    {showAds && (
      <>
        <!-- Google AdSense -->
        <meta name="google-adsense-account" content="ca-pub-5615542310815721">
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5615542310815721"
         crossorigin="anonymous"></script>
      </>
    )}

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>

    <!-- Calendly global badge -->
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
    <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async is:inline></script>
    <script is:inline>
      window.addEventListener('load', () => {
        const allowBadge = document.body?.dataset.mainPage === '1';
        if (!allowBadge || !window.Calendly || window.__ieltscornerCalendlyBadgeInit) {
          return;
        }

        window.Calendly.initBadgeWidget({
          url: "https://calendly.com/ieltscorner/weekly_webinar",
          text: "Weekly webinar",
          color: '#c48787',
          textColor: '#ffffff',
          branding: true,
        });

        window.__ieltscornerCalendlyBadgeInit = true;
      });
    </script>
  </head>

  <body data-main-page={showFloatingWebinarCta ? "1" : "0"}>
    <form
      name="subscription-cancel-feedback"
      method="POST"
      action="/"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      netlify
      hidden
      aria-hidden="true"
    >
      <input type="hidden" name="form-name" value="subscription-cancel-feedback" />
      <input type="hidden" name="source_page" />
      <input type="hidden" name="session_id" />
      <input type="hidden" name="subscription_id" />
      <input type="hidden" name="cancel_flow_version" />
      <input type="hidden" name="reason_code" />
      <input type="hidden" name="reason_detail" />
      <input type="hidden" name="improvement_priority" />
      <input type="hidden" name="usage_frequency" />
      <input type="hidden" name="satisfaction_score" />
      <input type="hidden" name="what_would_keep_you" />
      <input type="hidden" name="bot-field" />
    </form>

    <!-- WEBINAR BANNER (Sticky) -->
    <div class="top-drawer-banner" style="position: relative; z-index: 40; background: linear-gradient(90deg, var(--accent) 0%, rgba(217, 72, 72, 0.9) 100%); color: white; padding: 12px 0; text-align: center; border-bottom: 1px solid rgba(255, 255, 255, 0.2);">
      <div class="container" style="display: flex; align-items: center; justify-content: center; gap: var(--s-2); flex-wrap: wrap;">
        <span style="font-size: 14px;"><strong>Weekly webinar | 100 CELPIP writing prompts + sample responses for CA$5/month</strong></span>
        <a href="/webinar" style="color: white; font-weight: 700; font-size: 13px; text-decoration: none; background: rgba(255, 255, 255, 0.2); padding: 6px 12px; border-radius: 999px; transition: background 140ms ease;">
          Webinar
        </a>
        <a href="/celpip/writing/ai-feedback" style="color: white; font-weight: 700; font-size: 13px; text-decoration: none; background: rgba(255, 255, 255, 0.2); padding: 6px 12px; border-radius: 999px; transition: background 140ms ease;">
          Writing hub
        </a>
        <a href="/celpip/writing/samples" style="color: white; font-weight: 700; font-size: 13px; text-decoration: none; background: rgba(255, 255, 255, 0.2); padding: 6px 12px; border-radius: 999px; transition: background 140ms ease;">
          Sample essays
        </a>
      </div>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="IELTS Corner home">
          <img src="/logo.gif" alt="IELTS Corner" loading="eager" decoding="async" />
          <div class="brand-title">
            <strong>IELTS Corner</strong>
            <span>IELTS &amp; CELPIP prep</span>
          </div>
        </a>

        <button
          id="menu-toggle"
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-header-panel"
          aria-label="Toggle primary navigation"
        >
          Menu
        </button>

        <div id="site-header-panel" class="header-panel">
          <nav id="primary-navigation" class="nav nav-main" aria-label="Primary navigation">
            {navGroups.map((group) => {
              const groupActive = currentPath === group.href || currentPath.startsWith(`${group.href}/`);
              return (
                <div class="nav-item nav-item-dropdown">
                  <div class="nav-item-row">
                    <a class:list={["nav-trigger", groupActive && "is-active"]} href={group.href}>
                      <span>{group.label}</span>
                    </a>
                    <button class="nav-expand" type="button" aria-label={`Expand ${group.label} links`} aria-expanded="false">
                      <span aria-hidden="true">v</span>
                    </button>
                  </div>
                  <div class="nav-dropdown" role="menu" aria-label={`${group.label} links`}>
                    {group.items.map((item) => {
                      const itemActive = currentPath === item.href || currentPath.startsWith(`${item.href}/`);
                      return (
                        <a class:list={[itemActive && 'is-active']} href={item.href} role="menuitem">{item.label}</a>
                      );
                    })}
                  </div>
                </div>
              );
            })}

            <a class:list={["nav-hub", currentPath.startsWith('/celpip/writing/ai-feedback') && 'is-active']} href="/celpip/writing/ai-feedback">
              Writing Hub
            </a>
          </nav>

          <div class="header-right">
            <div class="social" aria-label="Social links">
              <a href="https://www.instagram.com/ieltscorner.ca" target="_blank" rel="noreferrer" aria-label="Instagram">IG</a>
              <a href="https://www.youtube.com/@KaraAbdolmaleki" target="_blank" rel="noreferrer" aria-label="YouTube">YT</a>
              <a href="https://t.me/Kaysenglishcorner" target="_blank" rel="noreferrer" aria-label="Telegram">TG</a>
            </div>
            <a class="btn btn-ghost cta" href="/about">About</a>
            <a class="btn btn-primary cta" href="/tutoring">Book a class</a>
          </div>
        </div>
      </div>
    </header>

    <script is:inline>
      // Dropdown persistence: keep open for 2s after mouse leaves, close on click elsewhere
      document.addEventListener('DOMContentLoaded', () => {
        const siteHeader = document.querySelector('.site-header');
        const menuToggle = document.getElementById('menu-toggle');
        const dropdowns = document.querySelectorAll('.nav-item-dropdown');
        const expandButtons = document.querySelectorAll('.nav-expand');
        const desktopQuery = window.matchMedia('(min-width: 769px)');
        const mobileQuery = window.matchMedia('(max-width: 768px)');

        const setExpandState = (item, expanded) => {
          const button = item.querySelector('.nav-expand');
          if (button instanceof HTMLButtonElement) {
            button.setAttribute('aria-expanded', String(expanded));
          }
        };

        const closeAllDropdowns = () => {
          dropdowns.forEach((item) => {
            item.classList.remove('dropdown-open');
            setExpandState(item, false);
          });
        };

        const closeMenu = () => {
          if (!siteHeader || !menuToggle) return;
          siteHeader.classList.remove('menu-open');
          menuToggle.setAttribute('aria-expanded', 'false');
          menuToggle.textContent = 'Menu';
          closeAllDropdowns();
        };

        if (menuToggle) {
          menuToggle.addEventListener('click', () => {
            if (!siteHeader) return;
            const isOpen = siteHeader.classList.toggle('menu-open');
            menuToggle.setAttribute('aria-expanded', String(isOpen));
            menuToggle.textContent = isOpen ? 'Close' : 'Menu';
          });
        }

        // Mobile accordion: expand/collapse from dedicated chevron button.
        expandButtons.forEach((button) => {
          button.addEventListener('click', (event) => {
            if (!mobileQuery.matches) return;
            event.preventDefault();
            event.stopPropagation();

            const item = button.closest('.nav-item-dropdown');
            if (!item) return;

            const isOpen = item.classList.contains('dropdown-open');
            closeAllDropdowns();

            if (!isOpen) {
              item.classList.add('dropdown-open');
              setExpandState(item, true);
            }
          });
        });

        // Close mobile menu after choosing any destination link.
        const navLinks = document.querySelectorAll('#primary-navigation a, #site-header-panel .header-right a');
        navLinks.forEach((link) => {
          link.addEventListener('click', () => {
            if (!mobileQuery.matches) return;
            closeMenu();
          });
        });

        dropdowns.forEach((item) => {
          let timeoutId;
          item.addEventListener('mouseenter', () => {
            if (!desktopQuery.matches) return;
            clearTimeout(timeoutId);
            item.classList.add('dropdown-open');
          });
          item.addEventListener('mouseleave', () => {
            if (!desktopQuery.matches) return;
            timeoutId = setTimeout(() => {
              item.classList.remove('dropdown-open');
            }, 2000);
          });
        });

        // Close dropdown immediately if clicking outside
        document.addEventListener('click', (e) => {
          const clickedInsideHeader = e.target instanceof Node && siteHeader?.contains(e.target);
          if (!clickedInsideHeader) {
            closeMenu();
          }

          dropdowns.forEach((item) => {
            if (!(e.target instanceof Node) || !item.contains(e.target)) {
              item.classList.remove('dropdown-open');
              setExpandState(item, false);
            }
          });
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeMenu();
            dropdowns.forEach((item) => item.classList.remove('dropdown-open'));
          }
        });

        desktopQuery.addEventListener('change', (event) => {
          if (event.matches) {
            closeMenu();
            closeAllDropdowns();
          }
        });
      });
    </script>

    {showLessonEmailGate && (
      <div id="lesson-email-gate" class="lesson-email-gate" role="dialog" aria-modal="true" aria-labelledby="lesson-email-gate-title">
        <div class="lesson-email-gate__panel surface">
          <h2 id="lesson-email-gate-title" style="margin-top: 0;">Get instant access to all lessons</h2>
          <p class="muted" style="margin-top: 0;">
            Enter your email once to unlock free lesson access. You will also receive lesson updates twice a week.
          </p>

          {/* @ts-ignore */}
          <form
            id="lesson-email-gate-form"
            name="newsletter"
            method="POST"
            action="/newsletter/thanks/"
            netlify
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            class="lesson-email-gate__form"
          >
            <input type="hidden" name="form-name" value="newsletter" />
            <p style="display:none;">
              <label>Do not fill this out: <input name="bot-field" /></label>
            </p>

            <input
              type="email"
              name="email"
              placeholder="Your email"
              required
              autocomplete="email"
              style="padding: var(--s-2); border-radius: 6px; border: 1px solid var(--text-muted);"
            />
            <button type="submit" class="btn btn-primary">Unlock lessons</button>
          </form>

          <p id="lesson-email-gate-status" role="status" aria-live="polite" class="muted" style="min-height: 1.2rem; margin: var(--s-2) 0 0;"></p>
          <p class="muted" style="font-size: 0.9rem; margin-bottom: 0;">By continuing, you agree to receive lesson emails. You can unsubscribe any time.</p>
        </div>
      </div>
    )}

    <main class="site-main">
      <div class="container">
        <slot />

        {isBlogArticle && (
          <section class="teacher-trust-banner surface">
            <div class="teacher-trust-banner__body">
              <p class="teacher-trust-banner__label">About The Instructor</p>
              <h2>Written by Kara Abdolmaleki.</h2>
              <p class="teacher-trust-banner__copy">
                If you want to know more about the person behind these articles, the About page includes
                exam results, training, and classroom background.
              </p>
            </div>
            <div class="teacher-trust-banner__actions">
              <a class="btn btn-primary" href="/about">About Kara</a>
              <a class="btn" href="/about#evidence-and-qualifications">See background</a>
            </div>
          </section>
        )}

        {isBlogArticle && (
          <section class="blog-post-cta surface">
            <div class="blog-post-cta__hero">
              <p class="blog-post-cta__label">Need direct feedback?</p>
              <h2>Turn this article into a score plan.</h2>
              <p class="blog-post-cta__copy">
                Read the guide first. Then choose the support that matches your next step:
                essay correction, a private class, the AI writing lab, or the weekly webinar.
              </p>
            </div>
            <div class="blog-post-cta__grid">
              <a class="blog-post-cta__card" href="/essay-correction">
                <span class="blog-post-cta__icon" aria-hidden="true">A+</span>
                <strong>Essay Correction</strong>
                <span>Get line-by-line comments and score guidance on one draft.</span>
              </a>
              <a class="blog-post-cta__card" href="/tutoring">
                <span class="blog-post-cta__icon" aria-hidden="true">1:1</span>
                <strong>Private Tutoring</strong>
                <span>Work directly on the exact skill gap behind your score.</span>
              </a>
              <a class="blog-post-cta__card" href="/celpip/writing/ai-feedback">
                <span class="blog-post-cta__icon" aria-hidden="true">AI</span>
                <strong>AI Writing Lab</strong>
                <span>Practice under time pressure and get instant writing analysis.</span>
              </a>
              <a class="blog-post-cta__card" href="/webinar">
                <span class="blog-post-cta__icon" aria-hidden="true">Live</span>
                <strong>Weekly Webinar</strong>
                <span>Join a live lesson and study with real exam-style examples.</span>
              </a>
            </div>
          </section>
        )}
      </div>
    </main>

    <!-- AdSense Before Footer -->
    {showAds && (
      <div class="container ad-container-footer ad-shell ad-shell--line" style="padding: var(--s-3) 0;">
        <ins class="adsbygoogle ad-unit-line"
            style="display:block"
            data-ad-format="horizontal"
            data-full-width-responsive="false"
            data-ad-client="ca-pub-5615542310815721"
            data-ad-slot="7254823697"></ins>
        <script is:inline>
             (window.adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>
    )}

    <footer class="site-footer">
      <div class="container">
        <div class="footer-inner">
          <div>
            <h3>IELTS Corner</h3>
            <div class="muted">Band 7+ focused lessons for IELTS &amp; CELPIP.</div>
          </div>

          <div>
            <h3>Explore</h3>
            <div class="footer-links">
              <a href="/lessons">Lessons</a>
              <a href="/tutoring">Tutoring</a>
              <a href="/essay-correction">Essay correction</a>
              <a href="/ebook">eBook</a>
              <a href="/about">About</a>
            </div>
          </div>

          <div>
            <h3>Social</h3>
            <div class="footer-links">
              <a href="https://www.instagram.com/ieltscorner.ca" target="_blank" rel="noreferrer">Instagram</a>
              <a href="https://www.youtube.com/@KaraAbdolmaleki" target="_blank" rel="noreferrer">YouTube</a>
              <a href="https://t.me/Kaysenglishcorner" target="_blank" rel="noreferrer">Telegram</a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <div>&copy; {new Date().getFullYear()} IELTS Corner</div>
          <div class="muted-2">ieltscorner.com redirects to ieltscorner.ca</div>
        </div>
      </div>
    </footer>

    {showLessonEmailGate && (
      <script is:inline>
        (() => {
          const storageKey = 'ieltscorner.newsletterSignup';
          const gate = document.getElementById('lesson-email-gate');
          const form = document.getElementById('lesson-email-gate-form');
          const status = document.getElementById('lesson-email-gate-status');
          const normalizeEmail = (value) => String(value || '').trim().toLowerCase();
          const readSignup = () => {
            try {
              const raw = localStorage.getItem(storageKey);
              if (!raw) return null;

              const parsed = JSON.parse(raw);
              if (!parsed || typeof parsed !== 'object') return null;

              return parsed;
            } catch {
              return null;
            }
          };
          const saveSignup = (email) => {
            try {
              localStorage.setItem(storageKey, JSON.stringify({
                email: normalizeEmail(email),
                unlockedLessons: true,
                subscribedAt: new Date().toISOString(),
              }));
            } catch {
            }
          };
          const unlockGate = () => {
            gate.remove();
            document.body.classList.remove('lessons-locked');
          };

          if (!gate) return;

          try {
            const savedSignup = readSignup();
            if (savedSignup?.email) {
              unlockGate();
              return;
            }
          } catch {
          }

          document.body.classList.add('lessons-locked');

          if (!(form instanceof HTMLFormElement)) return;

          form.addEventListener('submit', async (event) => {
            event.preventDefault();

            const emailInput = form.elements.namedItem('email');
            const email = emailInput instanceof HTMLInputElement ? normalizeEmail(emailInput.value) : '';

            if (!email) {
              if (status instanceof HTMLElement) {
                status.textContent = 'Please enter a valid email.';
              }
              return;
            }

            const savedSignup = readSignup();
            if (savedSignup?.email === email) {
              saveSignup(email);
              if (status instanceof HTMLElement) {
                status.textContent = 'Welcome back! Your lessons are unlocked.';
              }
              unlockGate();
              return;
            }

            if (status instanceof HTMLElement) {
              status.textContent = 'Unlocking...';
            }

            const formData = new FormData(form);
            const params = new URLSearchParams();
            formData.forEach((value, key) => {
              params.append(key, String(value));
            });

            try {
              const response = await fetch('/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString(),
              });

              if (!response.ok) {
                throw new Error('Request failed');
              }

              saveSignup(email);
              if (status instanceof HTMLElement) {
                status.textContent = 'Success! Your lessons are unlocked.';
              }
              unlockGate();
            } catch {
              if (savedSignup?.email === email) {
                saveSignup(email);
                if (status instanceof HTMLElement) {
                  status.textContent = 'Welcome back! Your lessons are unlocked.';
                }
                unlockGate();
                return;
              }

              if (status instanceof HTMLElement) {
                status.textContent = 'We had trouble submitting your email. Please try again.';
              }
            }
          });
        })();
      </script>
    )}

    {showLessonEmailGate && (
      <style is:global>
        body.lessons-locked {
          overflow: hidden;
        }

        .lesson-email-gate {
          position: fixed;
          inset: 0;
          z-index: 1000;
          display: grid;
          place-items: center;
          padding: var(--s-4);
          background: color-mix(in srgb, var(--text) 55%, transparent);
        }

        .lesson-email-gate__panel {
          width: min(520px, 100%);
          padding: var(--s-5);
          border-radius: 12px;
        }

        .lesson-email-gate__form {
          display: grid;
          grid-template-columns: 1fr auto;
          gap: var(--s-2);
          margin-top: var(--s-3);
        }

        @media (max-width: 640px) {
          .lesson-email-gate__form {
            grid-template-columns: 1fr;
          }
        }
      </style>
    )}
  </body>
</html>
