    <script is:inline>
      (() => {
        const globalName = '__ieltscornerNewsletterGuard';
        if (window[globalName]) return;

        const siteKey = String(document.body?.dataset.turnstileSiteKey || '').trim();
        const turnstileScriptSrc = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        let turnstileScriptPromise = null;

        const ensureHiddenInput = (form, name, value = '') => {
          const existing = form.elements.namedItem(name);
          if (existing instanceof HTMLInputElement) {
            if (!existing.value) {
              existing.value = value;
            }
            return existing;
          }

          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = name;
          input.value = value;
          form.appendChild(input);
          return input;
        };

        const ensureSignals = (form) => {
          if (!(form instanceof HTMLFormElement)) return;
          if (!form.dataset.newsletterRenderedAt) {
            form.dataset.newsletterRenderedAt = String(Date.now());
          }

          const renderedAtInput = ensureHiddenInput(form, 'form_rendered_at', form.dataset.newsletterRenderedAt);
          renderedAtInput.value = form.dataset.newsletterRenderedAt;
          ensureHiddenInput(form, 'bot-field', '');
        };

        const ensureTurnstileScript = () => {
          if (!siteKey) return Promise.resolve(false);
          if (window.turnstile?.render) return Promise.resolve(true);
          if (turnstileScriptPromise) return turnstileScriptPromise;

          turnstileScriptPromise = new Promise((resolve) => {
            const existing = document.querySelector('script[data-newsletter-turnstile="1"]');
            if (existing) {
              existing.addEventListener('load', () => resolve(Boolean(window.turnstile?.render)), { once: true });
              existing.addEventListener('error', () => resolve(false), { once: true });
              window.setTimeout(() => resolve(Boolean(window.turnstile?.render)), 900);
              return;
            }

            const script = document.createElement('script');
            script.src = turnstileScriptSrc;
            script.async = true;
            script.defer = true;
            script.dataset.newsletterTurnstile = '1';
            script.onload = () => resolve(Boolean(window.turnstile?.render));
            script.onerror = () => resolve(false);
            document.head.appendChild(script);
          });

          return turnstileScriptPromise;
        };

        const ensureTurnstileContainer = (form) => {
          if (!siteKey) return null;
          let container = form.querySelector('[data-turnstile-container]');
          if (container instanceof HTMLElement) return container;

          container = document.createElement('div');
          container.setAttribute('data-turnstile-container', '1');
          container.style.marginTop = '0.5rem';
          container.style.marginBottom = '0.5rem';
          form.appendChild(container);
          return container;
        };

        const ensureTurnstileWidget = async (form) => {
          if (!siteKey || !(form instanceof HTMLFormElement)) {
            return null;
          }

          const loaded = await ensureTurnstileScript();
          if (!loaded || !window.turnstile?.render) {
            return null;
          }

          if (form.dataset.turnstileWidgetId) {
            return form.dataset.turnstileWidgetId;
          }

          const container = ensureTurnstileContainer(form);
          if (!(container instanceof HTMLElement)) {
            return null;
          }

          const widgetId = window.turnstile.render(container, {
            sitekey: siteKey,
            theme: 'auto',
          });
          form.dataset.turnstileWidgetId = String(widgetId);
          return form.dataset.turnstileWidgetId;
        };

        const getTurnstileToken = (form) => {
          if (!(form instanceof HTMLFormElement)) return '';
          const tokenFromInput = form.querySelector('input[name="cf-turnstile-response"]');
          if (tokenFromInput instanceof HTMLInputElement && tokenFromInput.value) {
            return tokenFromInput.value.trim();
          }

          const widgetId = form.dataset.turnstileWidgetId;
          if (!widgetId || !window.turnstile?.getResponse) {
            return '';
          }

          try {
            return String(window.turnstile.getResponse(widgetId) || '').trim();
          } catch {
            return '';
          }
        };

        const buildAntiBotPayload = (form) => {
          if (!(form instanceof HTMLFormElement)) {
            return {
              formRenderedAt: null,
              botField: '',
              turnstileToken: '',
            };
          }

          ensureSignals(form);
          const botFieldInput = form.elements.namedItem('bot-field');
          const botField = botFieldInput instanceof HTMLInputElement ? String(botFieldInput.value || '') : '';

          return {
            formRenderedAt: form.dataset.newsletterRenderedAt || null,
            botField,
            turnstileToken: getTurnstileToken(form),
          };
        };

        const prepareForm = async (form) => {
          if (!(form instanceof HTMLFormElement)) return;
          ensureSignals(form);
          await ensureTurnstileWidget(form);
        };

        const validateFormBeforeSubmit = async (form) => {
          await prepareForm(form);
          const antiBot = buildAntiBotPayload(form);
          if (siteKey && !antiBot.turnstileToken) {
            return {
              ok: false,
              error: 'Please complete the verification step before submitting.',
              antiBot,
            };
          }
          return { ok: true, antiBot };
        };

        const resetTurnstile = (form) => {
          const widgetId = form?.dataset?.turnstileWidgetId;
          if (!widgetId || !window.turnstile?.reset) return;
          try {
            window.turnstile.reset(widgetId);
          } catch {
          }
        };

        window[globalName] = {
          siteKey,
          prepareForm,
          buildAntiBotPayload,
          validateFormBeforeSubmit,
          resetTurnstile,
        };
      })();
    </script>

    {showLessonEmailGate && (
      <script is:inline>
        (() => {
          const storageKey = 'ieltscorner.digestSignup';
          const legacyStorageKey = 'ieltscorner.newsletterSignup';
          const readingGuideSource = 'instagram-celpip-reading-guide';
          const gate = document.getElementById('lesson-email-gate');
          const form = document.getElementById('lesson-email-gate-form');
          const status = document.getElementById('lesson-email-gate-status');
          const normalizeEmail = (value) => String(value || '').trim().toLowerCase();
          const readSignup = () => {
            try {
              const raw = localStorage.getItem(storageKey) || localStorage.getItem(legacyStorageKey);
              if (!raw) return null;

              const parsed = JSON.parse(raw);
              if (!parsed || typeof parsed !== 'object') return null;
              if (parsed?.source === readingGuideSource) return null;

              return parsed;
            } catch {
              return null;
            }
          };
          const saveSignup = (email) => {
            try {
              localStorage.setItem(storageKey, JSON.stringify({
                email: normalizeEmail(email),
                unlockedLessons: true,
                audience: 'digest',
                source: 'lesson-email-gate',
                subscribedAt: new Date().toISOString(),
              }));
            } catch {
            }
          };
          const unlockGate = () => {
            gate.remove();
            document.body.classList.remove('lessons-locked');
          };

          if (!gate) return;

          try {
            const savedSignup = readSignup();
            if (savedSignup?.email) {
              unlockGate();
              return;
            }
          } catch {
          }

          document.body.classList.add('lessons-locked');

          if (!(form instanceof HTMLFormElement)) return;
          const newsletterGuard = window.__ieltscornerNewsletterGuard || null;
          newsletterGuard?.prepareForm?.(form).catch(() => {});

          const submitWithFunction = async ({ email, antiBot }) => {
            const response = await fetch('/.netlify/functions/subscribe-newsletter', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email,
                source: 'lesson-email-gate',
                audience: 'digest',
                formRenderedAt: antiBot?.formRenderedAt || null,
                'bot-field': antiBot?.botField || '',
                'cf-turnstile-response': antiBot?.turnstileToken || '',
              }),
            });
            const data = await response.json().catch(() => null);

            if (!response.ok) {
              throw new Error(data?.error || 'Function request failed');
            }

            return data;
          };

          form.addEventListener('submit', async (event) => {
            event.preventDefault();

            const emailInput = form.elements.namedItem('email');
            const email = emailInput instanceof HTMLInputElement ? normalizeEmail(emailInput.value) : '';

            if (!email) {
              if (status instanceof HTMLElement) {
                status.textContent = 'Please enter a valid email.';
              }
              return;
            }

            const savedSignup = readSignup();
            if (savedSignup?.email === email) {
              saveSignup(email);
              if (status instanceof HTMLElement) {
                status.textContent = 'Welcome back! Your lessons are unlocked.';
              }
              unlockGate();
              return;
            }

            if (status instanceof HTMLElement) {
              status.textContent = 'Unlocking...';
            }

            try {
              const verification = await newsletterGuard?.validateFormBeforeSubmit?.(form);
              if (verification && !verification.ok) {
                if (status instanceof HTMLElement) {
                  status.textContent = verification.error || 'Please complete the verification step and try again.';
                }
                return;
              }

              const data = await submitWithFunction({
                email,
                antiBot: verification?.antiBot || newsletterGuard?.buildAntiBotPayload?.(form),
              });

              saveSignup(email);
              if (status instanceof HTMLElement) {
                status.textContent = data?.duplicate
                  ? 'Welcome back! Your lessons are unlocked.'
                  : 'Success! Your lessons are unlocked.';
              }
              unlockGate();
            } catch (error) {
              newsletterGuard?.resetTurnstile?.(form);
              if (savedSignup?.email === email) {
                saveSignup(email);
                if (status instanceof HTMLElement) {
                  status.textContent = 'Welcome back! Your lessons are unlocked.';
                }
                unlockGate();
                return;
              }

              if (status instanceof HTMLElement) {
                status.textContent = error instanceof Error && error.message
                  ? error.message
                  : 'We had trouble submitting your email. Please try again.';
              }
            }
          });
        })();
      </script>
    )}

    <script is:inline>
      (() => {
        const newsletterGuard = window.__ieltscornerNewsletterGuard || null;
        const forms = Array.from(document.querySelectorAll('form[data-newsletter-capture="kit"]'));
        if (!forms.length) return;

        const normalizeEmail = (value) => String(value || '').trim().toLowerCase();
        const normalizeName = (value) => String(value || '').trim().replace(/\s+/g, ' ').slice(0, 80);

        forms.forEach((candidate) => {
          if (!(candidate instanceof HTMLFormElement)) return;
          if (candidate.dataset.newsletterBound === '1') return;
          candidate.dataset.newsletterBound = '1';
          newsletterGuard?.prepareForm?.(candidate).catch(() => {});

          candidate.addEventListener('submit', async (event) => {
            event.preventDefault();

            const emailInput = candidate.elements.namedItem('email');
            const nameInput = candidate.elements.namedItem('name');
            const sourceInput = candidate.elements.namedItem('source');
            const audienceInput = candidate.elements.namedItem('audience');
            const successPathInput = candidate.elements.namedItem('success_path');

            const email = emailInput instanceof HTMLInputElement ? normalizeEmail(emailInput.value) : '';
            const firstName = nameInput instanceof HTMLInputElement ? normalizeName(nameInput.value) : '';
            const source = sourceInput instanceof HTMLInputElement
              ? String(sourceInput.value || '').trim()
              : (candidate.getAttribute('name') || 'site');
            const audience = audienceInput instanceof HTMLInputElement
              ? String(audienceInput.value || '').trim()
              : 'digest';
            const successPath = successPathInput instanceof HTMLInputElement
              ? String(successPathInput.value || '').trim()
              : String(candidate.getAttribute('action') || '/thank-you/').trim();

            const status = candidate.parentElement?.querySelector('[data-newsletter-status]');
            const submitButton = candidate.querySelector('button[type="submit"]');

            if (!email || !email.includes('@')) {
              if (status instanceof HTMLElement) {
                status.textContent = 'Please enter a valid email address.';
              }
              return;
            }

            if (status instanceof HTMLElement) {
              status.textContent = 'Submitting...';
            }
            if (submitButton instanceof HTMLButtonElement) {
              submitButton.disabled = true;
            }

            try {
              const verification = await newsletterGuard?.validateFormBeforeSubmit?.(candidate);
              if (verification && !verification.ok) {
                if (status instanceof HTMLElement) {
                  status.textContent = verification.error || 'Please complete the verification step and try again.';
                }
                return;
              }

              const antiBotPayload = verification?.antiBot || newsletterGuard?.buildAntiBotPayload?.(candidate) || {};
              const response = await fetch('/.netlify/functions/subscribe-newsletter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  email,
                  firstName,
                  source,
                  audience,
                  formRenderedAt: antiBotPayload.formRenderedAt || null,
                  'bot-field': antiBotPayload.botField || '',
                  'cf-turnstile-response': antiBotPayload.turnstileToken || '',
                }),
              });
              const data = await response.json().catch(() => null);

              if (!response.ok) {
                throw new Error(data?.error || 'Subscribe request failed');
              }

              if (status instanceof HTMLElement) {
                status.textContent = data?.duplicate
                  ? 'You are already subscribed. Redirecting...'
                  : 'Success. Redirecting...';
              }
              window.location.href = successPath || '/thank-you/';
            } catch (error) {
              newsletterGuard?.resetTurnstile?.(candidate);
              if (status instanceof HTMLElement) {
                status.textContent = error instanceof Error && error.message
                  ? error.message
                  : 'We could not save your email right now. Please try again.';
              }
            } finally {
              if (submitButton instanceof HTMLButtonElement) {
                submitButton.disabled = false;
              }
            }
          });
        });
      })();
    </script>

