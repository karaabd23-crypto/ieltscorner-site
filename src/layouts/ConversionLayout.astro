---
import "../styles/global.css";
import ConversionTrackingScript from "../components/ConversionTrackingScript.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import GaConversionBridge from "../components/GaConversionBridge.astro";

const {
  title = "IELTS Corner",
  description = "IELTS and CELPIP training pages with clear next steps.",
  canonical = Astro.url.pathname,
  keywords = "IELTS writing help, CELPIP writing help, Band 7 writing, CLB 9 writing",
  noindex = false,
} = Astro.props;

const fullTitle = title.includes("IELTS Corner") ? title : `${title} | IELTS Corner`;
const canonicalURL = new URL(canonical, Astro.site);
const robots = noindex ? "noindex, nofollow" : "index, follow";
const normalizedPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const highIntentTrackingPaths = new Set([
  "/celpip/reading/clb-6-to-8",
  "/celpip-writing-help",
  "/ielts-writing-help",
  "/essay-correction",
  "/essay-correction/submit",
]);

const inferTrackingTest = (path: string) => {
  if (path.includes("/celpip")) return "celpip";
  if (path.includes("/ielts")) return "ielts";
  return "general";
};

const inferTrackingSkill = (path: string) => {
  if (path.includes("/writing")) return "writing";
  if (path.includes("/reading")) return "reading";
  if (path.includes("/speaking")) return "speaking";
  if (path.includes("/listening")) return "listening";
  return "general";
};

const trackingIntentLevel = highIntentTrackingPaths.has(normalizedPath) ? "high" : "medium";
const trackingTest = inferTrackingTest(normalizedPath);
const trackingSkill = inferTrackingSkill(normalizedPath);
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleAnalytics measurementId="G-G0WCV3WJ44" />
    <GaConversionBridge />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
  </head>
  <body
    data-intent-level={trackingIntentLevel}
    data-page-type="landing"
    data-test={trackingTest}
    data-skill={trackingSkill}
  >
    <main class="conversion-main">
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-inner">
          <div>
            <h3>IELTS Corner</h3>
            <div class="muted">Band 7+ and CLB 9+ focused prep for IELTS, CELPIP &amp; PTE Core.</div>
          </div>

          <div>
            <h3>Explore</h3>
            <div class="footer-links">
              <a href="/celpip">CELPIP</a>
              <a href="/ielts">IELTS</a>
              <a href="/pte-core">PTE Core</a>
              <a href="/lessons">Lessons</a>
              <a href="/clb-calculator">CLB Calculator</a>
              <a href="/blog">Blog</a>
              <a href="/faq">FAQ</a>
              <a href="/contact">Contact</a>
            </div>
          </div>

          <div>
            <h3>Social</h3>
            <div class="footer-links">
              <a href="https://www.instagram.com/ieltscorner.ca" target="_blank" rel="noreferrer">Instagram</a>
              <a href="https://www.youtube.com/@KaraAbdolmaleki" target="_blank" rel="noreferrer">YouTube</a>
              <a href="https://t.me/Kaysenglishcorner" target="_blank" rel="noreferrer">Telegram</a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <div>&copy; {new Date().getFullYear()} IELTS Corner</div>
          <div class="muted-2">ieltscorner.com redirects to ieltscorner.ca</div>
        </div>
      </div>
    </footer>
    <ConversionTrackingScript />
  </body>
</html>
