---
import Layout from "./Layout.astro";

// TypeScript declaration for AdSense
declare global {
  interface Window {
    adsbygoogle: any[];
  }
}

/* ---------- Types ---------- */
type NavItem = {
  href: string;
  label: string;
};

type Props = {
  title: string;
  description?: string;
  pill?: string;
  meta?: string[];
  nav?: NavItem[];
  videoEmbed?: string;

  /* quickCheck is typically Astro/JSX content or null.
     Type it loosely to avoid TS config differences. */
  quickCheck?: any;

  progressPct?: number;
};

/* ---------- Props ---------- */
const {
  title,
  description,
  pill = "📘 Lesson",
  meta = [],
  nav = [],
  videoEmbed = "",
  quickCheck = null,
  progressPct = 0,
} = Astro.props as Props;
---

<Layout title={title} description={description}>
  <!-- Hero -->
  <section class="section">
    <div class="shell">
      <div class="stack">
        <span class="pill">{pill}</span>
        <h1 style="margin-bottom:0.2em;">{title}</h1>

        {meta.length > 0 && (
          <div class="lesson-meta">
            {meta.map((m) => (
              <span class="pill">{m}</span>
            ))}
          </div>
        )}

        <div
          class="progress"
          style={`--pct:${progressPct}%; margin-top: var(--s-3);`}
          aria-label="Lesson progress"
        >
          <span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- AdSense After Hero -->
  <section style="padding: var(--s-3) 0;">
    <div class="shell">
      <ins class="adsbygoogle"
           style="display:block; text-align:center; max-height: 250px;"
           data-ad-layout="in-article"
           data-ad-format="fluid"
           data-ad-client="ca-pub-5615542310815721"
           data-ad-slot="4411874215"></ins>
      <script is:inline>
           (window.adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  </section>

  <!-- Content -->
  <section class="section-sm">
    <div class="shell split">
      <!-- Left nav -->
      <aside class="sidebar">
        <div class="panel">
          <h3 class="panel-title">Lesson sections</h3>

          {nav.length > 0 ? (
            <ul class="list">
              {nav.map((n) => (
                <li>
                  <a href={n.href}>{n.label}</a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted" style="margin:0;">This lesson follows a clear progression from explanation to examples, practice, and review so you can study in order without guessing what to do next.</p>
          )}
        </div>

        <div class="panel">
          <h3 class="panel-title">Next step</h3>
          <a class="btn btn-primary" href="/celpip">
            Continue CELPIP course →
          </a>
        </div>
      </aside>

      <!-- Main -->
      <main class="stack">
        {videoEmbed && <div class="video-frame" set:html={videoEmbed}></div>}

        <div class="panel" style="padding: var(--s-2) var(--s-3);">
          <ins class="adsbygoogle"
               style="display:block; max-height: 90px;"
               data-ad-client="ca-pub-5615542310815721"
               data-ad-slot="9664200893"
               data-ad-format="horizontal"
               data-full-width-responsive="true"></ins>
          <script is:inline>
               (window.adsbygoogle = window.adsbygoogle || []).push({});
          </script>
        </div>

        <div class="panel">
          <slot />
        </div>
      </main>

      <!-- Right rail -->
      <aside class="sidebar">
        <!-- AdSense Sidebar -->
        <div class="panel" style="padding: var(--s-3); background: var(--surface);">
          <ins class="adsbygoogle"
               style="display:block"
               data-ad-client="ca-pub-5615542310815721"
               data-ad-slot="5544332211"
               data-ad-format="auto"
               data-full-width-responsive="true"></ins>
          <script is:inline>
               (window.adsbygoogle = window.adsbygoogle || []).push({});
          </script>
        </div>

        <div class="panel">
          <h3 class="panel-title">Quick check</h3>
          {quickCheck ? (
            quickCheck
          ) : (
            <p class="muted" style="margin:0;">After reading the lesson, summarize the main rule in one sentence and create one original example to confirm you can apply the idea independently.</p>
          )}
        </div>

        <div class="panel">
          <h3 class="panel-title">Download</h3>
          <p class="muted" style="margin:0;">If you need a printable worksheet for this topic, send a request through tutoring and include the lesson title so the material can match your current level.</p>
        </div>
      </aside>
    </div>
  </section>
</Layout>
