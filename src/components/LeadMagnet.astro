---
interface Props {
  title?: string;
  text?: string;
  buttonLabel?: string;
  formName?: string;
  redirectTo?: string;
}

const {
  title = "Get CELPIP writing updates by email",
  text = "Subscribe for weekly CELPIP writing strategies, lesson updates, and new resources when they are ready.",
  buttonLabel = "Subscribe",
  formName = "newsletter-subscribe",
  redirectTo = "/thank-you",
} = Astro.props;
---

<section class="section-sm">
  <div class="surface feature">
    <div class="stack lead-magnet">
      <span class="pill">Free subscription</span>
      <h2>{title}</h2>
      <p class="muted">{text}</p>
      <form
        name={formName}
        method="POST"
        action={redirectTo}
        data-newsletter-capture="kit"
        class="lead-magnet-form"
      >
        <input type="hidden" name="source" value={formName} />
        <input type="hidden" name="audience" value="digest" />
        <input type="hidden" name="success_path" value={redirectTo} />
        <input
          type="email"
          name="email"
          required
          placeholder="Your email address"
          autocomplete="email"
          class="lead-magnet-input"
        />
        <button type="submit" class="btn btn-primary lead-magnet-btn">
          {buttonLabel}
        </button>
      </form>
      <p class="muted lead-magnet-disclaimer" data-newsletter-status style="min-height: 1.2rem; margin-top: var(--s-2);"></p>
      <p class="muted lead-magnet-disclaimer">No spam. Unsubscribe anytime.</p>
    </div>
  </div>
</section>

<style>
  .lead-magnet {
    text-align: center;
    align-items: center;
    max-width: 48ch;
    margin: 0 auto;
  }

  .lead-magnet h2 {
    margin-top: var(--s-2);
  }

  .lead-magnet-form {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    width: 100%;
    margin-top: var(--s-3);
  }

  .lead-magnet-input {
    font-family: var(--body-font);
    font-size: 1rem;
    padding: var(--s-3) var(--s-4);
    border: 1px solid #ccc;
    border-radius: 6px;
    width: 100%;
    box-sizing: border-box;
  }

  .lead-magnet-input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--accent);
  }

  .lead-magnet-btn {
    padding: var(--s-3) var(--s-5);
    font-size: 1.05rem;
    width: 100%;
    cursor: pointer;
  }

  .lead-magnet-disclaimer {
    font-size: 0.85rem;
    margin-top: var(--s-1);
  }

  @media (min-width: 600px) {
    .lead-magnet-form {
      flex-direction: row;
    }

    .lead-magnet-input {
      flex: 1;
    }

    .lead-magnet-btn {
      width: auto;
      flex-shrink: 0;
    }
  }
</style>
