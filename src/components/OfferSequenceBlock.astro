---
type SequenceStep = {
  title: string;
  copy: string;
  ctaLabel: string;
  href: string;
  offer: string;
};

type Props = {
  test?: "ielts" | "celpip" | "general";
  skill?: "reading" | "writing" | "speaking" | "listening" | "general";
  pageType?: string;
  position?: string;
  className?: string;
  heading?: string;
};

const {
  test = "general",
  skill = "general",
  pageType = "hub",
  position = "end",
  className = "",
  heading = "What to do next",
} = Astro.props as Props;

const buildSequence = (): SequenceStep[] => {
  if (test === "celpip" && skill === "reading") {
    return [
      {
        title: "Diagnose and improve",
        copy: "Subscribe for weekly reading strategy emails and updates when new tools are available.",
        ctaLabel: "Subscribe by Email",
        href: "/celpip/reading/clb-6-to-8#celpip-reading-checklist",
        offer: "lead_capture",
      },
      {
        title: "Get direct feedback",
        copy: "Book a private reading session for guided strategy and trap-elimination methods.",
        ctaLabel: "Book Reading Session",
        href: "/tutoring?src=offer-sequence-reading",
        offer: "tutoring",
      },
      {
        title: "Work with me live",
        copy: "Book a private reading session for your exact CLB problem.",
        ctaLabel: "Book 1:1 Reading Session",
        href: "/tutoring?src=offer-sequence-reading",
        offer: "tutoring",
      },
    ];
  }

  if (test === "celpip" && skill === "writing") {
    return [
      {
        title: "Diagnose and improve",
        copy: "Subscribe for weekly writing strategy emails and updates when new tools are available.",
        ctaLabel: "Subscribe by Email",
        href: "/celpip-writing-help#celpip-writing-checklist-optin",
        offer: "lead_capture",
      },
      {
        title: "Get direct feedback",
        copy: "Practice under timed conditions and get instant CLB scoring on your writing.",
        ctaLabel: "Try AI Writing Feedback",
        href: "/ai-feedback?src=offer-sequence-celpip-writing",
        offer: "ai_feedback",
      },
      {
        title: "Work with me live",
        copy: "Use private coaching to turn feedback into faster CLB score gains.",
        ctaLabel: "Book 1:1 Writing Session",
        href: "/tutoring?src=offer-sequence-celpip-writing",
        offer: "tutoring",
      },
    ];
  }

  return [
    {
      title: "Diagnose and improve",
      copy: "Subscribe for weekly IELTS writing strategy emails and updates when new tools are available.",
      ctaLabel: "Subscribe by Email",
      href: "/ielts-writing-help#ielts-writing-structure-guide-optin",
      offer: "lead_capture",
    },
    {
      title: "Get direct feedback",
      copy: "Practice under timed conditions and get instant AI scoring on your writing.",
      ctaLabel: "Try AI Writing Feedback",
      href: "/ai-feedback?src=offer-sequence-ielts-writing",
      offer: "ai_feedback",
    },
    {
      title: "Work with me live",
      copy: "Join live or private coaching to speed up your Band 7+ progress.",
      ctaLabel: "Book 1:1 Writing Session",
      href: "/tutoring?src=offer-sequence-ielts-writing",
      offer: "tutoring",
    },
  ];
};

const steps = buildSequence();
---

<section class:list={["surface offer-sequence", className]}>
  <h3>{heading}</h3>
  <div class="offer-sequence__grid">
    {steps.map((step, index) => (
      <article class="offer-sequence__step">
        <p class="offer-sequence__index">{index + 1}</p>
        <h4>{step.title}</h4>
        <p>{step.copy}</p>
        <a
          class="btn btn-primary"
          href={step.href}
          data-track-click={`offer-sequence-step-${index + 1}`}
          data-track-page-type={pageType}
          data-track-offer={step.offer}
          data-track-test={test}
          data-track-skill={skill}
          data-track-position={position}
        >
          {step.ctaLabel}
        </a>
      </article>
    ))}
  </div>
</section>
