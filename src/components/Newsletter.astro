---
interface Props {
  title?: string;
  description?: string;
  placeholder?: string;
  buttonText?: string;
  showBackground?: boolean;
}

const {
  title = "Get weekly IELTS tips",
  description = "Tips, strategies, and new lessons delivered to your inbox every week. Unsubscribe anytime.",
  placeholder = "Your email",
  buttonText = "Join now →",
  showBackground = true
} = Astro.props;
---

<div 
  class:list={[
    "newsletter-signup",
    { "with-background": showBackground }
  ]}
  style={showBackground ? "padding: var(--s-4); background: var(--accent-light); border-radius: 8px; text-align: center;" : ""}
>
  <h3 style={`margin-top: 0; ${showBackground ? '' : 'text-align: center;'}`}>{title}</h3>
  <p style={`color: var(--text-muted); ${showBackground ? '' : 'text-align: center;'}`}>{description}</p>
  
  {/* @ts-ignore */}
  <form 
    name="newsletter"
    method="POST"
    action="/newsletter/thanks/"
    netlify
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    id="newsletter-form"
    class="newsletter-form"
    style="display: grid; grid-template-columns: 1fr auto; gap: var(--s-1); margin-top: var(--s-2);"
  >
    <input 
      type="hidden" 
      name="form-name" 
      value="newsletter" 
    />

    <p style="display:none;">
      <label>Don’t fill this out: <input name="bot-field" /></label>
    </p>
    
    <input
      type="email"
      name="email"
      placeholder={placeholder}
      required
      style="padding: var(--s-2); border: 1px solid var(--text-muted); border-radius: 4px; font-size: 1rem; background: white;"
    />
    
    <button 
      type="submit"
      class="btn btn-primary"
      style="white-space: nowrap;"
    >
      {buttonText}
    </button>
  </form>

  <p id="newsletter-status" role="status" aria-live="polite" style="font-size: 0.9rem; margin-top: var(--s-1); min-height: 1.2rem;"></p>

  <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: var(--s-2); margin-bottom: 0;">
    No spam. We respect your inbox. <a href="/privacy" style="color: var(--accent);">Privacy policy</a>
  </p>
</div>

<script>
  const form = document.getElementById('newsletter-form');
  const status = document.getElementById('newsletter-status');

  if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      status.textContent = 'Submitting...';
      status.style.color = 'var(--text-muted)';

      const formData = new FormData(form);
      const params = new URLSearchParams();
      formData.forEach((value, key) => {
        params.append(key, String(value));
      });
      const encoded = params.toString();

      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: encoded,
        });

        if (!response.ok) {
          throw new Error('Request failed');
        }

        status.textContent = 'Thanks! You are subscribed.';
        status.style.color = 'var(--accent)';
        form.reset();
        window.location.href = '/newsletter/thanks/';
      } catch {
        status.textContent = 'Could not subscribe right now. Please try again.';
        status.style.color = 'var(--text)';
      }
    });
  }
</script>

<style>
  @media (max-width: 640px) {
    :global(.newsletter-form) {
      grid-template-columns: 1fr !important;
    }
  }
</style>
