---
interface Props {
  title?: string;
  description?: string;
  placeholder?: string;
  buttonText?: string;
  showBackground?: boolean;
}

const {
  title = "Get weekly IELTS tips",
  description = "Short study tips, strategy notes, and new lessons sent to your inbox each week.",
  placeholder = "Your email",
  buttonText = "Join now",
  showBackground = true,
} = Astro.props;
---

<div
  class:list={[
    "newsletter-signup",
    { "with-background": showBackground },
  ]}
  style={showBackground ? "padding: var(--s-4); background: var(--accent-light); border-radius: 8px; text-align: center;" : ""}
>
  <h3 style={`margin-top: 0; ${showBackground ? "" : "text-align: center;"}`}>{title}</h3>
  <p style={`color: var(--text-muted); ${showBackground ? "" : "text-align: center;"}`}>{description}</p>

  {/* @ts-ignore */}
  <form
    name="newsletter"
    method="POST"
    action="/newsletter/thanks/"
    netlify
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    id="newsletter-form"
    class="newsletter-form"
    style="display: grid; grid-template-columns: 1fr auto; gap: var(--s-1); margin-top: var(--s-2);"
  >
    <input type="hidden" name="form-name" value="newsletter" />

    <p style="display:none;">
      <label>Do not fill this out: <input name="bot-field" /></label>
    </p>

    <input
      type="email"
      name="email"
      placeholder={placeholder}
      required
      style="padding: var(--s-2); border: 1px solid var(--text-muted); border-radius: 4px; font-size: 1rem; background: white;"
    />

    <button
      type="submit"
      class="btn btn-primary"
      style="white-space: nowrap;"
    >
      {buttonText}
    </button>
  </form>

  <p id="newsletter-status" role="status" aria-live="polite" style="font-size: 0.9rem; margin-top: var(--s-1); min-height: 1.2rem;"></p>

  <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: var(--s-2); margin-bottom: 0;">
    No spam. We respect your inbox. <a href="/privacy" style="color: var(--accent);">Privacy policy</a>
  </p>
</div>

<script>
  const storageKey = "ieltscorner.newsletterSignup";
  const form = document.getElementById("newsletter-form");
  const status = document.getElementById("newsletter-status");
  const normalizeEmail = (value: string) => String(value || "").trim().toLowerCase();
  const readSignup = () => {
    try {
      const raw = localStorage.getItem(storageKey);
      if (!raw) return null;

      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== "object") return null;

      return parsed;
    } catch {
      return null;
    }
  };
  const saveSignup = (email: string) => {
    try {
      localStorage.setItem(storageKey, JSON.stringify({
        email: normalizeEmail(email),
        unlockedLessons: true,
        subscribedAt: new Date().toISOString(),
      }));
    } catch {
    }
  };

  if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
    const savedSignup = readSignup();
    if (savedSignup?.email) {
      status.textContent = `You are already subscribed as ${savedSignup.email}.`;
      status.style.color = "var(--accent)";
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const emailInput = form.elements.namedItem("email");
      const email = emailInput instanceof HTMLInputElement ? normalizeEmail(emailInput.value) : "";

      if (!email) {
        status.textContent = "Please enter a valid email.";
        status.style.color = "var(--text-muted)";
        return;
      }

      const saved = readSignup();
      if (saved?.email === email) {
        saveSignup(email);
        status.textContent = "You are already subscribed. No need to sign up again.";
        status.style.color = "var(--accent)";
        return;
      }

      status.textContent = "Submitting...";
      status.style.color = "var(--text-muted)";

      const formData = new FormData(form);
      const params = new URLSearchParams();
      formData.forEach((value, key) => {
        params.append(key, String(value));
      });
      const encoded = params.toString();

      try {
        const response = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: encoded,
        });

        if (!response.ok) {
          throw new Error("Request failed");
        }

        saveSignup(email);
        status.textContent = "Thanks. You are subscribed.";
        status.style.color = "var(--accent)";
        form.reset();
        window.location.href = "/newsletter/thanks/";
      } catch {
        if (saved?.email === email) {
          saveSignup(email);
          status.textContent = "You are already subscribed. No duplicate signup was created.";
          status.style.color = "var(--accent)";
          return;
        }

        status.textContent = "Retrying with standard submit...";
        status.style.color = "var(--text-muted)";
        form.submit();
      }
    });
  }
</script>

<style>
  @media (max-width: 640px) {
    :global(.newsletter-form) {
      grid-template-columns: 1fr !important;
    }
  }
</style>
