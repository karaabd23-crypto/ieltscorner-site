---
interface Props {
  title?: string;
  description?: string;
  placeholder?: string;
  buttonText?: string;
  showBackground?: boolean;
}

const {
  title = "Get weekly IELTS tips",
  description = "Short study tips, strategy notes, and new lessons sent to your inbox each week.",
  placeholder = "Your email",
  buttonText = "Join now",
  showBackground = true,
} = Astro.props;
---

<div
  class:list={[
    "newsletter-signup",
    { "with-background": showBackground },
  ]}
  style={showBackground ? "padding: var(--s-4); background: var(--accent-light); border-radius: 8px; text-align: center;" : ""}
>
  <h3 style={`margin-top: 0; ${showBackground ? "" : "text-align: center;"}`}>{title}</h3>
  <p style={`color: var(--text-muted); ${showBackground ? "" : "text-align: center;"}`}>{description}</p>

  {/* @ts-ignore */}
  <form
    name="newsletter"
    method="POST"
    action="/newsletter/thanks/"
    id="newsletter-form"
    class="newsletter-form"
    style="display: grid; grid-template-columns: 1fr auto; gap: var(--s-1); margin-top: var(--s-2);"
  >
    <input
      type="email"
      name="email"
      placeholder={placeholder}
      required
      style="padding: var(--s-2); border: 1px solid var(--text-muted); border-radius: 4px; font-size: 1rem; background: white;"
    />

    <button
      type="submit"
      class="btn btn-primary"
      style="white-space: nowrap;"
    >
      {buttonText}
    </button>
  </form>

  <p id="newsletter-status" role="status" aria-live="polite" style="font-size: 0.9rem; margin-top: var(--s-1); min-height: 1.2rem;"></p>

  <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: var(--s-2); margin-bottom: 0;">
    No spam. We respect your inbox. <a href="/privacy" style="color: var(--accent);">Privacy policy</a>
  </p>
</div>

<script>
  const storageKey = "ieltscorner.digestSignup";
  const legacyStorageKey = "ieltscorner.newsletterSignup";
  const readingGuideSource = "instagram-celpip-reading-guide";
  const form = document.getElementById("newsletter-form");
  const status = document.getElementById("newsletter-status");
  const getNewsletterGuard = () => (window as any).__ieltscornerNewsletterGuard || null;
  const normalizeEmail = (value: string) => String(value || "").trim().toLowerCase();
  const readSignup = () => {
    try {
      const raw = localStorage.getItem(storageKey) || localStorage.getItem(legacyStorageKey);
      if (!raw) return null;

      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== "object") return null;
      if (parsed?.source === readingGuideSource) return null;

      return parsed;
    } catch {
      return null;
    }
  };
  const saveSignup = (email: string) => {
    try {
      localStorage.setItem(storageKey, JSON.stringify({
        email: normalizeEmail(email),
        unlockedLessons: true,
        audience: "digest",
        source: "newsletter-component",
        subscribedAt: new Date().toISOString(),
      }));
    } catch {
    }
  };

  if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
    getNewsletterGuard()?.prepareForm?.(form).catch(() => {});
    const savedSignup = readSignup();
    if (savedSignup?.email) {
      status.textContent = `You are already subscribed as ${savedSignup.email}.`;
      status.style.color = "var(--accent)";
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const emailInput = form.elements.namedItem("email");
      const email = emailInput instanceof HTMLInputElement ? normalizeEmail(emailInput.value) : "";

      if (!email) {
        status.textContent = "Please enter a valid email.";
        status.style.color = "var(--text-muted)";
        return;
      }

      status.textContent = "Submitting...";
      status.style.color = "var(--text-muted)";

      try {
        const newsletterGuard = getNewsletterGuard();
        const verification = await newsletterGuard?.validateFormBeforeSubmit?.(form);
        if (verification && !verification.ok) {
          status.textContent = verification.error || "Please complete the verification step before submitting.";
          status.style.color = "var(--text-muted)";
          return;
        }

        const antiBotPayload = verification?.antiBot || newsletterGuard?.buildAntiBotPayload?.(form) || {};
        const response = await fetch("/.netlify/functions/subscribe-newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email,
            source: "newsletter-component",
            audience: "digest",
            formRenderedAt: antiBotPayload.formRenderedAt || null,
            "bot-field": antiBotPayload.botField || "",
            "cf-turnstile-response": antiBotPayload.turnstileToken || "",
          }),
        });
        const data = await response.json().catch(() => null);

        if (!response.ok) {
          throw new Error(data?.error || "Request failed");
        }

        saveSignup(email);
        status.textContent = data?.duplicate
          ? "You are already subscribed. No duplicate signup was created."
          : "Thanks. You are subscribed.";
        status.style.color = "var(--accent)";
        form.reset();
        window.location.href = "/newsletter/thanks/";
      } catch (error) {
        getNewsletterGuard()?.resetTurnstile?.(form);
        status.textContent = error instanceof Error && error.message
          ? error.message
          : "We could not save your signup right now. Please try again in a moment.";
        status.style.color = "var(--text-muted)";
      }
    });
  }
</script>

<style>
  @media (max-width: 640px) {
    :global(.newsletter-form) {
      grid-template-columns: 1fr !important;
    }
  }
</style>
