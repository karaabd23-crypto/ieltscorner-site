---
/**
 * Mobile-first "quick facts" strip for exam skill pages.
 * Renders a compact, scannable row of fact chips + a short focus list.
 * Designed to give thin skill pages visual interest and at-a-glance value
 * on small screens (single column at 375px, multi-column on wider viewports).
 */
interface Fact {
  label: string;
  value: string;
}

interface Props {
  heading?: string;
  facts: Fact[];
  focusPoints?: string[];
}

const { heading = "At a glance", facts, focusPoints = [] } = Astro.props as Props;
---

<section class="section-sm">
  <div class="surface skill-quick-facts">
    <h2 class="ic-display skill-quick-facts__heading">{heading}</h2>

    <div class="skill-quick-facts__grid">
      {facts.map((fact) => (
        <div class="skill-quick-facts__card">
          <p class="skill-quick-facts__value">{fact.value}</p>
          <p class="skill-quick-facts__label">{fact.label}</p>
        </div>
      ))}
    </div>

    {focusPoints.length > 0 && (
      <ul class="skill-quick-facts__focus">
        {focusPoints.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .skill-quick-facts {
    padding: clamp(18px, 2vw + 10px, 28px);
  }

  .skill-quick-facts__heading {
    margin: 0 0 var(--s-3);
    font-size: 1.25rem;
  }

  .skill-quick-facts__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-2);
  }

  .skill-quick-facts__card {
    border: 1px solid var(--border);
    border-radius: var(--radius-card, 8px);
    padding: var(--s-3);
    background: color-mix(in srgb, var(--accent) 5%, var(--surface));
    text-align: center;
  }

  .skill-quick-facts__value {
    margin: 0;
    font-family: var(--ic-font-display, serif);
    font-weight: 600;
    font-size: 1.35rem;
    line-height: 1.1;
    color: var(--accent);
  }

  .skill-quick-facts__label {
    margin: var(--s-1) 0 0;
    font-size: 0.8rem; /* 12px floor at the 15px root */
    color: var(--muted);
    line-height: 1.3;
  }

  .skill-quick-facts__focus {
    margin: var(--s-3) 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: var(--s-1);
  }

  .skill-quick-facts__focus li {
    line-height: 1.5;
  }

  /* Mobile-first: two-up on small screens, single column at the narrowest. */
  @media (max-width: 760px) {
    .skill-quick-facts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 380px) {
    .skill-quick-facts__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
