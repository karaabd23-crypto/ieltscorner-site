---
type Props = {
  heading?: string;
  message?: string;
  buttonLabel?: string;
  source?: string;
  formName?: string;
  formType?: string;
  className?: string;
  pageType?: string;
  offer?: string;
  test?: string;
  skill?: string;
  position?: string;
};

const {
  heading = "Get free Band 7+ strategies every week",
  message = "Get free Band 7+ strategies every week",
  buttonLabel = "Get Free Strategies",
  source = "site",
  formName = "lead-capture",
  formType = "lead_capture_general",
  className = "",
  pageType = "content",
  offer = "lead_capture",
  test = "general",
  skill = "general",
  position = "form_section",
} = Astro.props as Props;
---

<section class:list={["lead-capture", className]}>
  <h3>{heading}</h3>
  <p>{message}</p>
  <form
    name={formName}
    method="POST"
    action="/thank-you/"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    data-track-form={formName}
    data-track-form-type={formType}
    data-track-page-type={pageType}
    data-track-offer={offer}
    data-track-test={test}
    data-track-skill={skill}
    data-track-position={position}
    class="lead-capture__form"
  >
    <input type="hidden" name="form-name" value={formName} />
    <input type="hidden" name="source" value={source} />
    <p class="lead-capture__honeypot">
      <label>Do not fill this out: <input name="bot-field" /></label>
    </p>
    <label class="lead-capture__field">
      <span>Name</span>
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label class="lead-capture__field">
      <span>Email</span>
      <input type="email" name="email" required autocomplete="email" />
    </label>
    <button
      type="submit"
      class="btn btn-primary"
      data-track-click={`${formName}-submit`}
      data-track-page-type={pageType}
      data-track-offer={offer}
      data-track-test={test}
      data-track-skill={skill}
      data-track-position={position}
    >
      {buttonLabel}
    </button>
  </form>
</section>
