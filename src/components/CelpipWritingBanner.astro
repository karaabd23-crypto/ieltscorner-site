---
// Compact shortcut banner to the CELPIP Writing Hub.
// Drop this anywhere on CELPIP-related pages or lessons.
---
<div
  class="surface"
  style="
    padding: var(--s-3) var(--s-4);
    border-left: 4px solid var(--accent);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s-3);
  "
>
  <div>
    <strong style="color: var(--text);">✍️ CELPIP Writing Hub</strong>
    <p class="muted" style="margin: 0; font-size: 0.9rem;">
      Free lessons · AI task scoring · Live writing classes
    </p>
  </div>
  <a class="btn btn-primary" href="/celpip/writing">Open Writing Hub →</a>
</div>
