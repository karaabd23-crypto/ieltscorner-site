---
// File: src/components/lesson/LessonShell.astro
// Purpose: consistent lesson layout inside content pages (MDX)
// Usage in MDX:
//   import LessonShell from "@/components/lesson/LessonShell.astro";
//   <LessonShell title="..." description="..." level="Band 7+" date="2026-02-28"> ... </LessonShell>

type Props = {
  title: string;
  description?: string;
  level?: string;
  date?: string;
  exam?: string;
  skill?: string;
  introA?: string;
  introB?: string;
};

const {
  title,
  description = "",
  level,
  date,
  exam,
  skill,
  introA = "",
  introB = "",
} = Astro.props as Props;

const introParagraphs = [introA, introB].filter(Boolean);
const fallbackIntro = description ? [description] : [];
const renderedIntro = introParagraphs.length >= 1 ? introParagraphs : fallbackIntro;

const examLabel = exam ? exam.toUpperCase().replace("_", " ") : "IELTS";
const skillLabel = skill ? skill[0].toUpperCase() + skill.slice(1) : "Writing";
---

<section class="lesson-shell">
  <header class="lesson-hero">
    <div class="lesson-hero__accent" aria-hidden="true"></div>
    <div class="lesson-hero__meta">
      <span class="pill">{examLabel} • {skillLabel}</span>
      {level ? <span class="pill pill--soft">{level}</span> : null}
      {date ? <span class="pill pill--soft">{date}</span> : null}
    </div>
    <h1 class="lesson-hero__title ic-display">{title}</h1>

    {renderedIntro.length > 0 ? (
      <div class="lesson-hero__intro">
        {renderedIntro.map((paragraph) => (
          <p class="lesson-hero__desc">{paragraph}</p>
        ))}
      </div>
    ) : null}
  </header>

  <div class="lesson-body ic-prose">
    <slot />
  </div>
</section>
