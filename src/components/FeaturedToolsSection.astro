---
import type { FeaturedToolCard } from "../lib/promotionTools";

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  cards: FeaturedToolCard[];
  className?: string;
  trackPageType?: string;
  trackTest?: string;
  trackSkill?: string;
  trackPosition?: string;
}

const {
  eyebrow = "Featured tools",
  title,
  intro = "",
  cards = [],
  className = "",
  trackPageType = "hub",
  trackTest = "general",
  trackSkill = "general",
  trackPosition = "featured_tools",
} = Astro.props as Props;

const sectionClass = ["featured-tools", className].filter(Boolean).join(" ");
---

<section class={sectionClass}>
  <div class="featured-tools__head">
    <p class="featured-tools__eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {intro && <p class="muted featured-tools__intro">{intro}</p>}
  </div>

  <div class="featured-tools__grid" style={`--featured-tool-count: ${Math.max(cards.length, 1)}`}>
    {cards.map((card, index) => (
      <article class="featured-tools__card">
        <div class="featured-tools__card-head">
          <span class="featured-tools__badge">{card.badge}</span>
          <h3>{card.title}</h3>
        </div>
        <p class="featured-tools__description">{card.description}</p>
        {card.note && <p class="featured-tools__note">{card.note}</p>}
        <a
          class="btn btn-primary featured-tools__cta"
          href={card.href}
          data-track-click={`featured-tools-${card.offer}`}
          data-track-offer={card.offer}
          data-track-promo-type="featured_tools"
          data-track-page-type={trackPageType}
          data-track-test={trackTest}
          data-track-skill={trackSkill}
          data-track-position={`${trackPosition}-${index + 1}`}
        >
          {card.cta}
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .featured-tools {
    display: grid;
    gap: var(--s-2);
  }

  .featured-tools__head {
    display: grid;
    gap: 6px;
    max-width: 62ch;
  }

  .featured-tools__head h2,
  .featured-tools__card h3 {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .featured-tools__head h2 {
    font-size: clamp(1.15rem, 0.7vw + 0.95rem, 1.45rem);
    line-height: 1.35;
    color: #1d252b;
  }

  .featured-tools__card h3 {
    font-size: 0.95rem;
    line-height: 1.35;
    color: #1f2a33;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .featured-tools__eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #5a6775;
  }

  .featured-tools__intro {
    margin: 0;
  }

  .featured-tools__grid {
    display: grid;
    gap: var(--s-2);
    grid-template-columns: repeat(var(--featured-tool-count), minmax(0, 1fr));
    align-items: stretch;
  }

  .featured-tools__card {
    display: grid;
    min-width: 0;
    gap: 10px;
    padding: 20px;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: var(--shadow-soft);
    transition: transform 140ms ease, box-shadow 140ms ease;
  }

  .featured-tools__card:hover,
  .featured-tools__card:focus-within {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .featured-tools__card-head {
    display: grid;
    min-width: 0;
    gap: 8px;
  }

  .featured-tools__badge {
    width: fit-content;
    padding: 0;
    border-radius: 0;
    background: transparent;
    color: #5a6775;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .featured-tools__description,
  .featured-tools__note {
    margin: 0;
    color: #3f4f60;
    line-height: 1.4;
    font-size: 0.9rem;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .featured-tools__note {
    font-size: 0.85rem;
    color: #6a7682;
  }

  .featured-tools__cta {
    width: fit-content;
    max-width: 100%;
    min-width: 0;
    font-size: 14px;
    line-height: 1.1;
    white-space: normal;
    overflow-wrap: anywhere;
  }
</style>
