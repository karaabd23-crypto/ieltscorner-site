---
import type { FeaturedToolCard } from "../lib/promotionTools";

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  cards: FeaturedToolCard[];
  className?: string;
  trackPageType?: string;
  trackTest?: string;
  trackSkill?: string;
  trackPosition?: string;
}

const {
  eyebrow = "Featured tools",
  title,
  intro = "",
  cards = [],
  className = "",
  trackPageType = "hub",
  trackTest = "general",
  trackSkill = "general",
  trackPosition = "featured_tools",
} = Astro.props as Props;

const sectionClass = ["featured-tools", className].filter(Boolean).join(" ");
---

<section class={sectionClass}>
  <div class="featured-tools__head">
    <p class="featured-tools__eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {intro && <p class="muted featured-tools__intro">{intro}</p>}
  </div>

  <div class="featured-tools__grid">
    {cards.map((card, index) => (
      <article class="featured-tools__card">
        <div class="featured-tools__card-head">
          <span class="featured-tools__badge">{card.badge}</span>
          <h3>{card.title}</h3>
        </div>
        <p class="featured-tools__description">{card.description}</p>
        {card.note && <p class="featured-tools__note">{card.note}</p>}
        <a
          class="btn btn-primary featured-tools__cta"
          href={card.href}
          data-track-click={`featured-tools-${card.offer}`}
          data-track-offer={card.offer}
          data-track-promo-type="featured_tools"
          data-track-page-type={trackPageType}
          data-track-test={trackTest}
          data-track-skill={trackSkill}
          data-track-position={`${trackPosition}-${index + 1}`}
        >
          {card.cta}
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .featured-tools {
    display: grid;
    gap: var(--s-3);
  }

  .featured-tools__head {
    display: grid;
    gap: 8px;
    max-width: 62ch;
  }

  .featured-tools__head h2,
  .featured-tools__card h3 {
    margin: 0;
  }

  .featured-tools__eyebrow {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8f3434;
  }

  .featured-tools__intro {
    margin: 0;
  }

  .featured-tools__grid {
    display: grid;
    gap: var(--s-3);
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  .featured-tools__card {
    display: grid;
    gap: 12px;
    padding: 18px;
    border-radius: 18px;
    border: 1px solid rgba(20, 22, 23, 0.14);
    background: #fff;
    box-shadow: var(--shadow-soft);
  }

  .featured-tools__card-head {
    display: grid;
    gap: 8px;
  }

  .featured-tools__badge {
    width: fit-content;
    padding: 0.36rem 0.68rem;
    border-radius: 999px;
    background: rgba(217, 72, 72, 0.1);
    color: #8f3434;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .featured-tools__description,
  .featured-tools__note {
    margin: 0;
    color: #334556;
    line-height: 1.55;
  }

  .featured-tools__note {
    font-size: 0.92rem;
    color: #556677;
  }

  .featured-tools__cta {
    width: fit-content;
  }

  @media (min-width: 760px) {
    .featured-tools__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .featured-tools__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
