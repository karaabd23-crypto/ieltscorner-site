---
import { getCollection } from "astro:content";
import { getPublicLessonTitle } from "../lib/lessonLevel";
import { EXAM_KEYS, type ExamKey } from "../lib/examConfig";

interface Props {
  exam: ExamKey;
  skill: "listening" | "reading" | "writing" | "speaking";
  limit?: number;
}

const { exam, skill, limit = 4 } = Astro.props as Props;
const examUpper = exam.toUpperCase() as ExamKey;
const oppositeExams = EXAM_KEYS.filter((key) => key !== examUpper);
const skillLabel = `${skill.charAt(0).toUpperCase()}${skill.slice(1)}`;
const examLabel = examUpper === "PTE_CORE" ? "PTE Core" : examUpper;
const sectionHeading = `Free ${examLabel} ${skillLabel} lessons`;
const examParam = `?exam=${examUpper}`;
const skillLessonsPath = `/lessons/${skill}${examParam}`;
const grammarLessonsPath = `/lessons/grammar${examParam}`;
const vocabularyLessonsPath = `/lessons/vocabulary${examParam}`;
const allLessonsPath = `/lessons`;

const parseDate = (value: string | undefined) => {
  const parsed = Date.parse(value ?? "");
  return Number.isNaN(parsed) ? 0 : parsed;
};

const allSkillLessons = await getCollection(
  "lessons",
  ({ data }) => !data.draft && data.category === skill
);

const isEligibleForExam = (lesson: (typeof allSkillLessons)[number]) => {
  const lessonTest = String(lesson.data.test ?? "").toUpperCase();
  if (lessonTest && lessonTest !== examUpper) return false;

  const lessonExams = (lesson.data.exam ?? []).map((value) => String(value).toUpperCase());
  if (lessonExams.length > 0 && !lessonExams.includes(examUpper)) return false;

  const searchable = `${lesson.slug} ${lesson.data.title} ${lesson.data.description ?? ""} ${lesson.data.excerpt} ${lesson.data.tags.join(" ")}`.toUpperCase();
  if (oppositeExams.some((otherExam) => searchable.includes(otherExam))) return false;

  return true;
};

const examSignalScore = (lesson: (typeof allSkillLessons)[number]) => {
  const lessonTest = String(lesson.data.test ?? "").toUpperCase();
  const searchable = `${lesson.slug} ${lesson.data.title} ${lesson.data.description ?? ""} ${lesson.data.excerpt}`.toUpperCase();

  if (lessonTest === examUpper) return 3;

  const includesTarget = searchable.includes(examUpper);
  const includesOther = oppositeExams.some((otherExam) => searchable.includes(otherExam));

  if (includesTarget && !includesOther) return 2;
  if (includesTarget) return 1;
  return 0;
};

const eligibleLessons = allSkillLessons.filter((lesson) => isEligibleForExam(lesson));

const relatedLessons = eligibleLessons
  .sort((a, b) => {
    const scoreDifference = examSignalScore(b) - examSignalScore(a);
    if (scoreDifference !== 0) return scoreDifference;
    return parseDate(b.data.date) - parseDate(a.data.date);
  })
  .slice(0, limit);

const fallbackLessons = [...eligibleLessons]
  .sort((a, b) => parseDate(b.data.date) - parseDate(a.data.date))
  .slice(0, limit);

const displayLessons = relatedLessons.length > 0 ? relatedLessons : fallbackLessons;
---

<section class="section-sm">
  <div class="surface lesson-related-system">
    <h2>{sectionHeading}</h2>
    <p class="muted">
      Study free lessons first if you are not ready to pay.
    </p>
    {displayLessons.length > 0 ? (
      <div class="lesson-related-grid">
        {displayLessons.map((lesson) => (
          <a class="lesson-related-card" href={`/lessons/${lesson.data.category}/${lesson.slug}/`}>
            <h4>{getPublicLessonTitle(lesson.data.title, lesson.data.level)}</h4>
            <p>{lesson.data.description ?? lesson.data.excerpt}</p>
          </a>
        ))}
      </div>
    ) : (
      <p class="muted" style="margin-bottom: 0;">
        No new lessons yet for this skill. Use the links below.
      </p>
    )}
    <p class="quick-links-label">More free lessons</p>
    <div class="quick-links-grid" aria-label="Free lesson quick links">
      <a class="quick-link-card" href={skillLessonsPath}>
        <span class="quick-link-card__icon" aria-hidden="true">{skillLabel.charAt(0)}</span>
        <span class="quick-link-card__text">
          <strong>All {examLabel} {skill}</strong>
          <span>Every {skill} lesson, free</span>
        </span>
      </a>
      <a class="quick-link-card" href={grammarLessonsPath}>
        <span class="quick-link-card__icon" aria-hidden="true">G</span>
        <span class="quick-link-card__text">
          <strong>Grammar</strong>
          <span>{examLabel} grammar lessons</span>
        </span>
      </a>
      <a class="quick-link-card" href={vocabularyLessonsPath}>
        <span class="quick-link-card__icon" aria-hidden="true">V</span>
        <span class="quick-link-card__text">
          <strong>Vocabulary</strong>
          <span>{examLabel} vocabulary lessons</span>
        </span>
      </a>
      <a class="quick-link-card quick-link-card--all" href={allLessonsPath}>
        <span class="quick-link-card__icon" aria-hidden="true">&#9733;</span>
        <span class="quick-link-card__text">
          <strong>Full lesson library</strong>
          <span>Browse every free lesson</span>
        </span>
      </a>
    </div>
  </div>
</section>
