---
import {
  CELPIP_TASK_CONFIG,
  CELPIP_TASK_SIDEBARS,
  CELPIP_FREE_PROMPT_IDS,
  CELPIP_WRITING_PRICE_CAD,
  getPracticeHubPromptById,
} from '../lib/celpipWritingData.mjs';

// Build a lookup map: id → full prompt object (available at build time for JSON embed)
const taskOrder = ['task1', 'task2'];

const hubTasks = {
  task1: {
    ...CELPIP_TASK_CONFIG.task1,
    tabTitle: 'Task 1',
    tabFocus: 'Email writing',
    sidebarTitle: 'Writing > Task 1',
    sidebarSub: 'Email Writing',
    promptIntro: 'Read the following information.',
    promptTaskLine: `Write an email in about ${CELPIP_TASK_CONFIG.task1.targetWords}. Your email should:`,
    promptLabel: 'Task 1 | Email',
    shortLabel: 'Task 1',
    unlockLabel: 'Task 1 prompts and the full writing hub',
  },
  task2: {
    ...CELPIP_TASK_CONFIG.task2,
    tabTitle: 'Task 2',
    tabFocus: 'Survey response',
    sidebarTitle: 'Writing > Task 2',
    sidebarSub: 'Survey Response',
    promptIntro: 'Read the following survey question.',
    promptTaskLine: `Write a response in about ${CELPIP_TASK_CONFIG.task2.targetWords}. In your response:`,
    promptLabel: 'Task 2 | Survey Response',
    shortLabel: 'Task 2',
    unlockLabel: 'Task 2 prompts and the full writing hub',
  },
};

const promptData = {};
for (const taskType of taskOrder) {
  promptData[taskType] = {};
  for (const entry of CELPIP_TASK_SIDEBARS[taskType] || []) {
    const prompt = getPracticeHubPromptById(taskType, entry.id);
    if (prompt) promptData[taskType][entry.id] = prompt;
  }
}

const totalTasks = taskOrder.reduce((sum, taskType) => sum + (CELPIP_TASK_SIDEBARS[taskType]?.length || 0), 0);
const totalLockedCount = taskOrder.reduce(
  (sum, taskType) => sum + (CELPIP_TASK_SIDEBARS[taskType] || []).filter((entry) => !entry.isFree).length,
  0,
);

const hubConfig = {
  taskOrder,
  totalTasks,
  totalLockedCount,
  tasks: Object.fromEntries(
    taskOrder.map((taskType) => {
      const lockedCount = (CELPIP_TASK_SIDEBARS[taskType] || []).filter((entry) => !entry.isFree).length;
      return [taskType, {
        ...hubTasks[taskType],
        freePromptId: CELPIP_FREE_PROMPT_IDS[taskType],
        lockedCount,
      }];
    }),
  ),
};

const serializeInlineJSON = (value) =>
  JSON.stringify(value)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026')
    .replace(/\u2028/g, '\\u2028')
    .replace(/\u2029/g, '\\u2029');

const defaultSidebar = CELPIP_TASK_SIDEBARS.task1 || [];
---

<div class="practice-hub-shell" id="practice-hub">
  <div class="hub-task-switch" id="hub-task-switch" role="tablist" aria-label="Choose writing task">
    {taskOrder.map((taskType) => (
      <button
        class={`hub-task-switch__btn${taskType === 'task1' ? ' is-active' : ''}`}
        type="button"
        role="tab"
        aria-selected={taskType === 'task1' ? 'true' : 'false'}
        data-task-type={taskType}
      >
        <span class="hub-task-switch__title">{hubTasks[taskType].tabTitle}</span>
        <span class="hub-task-switch__focus">{hubTasks[taskType].tabFocus}</span>
      </button>
    ))}
  </div>

<div class="practice-hub">

  <!-- SIDEBAR -->
  <aside class="practice-hub__sidebar" aria-label="Task list">
    <div class="sidebar-header">
      <span class="sidebar-title" id="hub-sidebar-title">{hubTasks.task1.sidebarTitle}</span>
      <span class="sidebar-sub" id="hub-sidebar-sub">{hubTasks.task1.sidebarSub}</span>
    </div>
    <nav class="task-list" id="hub-task-list" role="list">
      {defaultSidebar.map((task, i) => (
        <button
          class={`task-item${task.isFree ? ' task-item--free' : ' task-item--locked'}${task.id === CELPIP_FREE_PROMPT_IDS.task1 ? ' is-active' : ''}`}
          data-task-id={task.id}
          data-is-free={task.isFree ? 'true' : 'false'}
          type="button"
        >
          <span class="task-num">{i + 1}.</span>
          <span class="task-label">{task.label}</span>
          {task.isFree
            ? <span class="free-badge">FREE</span>
            : (
              <svg class="lock-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M8 1a3.5 3.5 0 0 0-3.5 3.5V6H4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-.5V4.5A3.5 3.5 0 0 0 8 1Zm2 5V4.5a2 2 0 1 0-4 0V6h4Z" clip-rule="evenodd" />
              </svg>
            )
          }
        </button>
      ))}
    </nav>
  </aside>

  <!-- PROMPT PANEL -->
  <section class="practice-hub__prompt" id="hub-prompt-panel" aria-label="Prompt">
    <div class="prompt-top-bar">
      <span class="social-proof" id="hub-submissions-count" aria-live="polite">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM1.49 15.326a.78.78 0 0 1-.358-.442 3 3 0 0 1 4.308-3.516 6.484 6.484 0 0 0-1.905 3.959c-.023.222-.014.442.025.654a4.97 4.97 0 0 1-2.07-.655ZM16.44 15.98a4.97 4.97 0 0 0 2.07-.654.78.78 0 0 0 .357-.442 3 3 0 0 0-4.308-3.517 6.484 6.484 0 0 1 1.907 3.96 2.32 2.32 0 0 1-.026.654ZM18 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM5.304 16.19a.844.844 0 0 1-.277-.71 5 5 0 0 1 9.947 0 .843.843 0 0 1-.277.71A6.975 6.975 0 0 1 10 18a6.974 6.974 0 0 1-4.696-1.81Z"/></svg>
        <span class="social-proof__stack">
          <span class="social-proof__item" id="hub-subscriber-count" style="display:none;"></span>
          <span class="social-proof__item" id="hub-essays-today-count">0 essays submitted today</span>
        </span>
      </span>
    </div>

    <div class="prompt-card" id="hub-prompt-card">
      <div class="prompt-meta-row">
        <span class="prompt-kicker" id="hub-prompt-kicker">{hubTasks.task1.promptLabel}</span>
        <span class="prompt-target" id="hub-prompt-target">{hubTasks.task1.targetWords} | {hubTasks.task1.minutes} min</span>
      </div>
      <h3 class="prompt-title" id="hub-prompt-title"></h3>
      <p class="prompt-intro" id="hub-prompt-intro">{hubTasks.task1.promptIntro}</p>
      <div class="prompt-scenario" id="hub-prompt-scenario"></div>
      <div class="prompt-options" id="hub-prompt-options" style="display:none;"></div>
      <div class="prompt-task-line" id="hub-prompt-task-line"></div>
      <ul class="prompt-instructions" id="hub-prompt-instructions"></ul>

      <!-- Sample Responses -->
      <div class="sample-accordions">
        <details class="sample-accordion">
          <summary>CLB 5 Sample</summary>
          <div class="sample-content" id="hub-sample-clb5">
            <p class="muted sample-placeholder">Sample response coming soon — check back or subscribe to see all samples.</p>
          </div>
        </details>
        <details class="sample-accordion">
          <summary>CLB 7 Sample</summary>
          <div class="sample-content" id="hub-sample-clb7">
            <p class="muted sample-placeholder">Sample response coming soon — check back or subscribe to see all samples.</p>
          </div>
        </details>
        <details class="sample-accordion">
          <summary>CLB 9 Sample</summary>
          <div class="sample-content" id="hub-sample-clb9">
            <p class="muted sample-placeholder">Sample response coming soon — check back or subscribe to see all samples.</p>
          </div>
        </details>
        <details class="sample-accordion">
          <summary>CLB 11 Sample</summary>
          <div class="sample-content" id="hub-sample-clb11">
            <p class="muted sample-placeholder">Sample response coming soon â€” check back or subscribe to see all samples.</p>
          </div>
        </details>
      </div>

    </div>
  </section>

  <!-- WRITING PANEL -->
  <section class="practice-hub__writing" id="hub-writing-panel" aria-label="Writing area">
    <div class="writing-header">
      <span class="writing-title" id="hub-writing-title">Write your Task 1 to see your score</span>
      <div class="timer-box">
        <div class="timer-display" id="hub-timer">27:00</div>
        <div class="timer-controls">
          <button class="timer-btn" id="hub-timer-start" type="button" title="Start timer">&#9654;</button>
          <button class="timer-btn" id="hub-timer-reset" type="button" title="Reset timer">&#8635;</button>
        </div>
      </div>
    </div>

    <div class="word-count-row">
      <span class="word-count-label">Your response</span>
      <span class="word-count-badge" id="hub-word-count">0 words</span>
    </div>

    <textarea
      id="hub-textarea"
      class="writing-textarea"
      placeholder="Type your response here..."
      rows="14"
      aria-label="Your writing response"
    ></textarea>

    <!-- Submit area (shows different states) -->
    <div id="hub-submit-area">
      <button class="btn btn-primary hub-submit-btn" id="hub-submit-btn" type="button" disabled>
        Submit for evaluation
      </button>
      <p class="writing-status muted" id="hub-writing-status" style="min-height: 1.2em;"></p>
    </div>

    <!-- Upgrade prompt (shown after free eval used, no subscription) -->
    <div id="hub-upgrade-prompt" style="display:none;" class="upgrade-inline">
      <p class="upgrade-inline__msg" id="hub-upgrade-copy">Subscribe to unlock the full writing hub.</p>
      <button class="btn btn-primary hub-checkout-btn" type="button">
        Unlock all tasks - CA${CELPIP_WRITING_PRICE_CAD}/month
      </button>
      <p class="muted" style="font-size: 0.85rem; margin-top: var(--s-2);">Cancel anytime. Secure billing via Stripe.</p>
    </div>

    <!-- Results area -->
    <div id="hub-results" style="display:none;" class="results-area">
      <div class="results-header">
        <div class="results-score-block">
          <span class="results-label">Your estimated score</span>
          <div class="score-badge" id="hub-score-badge"></div>
          <span class="score-descriptor" id="hub-score-descriptor"></span>
        </div>
      </div>
      <p class="results-summary" id="hub-results-summary"></p>

      <!-- Criteria -->
      <div class="criteria-grid" id="hub-criteria-grid"></div>

      <!-- Strengths & Priorities -->
      <div class="feedback-cols">
        <div class="feedback-col">
          <h4 class="feedback-col__title feedback-col__title--good">What's working</h4>
          <ul class="feedback-list" id="hub-strengths"></ul>
        </div>
        <div class="feedback-col">
          <h4 class="feedback-col__title feedback-col__title--fix">What to fix next</h4>
          <ul class="feedback-list" id="hub-priorities"></ul>
        </div>
      </div>

      <!-- Error analysis -->
      <div id="hub-errors-section" style="display:none;">
        <h4 class="section-subtitle">Language issues found</h4>
        <div class="errors-list" id="hub-errors-list"></div>
      </div>

      <!-- Rewrite suggestions -->
      <div id="hub-rewrites-section" style="display:none;">
        <h4 class="section-subtitle">Suggested rewrites</h4>
        <div class="rewrites-list" id="hub-rewrites-list"></div>
      </div>

      <!-- Next practice steps -->
      <div id="hub-next-steps-section" style="display:none;">
        <h4 class="section-subtitle">What to work on next</h4>
        <ul class="feedback-list" id="hub-next-steps"></ul>
      </div>

      <!-- Lesson recommendations -->
      <div id="hub-lessons-section" style="display:none;">
        <h4 class="section-subtitle">Lessons to help you improve</h4>
        <div class="lessons-grid" id="hub-lessons-grid"></div>
      </div>

      <!-- Reflection support -->
      <div class="feedback-col">
        <h4 class="section-subtitle">Reflect before revising</h4>
        <ul class="feedback-list">
          <li>What is the single most important issue to fix first?</li>
          <li>Which part of your response is already working well?</li>
          <li>How will you revise your answer based on this feedback?</li>
        </ul>
      </div>

      <!-- Upgrade CTA inside results (for free users) -->
      <div id="hub-results-upgrade" style="display:none;" class="results-upgrade-cta">
        <p>Practice all {totalLockedCount} more tasks with AI feedback — CA${CELPIP_WRITING_PRICE_CAD}/month.</p>
        <button class="btn btn-primary hub-checkout-btn" type="button">Unlock all tasks</button>
      </div>
    </div>

    <!-- Inbox placeholder (before any submission) -->
    <div id="hub-no-submission" class="no-submission-placeholder">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.1 13.177a2.25 2.25 0 0 0-.1.661Z"/>
      </svg>
      <p>No submissions yet</p>
    </div>
  </section>
</div>
</div>

<!-- SUBSCRIPTION MODAL -->
<div id="hub-modal-backdrop" class="modal-backdrop" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="hub-modal-title">
  <div class="modal-card">
    <button class="modal-close" id="hub-modal-close" type="button" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
    </button>
    <div class="modal-icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3v-6.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25Zm3.75 8.25v-3a3.75 3.75 0 1 0-7.5 0v3h7.5Z" clip-rule="evenodd"/></svg>
    </div>
    <h2 class="modal-title" id="hub-modal-title">Unlock all {totalTasks} writing tasks</h2>
    <p class="modal-desc">
      Subscribe for CA${CELPIP_WRITING_PRICE_CAD}/month to access all Task 1 and Task 2 practice prompts with full AI evaluation, CLB scoring, and lesson recommendations.
    </p>
    <ul class="modal-features">
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/></svg>
        {totalLockedCount} more Task 1 &amp; 2 prompts
      </li>
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/></svg>
        AI evaluations with CLB scoring and targeted feedback
      </li>
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/></svg>
        Saved sample bands for CLB 5, 7, 9, and 11
      </li>
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/></svg>
        Cancel anytime — no commitment
      </li>
    </ul>
    <button class="btn btn-primary hub-checkout-btn modal-cta" type="button">
      Subscribe — CA${CELPIP_WRITING_PRICE_CAD}/month
    </button>
    <button class="modal-secondary" id="hub-modal-keep-free" type="button">
      Keep practising with the free task
    </button>
    <p class="modal-status muted" id="hub-modal-status" style="min-height: 1.2em;"></p>
  </div>
</div>

<!-- Embed all prompt data as JSON for client-side use -->
<script id="hub-config-data" type="application/json" is:inline set:html={serializeInlineJSON(hubConfig)}></script>
<script id="hub-prompt-data" type="application/json" is:inline set:html={serializeInlineJSON(promptData)}></script>
<script id="hub-sidebar-data" type="application/json" is:inline set:html={serializeInlineJSON(CELPIP_TASK_SIDEBARS)}></script>

<style>
  /* ---- Layout ---- */
  .practice-hub-shell {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .hub-task-switch {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-2);
  }

  .hub-task-switch__btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.12s, background 0.12s, transform 0.12s;
    text-align: left;
    font-family: inherit;
  }

  .hub-task-switch__btn:hover {
    border-color: var(--accent);
    background: rgba(217, 72, 72, 0.06);
    transform: translateY(-1px);
  }

  .hub-task-switch__btn.is-active {
    border-color: var(--accent);
    background: rgba(217, 72, 72, 0.08);
    box-shadow: inset 0 0 0 1px rgba(217, 72, 72, 0.12);
  }

  .hub-task-switch__title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
  }

  .hub-task-switch__focus {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .practice-hub {
    display: grid;
    grid-template-columns: 260px 1fr 1fr;
    align-items: start;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: visible;
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }

  /* ---- Sidebar ---- */
  .practice-hub__sidebar {
    background: var(--bg-2);
    border-right: 1px solid var(--border);
    overflow: visible;
  }

  .sidebar-header {
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--border);
    background: var(--bg-2);
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .sidebar-title {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sidebar-sub {
    display: block;
    font-size: 0.78rem;
    color: var(--muted-2);
    margin-top: 2px;
  }

  .task-list {
    display: flex;
    flex-direction: column;
  }

  .task-item {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: 9px var(--s-4);
    background: none;
    border: none;
    border-left: 3px solid transparent;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.82rem;
    color: var(--text);
    transition: background 0.12s, border-color 0.12s;
    line-height: 1.35;
  }

  .task-item:hover {
    background: rgba(217, 72, 72, 0.06);
  }

  .task-item.is-active {
    border-left-color: var(--accent);
    background: var(--surface);
    font-weight: 600;
    color: var(--ink);
  }

  .task-item--locked {
    opacity: 0.45;
  }

  .task-item--locked:hover {
    opacity: 0.7;
    background: rgba(217, 72, 72, 0.04);
  }

  .task-num {
    flex-shrink: 0;
    color: var(--muted-2);
    font-size: 0.78rem;
    min-width: 18px;
  }

  .task-label {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .free-badge {
    flex-shrink: 0;
    background: var(--gold);
    color: #1c1c1c;
    font-size: 0.6rem;
    font-weight: 800;
    padding: 2px 5px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .lock-icon {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    color: var(--muted-2);
  }

  /* ---- Prompt Panel ---- */
  .practice-hub__prompt {
    border-right: 1px solid var(--border);
    overflow: visible;
    background: var(--surface);
  }

  .prompt-top-bar {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .social-proof {
    display: flex;
    align-items: flex-start;
    gap: var(--s-1);
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 500;
    text-align: left;
  }

  .social-proof svg {
    width: 14px;
    height: 14px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .social-proof__item {
    white-space: nowrap;
  }

  .social-proof__stack {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .prompt-card {
    padding: var(--s-5) var(--s-5) var(--s-6);
