<script>
  (() => {
    // ---- Read embedded data ----
    const hubConfig = JSON.parse(
      document.getElementById('hub-config-data')?.textContent || '{}'
    );
    const promptData = JSON.parse(
      document.getElementById('hub-prompt-data')?.textContent || '{}'
    );
    const sidebarData = JSON.parse(
      document.getElementById('hub-sidebar-data')?.textContent || '{}'
    );

    // ---- State ----
    const ACCESS_KEY = 'ieltscorner.celpipWritingAccess';
    const FREE_EVAL_KEY = 'ieltscorner.celpipFreeEvalUsed';
    const taskOrder = hubConfig.taskOrder || ['task1', 'task2'];

    let currentTaskType = 'task1';
    let selectedTaskId = hubConfig.tasks?.task1?.freePromptId || 'informal-pet-sitting';
    let timerInterval = null;
    let timerSeconds = 27 * 60;
    let timerRunning = false;

    function getFreePromptId(taskType) {
      return hubConfig.tasks?.[taskType]?.freePromptId || '';
    }

    function getTaskMinutes(taskType) {
      return hubConfig.tasks?.[taskType]?.minutes || 27;
    }

    function getSubscription() {
      try {
        const raw = localStorage.getItem(ACCESS_KEY);
        if (!raw) return null;
        return JSON.parse(raw);
      } catch {
        return null;
      }
    }

    function hasFreeEvalUsed() {
      return localStorage.getItem(FREE_EVAL_KEY) === 'true';
    }

    function markFreeEvalUsed() {
      localStorage.setItem(FREE_EVAL_KEY, 'true');
    }

    // ---- DOM refs ----
    const taskSwitchBtns = Array.from(document.querySelectorAll('.hub-task-switch__btn'));
    const taskListNav = document.getElementById('hub-task-list');
    const sidebarTitle = document.getElementById('hub-sidebar-title');
    const sidebarSub = document.getElementById('hub-sidebar-sub');
    const promptTitle = document.getElementById('hub-prompt-title');
    const promptKicker = document.getElementById('hub-prompt-kicker');
    const promptTarget = document.getElementById('hub-prompt-target');
    const promptIntro = document.getElementById('hub-prompt-intro');
    const promptScenario = document.getElementById('hub-prompt-scenario');
    const promptOptions = document.getElementById('hub-prompt-options');
    const promptTaskLine = document.getElementById('hub-prompt-task-line');
    const promptInstructions = document.getElementById('hub-prompt-instructions');
    const sampleClb5 = document.getElementById('hub-sample-clb5');
    const sampleClb7 = document.getElementById('hub-sample-clb7');
    const sampleClb9 = document.getElementById('hub-sample-clb9');
    const sampleClb11 = document.getElementById('hub-sample-clb11');
    const textarea = document.getElementById('hub-textarea');
    const wordCountBadge = document.getElementById('hub-word-count');
    const submitBtn = document.getElementById('hub-submit-btn');
    const writingStatus = document.getElementById('hub-writing-status');
    const writingTitle = document.getElementById('hub-writing-title');
    const subscriberCountEl = document.getElementById('hub-subscriber-count');
    const essaysTodayCountEl = document.getElementById('hub-essays-today-count');
    const submitArea = document.getElementById('hub-submit-area');
    const upgradePrompt = document.getElementById('hub-upgrade-prompt');
    const resultsEl = document.getElementById('hub-results');
    const noSubmission = document.getElementById('hub-no-submission');
    const timerEl = document.getElementById('hub-timer');
    const timerStart = document.getElementById('hub-timer-start');
    const timerReset = document.getElementById('hub-timer-reset');
    const modalBackdrop = document.getElementById('hub-modal-backdrop');
    const modalClose = document.getElementById('hub-modal-close');
    const modalKeepFree = document.getElementById('hub-modal-keep-free');
    const modalStatus = document.getElementById('hub-modal-status');

    // ---- Helpers ----
    function wordCount(text) {
      return text.trim().split(/\s+/).filter(Boolean).length;
    }

    function formatTime(seconds) {
      const m = Math.floor(seconds / 60).toString().padStart(2, '0');
      const s = (seconds % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    function setStatus(msg, isError = false) {
      if (writingStatus) {
        writingStatus.textContent = msg;
        writingStatus.style.color = isError ? 'var(--accent)' : '';
      }
    }

    function setModalStatus(msg) {
      if (modalStatus) modalStatus.textContent = msg;
    }

    function autoResizeTextarea() {
      if (!(textarea instanceof HTMLTextAreaElement)) return;
      textarea.style.height = 'auto';
      const minHeight = 320;
      textarea.style.height = `${Math.max(textarea.scrollHeight, minHeight)}px`;
    }

    function formatCount(value) {
      return new Intl.NumberFormat('en-CA').format(Math.max(0, Number(value) || 0));
    }

    function renderStatsFallback() {
      if (subscriberCountEl) {
        subscriberCountEl.textContent = '';
        subscriberCountEl.style.display = 'none';
      }
      if (essaysTodayCountEl) {
        essaysTodayCountEl.textContent = '0 essays submitted today';
      }
    }

    async function loadUsageStats() {
      try {
        const response = await fetch('/.netlify/functions/celpip-writing-stats');
        if (!response.ok) {
          throw new Error(`Stats request failed with ${response.status}`);
        }

        const data = await response.json();
        const subscribers = Number(data?.subscriberCount);
        const essaysToday = Number(data?.essaysSubmittedToday);

        if (essaysTodayCountEl) {
          essaysTodayCountEl.textContent = `${formatCount(essaysToday)} essays submitted today`;
        }

        if (subscriberCountEl) {
          if (Number.isFinite(subscribers) && subscribers > 0) {
            subscriberCountEl.textContent = `${formatCount(subscribers)} subscribers`;
            subscriberCountEl.style.display = '';
          } else {
            subscriberCountEl.textContent = '';
            subscriberCountEl.style.display = 'none';
          }
        }
      } catch {
        renderStatsFallback();
      }
    }

    function getSampleResponses(prompt) {
      const samples = prompt?.sampleResponses && typeof prompt.sampleResponses === 'object'
        ? prompt.sampleResponses
        : {};

      return {
        clb5: String(samples.clb5 || '').trim(),
        clb7: String(samples.clb7 || '').trim(),
        clb9: String(samples.clb9 || prompt?.sampleResponse || '').trim(),
        clb11: String(samples.clb11 || '').trim(),
      };
    }

    function renderSampleCard(container, label, sampleText) {
      if (!(container instanceof HTMLElement)) return;
      container.innerHTML = '';
      if (!sampleText) {
        const placeholder = document.createElement('p');
        placeholder.className = 'muted sample-placeholder';
        placeholder.textContent = `${label} sample will appear here after it is added to the prompt library.`;
        container.appendChild(placeholder);
        return;
      }
      const sample = document.createElement('div');
      sample.className = 'sample-essay';
      sample.innerHTML = sampleText
        .split('\n')
        .map(line => line ? escHtml(line) : '<br>')
        .join('<br>');
      container.appendChild(sample);
    }

    function escHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function safeInternalHref(value) {
      try {
        const url = new URL(String(value || '').trim(), window.location.origin);
        if (!['http:', 'https:'].includes(url.protocol)) return '#';
        if (url.origin !== window.location.origin) return '#';
        if (url.pathname.startsWith('//') || url.pathname.includes('\\')) return '#';
        return `${url.pathname}${url.search}${url.hash}` || '#';
      } catch {
        return '#';
      }
    }

    function renderBulletList(listEl, items, maxItems = 6) {
      if (!(listEl instanceof HTMLElement)) return;
      listEl.innerHTML = '';
      if (!Array.isArray(items) || !items.length) return;
      items.slice(0, maxItems).forEach((item) => {
        const li = document.createElement('li');
        li.textContent = String(item || '');
        listEl.appendChild(li);
      });
    }

    // ---- Timer ----
    function updateTimerDisplay() {
      if (!timerEl) return;
      timerEl.textContent = formatTime(timerSeconds);
      timerEl.classList.toggle('timer-urgent', timerSeconds <= 180);
    }

    function startTimer() {
      if (timerRunning) return;
      timerRunning = true;
      if (timerStart) timerStart.textContent = '⏸';
      timerInterval = setInterval(() => {
        if (timerSeconds > 0) {
          timerSeconds--;
          updateTimerDisplay();
        } else {
          clearInterval(timerInterval);
          timerRunning = false;
          if (timerStart) timerStart.textContent = '▶';
        }
      }, 1000);
    }

    function pauseTimer() {
      timerRunning = false;
      clearInterval(timerInterval);
      if (timerStart) timerStart.textContent = '▶';
    }

    function resetTimer() {
      pauseTimer();
      const mins = getTaskMinutes(currentTaskType);
      timerSeconds = mins * 60;
      updateTimerDisplay();
    }

    timerStart?.addEventListener('click', () => {
      if (timerRunning) pauseTimer(); else startTimer();
    });

    timerReset?.addEventListener('click', resetTimer);

    // ---- Capture Astro scope attributes from server-rendered elements ----
    const astroAttrs = [];
    const firstBtn = taskListNav?.querySelector('.task-item');
    if (firstBtn) {
      for (const attr of firstBtn.attributes) {
        if (attr.name.startsWith('data-astro-cid-')) {
          astroAttrs.push(attr.name);
        }
      }
    }

    function applyAstroScope(el) {
      astroAttrs.forEach((attr) => el.setAttribute(attr, ''));
    }

    // ---- Bind click handlers on existing server-rendered sidebar ----
    function bindSidebarHandlers() {
      if (!taskListNav) return;
      const btns = Array.from(taskListNav.querySelectorAll('.task-item'));
      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-task-id');
          if (id) selectTask(id);
        });
      });
    }

    // ---- Rebuild sidebar for current task type (on switch only) ----
    function rebuildSidebar() {
      if (!taskListNav) return;
      const items = sidebarData[currentTaskType] || [];
      const freeId = getFreePromptId(currentTaskType);
      taskListNav.innerHTML = '';
      items.forEach((task, i) => {
        const btn = document.createElement('button');
        const isActive = task.id === selectedTaskId;
        const isFree = task.isFree || task.id === freeId;
        btn.className = `task-item${isFree ? ' task-item--free' : ' task-item--locked'}${isActive ? ' is-active' : ''}`;
        btn.setAttribute('data-task-id', task.id);
        btn.setAttribute('data-is-free', isFree ? 'true' : 'false');
        btn.type = 'button';
        applyAstroScope(btn);

        const numSpan = document.createElement('span');
        numSpan.className = 'task-num';
        numSpan.textContent = `${i + 1}.`;
        applyAstroScope(numSpan);
        btn.appendChild(numSpan);

        const labelSpan = document.createElement('span');
        labelSpan.className = 'task-label';
        labelSpan.textContent = task.label || task.sidebarLabel || task.id;
        applyAstroScope(labelSpan);
        btn.appendChild(labelSpan);

        if (isFree) {
          const badge = document.createElement('span');
          badge.className = 'free-badge';
          badge.textContent = 'FREE';
          applyAstroScope(badge);
          btn.appendChild(badge);
        } else {
          const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          svg.setAttribute('class', 'lock-icon');
          svg.setAttribute('viewBox', '0 0 16 16');
          svg.setAttribute('fill', 'currentColor');
          svg.setAttribute('aria-hidden', 'true');
          applyAstroScope(svg);
          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          path.setAttribute('fill-rule', 'evenodd');
          path.setAttribute('d', 'M8 1a3.5 3.5 0 0 0-3.5 3.5V6H4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-.5V4.5A3.5 3.5 0 0 0 8 1Zm2 5V4.5a2 2 0 1 0-4 0V6h4Z');
          path.setAttribute('clip-rule', 'evenodd');
          svg.appendChild(path);
          btn.appendChild(svg);
        }

        btn.addEventListener('click', () => selectTask(task.id));
        taskListNav.appendChild(btn);
      });
    }

    // ---- Load prompt into UI ----
    function loadPrompt(id) {
      const taskPrompts = promptData[currentTaskType] || {};
      const p = taskPrompts[id];
      if (!p) return;

      const cfg = hubConfig.tasks?.[currentTaskType] || {};

      // Title
      if (promptTitle) promptTitle.textContent = p.title || '';

      // Kicker + target
      if (promptKicker) promptKicker.textContent = cfg.promptLabel || '';
      if (promptTarget) promptTarget.textContent = `${cfg.targetWords || '150–200 words'} | ${cfg.minutes || 27} min`;

      // Intro
      if (promptIntro) promptIntro.textContent = cfg.promptIntro || '';

      // Scenario (task1) or question (task2)
      if (promptScenario) {
        promptScenario.textContent = currentTaskType === 'task2'
          ? (p.question || p.scenario || '')
          : (p.scenario || '');
      }

      // Options pills (task2 only)
      if (promptOptions) {
        const opts = Array.isArray(p.options) ? p.options : [];
        if (opts.length > 0) {
          promptOptions.innerHTML = opts.map((o) =>
            `<span class="prompt-option-pill">${escHtml(o)}</span>`
          ).join('');
          promptOptions.style.display = '';
        } else {
          promptOptions.innerHTML = '';
          promptOptions.style.display = 'none';
        }
      }

      // Task line
      if (promptTaskLine) {
        promptTaskLine.textContent = cfg.promptTaskLine || '';
      }

      // Instructions
      if (promptInstructions) {
        promptInstructions.innerHTML = '';
        (p.instructions || []).forEach((instr) => {
          const li = document.createElement('li');
          li.textContent = instr;
          promptInstructions.appendChild(li);
        });
      }

      // Sample bank
      const samples = getSampleResponses(p);
      renderSampleCard(sampleClb5, 'CLB 5', samples.clb5);
      renderSampleCard(sampleClb7, 'CLB 7', samples.clb7);
      renderSampleCard(sampleClb9, 'CLB 9', samples.clb9);
      renderSampleCard(sampleClb11, 'CLB 11', samples.clb11);

      // Reset timer for this task type
      resetTimer();
    }

    // ---- Update submit area based on state ----
    function updateSubmitArea() {
      const sub = getSubscription();
      const freeId = getFreePromptId(currentTaskType);
      const isFreeTask = selectedTaskId === freeId;
      const freeUsed = hasFreeEvalUsed();

      if (isFreeTask && freeUsed && !sub) {
        if (submitArea) submitArea.style.display = 'none';
        if (upgradePrompt) upgradePrompt.style.display = '';
      } else {
        if (submitArea) submitArea.style.display = '';
        if (upgradePrompt) upgradePrompt.style.display = 'none';
      }
    }

    // ---- Switch task type (Task 1 / Task 2 tabs) ----
    function switchTaskType(taskType) {
      if (taskType === currentTaskType) return;
      currentTaskType = taskType;

      // Update tab active states
      taskSwitchBtns.forEach((btn) => {
        const btnType = btn.getAttribute('data-task-type');
        const isActive = btnType === taskType;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      // Update sidebar header
      const cfg = hubConfig.tasks?.[taskType] || {};
      if (sidebarTitle) sidebarTitle.textContent = cfg.sidebarTitle || '';
      if (sidebarSub) sidebarSub.textContent = cfg.sidebarSub || '';

      // Update writing title
      if (writingTitle) writingTitle.textContent = `Write your ${cfg.shortLabel || 'Task'} to see your score`;

      // Select the free prompt for this task type
      selectedTaskId = getFreePromptId(taskType);

      // Rebuild sidebar and load prompt
      rebuildSidebar();
      loadPrompt(selectedTaskId);

      // Reset writing area
      if (textarea) textarea.value = '';
      autoResizeTextarea();
      if (wordCountBadge) {
        wordCountBadge.textContent = '0 words';
        wordCountBadge.classList.remove('ready');
      }
      if (submitBtn) submitBtn.disabled = true;
      setStatus('');
      if (resultsEl) resultsEl.style.display = 'none';
      if (noSubmission) noSubmission.style.display = '';

      updateSubmitArea();
    }

    // ---- Task type tab click handlers ----
    taskSwitchBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const taskType = btn.getAttribute('data-task-type');
        if (taskType) switchTaskType(taskType);
      });
    });

    // ---- Select task (individual prompt from sidebar) ----
    function selectTask(id) {
      const items = sidebarData[currentTaskType] || [];
      const freeId = getFreePromptId(currentTaskType);
      const entry = items.find((t) => t.id === id);
      if (!entry) return;

      const isFree = entry.isFree || entry.id === freeId;
      const sub = getSubscription();
      if (!isFree && !sub) {
        openModal();
        return;
      }

      selectedTaskId = id;

      // Update sidebar active state
      const sidebarBtns = taskListNav ? Array.from(taskListNav.querySelectorAll('.task-item')) : [];
      sidebarBtns.forEach((btn) => {
        btn.classList.toggle('is-active', btn.getAttribute('data-task-id') === id);
      });

      // Load prompt
      loadPrompt(id);

      // Reset writing area
      if (textarea) textarea.value = '';
      autoResizeTextarea();
      if (wordCountBadge) {
        wordCountBadge.textContent = '0 words';
        wordCountBadge.classList.remove('ready');
      }
      if (submitBtn) submitBtn.disabled = true;
      setStatus('');

      // Reset results
      if (resultsEl) resultsEl.style.display = 'none';
      if (noSubmission) noSubmission.style.display = '';

      updateSubmitArea();
    }

    // ---- Word count ----
    textarea?.addEventListener('input', () => {
      autoResizeTextarea();
      const wc = wordCount(textarea.value);
      if (wordCountBadge) {
        wordCountBadge.textContent = `${wc} word${wc !== 1 ? 's' : ''}`;
        wordCountBadge.classList.toggle('ready', wc >= 40);
      }
      if (submitBtn) {
        submitBtn.disabled = wc < 40;
      }
    });

    // ---- Submit ----
    submitBtn?.addEventListener('click', async () => {
      const sub = getSubscription();
      const freeId = getFreePromptId(currentTaskType);
      const isFreeTask = selectedTaskId === freeId;
      const freeUsed = hasFreeEvalUsed();

      if (isFreeTask && freeUsed && !sub) {
        updateSubmitArea();
        return;
      }

      const responseText = textarea?.value?.trim() || '';
      if (wordCount(responseText) < 40) {
        setStatus('Please write at least 40 words before submitting.', true);
        return;
      }

      const taskPrompts = promptData[currentTaskType] || {};
      const p = taskPrompts[selectedTaskId];
      if (!p) {
        setStatus('Prompt data not found. Please refresh the page.', true);
        return;
      }

      setStatus('Evaluating your response…');
      if (submitBtn) submitBtn.disabled = true;

      try {
        const promptText = currentTaskType === 'task2'
          ? (p.question || p.scenario || '')
          : (p.scenario || '');

        const payload = {
          taskType: currentTaskType,
          promptId: selectedTaskId,
          promptTitle: p.title || p.sidebarLabel || selectedTaskId,
          promptText,
          promptInstructions: p.instructions || [],
          responseText,
          isFreeTask: isFreeTask && !sub,
          ...(sub?.sessionId ? { sessionId: sub.sessionId } : {}),
        };

        const res = await fetch('/.netlify/functions/evaluate-celpip-writing', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          let errorMsg = `Evaluation failed (${res.status}).`;
          try {
            const errData = await res.json();
            if (errData.error) errorMsg = errData.error;
          } catch {
            if (res.status === 404) {
              errorMsg = 'Evaluation endpoint not found. Run "netlify dev" instead of "npm run dev" for local testing.';
            }
          }
          throw new Error(errorMsg);
        }

        const data = await res.json();

        if (!data.report) {
          throw new Error(data.error || 'Evaluation failed. Please try again.');
        }

        if (isFreeTask && !sub) {
          markFreeEvalUsed();
        }

        renderResults(data.report);
        setStatus('');
      } catch (err) {
        setStatus(err instanceof Error ? err.message : 'Evaluation failed.', true);
        if (submitBtn) submitBtn.disabled = false;
      }
    });

    // ---- Render results ----
    function renderResults(report) {
      if (!resultsEl) return;

      // Score
      const scoreBadge = document.getElementById('hub-score-badge');
      const scoreDesc = document.getElementById('hub-score-descriptor');
      if (scoreBadge) scoreBadge.textContent = `CLB ${report.overallLevel}`;
      if (scoreDesc) scoreDesc.textContent = report.descriptor || '';

      // Summary
      const summaryEl = document.getElementById('hub-results-summary');
      if (summaryEl) summaryEl.textContent = report.overallSummary || '';

      // Criteria
      const criteriaGrid = document.getElementById('hub-criteria-grid');
      if (criteriaGrid && report.traitScores) {
        criteriaGrid.innerHTML = '';
        Object.entries(report.traitScores).forEach(([name, score]) => {
          const comment = report.criterionComments?.[name] || '';
          const card = document.createElement('div');
          card.className = 'criterion-card';
          card.innerHTML = `
            <div class="criterion-name">${escHtml(name)}</div>
            <div class="criterion-score">CLB ${escHtml(String(score))}</div>
            <div class="criterion-comment">${escHtml(comment)}</div>
          `;
          criteriaGrid.appendChild(card);
        });
      }

      // Strengths
      const strengthsEl = document.getElementById('hub-strengths');
      if (strengthsEl && Array.isArray(report.strengths)) {
        renderBulletList(strengthsEl, report.strengths, 6);
      }

      // Priorities
      const prioritiesEl = document.getElementById('hub-priorities');
      if (prioritiesEl && Array.isArray(report.improvementPriorities)) {
        renderBulletList(prioritiesEl, report.improvementPriorities, 6);
      }

      // Errors
      const errorsSection = document.getElementById('hub-errors-section');
      const errorsList = document.getElementById('hub-errors-list');
      if (errorsSection && errorsList && Array.isArray(report.errorAnalysis) && report.errorAnalysis.length) {
        errorsList.innerHTML = report.errorAnalysis.slice(0, 4).map((e) => `
          <div class="error-card">
            <div class="error-card__cat">${escHtml(e.category || '')}</div>
            <div class="error-card__text">${escHtml(e.explanation || '')}</div>
            ${e.fixNow ? `<div class="error-card__fix">Fix: ${escHtml(e.fixNow)}</div>` : ''}
          </div>
        `).join('');
        errorsSection.style.display = '';
      } else if (errorsSection) {
        errorsSection.style.display = 'none';
      }

      // Rewrites
      const rewritesSection = document.getElementById('hub-rewrites-section');
      const rewritesList = document.getElementById('hub-rewrites-list');
      if (rewritesSection && rewritesList && Array.isArray(report.rewriteSuggestions) && report.rewriteSuggestions.length) {
        rewritesList.innerHTML = report.rewriteSuggestions.slice(0, 3).map((r) => `
          <div class="rewrite-card">
            <div class="rewrite-before">${escHtml(r.before || '')}</div>
            <div class="rewrite-after">${escHtml(r.after || '')}</div>
            <div class="rewrite-why">${escHtml(r.why || '')}</div>
          </div>
        `).join('');
        rewritesSection.style.display = '';
      } else if (rewritesSection) {
        rewritesSection.style.display = 'none';
      }

      // Next practice steps
      const nextStepsSection = document.getElementById('hub-next-steps-section');
      const nextStepsList = document.getElementById('hub-next-steps');
      if (nextStepsSection && nextStepsList && Array.isArray(report.nextPracticeSteps) && report.nextPracticeSteps.length) {
        renderBulletList(nextStepsList, report.nextPracticeSteps, 4);
        nextStepsSection.style.display = '';
      } else if (nextStepsSection) {
        nextStepsSection.style.display = 'none';
      }

      // Lesson recommendations
      const lessonsSection = document.getElementById('hub-lessons-section');
      const lessonsGrid = document.getElementById('hub-lessons-grid');
      const recs = report.lessonRecommendations || report.lessonNeeds || [];
      if (lessonsSection && lessonsGrid && Array.isArray(recs) && recs.length) {
        lessonsGrid.innerHTML = '';
        recs.slice(0, 4).forEach((lesson) => {
          const href = safeInternalHref(lesson.path || lesson.href || '#');
          const label = String(lesson.label || lesson.title || 'Lesson');
          const link = document.createElement('a');
          link.className = 'lesson-link';
          link.setAttribute('href', href);
          link.textContent = label;
          lessonsGrid.appendChild(link);
        });
        lessonsSection.style.display = '';
      } else if (lessonsSection) {
        lessonsSection.style.display = 'none';
      }

      // Upgrade CTA inside results for free users
      const resultsUpgrade = document.getElementById('hub-results-upgrade');
      if (resultsUpgrade) {
        const sub = getSubscription();
        resultsUpgrade.style.display = !sub ? '' : 'none';
      }

      // Show results, hide placeholder
      resultsEl.style.display = '';
      if (noSubmission) noSubmission.style.display = 'none';

      // Update submit area (may now show upgrade prompt)
      if (submitBtn) submitBtn.disabled = false;
      updateSubmitArea();
      loadUsageStats();
    }

    // ---- Modal ----
    function openModal() {
      if (modalBackdrop) modalBackdrop.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      setModalStatus('');
    }

    function closeModal() {
      if (modalBackdrop) modalBackdrop.style.display = 'none';
      document.body.style.overflow = '';
    }

    modalClose?.addEventListener('click', closeModal);
    modalKeepFree?.addEventListener('click', closeModal);

    modalBackdrop?.addEventListener('click', (e) => {
      if (e.target === modalBackdrop) closeModal();
    });

    // ---- Checkout (modal + inline buttons) ----
    async function startCheckout(statusEl) {
      if (statusEl) statusEl.textContent = 'Redirecting to secure checkout…';
      const allBtns = document.querySelectorAll('.hub-checkout-btn');
      allBtns.forEach((b) => { if (b instanceof HTMLButtonElement) b.disabled = true; });

      try {
        const res = await fetch('/.netlify/functions/create-celpip-writing-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ product: 'celpip-writing-ai' }),
        });
        const data = await res.json();
        if (!res.ok || !data.checkoutUrl) {
          throw new Error(data.error || 'Unable to start checkout.');
        }
        window.location.href = data.checkoutUrl;
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unable to start checkout.';
        if (statusEl) statusEl.textContent = msg;
        allBtns.forEach((b) => { if (b instanceof HTMLButtonElement) b.disabled = false; });
      }
    }

    document.querySelectorAll('.hub-checkout-btn').forEach((btn) => {
      btn.addEventListener('click', () => startCheckout(modalStatus));
    });

    // ---- Init ----
    bindSidebarHandlers();
    loadPrompt(selectedTaskId);
    autoResizeTextarea();
    updateSubmitArea();
    loadUsageStats();
  })();
</script>
