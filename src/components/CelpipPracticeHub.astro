</style>

<script>
  (() => {
    // ---- Read embedded data ----
    const promptData = JSON.parse(
      document.getElementById('hub-prompt-data')?.textContent || '{}'
    );
    const sidebarData = JSON.parse(
      document.getElementById('hub-sidebar-data')?.textContent || '[]'
    );

    // ---- State ----
    const FREE_TASK_ID = 'informal-pet-sitting';
    const ACCESS_KEY = 'ieltscorner.celpipWritingAccess';
    const FREE_EVAL_KEY = 'ieltscorner.celpipFreeEvalUsed';

    let selectedTaskId = FREE_TASK_ID;
    let timerInterval = null;
    let timerSeconds = 27 * 60;
    let timerRunning = false;

    function getSubscription() {
      try {
        const raw = localStorage.getItem(ACCESS_KEY);
        if (!raw) return null;
        return JSON.parse(raw);
      } catch {
        return null;
      }
    }

    function hasFreeEvalUsed() {
      return localStorage.getItem(FREE_EVAL_KEY) === 'true';
    }

    function markFreeEvalUsed() {
      localStorage.setItem(FREE_EVAL_KEY, 'true');
    }

    // ---- DOM refs ----
    const taskItems = Array.from(document.querySelectorAll('.task-item'));
    const promptScenario = document.getElementById('hub-prompt-scenario');
    const promptTaskLine = document.getElementById('hub-prompt-task-line');
    const promptInstructions = document.getElementById('hub-prompt-instructions');
    const sampleClb5 = document.getElementById('hub-sample-clb5');
    const sampleClb7 = document.getElementById('hub-sample-clb7');
    const sampleClb9 = document.getElementById('hub-sample-clb9');
    const sampleClb11 = document.getElementById('hub-sample-clb11');
    const sampleLevelBadge = document.getElementById('hub-sample-level-badge');
    const sampleLevelWhy = document.getElementById('hub-sample-level-why');
    const textarea = document.getElementById('hub-textarea');
    const wordCountBadge = document.getElementById('hub-word-count');
    const submitBtn = document.getElementById('hub-submit-btn');
    const writingStatus = document.getElementById('hub-writing-status');
    const submitArea = document.getElementById('hub-submit-area');
    const upgradePrompt = document.getElementById('hub-upgrade-prompt');
    const resultsEl = document.getElementById('hub-results');
    const noSubmission = document.getElementById('hub-no-submission');
    const timerEl = document.getElementById('hub-timer');
    const timerStart = document.getElementById('hub-timer-start');
    const timerReset = document.getElementById('hub-timer-reset');
    const modalBackdrop = document.getElementById('hub-modal-backdrop');
    const modalClose = document.getElementById('hub-modal-close');
    const modalKeepFree = document.getElementById('hub-modal-keep-free');
    const modalStatus = document.getElementById('hub-modal-status');

    // ---- Helpers ----
    function wordCount(text) {
      return text.trim().split(/\s+/).filter(Boolean).length;
    }

    function formatTime(seconds) {
      const m = Math.floor(seconds / 60).toString().padStart(2, '0');
      const s = (seconds % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    function setStatus(msg, isError = false) {
      if (writingStatus) {
        writingStatus.textContent = msg;
        writingStatus.style.color = isError ? 'var(--accent)' : '';
      }
    }

    function setModalStatus(msg) {
      if (modalStatus) modalStatus.textContent = msg;
    }

    function getSampleResponses(prompt) {
      const samples = prompt?.sampleResponses && typeof prompt.sampleResponses === 'object'
        ? prompt.sampleResponses
        : {};

      return {
        clb5: String(samples.clb5 || '').trim(),
        clb7: String(samples.clb7 || '').trim(),
        clb9: String(samples.clb9 || prompt?.sampleResponse || '').trim(),
        clb11: String(samples.clb11 || '').trim(),
      };
    }

    function renderSampleCard(container, label, sampleText) {
      if (!(container instanceof HTMLElement)) {
        return;
      }

      container.innerHTML = '';

      if (!sampleText) {
        const placeholder = document.createElement('p');
        placeholder.className = 'muted sample-placeholder';
        placeholder.textContent = `${label} sample will appear here after it is added to the prompt library.`;
        container.appendChild(placeholder);
        return;
      }

      const sample = document.createElement('pre');
      sample.className = 'sample-essay';
      sample.textContent = sampleText;
      container.appendChild(sample);
    }

    // ---- Timer ----
    function updateTimerDisplay() {
      if (!timerEl) return;
      timerEl.textContent = formatTime(timerSeconds);
      timerEl.classList.toggle('timer-urgent', timerSeconds <= 180);
    }

    function startTimer() {
      if (timerRunning) return;
      timerRunning = true;
      if (timerStart) timerStart.textContent = '⏸';
      timerInterval = setInterval(() => {
        if (timerSeconds > 0) {
          timerSeconds--;
          updateTimerDisplay();
        } else {
          clearInterval(timerInterval);
          timerRunning = false;
          if (timerStart) timerStart.textContent = '▶';
        }
      }, 1000);
    }

    function pauseTimer() {
      timerRunning = false;
      clearInterval(timerInterval);
      if (timerStart) timerStart.textContent = '▶';
    }

    function resetTimer() {
      pauseTimer();
      timerSeconds = 27 * 60;
      updateTimerDisplay();
    }

    timerStart?.addEventListener('click', () => {
      if (timerRunning) pauseTimer(); else startTimer();
    });

    timerReset?.addEventListener('click', resetTimer);

    // ---- Load prompt into UI ----
    function loadPrompt(id) {
      const p = promptData[id];
      if (!p) return;

      // Scenario
      if (promptScenario) promptScenario.textContent = p.scenario || '';

      // Task line
      if (promptTaskLine) {
        const wc = p.targetWords || '150\u2013200 words';
        promptTaskLine.textContent = `Write an email in about ${wc}. Your email should:`;
      }

      // Instructions
      if (promptInstructions) {
        promptInstructions.innerHTML = '';
        const items = p.instructions || [];
        items.forEach((instr) => {
          const li = document.createElement('li');
          li.textContent = instr;
          promptInstructions.appendChild(li);
        });
      }

      // Sample bank
      const samples = getSampleResponses(p);
      renderSampleCard(sampleClb5, 'CLB 5', samples.clb5);
      renderSampleCard(sampleClb7, 'CLB 7', samples.clb7);
      renderSampleCard(sampleClb11, 'CLB 11', samples.clb11);

      if (sampleClb9) {
        sampleClb9.textContent = samples.clb9 || 'CLB 9 sample will appear here after it is added to the prompt library.';
        sampleClb9.classList.toggle('sample-essay--placeholder', !samples.clb9);
      }
      if (sampleLevelBadge) {
        const hasClb9 = Boolean(samples.clb9);
        sampleLevelBadge.textContent = hasClb9 ? 'Reference sample' : '';
        sampleLevelBadge.style.display = hasClb9 ? '' : 'none';
      }
      if (sampleLevelWhy && Array.isArray(p.sampleLevelWhy)) {
        sampleLevelWhy.innerHTML = '';
        p.sampleLevelWhy.forEach((why) => {
          const li = document.createElement('li');
          li.textContent = why;
          sampleLevelWhy.appendChild(li);
        });
        sampleLevelWhy.style.display = samples.clb9 && p.sampleLevelWhy.length ? '' : 'none';
      } else if (sampleLevelWhy) {
        sampleLevelWhy.innerHTML = '';
        sampleLevelWhy.style.display = 'none';
      }

      // Reset timer
      resetTimer();
    }

    // ---- Update submit area based on state ----
    function updateSubmitArea() {
      const sub = getSubscription();
      const isFreeeTask = selectedTaskId === FREE_TASK_ID;
      const freeUsed = hasFreeEvalUsed();

      if (!isFreeeTask && !sub) {
        // Locked task, no subscription — shouldn't reach here but guard
        return;
      }

      if (isFreeeTask && freeUsed && !sub) {
        // Free eval exhausted
        if (submitArea) submitArea.style.display = 'none';
        if (upgradePrompt) upgradePrompt.style.display = '';
      } else {
        if (submitArea) submitArea.style.display = '';
        if (upgradePrompt) upgradePrompt.style.display = 'none';
      }
    }

    // ---- Select task ----
    function selectTask(id) {
      const entry = sidebarData.find((t) => t.id === id);
      if (!entry) return;

      const sub = getSubscription();
      if (!entry.isFree && !sub) {
        openModal();
        return;
      }

      selectedTaskId = id;

      // Update sidebar active state
      taskItems.forEach((btn) => {
        const btnId = btn.getAttribute('data-task-id');
        btn.classList.toggle('is-active', btnId === id);
      });

      // Load prompt
      loadPrompt(id);

      // Reset writing area
      if (textarea) textarea.value = '';
      if (wordCountBadge) {
        wordCountBadge.textContent = '0 words';
        wordCountBadge.classList.remove('ready');
      }
      if (submitBtn) submitBtn.disabled = true;
      setStatus('');

      // Reset results
      if (resultsEl) resultsEl.style.display = 'none';
      if (noSubmission) noSubmission.style.display = '';

      updateSubmitArea();
    }

    // ---- Sidebar click handlers ----
    taskItems.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-task-id');
        if (id) selectTask(id);
      });
    });

    // ---- Word count ----
    textarea?.addEventListener('input', () => {
      const wc = wordCount(textarea.value);
      if (wordCountBadge) {
        wordCountBadge.textContent = `${wc} word${wc !== 1 ? 's' : ''}`;
        wordCountBadge.classList.toggle('ready', wc >= 40);
      }
      if (submitBtn) {
        submitBtn.disabled = wc < 40;
      }
    });

    // ---- Submit ----
    submitBtn?.addEventListener('click', async () => {
      const sub = getSubscription();
      const isFreeeTask = selectedTaskId === FREE_TASK_ID;
      const freeUsed = hasFreeEvalUsed();

      if (isFreeeTask && freeUsed && !sub) {
        updateSubmitArea();
        return;
      }

      const responseText = textarea?.value?.trim() || '';
      if (wordCount(responseText) < 40) {
        setStatus('Please write at least 40 words before submitting.', true);
        return;
      }

      const p = promptData[selectedTaskId];
      if (!p) {
        setStatus('Prompt data not found. Please refresh the page.', true);
        return;
      }

      setStatus('Evaluating your response…');
      if (submitBtn) submitBtn.disabled = true;

      try {
        const payload = {
          taskType: 'task1',
          promptId: selectedTaskId,
          promptTitle: p.title || p.sidebarLabel || selectedTaskId,
          promptText: p.scenario || '',
          promptInstructions: p.instructions || [],
          responseText,
          isFreeTask: isFreeeTask && !sub,
          ...(sub?.sessionId ? { sessionId: sub.sessionId } : {}),
        };

        const res = await fetch('/.netlify/functions/evaluate-celpip-writing', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (!res.ok || !data.report) {
          throw new Error(data.error || 'Evaluation failed. Please try again.');
        }

        if (isFreeeTask && !sub) {
          markFreeEvalUsed();
        }

        renderResults(data.report);
        setStatus('');
      } catch (err) {
        setStatus(err instanceof Error ? err.message : 'Evaluation failed.', true);
        if (submitBtn) submitBtn.disabled = false;
      }
    });

    // ---- Render results ----
    function renderResults(report) {
      if (!resultsEl) return;

      // Score
      const scoreBadge = document.getElementById('hub-score-badge');
      const scoreDesc = document.getElementById('hub-score-descriptor');
      if (scoreBadge) scoreBadge.textContent = `CLB ${report.overallLevel}`;
      if (scoreDesc) scoreDesc.textContent = report.descriptor || '';

      // Summary
      const summaryEl = document.getElementById('hub-results-summary');
      if (summaryEl) summaryEl.textContent = report.overallSummary || '';

      // Criteria
      const criteriaGrid = document.getElementById('hub-criteria-grid');
      if (criteriaGrid && report.traitScores) {
        criteriaGrid.innerHTML = '';
        Object.entries(report.traitScores).forEach(([name, score]) => {
          const comment = report.criterionComments?.[name] || '';
          const card = document.createElement('div');
          card.className = 'criterion-card';
          card.innerHTML = `
            <div class="criterion-name">${escHtml(name)}</div>
            <div class="criterion-score">CLB ${escHtml(String(score))}</div>
            <div class="criterion-comment">${escHtml(comment)}</div>
          `;
          criteriaGrid.appendChild(card);
        });
      }

      // Strengths
      const strengthsEl = document.getElementById('hub-strengths');
      if (strengthsEl && Array.isArray(report.strengths)) {
        strengthsEl.innerHTML = report.strengths
          .map((s) => `<li>${escHtml(s)}</li>`)
          .join('');
      }

      // Priorities
      const prioritiesEl = document.getElementById('hub-priorities');
      if (prioritiesEl && Array.isArray(report.improvementPriorities)) {
        prioritiesEl.innerHTML = report.improvementPriorities
          .map((s) => `<li>${escHtml(s)}</li>`)
          .join('');
      }

      // Errors
      const errorsSection = document.getElementById('hub-errors-section');
      const errorsList = document.getElementById('hub-errors-list');
      if (errorsSection && errorsList && Array.isArray(report.errorAnalysis) && report.errorAnalysis.length) {
        errorsList.innerHTML = report.errorAnalysis.slice(0, 4).map((e) => `
          <div class="error-card">
            <div class="error-card__cat">${escHtml(e.category || '')}</div>
            <div class="error-card__text">${escHtml(e.explanation || '')}</div>
            ${e.fixNow ? `<div class="error-card__fix">Fix: ${escHtml(e.fixNow)}</div>` : ''}
          </div>
        `).join('');
        errorsSection.style.display = '';
      } else if (errorsSection) {
        errorsSection.style.display = 'none';
      }

      // Rewrites
      const rewritesSection = document.getElementById('hub-rewrites-section');
      const rewritesList = document.getElementById('hub-rewrites-list');
      if (rewritesSection && rewritesList && Array.isArray(report.rewriteSuggestions) && report.rewriteSuggestions.length) {
        rewritesList.innerHTML = report.rewriteSuggestions.slice(0, 3).map((r) => `
          <div class="rewrite-card">
            <div class="rewrite-before">${escHtml(r.before || '')}</div>
            <div class="rewrite-after">${escHtml(r.after || '')}</div>
            <div class="rewrite-why">${escHtml(r.why || '')}</div>
          </div>
        `).join('');
        rewritesSection.style.display = '';
      } else if (rewritesSection) {
        rewritesSection.style.display = 'none';
      }

      // Lesson recommendations
      const lessonsSection = document.getElementById('hub-lessons-section');
      const lessonsGrid = document.getElementById('hub-lessons-grid');
      const recs = report.lessonRecommendations || report.lessonNeeds || [];
      if (lessonsSection && lessonsGrid && Array.isArray(recs) && recs.length) {
        lessonsGrid.innerHTML = recs.slice(0, 4).map((l) => {
          const href = l.path || l.href || '#';
          const label = l.label || l.title || 'Lesson';
          return `<a class="lesson-link" href="${escHtml(href)}">${escHtml(label)}</a>`;
        }).join('');
        lessonsSection.style.display = '';
      } else if (lessonsSection) {
        lessonsSection.style.display = 'none';
      }

      // Upgrade CTA inside results for free users
      const resultsUpgrade = document.getElementById('hub-results-upgrade');
      if (resultsUpgrade) {
        const sub = getSubscription();
        resultsUpgrade.style.display = !sub ? '' : 'none';
      }

      // Show results, hide placeholder
      resultsEl.style.display = '';
      if (noSubmission) noSubmission.style.display = 'none';

      // Update submit area (may now show upgrade prompt)
      if (submitBtn) submitBtn.disabled = false;
      updateSubmitArea();

      // Scroll results into view
      resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function escHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // ---- Modal ----
    function openModal() {
      if (modalBackdrop) modalBackdrop.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      setModalStatus('');
    }

    function closeModal() {
      if (modalBackdrop) modalBackdrop.style.display = 'none';
      document.body.style.overflow = '';
    }

    modalClose?.addEventListener('click', closeModal);
    modalKeepFree?.addEventListener('click', closeModal);

    modalBackdrop?.addEventListener('click', (e) => {
      if (e.target === modalBackdrop) closeModal();
    });

    // ---- Checkout (modal + inline buttons) ----
    async function startCheckout(statusEl) {
      if (statusEl) statusEl.textContent = 'Redirecting to secure checkout…';
      const allBtns = document.querySelectorAll('.hub-checkout-btn');
      allBtns.forEach((b) => { if (b instanceof HTMLButtonElement) b.disabled = true; });

      try {
        const res = await fetch('/.netlify/functions/create-celpip-writing-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ product: 'celpip-writing-ai' }),
        });
        const data = await res.json();
        if (!res.ok || !data.checkoutUrl) {
          throw new Error(data.error || 'Unable to start checkout.');
        }
        window.location.href = data.checkoutUrl;
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unable to start checkout.';
        if (statusEl) statusEl.textContent = msg;
        allBtns.forEach((b) => { if (b instanceof HTMLButtonElement) b.disabled = false; });
      }
    }

    document.querySelectorAll('.hub-checkout-btn').forEach((btn) => {
      btn.addEventListener('click', () => startCheckout(modalStatus));
    });

    // ---- Init ----
    selectTask(FREE_TASK_ID);
    updateSubmitArea();
  })();
</script>
