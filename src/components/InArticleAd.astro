---
const {
  adId,
  targetSelector,
  anchorSelector,
  label = "Sponsored",
} = Astro.props;

const isLocalPreview = import.meta.env.DEV || ["localhost", "127.0.0.1"].includes(Astro.url.hostname);
---

<div id={adId} class="content-ad content-ad--in-article" hidden>
  {label && <p class="content-ad__label">{label}</p>}

  {isLocalPreview ? (
    <div class="content-ad__preview">In-article ad placeholder. The live unit will appear here on production.</div>
  ) : (
    <ins
      class="adsbygoogle"
      style="display:block; text-align:center;"
      data-ad-layout="in-article"
      data-ad-format="fluid"
      data-ad-client="ca-pub-5615542310815721"
      data-ad-slot="1334989000"
    ></ins>
  )}
</div>

<script is:inline define:vars={{ adId, targetSelector, anchorSelector, isLocalPreview }}>
  (() => {
    const adRoot = document.getElementById(adId);
    if (!adRoot) return;

    const target = document.querySelector(targetSelector);
    if (!target) {
      adRoot.remove();
      return;
    }

    const cardSelector = [
      ".card",
      ".card-item",
      ".lesson-example-card",
      ".lesson-error-card",
      ".lesson-resource-card",
      ".lesson-support-card",
      ".lesson-related-card",
      ".blog-post-cta__card",
      ".mini-quiz-card",
    ].join(",");

    const isElementNode = (node) => node instanceof HTMLElement;
    const isCardLike = (node) => node.matches(cardSelector);
    const isAdContainer = (node) => node.classList.contains("content-ad");

    const toDirectChild = (node) => {
      let cursor = node;
      while (isElementNode(cursor) && cursor.parentElement && cursor.parentElement !== target) {
        cursor = cursor.parentElement;
      }
      return isElementNode(cursor) && cursor.parentElement === target ? cursor : null;
    };

    const directBlocks = Array.from(target.children).filter(isElementNode);
    const safeBlocks = directBlocks.filter((block) => {
      if (isAdContainer(block)) return false;
      if (block.hidden) return false;
      if (isCardLike(block) || block.closest(cardSelector)) return false;
      return (block.textContent || "").trim().length > 0;
    });

    const fromSelector = (() => {
      if (!anchorSelector) return null;
      const matches = Array.from(target.querySelectorAll(anchorSelector)).filter(isElementNode);
      for (const match of matches) {
        if (isCardLike(match) || match.closest(cardSelector)) continue;
        const directMatch = toDirectChild(match);
        if (directMatch && safeBlocks.includes(directMatch)) return directMatch;
      }
      return null;
    })();

    const fallbackIndex = safeBlocks.length > 1
      ? Math.max(0, Math.floor(safeBlocks.length * 0.6) - 1)
      : 0;
    const fallbackAnchor = safeBlocks[fallbackIndex] || safeBlocks[safeBlocks.length - 1] || null;
    const anchor = fromSelector || fallbackAnchor;

    if (!isElementNode(anchor)) {
      adRoot.remove();
      return;
    }

    anchor.insertAdjacentElement("afterend", adRoot);
    adRoot.hidden = false;

    if (!isLocalPreview && !adRoot.dataset.initialized) {
      (window.adsbygoogle = window.adsbygoogle || []).push({});
      adRoot.dataset.initialized = "true";
    }
  })();
</script>
