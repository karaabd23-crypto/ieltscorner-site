---
import {
  PTE_CORE_ROUTE_MAP,
  PTE_CORE_SIMULATOR_SAMPLE_ITEMS,
  PTE_CORE_SIMULATOR_SECTIONS,
  PTE_CORE_SIMULATOR_TOTAL_MINUTES,
  getPteQuestionTypeBySlug,
} from "../lib/pteCoreConfig.mjs";

const {
  mode = "full",
} = Astro.props;

const isPracticeMode = mode === "practice";
const simulatorItems = PTE_CORE_SIMULATOR_SAMPLE_ITEMS.map((item) => ({
  ...item,
  task: getPteQuestionTypeBySlug(item.taskSlug),
}));

const simulatorPayload = {
  mode,
  sections: PTE_CORE_SIMULATOR_SECTIONS,
  items: simulatorItems,
  totalMinutes: PTE_CORE_SIMULATOR_TOTAL_MINUTES,
};
---

<section
  class="pte-sim"
  data-pte-simulator
  data-mode={mode}
  aria-label={isPracticeMode ? "PTE Core practice simulator" : "PTE Core full simulator"}
>
  <script type="application/json" data-pte-simulator-data set:html={JSON.stringify(simulatorPayload)}></script>

  <div class="pte-sim__chrome">
    <div>
      <p class="pte-sim__eyebrow">{isPracticeMode ? "Task practice" : "Mock test interface"}</p>
      <h2>{isPracticeMode ? "PTE Core practice engine" : "PTE Core simulator"}</h2>
      <p class="muted">
        {isPracticeMode
          ? "Practice with the same task renderer used by the simulator, including browser recording, AI-assisted writing and speaking feedback, and account history when signed in."
          : "Move through all 19 PTE Core task types in one exam-style workspace with answer capture, writing feedback, speaking recording, and attempt history."}
      </p>
    </div>
    <div class="pte-sim__status" aria-live="polite">
      <span class="pte-sim__timer" data-pte-timer>{PTE_CORE_SIMULATOR_TOTAL_MINUTES}:00</span>
      <span class="pte-sim__progress" data-pte-progress>0 of {simulatorItems.length} answered</span>
    </div>
  </div>

  <div class="pte-sim__sections" aria-label="PTE Core simulator sections">
    {PTE_CORE_SIMULATOR_SECTIONS.map((section, index) => (
      <button class="pte-sim__section-tab" type="button" data-pte-section={section.id} aria-pressed={index === 0 ? "true" : "false"}>
        <span>{section.label}</span>
        <strong>{section.title}</strong>
        <small>{section.durationMinutes} min</small>
      </button>
    ))}
  </div>

  <div class="pte-sim__body">
    <aside class="pte-sim__palette" aria-label="Question navigator">
      <div class="pte-sim__palette-head">
        <strong>Questions</strong>
        <span data-pte-flag-count>0 flagged</span>
      </div>
      <div class="pte-sim__question-grid">
        {simulatorItems.map((item, index) => (
          <button
            type="button"
            class="pte-sim__question-dot"
            data-pte-jump={index}
            aria-label={`Go to question ${item.number}`}
          >
            {item.number}
          </button>
        ))}
      </div>
      <div class="pte-sim__legend">
        <span><i class="pte-sim__key pte-sim__key--current"></i>Current</span>
        <span><i class="pte-sim__key pte-sim__key--answered"></i>Answered</span>
        <span><i class="pte-sim__key pte-sim__key--flagged"></i>Flagged</span>
      </div>
    </aside>

    <div class="pte-sim__workspace">
      <div class="pte-sim__taskbar">
        <div>
          <p class="pte-sim__task-label" data-pte-task-label>Question type</p>
          <h3 data-pte-task-title>Loading task</h3>
        </div>
        <div class="pte-sim__task-meta">
          <span data-pte-section-title>Section</span>
          <span data-pte-timing></span>
        </div>
      </div>

      <div class="pte-sim__panels">
        <article class="pte-sim__prompt-panel">
          <p class="pte-sim__panel-label">Prompt</p>
          <div class="pte-sim__prompt" data-pte-prompt></div>
          <div class="pte-sim__instructions" data-pte-instructions></div>
        </article>

        <article class="pte-sim__answer-panel">
          <p class="pte-sim__panel-label">Response</p>
          <form class="pte-sim__answer-form" data-pte-answer-form></form>
          <div class="pte-sim__grading" data-pte-grading hidden></div>
          <p class="pte-sim__save-state" data-pte-save-state>Responses save in this browser. Signed-in users also get account-backed attempt history when they finish.</p>
        </article>
      </div>

      <div class="pte-sim__controls">
        <button class="btn btn-ghost" type="button" data-pte-prev>Previous</button>
        <button class="btn btn-ghost" type="button" data-pte-flag>Flag for review</button>
        <button class="btn btn-primary" type="button" data-pte-next>Next</button>
        <button class="btn btn-primary" type="button" data-pte-finish>Finish attempt</button>
      </div>
    </div>
  </div>

  <section class="pte-sim__results" data-pte-results hidden>
    <div>
      <p class="pte-sim__eyebrow">Completion report</p>
      <h2 data-pte-results-title>Attempt complete</h2>
      <p class="muted" data-pte-results-copy>
        Your completion report includes answer progress, AI feedback completed during the attempt, and account-backed history when you are signed in.
      </p>
    </div>
    <div class="pte-sim__result-grid" data-pte-result-grid></div>
    <div class="pte-sim__review-list" data-pte-review-list></div>
    <div class="pte-sim__history" data-pte-history></div>
    <div class="cluster">
      <button class="btn btn-primary" type="button" data-pte-restart>Restart simulator</button>
      <a class="btn btn-ghost" href={PTE_CORE_ROUTE_MAP.questionTypes}>Review question types</a>
    </div>
  </section>
</section>

<script>
  const roots = document.querySelectorAll("[data-pte-simulator]");

  roots.forEach((root) => {
    const dataNode = root.querySelector("[data-pte-simulator-data]");
    if (!dataNode?.textContent) return;

    const data = JSON.parse(dataNode.textContent);
    const storageKey = `pte-core-simulator:${data.mode}`;
    const itemById = new Map(data.items.map((item) => [item.id, item]));
    const sectionById = new Map(data.sections.map((section) => [section.id, section]));
    const initialState = {
      attemptId: `pte_attempt_${Date.now()}_${Math.random().toString(36).slice(2)}`,
      currentIndex: 0,
      answers: {},
      grades: {},
      speakingGrades: {},
      flagged: {},
      startedAt: Date.now(),
      remainingSeconds: data.totalMinutes * 60,
      finished: false,
    };

    let state = loadState();
    let timerId;
    let activeRecorder = null;
    let activeRecorderChunks = [];
    let activeRecorderItemId = "";
    const recordings = new Map();
    const premiumSessionKey = "pte-core-premium-session-id";
    const urlParams = new URLSearchParams(window.location.search);
    const checkoutSessionId = urlParams.get("session_id");
    if (urlParams.get("checkout") === "success" && checkoutSessionId) {
      window.localStorage.setItem(premiumSessionKey, checkoutSessionId);
    }

    const timerNode = root.querySelector("[data-pte-timer]");
    const progressNode = root.querySelector("[data-pte-progress]");
    const flagCountNode = root.querySelector("[data-pte-flag-count]");
    const sectionTabs = Array.from(root.querySelectorAll("[data-pte-section]"));
    const questionDots = Array.from(root.querySelectorAll("[data-pte-jump]"));
    const taskLabelNode = root.querySelector("[data-pte-task-label]");
    const taskTitleNode = root.querySelector("[data-pte-task-title]");
    const sectionTitleNode = root.querySelector("[data-pte-section-title]");
    const timingNode = root.querySelector("[data-pte-timing]");
    const promptNode = root.querySelector("[data-pte-prompt]");
    const instructionsNode = root.querySelector("[data-pte-instructions]");
    const formNode = root.querySelector("[data-pte-answer-form]");
    const gradingNode = root.querySelector("[data-pte-grading]");
    const resultsNode = root.querySelector("[data-pte-results]");
    const resultGridNode = root.querySelector("[data-pte-result-grid]");
    const reviewListNode = root.querySelector("[data-pte-review-list]");
    const historyNode = root.querySelector("[data-pte-history]");

    function loadState() {
      try {
        const saved = JSON.parse(window.localStorage.getItem(storageKey) || "null");
        if (saved && typeof saved.currentIndex === "number") {
          return { ...initialState, ...saved };
        }
      } catch {
        window.localStorage.removeItem(storageKey);
      }

      return { ...initialState };
    }

    function saveState() {
      window.localStorage.setItem(storageKey, JSON.stringify(state));
    }

    function getPremiumSessionId() {
      return window.localStorage.getItem(premiumSessionKey) || "";
    }

    function hasPremiumSession() {
      return Boolean(getPremiumSessionId());
    }

    function getCurrentItem() {
      return data.items[state.currentIndex] || data.items[0];
    }

    function getAnswer(item) {
      return state.answers[item.id] ?? (item.responseType === "multiple" ? [] : "");
    }

    function setAnswer(item, value) {
      state.answers[item.id] = value;
      saveState();
      renderProgress();
      renderGradingPanel(item);
    }

    function isAnswered(item) {
      const answer = getAnswer(item);
      if (Array.isArray(answer)) return answer.length > 0;
      return String(answer).trim().length > 0;
    }

    function formatTime(seconds) {
      const safeSeconds = Math.max(0, seconds);
      const minutes = Math.floor(safeSeconds / 60);
      const remainder = safeSeconds % 60;
      return `${minutes}:${String(remainder).padStart(2, "0")}`;
    }

    function renderProgress() {
      const answeredCount = data.items.filter(isAnswered).length;
      const flaggedCount = Object.values(state.flagged).filter(Boolean).length;
      progressNode.textContent = `${answeredCount} of ${data.items.length} answered`;
      flagCountNode.textContent = `${flaggedCount} flagged`;

      questionDots.forEach((dot, index) => {
        const item = data.items[index];
        dot.classList.toggle("is-current", index === state.currentIndex);
        dot.classList.toggle("is-answered", isAnswered(item));
        dot.classList.toggle("is-flagged", Boolean(state.flagged[item.id]));
      });
    }

    function renderSections() {
      const item = getCurrentItem();
      sectionTabs.forEach((tab) => {
        const isActive = tab.dataset.pteSection === item.sectionId;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-pressed", isActive ? "true" : "false");
      });
    }

    function renderAnswerInput(item) {
      const answer = getAnswer(item);
      const label = `<label class="pte-sim__field-label" for="pte-answer-${item.id}">Your response</label>`;

      if (item.responseType === "speaking-note") {
        const speakingGrade = state.speakingGrades?.[item.id];
        formNode.innerHTML = `
          ${label}
          <textarea id="pte-answer-${item.id}" rows="6" data-pte-answer aria-label="Optional typed speaking response notes">${escapeHtml(answer)}</textarea>
          <div class="pte-sim__recording">
            <button class="btn btn-primary" type="button" data-pte-record>${recordings.has(item.id) ? "Record again" : "Start recording"}</button>
            <button class="btn btn-ghost" type="button" data-pte-grade-speaking ${String(answer || "").trim() || recordings.has(item.id) ? "" : "disabled"}>Grade speaking</button>
            <span data-pte-record-status>${recordings.has(item.id) ? "Recording captured for this task." : "Use your microphone to capture the spoken response."}</span>
          </div>
          ${speakingGrade ? renderSpeakingGradeResult(speakingGrade.payload, speakingGrade.answerSnapshot === String(answer || "")) : ""}
        `;
        formNode.querySelector("[data-pte-answer]").addEventListener("input", (event) => {
          setAnswer(item, event.target.value);
          const gradeButton = formNode.querySelector("[data-pte-grade-speaking]");
          if (gradeButton) gradeButton.disabled = !String(event.target.value || "").trim() && !recordings.has(item.id);
        });
        formNode.querySelector("[data-pte-record]")?.addEventListener("click", () => toggleRecording(item));
        formNode.querySelector("[data-pte-grade-speaking]")?.addEventListener("click", () => submitSpeakingGrade(item));
        return;
      }

      if (item.responseType === "textarea") {
        const bounds = item.minWords || item.maxWords
          ? `<p class="pte-sim__field-hint">${item.minWords || 0}-${item.maxWords || "open"} words recommended</p>`
          : "";

        formNode.innerHTML = `${label}<textarea id="pte-answer-${item.id}" rows="8" data-pte-answer>${escapeHtml(answer)}</textarea>${bounds}`;
        formNode.querySelector("[data-pte-answer]").addEventListener("input", (event) => {
          setAnswer(item, event.target.value);
        });
        return;
      }

      if (item.responseType === "single") {
        formNode.innerHTML = item.options.map((option, index) => `
          <label class="pte-sim__choice">
            <input type="radio" name="pte-answer-${item.id}" value="${escapeAttribute(option)}" ${answer === option ? "checked" : ""}>
            <span>${escapeHtml(option)}</span>
          </label>
        `).join("");
        formNode.querySelectorAll("input").forEach((input) => {
          input.addEventListener("change", () => setAnswer(item, input.value));
        });
        return;
      }

      if (item.responseType === "multiple") {
        const selected = Array.isArray(answer) ? answer : [];
        formNode.innerHTML = item.options.map((option) => `
          <label class="pte-sim__choice">
            <input type="checkbox" value="${escapeAttribute(option)}" ${selected.includes(option) ? "checked" : ""}>
            <span>${escapeHtml(option)}</span>
          </label>
        `).join("");
        formNode.querySelectorAll("input").forEach((input) => {
          input.addEventListener("change", () => {
            const values = Array.from(formNode.querySelectorAll("input:checked")).map((checked) => checked.value);
            setAnswer(item, values);
          });
        });
        return;
      }

      formNode.innerHTML = `${label}<input id="pte-answer-${item.id}" type="text" data-pte-answer value="${escapeAttribute(answer)}">`;
      formNode.querySelector("[data-pte-answer]").addEventListener("input", (event) => {
        setAnswer(item, event.target.value);
      });
    }

    function isWritingGradeTask(item) {
      return item.taskSlug === "summarize-written-text" || item.taskSlug === "write-email";
    }

    function isSpeakingGradeTask(item) {
      return item.responseType === "speaking-note";
    }

    function getWordCount(value) {
      return String(value || "").trim().split(/\s+/).filter(Boolean).length;
    }

    function getGradeMinimumWords(item) {
      return item.taskSlug === "write-email" ? 40 : 5;
    }

    function getLocalGradeCount() {
      const today = new Date().toISOString().slice(0, 10);
      const key = `pte-core-grade-count:${today}`;
      const count = Number(window.sessionStorage.getItem(key) || 0) || 0;
      return { key, count };
    }

    function incrementLocalGradeCount() {
      const { key, count } = getLocalGradeCount();
      window.sessionStorage.setItem(key, String(count + 1));
    }

    function renderGradingPanel(item, statusMessage = "") {
      if (!gradingNode) return;
      if (!isWritingGradeTask(item)) {
        gradingNode.hidden = true;
        gradingNode.innerHTML = "";
        return;
      }

      const answer = String(getAnswer(item) || "");
      const wordCount = getWordCount(answer);
      const minimumWords = getGradeMinimumWords(item);
      const grade = state.grades?.[item.id];
      const isCurrentGrade = grade?.answerSnapshot === answer;
      const staleNotice = grade && !isCurrentGrade
        ? "<p class=\"pte-sim__grade-note\">Your response changed after this grade. Grade again when you are ready.</p>"
        : "";
      const gradeButtonDisabled = wordCount < minimumWords ? "disabled" : "";
      const sourceLabel = grade?.payload?.evaluationSource
        ? `<span>${escapeHtml(grade.payload.evaluationSource)} feedback</span>`
        : `<span>${hasPremiumSession() ? "Premium writing feedback" : "Freemium writing feedback"}</span>`;
      const plan = grade?.payload?.plan;
      const planNote = plan?.freeDailyLimit
        ? `Free AI tier: ${plan.freeDailyLimit} writing grade${Number(plan.freeDailyLimit) === 1 ? "" : "s"} per day when real AI grading is enabled.`
        : "Free rule-based feedback is available; real AI grading is controlled by the server plan.";
      const billingNote = hasPremiumSession()
        ? "Premium session saved for this browser. Paid AI grades bypass the free daily caps."
        : "Need more than the free daily cap? Unlock PTE Core Premium with the same monthly plan used for CELPIP Reading.";
      const upgradeButton = hasPremiumSession()
        ? ""
        : "<button class=\"btn btn-ghost\" type=\"button\" data-pte-upgrade>Unlock premium</button>";

      gradingNode.hidden = false;
      gradingNode.innerHTML = `
        <div class="pte-sim__grade-head">
          <div>
            <p class="pte-sim__panel-label">AI writing feedback</p>
            <h4>${escapeHtml(item.task?.label || "Writing task")}</h4>
          </div>
          ${sourceLabel}
        </div>
        <p class="pte-sim__grade-note">
          Click once when your answer is ready. ${escapeHtml(planNote)} ${escapeHtml(billingNote)}
        </p>
        <div class="pte-sim__grade-actions">
          <button class="btn btn-primary" type="button" data-pte-grade ${gradeButtonDisabled}>Grade writing</button>
          ${upgradeButton}
          <span>${wordCount} words / minimum ${minimumWords}</span>
        </div>
        ${statusMessage ? `<p class="pte-sim__grade-status" data-pte-grade-status>${escapeHtml(statusMessage)}</p>` : ""}
        ${staleNotice}
        ${grade ? renderGradeResult(grade.payload, isCurrentGrade) : ""}
      `;

      const gradeButton = gradingNode.querySelector("[data-pte-grade]");
      if (gradeButton) {
        gradeButton.addEventListener("click", () => submitWritingGrade(item));
      }

      const upgradeButtonNode = gradingNode.querySelector("[data-pte-upgrade]");
      if (upgradeButtonNode) {
        upgradeButtonNode.addEventListener("click", () => startPteCheckout(item));
      }
    }

    function renderGradeResult(payload, isCurrentGrade) {
      const scores = payload?.scores || {};
      const criteria = Array.isArray(payload?.criteria) ? payload.criteria : [];
      const strengths = Array.isArray(payload?.strengths) ? payload.strengths : [];
      const priorities = Array.isArray(payload?.priorities) ? payload.priorities : [];
      const fadedClass = isCurrentGrade ? "" : " is-stale";
      const scoreKeys = Object.keys(scores).length
        ? Object.keys(scores)
        : ["content", "form", "grammar", "vocabulary", "coherence"];

      return `
        <article class="pte-sim__grade-result${fadedClass}">
          <div class="pte-sim__grade-score">
            <strong>${escapeHtml(payload?.overallScore ?? "N/A")}</strong>
            <span>${escapeHtml(payload?.readiness || "Practice feedback")}</span>
          </div>
          <p>${escapeHtml(payload?.summary || "Feedback is ready.")}</p>
          ${payload?.transcript ? `<p class="pte-sim__grade-note"><strong>Transcript:</strong> ${escapeHtml(payload.transcript)}</p>` : ""}
          <div class="pte-sim__grade-score-grid">
            ${scoreKeys.map((key) => `
              <span><strong>${escapeHtml(key)}</strong>${escapeHtml(scores[key] ?? "N/A")}</span>
            `).join("")}
          </div>
          <div class="pte-sim__grade-columns">
            <div>
              <h5>Strengths</h5>
              <ul>${strengths.map((item) => `<li>${escapeHtml(item)}</li>`).join("")}</ul>
            </div>
            <div>
              <h5>Priorities</h5>
              <ul>${priorities.map((item) => `<li>${escapeHtml(item)}</li>`).join("")}</ul>
            </div>
          </div>
        ${criteria.length ? `
            <div class="pte-sim__grade-criteria">
              ${criteria.map((item) => `
                <section>
                  <strong>${escapeHtml(item.label)}</strong>
                  <p>${escapeHtml(item.comment)}</p>
                </section>
              `).join("")}
            </div>
          ` : ""}
          ${payload?.plan ? `
            <p class="pte-sim__grade-note">
              Plan: ${escapeHtml(payload.plan.tier || "free")} / free daily limit ${escapeHtml(payload.plan.freeDailyLimit ?? "limited")} / site cap ${escapeHtml(payload.plan.globalDailyLimit ?? "limited")}.
            </p>
          ` : ""}
        </article>
      `;
    }

    function renderSpeakingGradeResult(payload, isCurrentGrade) {
      return renderGradeResult(payload, isCurrentGrade);
    }

    function updateRecordStatus(message) {
      const status = formNode.querySelector("[data-pte-record-status]");
      if (status) status.textContent = message;
    }

    async function toggleRecording(item) {
      if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === "undefined") {
        updateRecordStatus("Microphone recording is not supported in this browser. Type your response notes and grade from text.");
        return;
      }

      if (activeRecorder && activeRecorder.state === "recording") {
        activeRecorder.stop();
        return;
      }

      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        activeRecorderChunks = [];
        activeRecorderItemId = item.id;
        activeRecorder = new MediaRecorder(stream);
        activeRecorder.addEventListener("dataavailable", (event) => {
          if (event.data?.size) activeRecorderChunks.push(event.data);
        });
        activeRecorder.addEventListener("stop", () => {
          const blob = new Blob(activeRecorderChunks, { type: activeRecorder.mimeType || "audio/webm" });
          recordings.set(activeRecorderItemId, blob);
          stream.getTracks().forEach((track) => track.stop());
          updateRecordStatus("Recording captured. You can grade speaking now or record again.");
          renderAnswerInput(item);
        });
        activeRecorder.start();
        updateRecordStatus("Recording... click Stop recording when finished.");
        const button = formNode.querySelector("[data-pte-record]");
        if (button) button.textContent = "Stop recording";
      } catch (error) {
        updateRecordStatus(error?.message || "Unable to access the microphone.");
      }
    }

    function blobToBase64(blob) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onloadend = () => resolve(String(reader.result || "").split(",")[1] || "");
        reader.onerror = () => reject(new Error("Unable to read the recording."));
        reader.readAsDataURL(blob);
      });
    }

    async function submitSpeakingGrade(item) {
      const notes = String(getAnswer(item) || "").trim();
      const recording = recordings.get(item.id);
      if (!notes && !recording) {
        updateRecordStatus("Record your response or type what you said before grading.");
        return;
      }

      updateRecordStatus("Grading speaking...");

      try {
        const audioBase64 = recording ? await blobToBase64(recording) : "";
        const response = await fetch("/.netlify/functions/pte-core-grade-speaking", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            taskSlug: item.taskSlug,
            taskLabel: item.task?.label || item.taskSlug,
            prompt: item.prompt,
            instructions: item.instructions,
            notes,
            audioBase64,
            mimeType: recording?.type || "audio/webm",
            sessionId: getPremiumSessionId(),
          }),
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(payload.error || "Unable to grade this speaking response right now.");
        }

        state.speakingGrades = {
          ...(state.speakingGrades || {}),
          [item.id]: {
            answerSnapshot: notes,
            gradedAt: new Date().toISOString(),
            payload,
          },
        };
        saveState();
        renderAnswerInput(item);
      } catch (error) {
        updateRecordStatus(error?.message || "Unable to grade this speaking response right now.");
      }
    }

    async function startPteCheckout(item) {
      renderGradingPanel(item, "Opening secure PTE Core checkout...");

      try {
        const response = await fetch("/.netlify/functions/create-pte-core-checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({}),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.checkoutUrl) {
          throw new Error(payload.error || "Unable to start checkout.");
        }
        window.location.href = payload.checkoutUrl;
      } catch (error) {
        renderGradingPanel(item, error?.message || "Unable to start checkout.");
      }
    }

    async function submitWritingGrade(item) {
      const answer = String(getAnswer(item) || "").trim();
      const minimumWords = getGradeMinimumWords(item);

      if (getWordCount(answer) < minimumWords) {
        renderGradingPanel(item, `Add more detail first. Minimum: ${minimumWords} words.`);
        return;
      }

      const { count } = getLocalGradeCount();
      if (!hasPremiumSession() && count >= 8) {
        renderGradingPanel(item, "Session grading limit reached. Refresh tomorrow or continue practising without grading.");
        return;
      }

      renderGradingPanel(item, "Grading writing...");

      try {
        const response = await fetch("/.netlify/functions/pte-core-grade-writing", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            taskSlug: item.taskSlug,
            taskLabel: item.task?.label || item.taskSlug,
            prompt: item.prompt,
            instructions: item.instructions,
            responseText: answer,
            sessionId: getPremiumSessionId(),
          }),
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(payload.error || "Unable to grade this response right now.");
        }

        incrementLocalGradeCount();
        state.grades = {
          ...(state.grades || {}),
          [item.id]: {
            answerSnapshot: answer,
            gradedAt: new Date().toISOString(),
            payload,
          },
        };
        saveState();
        renderGradingPanel(item, payload.cached ? "Showing cached feedback for this response." : "Feedback ready.");
      } catch (error) {
        renderGradingPanel(item, error?.message || "Unable to grade this response right now.");
      }
    }

    function renderQuestion() {
      const item = getCurrentItem();
      const section = sectionById.get(item.sectionId);
      const taskLabel = item.task?.label || item.taskSlug;
      const timing = [item.prepSeconds ? `${item.prepSeconds}s prep` : "", item.responseSeconds ? `${item.responseSeconds}s response` : ""]
        .filter(Boolean)
        .join(" / ");

      taskLabelNode.textContent = `Question ${item.number} of ${data.items.length}`;
      taskTitleNode.textContent = taskLabel;
      sectionTitleNode.textContent = section ? `${section.label}: ${section.title}` : item.sectionId;
      timingNode.textContent = timing;
      promptNode.textContent = item.prompt;
      instructionsNode.textContent = item.instructions;
      renderAnswerInput(item);
      renderGradingPanel(item);
      renderSections();
      renderProgress();
      saveState();
    }

    function jumpTo(index) {
      state.currentIndex = Math.min(Math.max(index, 0), data.items.length - 1);
      renderQuestion();
    }

    function toggleFlag() {
      const item = getCurrentItem();
      state.flagged[item.id] = !state.flagged[item.id];
      saveState();
      renderProgress();
    }

    function renderResults() {
      state.finished = true;
      saveState();
      const answeredItems = data.items.filter(isAnswered);
      const writingGradeCount = Object.keys(state.grades || {}).length;
      const speakingGradeCount = Object.keys(state.speakingGrades || {}).length;

      resultGridNode.innerHTML = data.sections.map((section) => {
        const sectionItems = data.items.filter((item) => item.sectionId === section.id);
        const sectionAnswered = sectionItems.filter(isAnswered);
        return `
          <article class="pte-sim__result-card">
            <span>${escapeHtml(section.label)}</span>
            <strong>${escapeHtml(section.title)}</strong>
            <p>${sectionAnswered.length} of ${sectionItems.length} answered</p>
          </article>
        `;
      }).join("");

      reviewListNode.innerHTML = `
        <h3>Review queue</h3>
        <p>${answeredItems.length} of ${data.items.length} tasks have a saved response. ${Object.values(state.flagged).filter(Boolean).length} task(s) are flagged.</p>
        <p>${writingGradeCount} writing response(s) and ${speakingGradeCount} speaking response(s) include feedback in this attempt.</p>
      `;

      saveAttemptHistory();
      resultsNode.hidden = false;
      resultsNode.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    async function saveAttemptHistory() {
      if (!historyNode) return;
      historyNode.innerHTML = "<p class=\"pte-sim__grade-status\">Saving attempt history...</p>";

      try {
        const response = await fetch("/.netlify/functions/account-save-pte-attempt", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            attemptId: state.attemptId,
            mode: data.mode,
            startedAt: new Date(state.startedAt).toISOString(),
            submittedAt: new Date().toISOString(),
            answers: state.answers,
            flagged: state.flagged,
            grades: state.grades,
            speakingGrades: state.speakingGrades,
            total: data.items.length,
          }),
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(payload.error || "Sign in to save this attempt to your account.");
        }

        historyNode.innerHTML = `
          <article class="pte-sim__history-card">
            <strong>Saved to account history</strong>
            <p>${escapeHtml(payload.attempt?.answered ?? 0)} of ${escapeHtml(payload.attempt?.total ?? data.items.length)} tasks answered. ${escapeHtml(payload.attempt?.writingGrades ?? 0)} writing grade(s), ${escapeHtml(payload.attempt?.speakingGrades ?? 0)} speaking grade(s).</p>
          </article>
        `;
        loadAttemptHistory();
      } catch (error) {
        historyNode.innerHTML = `
          <article class="pte-sim__history-card">
            <strong>Browser attempt saved</strong>
            <p>${escapeHtml(error?.message || "Sign in to save PTE Core attempts to account history.")}</p>
          </article>
        `;
      }
    }

    async function loadAttemptHistory() {
      if (!historyNode) return;
      try {
        const response = await fetch("/.netlify/functions/account-list-pte-attempts?limit=5");
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !Array.isArray(payload.attempts) || !payload.attempts.length) return;

        historyNode.insertAdjacentHTML("beforeend", `
          <div class="pte-sim__history-list">
            <h3>Recent PTE Core attempts</h3>
            ${payload.attempts.map((attempt) => `
              <article>
                <strong>${escapeHtml(new Date(attempt.submittedAt || attempt.updatedAt).toLocaleDateString())}</strong>
                <span>${escapeHtml(attempt.answered)} / ${escapeHtml(attempt.total)} answered · ${escapeHtml(attempt.writingGrades)} writing · ${escapeHtml(attempt.speakingGrades)} speaking</span>
              </article>
            `).join("")}
          </div>
        `);
      } catch {
        // History is optional for signed-out visitors.
      }
    }

    function restart() {
      state = {
        ...initialState,
        attemptId: `pte_attempt_${Date.now()}_${Math.random().toString(36).slice(2)}`,
        startedAt: Date.now(),
      };
      window.localStorage.removeItem(storageKey);
      recordings.clear();
      resultsNode.hidden = true;
      startTimer();
      renderQuestion();
    }

    function startTimer() {
      window.clearInterval(timerId);
      timerNode.textContent = formatTime(state.remainingSeconds);
      timerId = window.setInterval(() => {
        if (state.finished) return;
        state.remainingSeconds = Math.max(0, state.remainingSeconds - 1);
        timerNode.textContent = formatTime(state.remainingSeconds);
        saveState();
        if (state.remainingSeconds === 0) {
          window.clearInterval(timerId);
          renderResults();
        }
      }, 1000);
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function escapeAttribute(value) {
      return escapeHtml(value).replace(/`/g, "&#096;");
    }

    root.querySelector("[data-pte-prev]").addEventListener("click", () => jumpTo(state.currentIndex - 1));
    root.querySelector("[data-pte-next]").addEventListener("click", () => jumpTo(state.currentIndex + 1));
    root.querySelector("[data-pte-flag]").addEventListener("click", toggleFlag);
    root.querySelector("[data-pte-finish]").addEventListener("click", renderResults);
    root.querySelector("[data-pte-restart]").addEventListener("click", restart);

    questionDots.forEach((dot) => {
      dot.addEventListener("click", () => jumpTo(Number(dot.dataset.pteJump)));
    });

    sectionTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const index = data.items.findIndex((item) => item.sectionId === tab.dataset.pteSection);
        if (index >= 0) jumpTo(index);
      });
    });

    renderQuestion();
    startTimer();
  });
</script>
