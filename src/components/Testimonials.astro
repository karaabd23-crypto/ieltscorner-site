---
// Real, consented student reviews only. Source: src/data/reviews.json
// (starts empty; see src/data/reviews.README.md). No fabricated defaults.
import reviewsData from "../data/reviews.json";

interface Review {
  slug?: string;
  name: string;
  exam?: string;
  result?: string;
  skillFocus?: string;
  quote: string;
  story?: string;
  consent?: boolean;
  date?: string;
}

interface Props {
  columns?: 1 | 2 | 3;
}

const { columns = 3 } = Astro.props;

// Only render reviews with explicit consent and a quote.
const reviews = (reviewsData as Review[]).filter(
  (r) => r && r.consent === true && r.quote
);
---

{reviews.length === 0 ? (
  <p class="testimonials-empty muted">
    Verified student reviews will appear here. We publish reviews only from
    real students who have completed lessons with us.
  </p>
) : (
  <div class="testimonials-grid" style={`grid-template-columns: repeat(${columns}, 1fr);`}>
    {reviews.map((review) => {
      const title = [review.exam, review.result].filter(Boolean).join(" • ");
      return (
        <article class="testimonial-card">
          <div class="testimonial-card__top">
            <span class="testimonial-card__rating">5/5</span>
          </div>

          <p class="testimonial-card__text">"{review.quote}"</p>

          <div class="testimonial-card__meta">
            <p class="testimonial-card__name">{review.name}</p>
            {title && <p class="testimonial-card__title">{title}</p>}
            {review.skillFocus && <p class="testimonial-card__score">{review.skillFocus} focus</p>}
            {review.story && review.slug && (
              <a class="testimonial-card__link" href={`/success-stories/${review.slug}/`}>Read the full story</a>
            )}
          </div>
        </article>
      );
    })}
  </div>
)}

<style>
  .testimonials-grid {
    display: grid;
    gap: var(--s-3);
  }

  .testimonial-card {
    padding: var(--s-3);
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-soft);
  }

  .testimonial-card__top {
    margin-bottom: var(--s-2);
  }

  .testimonial-card__rating {
    display: inline-flex;
    align-items: center;
    padding: 4px 9px;
    border-radius: 999px;
    background: #fff4d6;
    color: #8b5a00;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .testimonial-card__text {
    flex: 1;
    margin: 0 0 var(--s-2);
    font-style: italic;
    line-height: 1.7;
  }

  .testimonial-card__meta {
    border-top: 1px solid var(--border);
    padding-top: var(--s-2);
  }

  .testimonial-card__name {
    margin: 0;
    font-weight: 700;
  }

  .testimonial-card__title {
    margin: var(--s-1) 0 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .testimonial-card__score {
    margin: var(--s-1) 0 0;
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 600;
  }

  .testimonial-card__link {
    display: inline-block;
    margin-top: var(--s-2);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }

  .testimonials-empty {
    padding: var(--s-4);
    border: 1px dashed var(--border-strong);
    border-radius: 14px;
    text-align: center;
    max-width: 60ch;
  }

  @media (max-width: 768px) {
    .testimonials-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
