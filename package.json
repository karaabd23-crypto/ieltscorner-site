{
  "name": "ieltscorner-site",
  "type": "module",
  "version": "0.0.3",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "celpip:calibration:check": "node scripts/check-celpip-sample-calibration.mjs",
    "reading:check": "node scripts/check-celpip-reading-quality.mjs",
    "lesson:check:frontmatter": "node scripts/check-all-lessons.mjs",
    "lesson:check:standards": "node scripts/enforce-lesson-quality-gate.mjs",
    "lesson:check:standards:changed": "node scripts/enforce-lesson-quality-gate.mjs --changed",
    "lesson:check:standards:working": "node scripts/enforce-lesson-quality-gate.mjs --working",
    "lesson:audit:excellence": "node scripts/audit-grammar-lesson-excellence.mjs",
    "lesson:audit:topic": "node scripts/audit-lessons-topic-alignment.mjs",
    "lesson:qa": "npm run lesson:check:standards && npm run lesson:audit:topic",
    "lesson:qa:changed": "npm run lesson:check:standards:changed && npm run lesson:audit:topic",
    "lesson:qa:full": "npm run lesson:check:frontmatter && npm run lesson:qa",
    "lesson:align": "node scripts/align-lessons-to-title.mjs",
    "lesson:generate": "node scripts/generate-lessons.mjs",
    "lesson:generate:seo": "node scripts/generate-seo-lessons.mjs",
    "lesson:generate:pte-core": "node scripts/generate-pte-core-lessons.mjs",
    "lesson:dry-run": "node scripts/generate-lessons.mjs --dry-run",
    "telegram:post": "node scripts/post-telegram-content.mjs",
    "telegram:post:dry": "node scripts/post-telegram-content.mjs --dry-run",
    "telegram:bot-guide": "node scripts/post-bot-tutorial.mjs",
    "telegram:bot-guide:dry": "node scripts/post-bot-tutorial.mjs --dry-run",
    "telegram:webhook:set": "node scripts/set-telegram-webhook.mjs",
    "telegram:worker:dev": "npx wrangler dev --config workers/telegram-bot/wrangler.jsonc",
    "telegram:worker:deploy": "npx wrangler deploy --config workers/telegram-bot/wrangler.jsonc",
    "newsletter:digest": "node scripts/send-newsletter-digest.mjs",
    "newsletter:digest:dry": "node scripts/send-newsletter-digest.mjs --dry-run",
    "newsletter:digest:preview": "node scripts/send-newsletter-digest.mjs --preview",
    "newsletter:migrate:kit": "node scripts/migrate-netlify-newsletter-to-kit.mjs",
    "newsletter:migrate:kit:apply": "node scripts/migrate-netlify-newsletter-to-kit.mjs --apply",
    "newsletter:migrate:kit:cleanup": "node scripts/migrate-netlify-newsletter-to-kit.mjs --apply --delete-extra",
    "newsletter:kit:sync-audience": "node scripts/sync-kit-digest-audience.mjs",
    "newsletter:kit:sync-audience:apply": "node scripts/sync-kit-digest-audience.mjs --apply",
    "newsletter:dedupe": "node scripts/dedupe-newsletter-subscribers.mjs",
    "newsletter:dedupe:apply": "node scripts/dedupe-newsletter-subscribers.mjs --apply",
    "newsletter:stats": "node scripts/newsletter-stats.mjs",
    "newsletter:stats:json": "node scripts/newsletter-stats.mjs --json",
    "session:index": "node scripts/session-catalog.mjs",
    "session:show": "node scripts/session-catalog.mjs show",
    "session:starter": "powershell -ExecutionPolicy Bypass -File scripts/copy-session-starter.ps1",
    "cancel:insights": "node scripts/monthly-cancellation-insights.mjs",
    "cancel:insights:dry": "node scripts/monthly-cancellation-insights.mjs --dry-run",
    "cro:credential:set": "node scripts/set-cro-analytics-credential.mjs",
    "cro:credential:verify": "node scripts/set-cro-analytics-credential.mjs --verify"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.7",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/sitemap": "^3.7.0",
    "@netlify/aws-lambda-compat": "^1.0.2",
    "@netlify/blobs": "^10.7.2",
    "@netlify/identity": "^1.0.0",
    "astro": "^5.16.0",
    "nodemailer": "^8.0.5",
    "sharp": "^0.33.5",
    "stripe": "^17.5.0",
    "typescript": "^5.9.3"
  }
}
